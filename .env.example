# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=embeddedindia_super_secure_session_key_2026

# Database (SQLite default for zero-friction setup, switch to postgresql:// for production)
DATABASE_URL="file:./dev.db"

# Admin Setup
ADMIN_DEFAULT_EMAIL=admin@embeddedindia.in
ADMIN_DEFAULT_PASSWORD=AdminEmbedded@2026!
ADMIN_JWT_SECRET=embeddedindia_jwt_secret_token_key_9999

# Mailer (Nodemailer SMTP Configuration)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=info@embeddedindia.in
SMTP_PASS=your-smtp-app-password
SMTP_FROM="Embedded India <info@embeddedindia.in>"

# Copilot and article generation share the connected provider in Admin > AI.
# These server-only values are fallbacks when admin settings are empty.
AI_PROVIDER=nvidia
AI_API_KEY=
AI_MODEL=meta/llama-3.1-70b-instruct
AI_BASE_URL=

# Anti-Spam / reCAPTCHA / Cloudflare Turnstile (Optional)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Monetization & Ads (Optional)
ADSENSE_PUB_ID=
META_PIXEL_ID=
