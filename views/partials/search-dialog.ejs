<dialog id="header-search-modal" aria-labelledby="header-search-title" class="header-search-dialog w-full max-w-xl rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white p-0 shadow-2xl">
  <div class="p-4 border-b border-slate-200 dark:border-slate-700">
    <div class="flex items-center justify-between gap-3 mb-3">
      <h2 id="header-search-title" class="text-lg font-bold"><%= locals.adminSearch ? 'Search admin pages and settings' : 'Search Embedded India' %></h2>
      <button id="header-search-close" type="button" aria-label="Close search" class="min-w-[44px] min-h-[44px] px-2 rounded-lg bg-slate-100 dark:bg-slate-800">ESC</button>
    </div>
    <label for="headerSearchInput" class="sr-only">Search pages and topics</label>
    <input type="search" id="headerSearchInput" placeholder="<%= locals.adminSearch ? 'Find inquiries, posts, SMTP, theme...' : 'Find services, calculators, guides...' %>" autocomplete="off" class="w-full p-3 rounded-lg border text-base">
    <p id="header-search-status" role="status" class="sr-only"></p>
  </div>
  <div id="headerSearchResults" class="max-h-80 overflow-y-auto p-2"></div>
</dialog>
