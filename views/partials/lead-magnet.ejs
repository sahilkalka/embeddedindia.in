<!-- Unified Lead Magnet Partial -->
<section class="bg-gradient-to-br from-brand-900 via-brand-800 to-[#0d1715] text-white py-14 border-t border-brand-700">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white/5 backdrop-blur-md rounded-2xl p-8 sm:p-10 border border-white/10 shadow-2xl flex flex-col lg:flex-row items-center justify-between gap-8">
      <div class="max-w-xl text-center lg:text-left">
        <div class="inline-flex items-center space-x-2 px-3 py-1 bg-accent/20 text-accent rounded-full text-xs font-bold uppercase tracking-wider mb-3">
          <span>Free Engineering Lead Magnet</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
          Subscribe for Weekly Embedded Tips &amp; Get the Free PCB Design Checklist
        </h2>
        <p class="text-slate-300 mt-2 text-sm sm:text-base">
          Join 3,500+ hardware &amp; firmware engineers. Receive curated DFM rules, high-speed routing techniques, and RTOS architecture patterns.
        </p>
      </div>
      <div class="w-full lg:w-auto flex-1 max-w-md">
        <form id="newsletter-form" class="lead-magnet-form space-y-3">
          <input type="text" name="honeypot" class="hidden" tabindex="-1" autocomplete="off">
          <input type="hidden" name="source" value="<%= typeof currentPath !== 'undefined' ? currentPath : '/' %>">
          <div class="flex flex-col sm:flex-row gap-2">
            <input type="email" name="email" required aria-label="Work email for newsletter" placeholder="Enter your work email..." class="flex-1 px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-accent focus:bg-white/15 transition text-sm">
            <button type="submit" class="btn-shimmer px-6 py-3 bg-accent hover:bg-accent-light text-brand-900 font-bold rounded-xl text-sm transition shadow-lg hover:shadow-accent/30 whitespace-nowrap active:scale-95">
              Subscribe
            </button>
          </div>
          <p id="newsletter-status" class="lead-magnet-status text-xs text-slate-300"></p>
          <p class="text-xs text-slate-200 text-center sm:text-left font-medium flex items-center justify-center sm:justify-start gap-1.5">
            <span class="text-accent text-sm flex-shrink-0">🔒</span>
            <span>Zero spam. One-click unsubscribe at any time. Double opt-in secured.</span>
          </p>
        </form>
        <div id="newsletter-success-box" class="lead-magnet-success hidden mt-3 p-3 rounded-xl bg-emerald-500/20 text-emerald-300 text-xs font-semibold border border-emerald-500/40">
          ✅ Subscribed! Check your inbox for the PCB Design Checklist.
        </div>
      </div>
    </div>
  </div>
</section>
