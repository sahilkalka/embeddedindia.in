<%
const wrapperId = locals.wrapperId || 'palette-dropdown-wrapper';
const btnId = locals.btnId || 'palette-dropdown-btn';
const menuId = (locals.menuId || 'palette-dropdown-menu') + '-appearance';
%>
<div id="<%= wrapperId %>" class="appearance-control">
  <% if (locals.showSearch) { %>
  <button id="header-search-btn" type="button" aria-label="<%= locals.searchLabel || 'Search' %>" title="Search" class="appearance-search min-h-[44px] min-w-[44px] flex items-center justify-center p-1">
    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
  </button>
  <% } %>
  <button id="<%= btnId %>" type="button" aria-label="Appearance" aria-expanded="false" aria-controls="<%= menuId %>" class="appearance-trigger min-h-[44px] min-w-[44px] flex items-center justify-center p-1">
    <svg class="appearance-mode-moon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20.4 15.4A9 9 0 0 1 8.6 3.6 9 9 0 1 0 20.4 15.4Z"/></svg>
    <svg class="appearance-mode-sun" aria-hidden="true" hidden width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
    <span class="appearance-current-color" aria-hidden="true"></span>
  </button>
  <div id="<%= menuId %>" class="appearance-panel" hidden inert aria-label="Appearance settings">
    <div class="appearance-panel-content">
      <label class="appearance-mode"><span>Night mode</span><input id="theme-mode-switch" type="checkbox" role="switch" aria-label="Night mode"><span class="appearance-switch-track" aria-hidden="true"></span></label>
      <div class="appearance-palettes">
        <% colorThemes.forEach(preset => { %>
        <button type="button" class="appearance-palette min-h-[44px] min-w-[44px] flex items-center justify-center p-1" data-scheme="<%= preset.key %>" aria-label="<%= preset.name %>" aria-pressed="false"><span class="appearance-swatch" style="--swatch:<%= preset.accent %>"><span class="appearance-check" aria-hidden="true">✓</span></span><span><%= preset.label || preset.name %></span></button>
        <% }); %>
      </div>
    </div>
  </div>
</div>
<script id="appearance-presets" type="application/json"><%- JSON.stringify(colorThemes).replace(/</g, '\u003c') %></script>
