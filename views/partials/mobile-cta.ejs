<!-- Sticky Mobile Bottom Bar - visible only on mobile (<768px) -->
<% const cPath = (typeof currentPath !== 'undefined') ? currentPath : ''; %>
<div id="mobile-cta-bar" class="fixed bottom-0 inset-x-0 z-50 flex md:hidden items-center justify-around bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-t border-slate-200 dark:border-slate-800 py-1.5 px-2 shadow-2xl shadow-black/20" style="position: fixed !important; bottom: 0 !important; left: 0 !important; right: 0 !important; width: 100% !important; top: auto !important; z-index: 9990 !important;">
  
  <!-- Services -->
  <a href="/services" aria-label="Services" class="flex-1 flex flex-col items-center justify-center py-1.5 px-1 rounded-xl transition-colors duration-200 <%= cPath.startsWith('/services') ? 'text-brand-600 dark:text-accent font-black' : 'text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-accent' %>">
    <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
    </svg>
    <span class="text-[11px] font-bold leading-tight">Services</span>
  </a>

  <!-- Projects -->
  <a href="/projects" aria-label="Projects" class="flex-1 flex flex-col items-center justify-center py-1.5 px-1 rounded-xl transition-colors duration-200 <%= cPath.startsWith('/projects') ? 'text-brand-600 dark:text-accent font-black' : 'text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-accent' %>">
    <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
    </svg>
    <span class="text-[11px] font-bold leading-tight">Projects</span>
  </a>

  <!-- About -->
  <a href="/about" aria-label="About" class="flex-1 flex flex-col items-center justify-center py-1.5 px-1 rounded-xl transition-colors duration-200 <%= cPath === '/about' ? 'text-brand-600 dark:text-accent font-black' : 'text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-accent' %>">
    <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
    </svg>
    <span class="text-[11px] font-bold leading-tight">About</span>
  </a>

  <!-- Single Get RFQ Button -->
  <div class="flex-1 flex items-center justify-center px-1">
    <a href="/contact" aria-label="Get RFQ" class="w-full inline-flex items-center justify-center gap-1 py-2 px-2.5 rounded-xl bg-gradient-to-r from-brand-600 via-brand-500 to-accent text-white font-black text-xs shadow-md shadow-brand-500/25 active:scale-95 transition-all text-center whitespace-nowrap">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
      </svg>
      <span>Get RFQ</span>
    </a>
  </div>

</div>
