<%- include('../layouts/header') %>

<!-- Services Hero (Left-Aligned with Ambient Mesh) -->
<section class="pt-20 pb-12 sm:pt-16 sm:pb-16 lg:py-20 bg-white dark:bg-[#0d1715] border-b border-slate-200 dark:border-brand-border spaceship-ambient-mesh circuit-grid">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">
    <div class="max-w-3xl">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-slate-100 dark:bg-slate-800/90 border border-slate-300 dark:border-slate-700 text-slate-800 dark:text-slate-100 text-xs font-bold uppercase tracking-wider shadow-sm backdrop-blur-md animate-float-slow">
        <span class="w-2 h-2 rounded-full bg-brand-500 dark:bg-accent animate-ping flex-shrink-0"></span>
        <span class="font-extrabold text-slate-800 dark:text-slate-100">Comprehensive Solutions</span>
      </div>
      <h1 class="text-[clamp(1.75rem,4vw,2.625rem)] font-black text-slate-900 dark:text-white mt-4 tracking-tight leading-tight">
        Services we offer
      </h1>
      <p class="mt-4 text-[15px] md:text-base leading-relaxed text-slate-700 dark:text-slate-200 font-normal">
        Turnkey electronic product engineering from napkin architecture and high-speed simulation to volume mass manufacturing and lifecycle sustainment.
      </p>
    </div>
  </div>
</section>

<!-- Detailed Services Grid with Sticky Sidebar -->
<section class="py-20 bg-slate-50 dark:bg-[#13221f]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Sticky Navigation Sidebar on LG -->
      <aside class="hidden lg:block lg:col-span-3 sticky top-28 space-y-4">
        <nav aria-label="Services Navigation" class="p-5 bg-white dark:bg-brand-surface rounded-3xl border border-slate-200 dark:border-brand-border shadow-sm space-y-2">
          <p class="text-xs font-black uppercase text-slate-400 tracking-wider mb-3">Disciplines</p>
          <a href="#hardware" class="flex items-center space-x-2.5 text-xs font-bold text-slate-700 dark:text-slate-200 hover:text-brand-500 dark:hover:text-accent p-2 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition">
            <span class="w-6 h-6 rounded-lg bg-brand-50 dark:bg-brand-900/60 text-brand-600 dark:text-accent flex items-center justify-center text-[10px] font-black">01</span>
            <span>Hardware Design</span>
          </a>
          <a href="#firmware" class="flex items-center space-x-2.5 text-xs font-bold text-slate-700 dark:text-slate-200 hover:text-brand-500 dark:hover:text-accent p-2 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition">
            <span class="w-6 h-6 rounded-lg bg-brand-50 dark:bg-brand-900/60 text-brand-600 dark:text-accent flex items-center justify-center text-[10px] font-black">02</span>
            <span>Firmware &amp; BSP</span>
          </a>
          <a href="#connectivity" class="flex items-center space-x-2.5 text-xs font-bold text-slate-700 dark:text-slate-200 hover:text-brand-500 dark:hover:text-accent p-2 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition">
            <span class="w-6 h-6 rounded-lg bg-brand-50 dark:bg-brand-900/60 text-brand-600 dark:text-accent flex items-center justify-center text-[10px] font-black">03</span>
            <span>Connectivity &amp; IoT</span>
          </a>
        </nav>
        
        <div class="p-5 bg-gradient-to-br from-brand-900 to-slate-900 text-white rounded-3xl border border-brand-700 shadow-sm text-center">
          <h4 class="font-bold text-xs">Need Custom Scoping?</h4>
          <p class="text-[11px] text-slate-300 mt-1">Talk to an engineering architect within 24 hours.</p>
          <a href="/contact" class="btn-shimmer mt-3 block py-2 px-3 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl text-xs transition">
            Get an RFQ &rarr;
          </a>
        </div>
      </aside>

      <!-- Main Services Column -->
      <div class="lg:col-span-9 space-y-16">
        
        <!-- Service Category 1: Hardware Development & Design -->
        <div id="hardware" class="spotlight-card reveal-on-scroll bg-white dark:bg-brand-surface rounded-3xl p-8 sm:p-12 border border-slate-200 dark:border-brand-border shadow-md scroll-mt-28">
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-8 border-b border-slate-100 dark:border-brand-border">
            <div>
              <span class="text-xs font-bold text-brand-500 dark:text-accent uppercase tracking-wider">Discipline 01</span>
              <h2 class="text-[clamp(1.375rem,3vw,2rem)] font-extrabold text-slate-900 dark:text-white mt-1">Hardware Development &amp; Design</h2>
              <p class="text-slate-600 dark:text-slate-300 mt-2 max-w-2xl pr-14 lg:pr-0 text-[15px] md:text-base leading-relaxed">
                From mixed-signal analog circuitry to high-density multi-layer digital layouts with impedance control.
              </p>
            </div>
            <a href="/contact?service=Hardware%20Design" class="btn-shimmer inline-flex items-center min-h-[44px] px-6 py-3 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl text-sm transition shadow-md active:scale-95 whitespace-nowrap">
              Inquire Hardware &rarr;
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200/60 dark:border-brand-border/60 min-h-[140px] flex flex-col justify-between">
              <h3 class="font-bold text-slate-900 dark:text-white mb-2">System Architecture &amp; Feasibility</h3>
              <p class="text-xs text-slate-700 dark:text-slate-200 leading-relaxed">
                Component trade-off analysis, power tree calculation, bus bandwidth budgeting, and thermal feasibility modeling.
              </p>
            </div>
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200/60 dark:border-brand-border/60 min-h-[140px] flex flex-col justify-between">
              <h3 class="font-bold text-slate-900 dark:text-white mb-2">Electronic Circuit Design</h3>
              <p class="text-xs text-slate-700 dark:text-slate-200 leading-relaxed">
                Precision analog front-ends, low-noise power supplies, sensor signal conditioning, and robust ESD/EMC surge protection.
              </p>
            </div>
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200/60 dark:border-brand-border/60 min-h-[140px] flex flex-col justify-between">
              <h3 class="font-bold text-slate-900 dark:text-white mb-2">PCB Design &amp; Layout</h3>
              <p class="text-xs text-slate-700 dark:text-slate-200 leading-relaxed">
                Multi-layer routing (up to 16+ layers), HDI microvias, controlled impedance traces, and differential skew matching.
              </p>
            </div>
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200/60 dark:border-brand-border/60 min-h-[140px] flex flex-col justify-between">
              <h3 class="font-bold text-slate-900 dark:text-white mb-2">Prototype &amp; NPI</h3>
              <p class="text-xs text-slate-700 dark:text-slate-200 leading-relaxed">
                Rapid quick-turn PCB fabrication, automated stencil printing, component procurement, and bring-up bench testing.
              </p>
            </div>
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200/60 dark:border-brand-border/60 min-h-[140px] flex flex-col justify-between">
              <h3 class="font-bold text-slate-900 dark:text-white mb-2">Obsolescence Management</h3>
              <p class="text-xs text-slate-700 dark:text-slate-200 leading-relaxed">
                Drop-in second-sourcing, pin-compatible redesigns, and continuous component lifecycle health monitoring.
              </p>
            </div>
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200/60 dark:border-brand-border/60 min-h-[140px] flex flex-col justify-between">
              <h3 class="font-bold text-slate-900 dark:text-white mb-2">Technical Documentation</h3>
              <p class="text-xs text-slate-700 dark:text-slate-200 leading-relaxed">
                Essential documentation includes production-ready fabrication drawings, assembly BOMs, pick-and-place centroids, and test station specifications.
              </p>
            </div>
          </div>
        </div>

        <!-- Service Category 2: Embedded Software & Firmware Development -->
        <div id="firmware" class="spotlight-card reveal-on-scroll delay-100 bg-white dark:bg-brand-surface rounded-3xl p-8 sm:p-12 border border-slate-200 dark:border-brand-border shadow-md scroll-mt-28">
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-8 border-b border-slate-100 dark:border-brand-border">
            <div>
              <span class="text-xs font-bold text-brand-500 dark:text-accent uppercase tracking-wider">Discipline 02</span>
              <h2 class="text-[clamp(1.375rem,3vw,2rem)] font-extrabold text-slate-900 dark:text-white mt-1">Embedded Software &amp; Firmware</h2>
              <p class="text-slate-600 dark:text-slate-300 mt-2 max-w-2xl text-[15px] md:text-base leading-relaxed">
                Reliable, secure code engineered for ARM Cortex, RISC-V, ESP32, STM32, and PIC architectures.
              </p>
            </div>
            <a href="/contact?service=Firmware%20Development" class="btn-shimmer inline-flex items-center px-6 py-3 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl text-sm transition shadow-md active:scale-95 whitespace-nowrap">
              Inquire Firmware &rarr;
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200/60 dark:border-brand-border/60 min-h-[140px] flex flex-col justify-between">
              <h3 class="font-bold text-slate-900 dark:text-white mb-2">Low-Level Firmware Coding</h3>
              <p class="text-xs text-slate-700 dark:text-slate-200 leading-relaxed">
                Bare-metal C/C++ driver development, memory management, DMA transfers, and ultra-low power sleep states.
              </p>
            </div>
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200/60 dark:border-brand-border/60 min-h-[140px] flex flex-col justify-between">
              <h3 class="font-bold text-slate-900 dark:text-white mb-2">BSP &amp; Device Drivers</h3>
              <p class="text-xs text-slate-700 dark:text-slate-200 leading-relaxed">
                Board support packages for custom boards, Embedded Linux kernel configuration, and driver implementation.
              </p>
            </div>
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200/60 dark:border-brand-border/60 min-h-[140px] flex flex-col justify-between">
              <h3 class="font-bold text-slate-900 dark:text-white mb-2">RTOS Multithreading</h3>
              <p class="text-xs text-slate-700 dark:text-slate-200 leading-relaxed">
                Deterministic real-time scheduling on FreeRTOS and Zephyr with mutexes, semaphores, and message queues.
              </p>
            </div>
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200/60 dark:border-brand-border/60 min-h-[140px] flex flex-col justify-between">
              <h3 class="font-bold text-slate-900 dark:text-white mb-2">Wireless Protocols</h3>
              <p class="text-xs text-slate-700 dark:text-slate-200 leading-relaxed">
                <a href="#connectivity" class="text-brand-500 dark:text-accent font-bold hover:underline">See Wireless Protocols under Connectivity &rarr;</a>
              </p>
            </div>
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200/60 dark:border-brand-border/60 min-h-[140px] flex flex-col justify-between">
              <h3 class="font-bold text-slate-900 dark:text-white mb-2">Secure Boot &amp; FOTA</h3>
              <p class="text-xs text-slate-700 dark:text-slate-200 leading-relaxed">
                Dual-bank fail-safe firmware updates with cryptographic ECDSA signature verification and rollback protection.
              </p>
            </div>
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200/60 dark:border-brand-border/60 min-h-[140px] flex flex-col justify-between">
              <h3 class="font-bold text-slate-900 dark:text-white mb-2">Algorithm Porting &amp; DSP</h3>
              <p class="text-xs text-slate-700 dark:text-slate-200 leading-relaxed">
                Digital signal filtering (FIR/IIR), sensor fusion, Kalman filters, and TinyML neural network inference.
              </p>
            </div>
          </div>
        </div>

        <!-- Service Category 3: Connectivity & IoT Solutions, Automotive & Edge -->
        <div id="connectivity" class="spotlight-card reveal-on-scroll delay-200 bg-white dark:bg-brand-surface rounded-3xl p-8 sm:p-12 border border-slate-200 dark:border-brand-border shadow-md scroll-mt-28">
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-8 border-b border-slate-100 dark:border-brand-border">
            <div>
              <span class="text-xs font-bold text-brand-500 dark:text-accent uppercase tracking-wider">Discipline 03</span>
              <h2 class="text-[clamp(1.375rem,3vw,2rem)] font-extrabold text-slate-900 dark:text-white mt-1">Connectivity &amp; IoT Solutions</h2>
              <p class="text-slate-600 dark:text-slate-300 mt-2 max-w-2xl text-[15px] md:text-base leading-relaxed">
                Connected intelligent nodes with cloud telemetry, ISO 26262 compliance, and automated HIL test rigs.
              </p>
            </div>
            <a href="/contact?service=IoT%20Solutions" class="btn-shimmer inline-flex items-center px-6 py-3 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl text-sm transition shadow-md active:scale-95 whitespace-nowrap">
              Inquire IoT &rarr;
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200/60 dark:border-brand-border/60 min-h-[140px] flex flex-col justify-between">
              <h3 class="font-bold text-slate-900 dark:text-white mb-2">Wireless Protocol Implementation</h3>
              <p class="text-xs text-slate-700 dark:text-slate-200 leading-relaxed">
                Designing and deploying low-power wireless stacks (BLE, Wi-Fi, Zigbee, LoRaWAN, Cellular IoT, and MQTT/CoAP) for reliable device-to-cloud communication.
              </p>
            </div>
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200/60 dark:border-brand-border/60 min-h-[140px] flex flex-col justify-between">
              <h3 class="font-bold text-slate-900 dark:text-white mb-2">Industrial IoT Gateways</h3>
              <p class="text-xs text-slate-700 dark:text-slate-200 leading-relaxed">
                Ruggedized gateways supporting 4G/LTE-Cat1, RS-485 isolation, and local edge processing for telemetry.
              </p>
            </div>
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200/60 dark:border-brand-border/60 min-h-[140px] flex flex-col justify-between">
              <h3 class="font-bold text-slate-900 dark:text-white mb-2">Automotive CAN-FD &amp; ECUs</h3>
              <p class="text-xs text-slate-700 dark:text-slate-200 leading-relaxed">
                Automotive body control, climate management, and powertrain controllers built to ISO 26262 safety guidelines.
              </p>
            </div>
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200/60 dark:border-brand-border/60 min-h-[140px] flex flex-col justify-between">
              <h3 class="font-bold text-slate-900 dark:text-white mb-2">Hardware-in-the-Loop (HIL)</h3>
              <p class="text-xs text-slate-700 dark:text-slate-200 leading-relaxed">
                Automated regression test benches simulating physical loads, environmental temperatures, and sensor faults.
              </p>
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

