            <span class="font-bold text-slate-800 dark:text-white">AWS IoT Core / MQTT</span>
          </div>
          <div class="p-3 bg-slate-50 dark:bg-brand-dark rounded-xl border border-slate-200/60 dark:border-brand-border/60">
            <span class="text-slate-700 dark:text-slate-300 font-semibold block">Updates</span>
            <span class="font-bold text-slate-800 dark:text-white">Dual-Bank FOTA</span>
          </div>
        </div>
      </div>
      <div class="lg:col-span-5">
        <figure class="space-y-2">
          <div class="relative w-full aspect-video rounded-2xl overflow-hidden shadow-lg border border-slate-200/60 dark:border-brand-border/60 bg-black">
            <iframe 
              class="w-full h-full"
              src="https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ?rel=0" 
