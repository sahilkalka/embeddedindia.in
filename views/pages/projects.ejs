    <div class="max-w-3xl">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-white/90 dark:bg-brand-surface/90 border border-slate-200 dark:border-brand-border text-brand-600 dark:text-accent text-xs font-bold uppercase tracking-wider shadow-sm backdrop-blur-md animate-float-slow">
