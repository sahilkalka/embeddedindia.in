            <span class="font-bold text-slate-800 dark:text-white">CAN 2.0B / LIN 2.2</span>
          </div>
          <div class="p-3 bg-slate-50 dark:bg-brand-dark rounded-xl border border-slate-200/60 dark:border-brand-border/60">
            <span class="text-slate-700 dark:text-slate-300 font-semibold block">Compliance</span>
            <span class="font-bold text-slate-800 dark:text-white">ISO 7637-2 Surge</span>
          </div>
        </div>
      </div>
      <div class="lg:col-span-5">
        <figure class="space-y-2">
          <div class="relative w-full aspect-video rounded-2xl overflow-hidden shadow-lg border border-slate-200/60 dark:border-brand-border/60 bg-black">
