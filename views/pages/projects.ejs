    <!-- Project 1: Bus AC Controller -->
    <div class="spotlight-card reveal-on-scroll bg-white dark:bg-brand-surface rounded-3xl p-8 sm:p-12 border border-slate-200 dark:border-brand-border shadow-md grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
