<%- include('../../layouts/header') %>

<div class="py-12 bg-white dark:bg-[#0d1715] border-b border-slate-200 dark:border-brand-border">
  <div class="max-w-5xl mx-auto px-4">
    <a href="/tools" class="inline-flex items-center text-xs font-bold text-brand-500 dark:text-accent hover:underline mb-4">
      &larr; Back to All Tools
    </a>
    <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white">
      SMD Resistor Code Decoder (3-Digit, 4-Digit &amp; EIA-96)
    </h1>
    <p class="text-slate-600 dark:text-slate-300 mt-2 text-sm sm:text-base">
      Instantly decode SMD surface-mount resistor markings into exact resistance, tolerance, and package standard.
    </p>
  </div>
</div>

<div class="py-12 bg-slate-50 dark:bg-[#13221f]">
  <div class="max-w-5xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Input Column -->
      <div class="lg:col-span-6 bg-white dark:bg-brand-surface rounded-2xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-md space-y-5">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white border-b border-slate-100 dark:border-brand-border pb-3">
          Enter SMD Marking Code
        </h2>

        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
            Marking Code (e.g. 103, 4702, 01C, 4R7)
          </label>
          <input type="text" id="smdInput" value="103" maxlength="6" class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white font-mono text-2xl uppercase tracking-wider focus:ring-2 focus:ring-brand-500">
        </div>

        <!-- Quick Examples -->
        <div>
          <span class="text-xs font-bold text-slate-500 block mb-2 uppercase tracking-wider">Try Examples:</span>
          <div class="flex flex-wrap gap-2 text-xs font-mono">
            <button type="button" class="px-2.5 py-1 bg-slate-100 dark:bg-brand-dark rounded-lg hover:bg-brand-500 hover:text-white transition example-btn">103</button>
            <button type="button" class="px-2.5 py-1 bg-slate-100 dark:bg-brand-dark rounded-lg hover:bg-brand-500 hover:text-white transition example-btn">4R7</button>
            <button type="button" class="px-2.5 py-1 bg-slate-100 dark:bg-brand-dark rounded-lg hover:bg-brand-500 hover:text-white transition example-btn">4702</button>
            <button type="button" class="px-2.5 py-1 bg-slate-100 dark:bg-brand-dark rounded-lg hover:bg-brand-500 hover:text-white transition example-btn">01C</button>
            <button type="button" class="px-2.5 py-1 bg-slate-100 dark:bg-brand-dark rounded-lg hover:bg-brand-500 hover:text-white transition example-btn">R050</button>
          </div>
        </div>

        <!-- Visual SMD Resistor Package Graphic -->
        <div class="mt-8 p-6 bg-slate-900 rounded-xl text-center">
          <p class="text-[11px] font-mono text-slate-400 mb-4">SMD Chip Package View</p>
          <div class="inline-flex items-center justify-center p-1 bg-slate-700 rounded-lg shadow-inner">
            <div class="w-8 h-16 bg-slate-300 rounded-l-sm border-r border-slate-500"></div>
            <div class="w-36 h-16 bg-slate-800 flex items-center justify-center border-y border-slate-700">
              <span id="chipText" class="text-white font-mono font-bold text-2xl tracking-widest">103</span>
            </div>
            <div class="w-8 h-16 bg-slate-300 rounded-r-sm border-l border-slate-500"></div>
          </div>
        </div>

      </div>

      <!-- Results Column -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-white dark:bg-brand-surface rounded-2xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-md">
          <h2 class="text-lg font-bold text-slate-900 dark:text-white border-b border-slate-100 dark:border-brand-border pb-3">
            Decoded Specifications
          </h2>

          <div class="mt-6 p-5 bg-brand-50 dark:bg-brand-900/40 rounded-xl border border-brand-200 dark:border-brand-700">
            <span class="text-xs text-brand-800 dark:text-accent font-semibold block">Decoded Resistance</span>
            <span id="resResistance" class="text-3xl font-black text-brand-700 dark:text-white font-mono">10 kΩ</span>
            <span id="resOhmsExact" class="text-xs text-slate-500 dark:text-slate-700 dark:text-slate-300 font-semibold block mt-1">(10,000 Ohms)</span>
          </div>

          <div class="mt-4 grid grid-cols-2 gap-3 text-xs">
            <div class="p-3 bg-slate-50 dark:bg-brand-dark rounded-xl border border-slate-200/60 dark:border-brand-border/60">
              <span class="text-slate-700 dark:text-slate-300 font-semibold block">Coding Standard</span>
              <span id="resStandard" class="font-bold text-slate-800 dark:text-white font-mono text-sm">3-Digit Standard (5%)</span>
            </div>
            <div class="p-3 bg-slate-50 dark:bg-brand-dark rounded-xl border border-slate-200/60 dark:border-brand-border/60">
              <span class="text-slate-700 dark:text-slate-300 font-semibold block">Typical Tolerance</span>
              <span id="resTolerance" class="font-bold text-slate-800 dark:text-white font-mono text-sm">± 5%</span>
            </div>
          </div>

        </div>

        
        <!-- AdSense: Tool Sub-Page Banner Ad -->
        <%- include('../../partials/ad-slot', { slot: settings.adsense_tools_bottom_slot, format: 'auto' }) %>

        <div class="bg-gradient-to-r from-brand-900 to-brand-800 rounded-2xl p-6 text-white border border-brand-700 shadow-lg">
          <span class="text-xs font-bold text-accent uppercase tracking-wider block">BOM &amp; Sourcing</span>
          <h3 class="text-lg font-bold mt-1">Need Turnkey SMT Assembly or Component Procurement?</h3>
          <p class="text-xs text-slate-300 mt-1 leading-relaxed">
            We source verified components from authorized distributors with complete traceability and RoHS certification.
          </p>
          <a href="/contact?service=Hardware%20Design" class="inline-block mt-4 px-5 py-2.5 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl text-xs transition">
            Request Assembly Quote &rarr;
          </a>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  // EIA-96 Lookup Table
  const EIA96_CODES = {
    '01': 100, '02': 102, '03': 105, '04': 107, '05': 110, '06': 113, '07': 115, '08': 118, '09': 121, '10': 124,
    '11': 127, '12': 130, '13': 133, '14': 137, '15': 140, '16': 143, '17': 147, '18': 150, '19': 154, '20': 158,
    '21': 162, '22': 165, '23': 169, '24': 174, '25': 178, '26': 182, '27': 187, '28': 191, '29': 196, '30': 200,
    '31': 205, '32': 210, '33': 215, '34': 221, '35': 226, '36': 232, '37': 237, '38': 243, '39': 249, '40': 255,
    '41': 261, '42': 267, '43': 274, '44': 280, '45': 287, '46': 294, '47': 301, '48': 309, '49': 316, '50': 324,
    '51': 332, '52': 340, '53': 348, '54': 357, '55': 365, '56': 374, '57': 383, '58': 392, '59': 402, '60': 412,
    '61': 422, '62': 432, '63': 442, '64': 453, '65': 464, '66': 475, '67': 487, '68': 499, '69': 511, '70': 523,
    '71': 536, '72': 549, '73': 562, '74': 576, '75': 590, '76': 604, '77': 619, '78': 634, '79': 649, '80': 665,
    '81': 681, '82': 698, '83': 715, '84': 732, '85': 750, '86': 768, '87': 787, '88': 806, '89': 825, '90': 845,
    '91': 866, '92': 887, '93': 909, '94': 931, '95': 953, '96': 976
  };

  const EIA96_LETTERS = {
    'Z': 0.001, 'Y': 0.01, 'R': 0.01, 'X': 0.1, 'S': 0.1,
    'A': 1, 'B': 10, 'C': 100, 'D': 1000, 'E': 10000, 'F': 100000
  };

  function formatOhms(val) {
    if (val >= 1000000) return (val / 1000000).toFixed(2) + ' MΩ';
    if (val >= 1000) return (val / 1000).toFixed(2) + ' kΩ';
    return val.toFixed(2) + ' Ω';
  }

  function decodeSMD() {
    const raw = document.getElementById('smdInput').value.trim().toUpperCase();
    document.getElementById('chipText').textContent = raw || '---';

    let ohms = null;
    let standard = 'Unknown';
    let tolerance = '± 5%';

    // R notation (e.g. 4R7 = 4.7, R050 = 0.050)
    if (raw.includes('R')) {
      const parts = raw.split('R');
      const whole = parts[0] ? parseFloat(parts[0]) : 0;
      const frac = parts[1] ? parseFloat('0.' + parts[1]) : 0;
      ohms = whole + frac;
      standard = 'Decimal R Notation';
      tolerance = '± 1% to 5%';
    }
    // 3-Digit Standard (e.g. 103 = 10 * 10^3 = 10,000)
    else if (/^\d{3}$/.test(raw)) {
      const digits = parseInt(raw.slice(0, 2));
      const mult = parseInt(raw.slice(2));
      ohms = digits * Math.pow(10, mult);
      standard = '3-Digit Standard (E24)';
      tolerance = '± 5%';
    }
    // 4-Digit High Precision (e.g. 4702 = 470 * 10^2 = 47,000)
    else if (/^\d{4}$/.test(raw)) {
      const digits = parseInt(raw.slice(0, 3));
      const mult = parseInt(raw.slice(3));
      ohms = digits * Math.pow(10, mult);
      standard = '4-Digit Precision (E96)';
      tolerance = '± 1%';
    }
    // EIA-96 (e.g. 01C = 100 * 100 = 10k)
    else if (/^\d{2}[A-Z]$/.test(raw)) {
      const numCode = raw.slice(0, 2);
      const letterCode = raw.slice(2);
      if (EIA96_CODES[numCode] && EIA96_LETTERS[letterCode]) {
        ohms = EIA96_CODES[numCode] * EIA96_LETTERS[letterCode];
        standard = 'EIA-96 High-Precision (1%)';
        tolerance = '± 1%';
      }
    }

    if (ohms !== null) {
      document.getElementById('resResistance').textContent = formatOhms(ohms);
      document.getElementById('resOhmsExact').textContent = `(${ohms.toLocaleString()} Ohms)`;
      document.getElementById('resStandard').textContent = standard;
      document.getElementById('resTolerance').textContent = tolerance;
    } else {
      document.getElementById('resResistance').textContent = 'Invalid Code';
      document.getElementById('resOhmsExact').textContent = 'Please check marking format';
      document.getElementById('resStandard').textContent = '--';
      document.getElementById('resTolerance').textContent = '--';
    }
  }

  document.getElementById('smdInput').addEventListener('input', decodeSMD);

  document.querySelectorAll('.example-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.getElementById('smdInput').value = btn.textContent;
      decodeSMD();
    });
  });

  decodeSMD();
</script>

<%- include('../../layouts/footer') %>
