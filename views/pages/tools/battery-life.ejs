<%- include('../../layouts/header') %>

<div class="py-12 bg-white dark:bg-[#0d1715] border-b border-slate-200 dark:border-brand-border">
  <div class="max-w-5xl mx-auto px-4">
    <a href="/tools" class="inline-flex items-center text-xs font-bold text-brand-500 dark:text-accent hover:underline mb-4">
      &larr; Back to All Tools
    </a>
    <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white">
      IoT Battery Life &amp; Power Budget Calculator
    </h1>
    <p class="text-slate-600 dark:text-slate-300 mt-2 text-sm sm:text-base">
      Calculate expected battery longevity for wireless IoT sensor nodes (LoRa, BLE, NB-IoT) based on sleep current, transmit duty cycle, and battery capacity.
    </p>
  </div>
</div>

<div class="py-12 bg-slate-50 dark:bg-[#13221f]">
  <div class="max-w-5xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Inputs Column -->
      <div class="lg:col-span-6 bg-white dark:bg-brand-surface rounded-2xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-md space-y-5">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white border-b border-slate-100 dark:border-brand-border pb-3">
          Power Profile &amp; Battery
        </h2>

        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
            Battery Capacity (mAh)
          </label>
          <input type="number" id="batteryCap" value="2400" step="50" min="10" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white font-mono text-sm focus:ring-2 focus:ring-brand-500">
          <span class="text-[11px] text-slate-500 mt-1 block">e.g. CR2032: ~220 mAh; 2x AA Alkaline: ~2400 mAh; 18650 Li-ion: ~3000 mAh</span>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              Active Current (mA)
            </label>
            <input type="number" id="activeCurrent" value="35.0" step="1" min="0.1" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white font-mono text-sm focus:ring-2 focus:ring-brand-500">
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              Active Duration (ms)
            </label>
            <input type="number" id="activeDuration" value="250" step="10" min="1" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white font-mono text-sm focus:ring-2 focus:ring-brand-500">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              Sleep Current (µA)
            </label>
            <input type="number" id="sleepCurrent" value="15.0" step="1" min="0.1" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white font-mono text-sm focus:ring-2 focus:ring-brand-500">
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
              Transmit Interval (sec)
            </label>
            <input type="number" id="sleepDuration" value="60" step="5" min="1" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white font-mono text-sm focus:ring-2 focus:ring-brand-500">
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
            Annual Battery Self-Discharge (%)
          </label>
          <input type="number" id="selfDischarge" value="2.0" step="0.5" min="0" max="25" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white font-mono text-sm focus:ring-2 focus:ring-brand-500">
        </div>

      </div>

      <!-- Results Column -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-white dark:bg-brand-surface rounded-2xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-md">
          <h2 class="text-lg font-bold text-slate-900 dark:text-white border-b border-slate-100 dark:border-brand-border pb-3">
            Estimated Battery Operating Time
          </h2>

          <div class="mt-6 grid grid-cols-2 gap-4">
            <div class="p-4 bg-brand-50 dark:bg-brand-900/40 rounded-xl border border-brand-200 dark:border-brand-700">
              <span class="text-xs text-brand-800 dark:text-accent font-semibold block">Operating Life</span>
              <span id="resYears" class="text-3xl font-black text-brand-700 dark:text-white font-mono">--</span>
              <span class="text-[10px] text-slate-500 dark:text-slate-700 dark:text-slate-300 font-semibold block mt-0.5">Years of Operation</span>
            </div>

            <div class="p-4 bg-accent/15 dark:bg-accent/20 rounded-xl border border-accent/30">
              <span class="text-xs text-accent-dark dark:text-accent font-semibold block">Average Current</span>
              <span id="resAvgCurrent" class="text-3xl font-black text-accent-dark dark:text-white font-mono">-- µA</span>
              <span class="text-[10px] text-slate-500 dark:text-slate-700 dark:text-slate-300 font-semibold block mt-0.5">Continuous Equivalent</span>
            </div>
          </div>

          <div class="mt-4 grid grid-cols-2 gap-3 text-xs">
            <div class="p-3 bg-slate-50 dark:bg-brand-dark rounded-xl border border-slate-200/60 dark:border-brand-border/60">
              <span class="text-slate-700 dark:text-slate-300 font-semibold block">Total Days</span>
              <span id="resDays" class="font-bold text-slate-800 dark:text-white font-mono text-sm">-- days</span>
            </div>
            <div class="p-3 bg-slate-50 dark:bg-brand-dark rounded-xl border border-slate-200/60 dark:border-brand-border/60">
              <span class="text-slate-700 dark:text-slate-300 font-semibold block">Transmissions Per Day</span>
              <span id="resTxCount" class="font-bold text-slate-800 dark:text-white font-mono text-sm">-- tx</span>
            </div>
          </div>

        </div>

        <div class="bg-gradient-to-r from-brand-900 to-brand-800 rounded-2xl p-6 text-white border border-brand-700 shadow-lg">
          <span class="text-xs font-bold text-accent uppercase tracking-wider block">Low-Power Engineering</span>
          <h3 class="text-lg font-bold mt-1">Need Ultra-Low Power Firmware Optimization?</h3>
          <p class="text-xs text-slate-300 mt-1 leading-relaxed">
            We profile firmware execution using Otii power analyzers, tuning DMA sleeps and radio preamble durations to hit 10-year battery targets.
          </p>
          <a href="/contact?service=IoT%20Solutions" class="inline-block mt-4 px-5 py-2.5 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl text-xs transition">
            Request Power Profiling Call &rarr;
          </a>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  function calculateBattery() {
    const cap = parseFloat(document.getElementById('batteryCap').value) || 2400; // mAh
    const iActive = parseFloat(document.getElementById('activeCurrent').value) || 35; // mA
    const tActive = (parseFloat(document.getElementById('activeDuration').value) || 250) / 1000; // seconds
    const iSleep = (parseFloat(document.getElementById('sleepCurrent').value) || 15) / 1000; // mA
    const tSleep = parseFloat(document.getElementById('sleepDuration').value) || 60; // seconds
    const selfDischarge = parseFloat(document.getElementById('selfDischarge').value) || 2.0;

    const totalPeriodSec = tActive + tSleep;
    // Charge per cycle in mAh
    const qCycleMah = (iActive * (tActive / 3600)) + (iSleep * (tSleep / 3600));
    const cyclesPerHour = 3600 / totalPeriodSec;
    const avgCurrentMa = qCycleMah * cyclesPerHour; // mA

    // Derate capacity for annual self-discharge
    const hours = cap / avgCurrentMa;
    const days = hours / 24;
    const years = days / 365.25;

    // Apply self-discharge reduction: approx T_effective = -ln(1 - (years * self_rate)) ...
    const effectiveYears = years * (1 - (selfDischarge / 100 * (years / 2)));
    const finalYears = Math.max(Math.min(effectiveYears, 20), 0.01);
    const finalDays = Math.round(finalYears * 365);

    document.getElementById('resYears').textContent = finalYears.toFixed(2) + ' yrs';
    document.getElementById('resAvgCurrent').textContent = (avgCurrentMa * 1000).toFixed(1) + ' µA';
    document.getElementById('resDays').textContent = finalDays.toLocaleString() + ' days';
    document.getElementById('resTxCount').textContent = Math.round(86400 / totalPeriodSec).toLocaleString();
  }

  ['batteryCap', 'activeCurrent', 'activeDuration', 'sleepCurrent', 'sleepDuration', 'selfDischarge'].forEach(id => {
    document.getElementById(id).addEventListener('input', calculateBattery);
  });

  calculateBattery();
</script>

<%- include('../../layouts/footer') %>
