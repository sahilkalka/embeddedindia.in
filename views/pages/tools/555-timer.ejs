<%- include('../../layouts/header') %>

<div class="py-12 bg-white dark:bg-[#0d1715] border-b border-slate-200 dark:border-brand-border">
  <div class="max-w-5xl mx-auto px-4">
    <a href="/tools" class="inline-flex items-center text-xs font-bold text-brand-500 dark:text-accent hover:underline mb-4">
      &larr; Back to All Tools
    </a>
    <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white">
      555 Timer Circuit Calculator
    </h1>
    <p class="text-slate-600 dark:text-slate-300 mt-2 text-sm sm:text-base">
      Calculate output frequency, period, and duty cycle for NE555 timers in Astable (Oscillator) and Monostable (One-Shot Pulse) modes with live animated waveform visualization.
    </p>
  </div>
</div>

<div class="py-12 bg-slate-50 dark:bg-[#13221f]">
  <div class="max-w-5xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Inputs Column -->
      <div class="lg:col-span-6 bg-white dark:bg-brand-surface rounded-2xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-md space-y-5">
        
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-brand-border pb-3">
          <h2 class="text-lg font-bold text-slate-900 dark:text-white">Configuration</h2>
          <div class="flex bg-slate-100 dark:bg-brand-dark p-1 rounded-xl">
            <button id="modeAstable" type="button" class="px-3 py-1 text-xs font-bold rounded-lg bg-brand-500 text-white shadow">Astable</button>
            <button id="modeMonostable" type="button" class="px-3 py-1 text-xs font-bold rounded-lg text-slate-600 dark:text-slate-300">Monostable</button>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
            Resistor R1 (kΩ)
          </label>
          <input type="number" id="r1" value="10" step="0.5" min="0.1" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white font-mono text-sm focus:ring-2 focus:ring-brand-500">
        </div>

        <div id="r2Group">
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
            Resistor R2 (kΩ)
          </label>
          <input type="number" id="r2" value="47" step="1" min="0.1" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white font-mono text-sm focus:ring-2 focus:ring-brand-500">
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
            Timing Capacitor C (µF)
          </label>
          <input type="number" id="c1" value="0.1" step="0.01" min="0.0001" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white font-mono text-sm focus:ring-2 focus:ring-brand-500">
        </div>

        <!-- 555 Pinout SVG diagram -->
        <div class="mt-6 p-4 bg-slate-900 rounded-xl">
          <p class="text-[11px] font-mono text-slate-400 mb-2 text-center">NE555 DIP-8 Pinout Diagram</p>
          <svg class="w-full max-w-full h-32" viewBox="0 0 240 120">
            <!-- IC Body -->
            <rect x="70" y="20" width="100" height="80" rx="4" fill="#182c27" stroke="#55a630" stroke-width="2"/>
            <circle cx="80" cy="30" r="3" fill="#55a630"/>
            <text x="120" y="65" fill="#ffffff" font-size="12" font-family="monospace" font-weight="bold" text-anchor="middle">NE555</text>

            <!-- Left Pins: 1, 2, 3, 4 -->
            <line x1="45" y1="35" x2="70" y2="35" stroke="#dbdbdb" stroke-width="3"/>
            <text x="35" y="38" fill="#94a3b8" font-size="8" font-family="monospace">1:GND</text>
            <line x1="45" y1="52" x2="70" y2="52" stroke="#dbdbdb" stroke-width="3"/>
            <text x="35" y="55" fill="#94a3b8" font-size="8" font-family="monospace">2:TRIG</text>
            <line x1="45" y1="69" x2="70" y2="69" stroke="#dbdbdb" stroke-width="3"/>
            <text x="35" y="72" fill="#94a3b8" font-size="8" font-family="monospace">3:OUT</text>
            <line x1="45" y1="86" x2="70" y2="86" stroke="#dbdbdb" stroke-width="3"/>
            <text x="35" y="89" fill="#94a3b8" font-size="8" font-family="monospace">4:RST</text>

            <!-- Right Pins: 8, 7, 6, 5 -->
            <line x1="170" y1="35" x2="195" y2="35" stroke="#dbdbdb" stroke-width="3"/>
            <text x="200" y="38" fill="#94a3b8" font-size="8" font-family="monospace">8:VCC</text>
            <line x1="170" y1="52" x2="195" y2="52" stroke="#dbdbdb" stroke-width="3"/>
            <text x="200" y="55" fill="#94a3b8" font-size="8" font-family="monospace">7:DIS</text>
            <line x1="170" y1="69" x2="195" y2="69" stroke="#dbdbdb" stroke-width="3"/>
            <text x="200" y="72" fill="#94a3b8" font-size="8" font-family="monospace">6:THR</text>
            <line x1="170" y1="86" x2="195" y2="86" stroke="#dbdbdb" stroke-width="3"/>
            <text x="200" y="89" fill="#94a3b8" font-size="8" font-family="monospace">5:CTRL</text>
          </svg>
        </div>

      </div>

      <!-- Results Column -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-white dark:bg-brand-surface rounded-2xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-md">
          <h2 class="text-lg font-bold text-slate-900 dark:text-white border-b border-slate-100 dark:border-brand-border pb-3">
            Output Characteristics
          </h2>

          <div class="mt-6 grid grid-cols-2 gap-4">
            <div class="p-4 bg-brand-50 dark:bg-brand-900/40 rounded-xl border border-brand-200 dark:border-brand-700">
              <span class="text-xs text-brand-800 dark:text-accent font-semibold block">Oscillator Frequency</span>
              <span id="resFreq" class="text-2xl font-black text-brand-700 dark:text-white font-mono">--</span>
              <span class="text-[10px] text-slate-500 dark:text-slate-700 dark:text-slate-300 font-semibold block mt-0.5">Hertz (Hz)</span>
            </div>

            <div class="p-4 bg-accent/15 dark:bg-accent/20 rounded-xl border border-accent/30">
              <span class="text-xs text-accent-dark dark:text-accent font-semibold block">Duty Cycle</span>
              <span id="resDuty" class="text-2xl font-black text-accent-dark dark:text-white font-mono">--</span>
              <span class="text-[10px] text-slate-500 dark:text-slate-700 dark:text-slate-300 font-semibold block mt-0.5">% High</span>
            </div>
          </div>

          <div class="mt-4 grid grid-cols-3 gap-3 text-xs">
            <div class="p-3 bg-slate-50 dark:bg-brand-dark rounded-xl border border-slate-200/60 dark:border-brand-border/60">
              <span class="text-slate-700 dark:text-slate-300 font-semibold block">Total Period (T)</span>
              <span id="resPeriod" class="font-bold text-slate-800 dark:text-white font-mono text-sm">-- ms</span>
            </div>
            <div class="p-3 bg-slate-50 dark:bg-brand-dark rounded-xl border border-slate-200/60 dark:border-brand-border/60">
              <span class="text-slate-700 dark:text-slate-300 font-semibold block">Time High (Th)</span>
              <span id="resThigh" class="font-bold text-slate-800 dark:text-white font-mono text-sm">-- ms</span>
            </div>
            <div class="p-3 bg-slate-50 dark:bg-brand-dark rounded-xl border border-slate-200/60 dark:border-brand-border/60">
              <span class="text-slate-700 dark:text-slate-300 font-semibold block">Time Low (Tl)</span>
              <span id="resTlow" class="font-bold text-slate-800 dark:text-white font-mono text-sm">-- ms</span>
            </div>
          </div>

          <!-- Dynamic Waveform Preview -->
          <div class="mt-6 p-4 bg-slate-900 rounded-xl text-center">
            <p class="text-[11px] font-mono text-slate-400 mb-2">Simulated Output Square Waveform</p>
            <svg class="w-full max-w-full h-24" viewBox="0 0 320 80">
              <line x1="10" y1="70" x2="310" y2="70" stroke="#334155" stroke-width="1"/>
              <line x1="10" y1="20" x2="310" y2="20" stroke="#334155" stroke-dasharray="2 2" stroke-width="1"/>
              <path id="svgWaveform" d="M 10 70 L 10 20 L 70 20 L 70 70 L 110 70 L 110 20 L 170 20 L 170 70 L 210 70 L 210 20 L 270 20 L 270 70 L 310 70" fill="none" stroke="#55a630" stroke-width="2.5" stroke-linejoin="round"/>
            </svg>
          </div>

        </div>

        <!-- CTA Banner -->
        <div class="bg-gradient-to-r from-brand-900 to-brand-800 rounded-2xl p-6 text-white border border-brand-700 shadow-lg">
          <span class="text-xs font-bold text-accent uppercase tracking-wider block">Custom Engineering</span>
          <h3 class="text-lg font-bold mt-1">Need Precision Clock Generation or Custom Oscillators?</h3>
          <p class="text-xs text-slate-300 mt-1 leading-relaxed">
            From low-jitter PLL synthesis to micro-power quartz oscillators and discrete analog front-ends.
          </p>
          <a href="/contact?service=Hardware%20Design" class="inline-block mt-4 px-5 py-2.5 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl text-xs transition">
            Speak to an Engineer &rarr;
          </a>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  let mode = 'astable';

  const modeAstableBtn = document.getElementById('modeAstable');
  const modeMonostableBtn = document.getElementById('modeMonostable');
  const r2Group = document.getElementById('r2Group');

  modeAstableBtn.addEventListener('click', () => {
    mode = 'astable';
    modeAstableBtn.className = 'px-3 py-1 text-xs font-bold rounded-lg bg-brand-500 text-white shadow';
    modeMonostableBtn.className = 'px-3 py-1 text-xs font-bold rounded-lg text-slate-600 dark:text-slate-300';
    r2Group.style.display = 'block';
    calculate555();
  });

  modeMonostableBtn.addEventListener('click', () => {
    mode = 'monostable';
    modeMonostableBtn.className = 'px-3 py-1 text-xs font-bold rounded-lg bg-brand-500 text-white shadow';
    modeAstableBtn.className = 'px-3 py-1 text-xs font-bold rounded-lg text-slate-600 dark:text-slate-300';
    r2Group.style.display = 'none';
    calculate555();
  });

  function calculate555() {
    const r1 = (parseFloat(document.getElementById('r1').value) || 1) * 1000; // Ohms
    const r2 = (parseFloat(document.getElementById('r2').value) || 1) * 1000; // Ohms
    const c = (parseFloat(document.getElementById('c1').value) || 0.1) * 1e-6; // Farads

    if (mode === 'astable') {
      // Astable formulas:
      // Thigh = 0.693 * (R1 + R2) * C
      // Tlow = 0.693 * R2 * C
      // Total Period T = Thigh + Tlow
      // Frequency f = 1.44 / ((R1 + 2R2) * C)
      // Duty cycle D = (R1 + R2) / (R1 + 2*R2) * 100%
      const tHigh = 0.693 * (r1 + r2) * c;
      const tLow = 0.693 * r2 * c;
      const period = tHigh + tLow;
      const freq = 1 / period;
      const duty = ((r1 + r2) / (r1 + 2 * r2)) * 100;

      document.getElementById('resFreq').textContent = freq > 1000 ? (freq / 1000).toFixed(2) + ' kHz' : freq.toFixed(1) + ' Hz';
      document.getElementById('resDuty').textContent = duty.toFixed(1) + ' %';
      document.getElementById('resPeriod').textContent = (period * 1000).toFixed(3) + ' ms';
      document.getElementById('resThigh').textContent = (tHigh * 1000).toFixed(3) + ' ms';
      document.getElementById('resTlow').textContent = (tLow * 1000).toFixed(3) + ' ms';

      // Update waveform SVG
      const dutyFraction = Math.min(Math.max(duty / 100, 0.1), 0.9);
      const cycleWidth = 80;
      const highW = cycleWidth * dutyFraction;
      const lowW = cycleWidth * (1 - dutyFraction);
      let d = `M 10 70 `;
      for (let i = 0; i < 3; i++) {
        const startX = 10 + i * cycleWidth;
        d += `L ${startX} 20 L ${startX + highW} 20 L ${startX + highW} 70 L ${startX + cycleWidth} 70 `;
      }
      document.getElementById('svgWaveform').setAttribute('d', d);
    } else {
      // Monostable formula: Pulse width T = 1.1 * R1 * C
      const pulseWidth = 1.1 * r1 * c;
      document.getElementById('resFreq').textContent = 'One-Shot';
      document.getElementById('resDuty').textContent = 'Pulse';
      document.getElementById('resPeriod').textContent = (pulseWidth * 1000).toFixed(2) + ' ms';
      document.getElementById('resThigh').textContent = (pulseWidth * 1000).toFixed(2) + ' ms';
      document.getElementById('resTlow').textContent = 'N/A';

      document.getElementById('svgWaveform').setAttribute('d', 'M 10 70 L 40 70 L 40 20 L 180 20 L 180 70 L 310 70');
    }
  }

  ['r1', 'r2', 'c1'].forEach(id => {
    document.getElementById(id).addEventListener('input', calculate555);
  });

  calculate555();
</script>

<%- include('../../layouts/footer') %>
