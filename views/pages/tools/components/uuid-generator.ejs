<div class="space-y-6">
  <div class="bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-md space-y-5">
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 dark:border-brand-border pb-4">
      <div>
        <h3 class="text-base font-bold text-slate-900 dark:text-white">RFC4122 UUID v4 Generator</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400">Generate cryptographically secure 128-bit Universally Unique Identifiers.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <button type="button" id="uuid-gen-btn" class="px-3.5 py-1.5 bg-brand-500 hover:bg-brand-600 text-white font-bold text-xs rounded-xl shadow">Generate</button>
        <button type="button" id="uuid-copy-btn" class="px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl">Copy All</button>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <label for="uuid-count" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Count</label>
        <select id="uuid-count" class="w-full px-4 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white text-xs focus:ring-2 focus:ring-brand-500 outline-none">
          <option value="1">1 UUID</option>
          <option value="5" selected>5 UUIDs</option>
          <option value="10">10 UUIDs</option>
          <option value="25">25 UUIDs</option>
          <option value="50">50 UUIDs</option>
        </select>
      </div>
      <div>
        <label for="uuid-format" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Letter Casing</label>
        <select id="uuid-format" class="w-full px-4 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white text-xs focus:ring-2 focus:ring-brand-500 outline-none">
          <option value="lower" selected>lowercase (standard)</option>
          <option value="upper">UPPERCASE</option>
        </select>
      </div>
      <div>
        <label for="uuid-hyphens" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Hyphens</label>
        <select id="uuid-hyphens" class="w-full px-4 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white text-xs focus:ring-2 focus:ring-brand-500 outline-none">
          <option value="yes" selected>With Hyphens (8-4-4-4-12)</option>
          <option value="no">Without Hyphens (32 hex)</option>
        </select>
      </div>
    </div>

    <div>
      <textarea id="uuid-output" readonly rows="8" class="w-full px-4 py-3 rounded-2xl bg-slate-900 border border-slate-800 text-emerald-400 font-mono text-sm leading-relaxed outline-none"></textarea>
    </div>
  </div>
</div>
<script>
(function() {
  const countEl = document.getElementById('uuid-count');
  const formatEl = document.getElementById('uuid-format');
  const hyphenEl = document.getElementById('uuid-hyphens');
  const outEl = document.getElementById('uuid-output');

  function generate() {
    const count = parseInt(countEl.value) || 1;
    const isUpper = formatEl.value === 'upper';
    const noHyphen = hyphenEl.value === 'no';

    const list = [];
    for (let i = 0; i < count; i++) {
      let u = window.crypto.randomUUID ? window.crypto.randomUUID() : (function() {
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
          const r = Math.random() * 16 | 0;
          const v = c === 'x' ? r : (r & 0x3 | 0x8);
          return v.toString(16);
        });
      })();

      if (noHyphen) u = u.replace(/-/g, '');
      if (isUpper) u = u.toUpperCase();
      list.push(u);
    }
    outEl.value = list.join('\n');
  }

  [countEl, formatEl, hyphenEl].forEach(el => el.addEventListener('change', generate));
  document.getElementById('uuid-gen-btn').addEventListener('click', generate);

  document.getElementById('uuid-copy-btn').addEventListener('click', () => {
    if (outEl.value) {
      navigator.clipboard.writeText(outEl.value);
      const btn = document.getElementById('uuid-copy-btn');
      const orig = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => btn.textContent = orig, 1500);
    }
  });

  generate();
})();
</script>