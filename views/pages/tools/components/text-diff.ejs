<div class="space-y-6">
  <div class="bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-md space-y-5">
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 dark:border-brand-border pb-4">
      <div>
        <h3 class="text-base font-bold text-slate-900 dark:text-white">Text &amp; Code Diff Checker</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400">Side-by-side or unified line diff inspection without cloud dependencies.</p>
      </div>
      <div class="flex gap-2">
        <button type="button" id="diff-swap-btn" class="px-3 py-1.5 bg-slate-100 dark:bg-brand-dark text-slate-700 dark:text-slate-300 font-bold text-xs rounded-xl">Swap Left &amp; Right</button>
        <button type="button" id="diff-sample-btn" class="px-3 py-1.5 bg-brand-500 hover:bg-brand-600 text-white font-bold text-xs rounded-xl shadow">Load Sample</button>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div>
        <label for="diff-original" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Original Text (Left / Before)</label>
        <textarea id="diff-original" rows="10" class="w-full px-4 py-3 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white font-mono text-xs focus:ring-2 focus:ring-brand-500 outline-none" placeholder="Original code or text..."></textarea>
      </div>
      <div>
        <label for="diff-modified" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Modified Text (Right / After)</label>
        <textarea id="diff-modified" rows="10" class="w-full px-4 py-3 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white font-mono text-xs focus:ring-2 focus:ring-brand-500 outline-none" placeholder="Modified code or text..."></textarea>
      </div>
    </div>

    <div>
      <span class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider block mb-2">Unified Diff View</span>
      <div id="diff-result" class="p-4 bg-slate-900 rounded-2xl border border-slate-800 font-mono text-xs overflow-x-auto space-y-1"></div>
    </div>
  </div>
</div>
<script>
(function() {
  const orig = document.getElementById('diff-original');
  const mod = document.getElementById('diff-modified');
  const result = document.getElementById('diff-result');

  function renderDiff() {
    const a = orig.value.split('\n');
    const b = mod.value.split('\n');

    const max = Math.max(a.length, b.length);
    let html = '';

    for (let i = 0; i < max; i++) {
      const lineA = a[i];
      const lineB = b[i];

      if (lineA === lineB) {
        if (lineA !== undefined) {
          html += '<div class="text-slate-400 py-0.5"><span class="inline-block w-8 text-slate-600 select-none">' + (i + 1) + '</span> ' + escapeHtml(lineA) + '</div>';
        }
      } else {
        if (lineA !== undefined) {
          html += '<div class="bg-red-500/20 text-red-400 py-0.5 px-1 rounded"><span class="inline-block w-8 text-red-500/60 select-none">- ' + (i + 1) + '</span> ' + escapeHtml(lineA) + '</div>';
        }
        if (lineB !== undefined) {
          html += '<div class="bg-emerald-500/20 text-emerald-400 py-0.5 px-1 rounded"><span class="inline-block w-8 text-emerald-500/60 select-none">+ ' + (i + 1) + '</span> ' + escapeHtml(lineB) + '</div>';
        }
      }
    }
    result.innerHTML = html || '<div class="text-slate-500">No content entered.</div>';
  }

  function escapeHtml(s) {
    return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  orig.addEventListener('input', renderDiff);
  mod.addEventListener('input', renderDiff);

  document.getElementById('diff-swap-btn').addEventListener('click', () => {
    const tmp = orig.value;
    orig.value = mod.value;
    mod.value = tmp;
    renderDiff();
  });

  document.getElementById('diff-sample-btn').addEventListener('click', () => {
    orig.value = "void setup_uart() {\n  baud_rate = 9600;\n  parity = NONE;\n  stop_bits = 1;\n}";
    mod.value = "void setup_uart() {\n  baud_rate = 115200;\n  parity = EVEN;\n  stop_bits = 1;\n  enable_hardware_flow_control();\n}";
    renderDiff();
  });

  document.getElementById('diff-sample-btn').click();
})();
</script>