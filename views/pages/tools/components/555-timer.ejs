<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
  <div class="lg:col-span-6 bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-md space-y-5">
    <div class="flex items-center justify-between border-b border-slate-100 dark:border-brand-border pb-3">
      <h3 class="text-base font-bold text-slate-900 dark:text-white">Timer Configuration</h3>
      <div class="flex bg-slate-100 dark:bg-brand-dark p-1 rounded-xl">
        <button id="t555-btnAstable" type="button" class="px-3 py-1 text-xs font-bold rounded-lg bg-brand-500 text-white shadow">Astable</button>
        <button id="t555-btnMonostable" type="button" class="px-3 py-1 text-xs font-bold rounded-lg text-slate-600 dark:text-slate-300">Monostable</button>
      </div>
    </div>

    <div>
      <label for="t555-r1" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Resistor R1 (kΩ)</label>
      <input type="number" id="t555-r1" value="10" step="0.5" min="0.1" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white font-mono text-sm focus:ring-2 focus:ring-brand-500 outline-none">
    </div>

    <div id="t555-r2Group">
      <label for="t555-r2" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Resistor R2 (kΩ)</label>
      <input type="number" id="t555-r2" value="47" step="1" min="0.1" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white font-mono text-sm focus:ring-2 focus:ring-brand-500 outline-none">
    </div>

    <div>
      <label for="t555-c" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Timing Capacitor C (µF)</label>
      <input type="number" id="t555-c" value="0.1" step="0.01" min="0.0001" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white font-mono text-sm focus:ring-2 focus:ring-brand-500 outline-none">
    </div>
  </div>

  <div class="lg:col-span-6 space-y-6">
    <div class="bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-md">
      <h3 class="text-base font-bold text-slate-900 dark:text-white border-b border-slate-100 dark:border-brand-border pb-3">Frequency &amp; Pulse Characteristics</h3>
      <div class="mt-6 grid grid-cols-2 gap-4">
        <div class="p-4 bg-brand-50 dark:bg-brand-900/40 rounded-2xl border border-brand-200 dark:border-brand-700">
          <span class="text-xs text-brand-800 dark:text-accent font-semibold block">Frequency</span>
          <span id="t555-resFreq" class="text-3xl font-black text-brand-700 dark:text-white font-mono">--</span>
          <span class="text-[10px] text-slate-500 dark:text-slate-400 font-semibold block mt-0.5">Hertz (Hz)</span>
        </div>
        <div class="p-4 bg-accent/15 dark:bg-accent/20 rounded-2xl border border-accent/30">
          <span class="text-xs text-accent-dark dark:text-accent font-semibold block">Duty Cycle / Width</span>
          <span id="t555-resDuty" class="text-3xl font-black text-slate-900 dark:text-white font-mono">--</span>
          <span id="t555-dutyLabel" class="text-[10px] text-slate-500 dark:text-slate-400 font-semibold block mt-0.5">Percentage (%)</span>
        </div>
      </div>
      <div class="mt-4 grid grid-cols-2 gap-3">
        <div class="p-3 bg-slate-50 dark:bg-brand-dark rounded-xl border border-slate-200/60 dark:border-brand-border/60">
          <span class="text-[10px] text-slate-500 dark:text-slate-400 block font-semibold">Total Period (T)</span>
          <span id="t555-resPeriod" class="text-sm font-bold text-slate-900 dark:text-white font-mono">--</span>
        </div>
        <div class="p-3 bg-slate-50 dark:bg-brand-dark rounded-xl border border-slate-200/60 dark:border-brand-border/60">
          <span class="text-[10px] text-slate-500 dark:text-slate-400 block font-semibold">Time High (Th)</span>
          <span id="t555-resTh" class="text-sm font-bold text-slate-900 dark:text-white font-mono">--</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  let isAstable = true;

  function calc555() {
    const r1K = parseFloat(document.getElementById('t555-r1')?.value) || 10;
    const r2K = parseFloat(document.getElementById('t555-r2')?.value) || 47;
    const cUf = parseFloat(document.getElementById('t555-c')?.value) || 0.1;

    const r1 = r1K * 1000;
    const r2 = r2K * 1000;
    const c = cUf * 1e-6;

    if (isAstable) {
      const th = 0.693 * (r1 + r2) * c;
      const tl = 0.693 * r2 * c;
      const t = th + tl;
      const freq = t > 0 ? (1 / t) : 0;
      const duty = t > 0 ? ((th / t) * 100) : 0;

      document.getElementById('t555-resFreq').textContent = freq < 1000 ? freq.toFixed(1) : (freq / 1000).toFixed(2) + ' k';
      document.getElementById('t555-resDuty').textContent = duty.toFixed(1) + '%';
      document.getElementById('t555-dutyLabel').textContent = 'Duty Cycle (%)';
      document.getElementById('t555-resPeriod').textContent = t < 0.001 ? (t * 1e6).toFixed(0) + ' µs' : t < 1 ? (t * 1000).toFixed(2) + ' ms' : t.toFixed(3) + ' s';
      document.getElementById('t555-resTh').textContent = th < 0.001 ? (th * 1e6).toFixed(0) + ' µs' : th < 1 ? (th * 1000).toFixed(2) + ' ms' : th.toFixed(3) + ' s';
    } else {
      const tPulse = 1.1 * r1 * c;
      document.getElementById('t555-resFreq').textContent = 'Single Pulse';
      document.getElementById('t555-resDuty').textContent = tPulse < 1 ? (tPulse * 1000).toFixed(1) + ' ms' : tPulse.toFixed(3) + ' s';
      document.getElementById('t555-dutyLabel').textContent = 'Pulse Width (T)';
      document.getElementById('t555-resPeriod').textContent = tPulse.toFixed(3) + ' s';
      document.getElementById('t555-resTh').textContent = tPulse.toFixed(3) + ' s';
    }
  }

  const btnAstable = document.getElementById('t555-btnAstable');
  const btnMonostable = document.getElementById('t555-btnMonostable');
  const r2Group = document.getElementById('t555-r2Group');

  btnAstable?.addEventListener('click', () => {
    isAstable = true;
    btnAstable.className = 'px-3 py-1 text-xs font-bold rounded-lg bg-brand-500 text-white shadow';
    btnMonostable.className = 'px-3 py-1 text-xs font-bold rounded-lg text-slate-600 dark:text-slate-300';
    if (r2Group) r2Group.style.display = 'block';
    calc555();
  });

  btnMonostable?.addEventListener('click', () => {
    isAstable = false;
    btnMonostable.className = 'px-3 py-1 text-xs font-bold rounded-lg bg-brand-500 text-white shadow';
    btnAstable.className = 'px-3 py-1 text-xs font-bold rounded-lg text-slate-600 dark:text-slate-300';
    if (r2Group) r2Group.style.display = 'none';
    calc555();
  });

  ['t555-r1', 't555-r2', 't555-c'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calc555);
  });
  calc555();
})();
</script>