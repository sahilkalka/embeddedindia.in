<div class="space-y-6">
  <div class="bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-md">
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 dark:border-brand-border pb-4 mb-4">
      <div>
        <h3 class="text-base font-bold text-slate-900 dark:text-white">JSON Input & Controls</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400">Validate, beautify, minify, and inspect JSON payloads.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <button type="button" id="jf-format" class="px-3.5 py-1.5 bg-brand-500 hover:bg-brand-600 text-white text-xs font-bold rounded-xl shadow transition">Beautify (2 Spaces)</button>
        <button type="button" id="jf-format-4" class="px-3.5 py-1.5 bg-slate-100 dark:bg-brand-dark hover:bg-slate-200 dark:hover:bg-brand-border text-slate-700 dark:text-slate-200 text-xs font-bold rounded-xl transition">4 Spaces</button>
        <button type="button" id="jf-minify" class="px-3.5 py-1.5 bg-slate-100 dark:bg-brand-dark hover:bg-slate-200 dark:hover:bg-brand-border text-slate-700 dark:text-slate-200 text-xs font-bold rounded-xl transition">Minify</button>
        <button type="button" id="jf-sample" class="px-3.5 py-1.5 bg-slate-100 dark:bg-brand-dark hover:bg-slate-200 dark:hover:bg-brand-border text-slate-700 dark:text-slate-200 text-xs font-bold rounded-xl transition">Sample</button>
        <button type="button" id="jf-clear" class="px-3.5 py-1.5 bg-slate-100 dark:bg-brand-dark hover:bg-slate-200 dark:hover:bg-brand-border text-slate-700 dark:text-slate-200 text-xs font-bold rounded-xl transition">Clear</button>
        <button type="button" id="jf-copy" class="px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl transition">Copy Output</button>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div>
        <label for="jf-input" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Input JSON</label>
        <textarea id="jf-input" rows="16" class="w-full px-4 py-3 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white font-mono text-xs focus:ring-2 focus:ring-brand-500 outline-none" placeholder="Paste raw JSON here..."></textarea>
      </div>
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="jf-output" class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Formatted Output</label>
          <span id="jf-status" class="text-xs font-mono font-bold text-emerald-500">Ready</span>
        </div>
        <textarea id="jf-output" readonly rows="16" class="w-full px-4 py-3 rounded-2xl bg-slate-900 border border-slate-800 text-emerald-400 font-mono text-xs outline-none" placeholder="Formatted result will appear here..."></textarea>
      </div>
    </div>
    
    <div id="jf-metrics" class="mt-4 pt-4 border-t border-slate-100 dark:border-brand-border flex flex-wrap gap-6 text-xs text-slate-600 dark:text-slate-400">
      <div>Size: <span id="jf-size" class="font-bold font-mono text-slate-900 dark:text-white">0 bytes</span></div>
      <div>Keys / Items: <span id="jf-keys" class="font-bold font-mono text-slate-900 dark:text-white">0</span></div>
      <div>Status: <span id="jf-valid" class="font-bold font-mono text-emerald-500">Valid</span></div>
    </div>
  </div>
</div>
<script>
(function() {
  const input = document.getElementById('jf-input');
  const output = document.getElementById('jf-output');
  const status = document.getElementById('jf-status');
  const sizeEl = document.getElementById('jf-size');
  const keysEl = document.getElementById('jf-keys');
  const validEl = document.getElementById('jf-valid');

  function parseAndRender(indent) {
    const val = input.value.trim();
    if (!val) {
      output.value = '';
      status.textContent = 'Empty';
      status.className = 'text-xs font-mono font-bold text-slate-400';
      sizeEl.textContent = '0 bytes';
      keysEl.textContent = '0';
      validEl.textContent = 'N/A';
      return;
    }
    try {
      const parsed = JSON.parse(val);
      const str = indent !== undefined ? JSON.stringify(parsed, null, indent) : JSON.stringify(parsed);
      output.value = str;
      status.textContent = 'Valid JSON';
      status.className = 'text-xs font-mono font-bold text-emerald-500';
      validEl.textContent = 'Valid';
      validEl.className = 'font-bold font-mono text-emerald-500';
      sizeEl.textContent = new Blob([str]).size + ' bytes';
      keysEl.textContent = typeof parsed === 'object' && parsed !== null ? Object.keys(parsed).length : 1;
    } catch (e) {
      status.textContent = 'Invalid JSON: ' + e.message;
      status.className = 'text-xs font-mono font-bold text-red-500';
      validEl.textContent = 'Invalid';
      validEl.className = 'font-bold font-mono text-red-500';
    }
  }

  document.getElementById('jf-format').addEventListener('click', () => parseAndRender(2));
  document.getElementById('jf-format-4').addEventListener('click', () => parseAndRender(4));
  document.getElementById('jf-minify').addEventListener('click', () => parseAndRender(undefined));
  document.getElementById('jf-clear').addEventListener('click', () => { input.value = ''; parseAndRender(2); });
  document.getElementById('jf-sample').addEventListener('click', () => {
    input.value = JSON.stringify({
      product: "Embedded India Gateway",
      version: "2.4.0",
      specs: { mcu: "ESP32-S3", ramKb: 512, flashMb: 16, wireless: ["Wi-Fi", "BLE 5.0", "LoRaWAN"] },
      telemetry: { uptimeSec: 86400, batteryPct: 98.4, activeSensors: 4 }
    }, null, 2);
    parseAndRender(2);
  });
  document.getElementById('jf-copy').addEventListener('click', () => {
    if (output.value) {
      navigator.clipboard.writeText(output.value);
      const btn = document.getElementById('jf-copy');
      const orig = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => btn.textContent = orig, 1500);
    }
  });

  input.addEventListener('input', () => parseAndRender(2));
})();
</script>