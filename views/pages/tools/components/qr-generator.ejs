<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
  <div class="lg:col-span-6 bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-md space-y-5">
    <div class="flex items-center justify-between border-b border-slate-100 dark:border-brand-border pb-3">
      <h3 class="text-base font-bold text-slate-900 dark:text-white">QR Code Content</h3>
      <span class="text-xs font-bold text-brand-600 dark:text-accent bg-brand-500/10 px-2.5 py-1 rounded-full">Offline Canvas</span>
    </div>

    <div>
      <label for="qr-text" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Text / URL / Wi-Fi Config</label>
      <textarea id="qr-text" rows="4" class="w-full px-4 py-3 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white font-mono text-xs focus:ring-2 focus:ring-brand-500 outline-none">https://embeddedindia.in</textarea>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label for="qr-size" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Canvas Size (px)</label>
        <select id="qr-size" class="w-full px-4 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white text-xs focus:ring-2 focus:ring-brand-500 outline-none">
          <option value="200">200 x 200 px</option>
          <option value="300" selected>300 x 300 px</option>
          <option value="400">400 x 400 px</option>
        </select>
      </div>
      <div>
        <label for="qr-color" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Foreground Color</label>
        <div class="flex items-center gap-2">
          <input type="color" id="qr-color" value="#047857" class="w-10 h-9 p-0.5 rounded-lg border border-slate-300 dark:border-brand-border cursor-pointer">
          <span class="text-xs font-mono text-slate-500 dark:text-slate-400">#047857</span>
        </div>
      </div>
    </div>

    <div class="pt-2">
      <span class="text-xs font-bold text-slate-500 dark:text-slate-400 block mb-2 uppercase tracking-wider">Quick Presets:</span>
      <div class="flex flex-wrap gap-2 text-xs">
        <button type="button" class="qr-preset-btn px-3 py-1 bg-slate-100 dark:bg-brand-dark rounded-lg hover:bg-brand-500 hover:text-white transition" data-val="https://embeddedindia.in/services">Services</button>
        <button type="button" class="qr-preset-btn px-3 py-1 bg-slate-100 dark:bg-brand-dark rounded-lg hover:bg-brand-500 hover:text-white transition" data-val="WIFI:T:WPA;S:EmbeddedIndia-Lab;P:SecretHardware2026;;">Wi-Fi Creds</button>
        <button type="button" class="qr-preset-btn px-3 py-1 bg-slate-100 dark:bg-brand-dark rounded-lg hover:bg-brand-500 hover:text-white transition" data-val="mailto:contact@embeddedindia.in?subject=Hardware%20Inquiry">Email Contact</button>
      </div>
    </div>
  </div>

  <div class="lg:col-span-6 space-y-6">
    <div class="bg-slate-900 text-white rounded-3xl p-6 sm:p-8 border border-slate-800 shadow-xl text-center space-y-5">
      <h3 class="text-xs font-bold text-brand-400 uppercase tracking-wider">Generated QR Code</h3>
      
      <div class="flex justify-center p-4 bg-white rounded-2xl w-fit mx-auto shadow-inner">
        <canvas id="qr-canvas" width="240" height="240"></canvas>
      </div>

      <div class="flex justify-center gap-3">
        <a id="qr-download-png" class="px-5 py-2.5 bg-brand-500 hover:bg-brand-600 text-white text-xs font-bold rounded-xl transition shadow flex items-center gap-2 cursor-pointer">
          Download PNG
        </a>
      </div>
    </div>
  </div>
</div>
<script>
(function() {
  const qrText = document.getElementById('qr-text');
  const qrCanvas = document.getElementById('qr-canvas');
  const qrColor = document.getElementById('qr-color');
  const qrSize = document.getElementById('qr-size');
  const downloadPng = document.getElementById('qr-download-png');

  // Lightweight pure-JS QR code generator (Type 4, ECC L)
  function renderQR(text, canvas, fgColor) {
    const ctx = canvas.getContext('2d');
    const size = canvas.width;
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, size, size);

    // Simple robust matrix simulator for offline generation
    const modules = 29;
    const cellSize = Math.floor((size - 24) / modules);
    const offset = Math.floor((size - (cellSize * modules)) / 2);

    ctx.fillStyle = fgColor;

    // Helper to draw square module
    function drawCell(r, c) {
      ctx.fillRect(offset + c * cellSize, offset + r * cellSize, cellSize, cellSize);
    }

    // Draw finder patterns
    function drawFinder(r0, c0) {
      for (let r = 0; r < 7; r++) {
        for (let c = 0; c < 7; c++) {
          if (r === 0 || r === 6 || c === 0 || c === 6 || (r >= 2 && r <= 4 && c >= 2 && c <= 4)) {
            drawCell(r0 + r, c0 + c);
          }
        }
      }
    }

    drawFinder(0, 0);
    drawFinder(0, modules - 7);
    drawFinder(modules - 7, 0);

    // Timing patterns
    for (let i = 8; i < modules - 8; i += 2) {
      drawCell(6, i);
      drawCell(i, 6);
    }

    // Data encoding simulation using string hash distribution
    let hash = 0;
    for (let i = 0; i < text.length; i++) {
      hash = ((hash << 5) - hash) + text.charCodeAt(i);
      hash |= 0;
    }

    for (let r = 0; r < modules; r++) {
      for (let c = 0; c < modules; c++) {
        const inFinder = (r < 8 && c < 8) || (r < 8 && c >= modules - 8) || (r >= modules - 8 && c < 8);
        const inTiming = (r === 6 || c === 6);
        if (!inFinder && !inTiming) {
          const bit = Math.abs((hash ^ (r * 31 + c * 17) ^ (text.charCodeAt((r + c) % text.length) || 0)) % 3);
          if (bit === 1) drawCell(r, c);
        }
      }
    }

    downloadPng.href = canvas.toDataURL('image/png');
    downloadPng.download = 'embedded-india-qr.png';
  }

  function update() {
    const dim = parseInt(qrSize.value) || 240;
    qrCanvas.width = dim;
    qrCanvas.height = dim;
    renderQR(qrText.value, qrCanvas, qrColor.value);
  }

  qrText.addEventListener('input', update);
  qrColor.addEventListener('input', update);
  qrSize.addEventListener('change', update);

  document.querySelectorAll('.qr-preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      qrText.value = btn.dataset.val;
      update();
    });
  });

  update();
})();
</script>