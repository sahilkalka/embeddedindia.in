<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
  <div class="lg:col-span-5 bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-md space-y-5">
    <div class="flex items-center justify-between border-b border-slate-100 dark:border-brand-border pb-3">
      <h3 class="text-base font-bold text-slate-900 dark:text-white">Compression Controls</h3>
      <span class="text-xs font-bold text-brand-600 dark:text-accent bg-brand-500/10 px-2.5 py-1 rounded-full">100% Client-Side</span>
    </div>

    <div>
      <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Upload Source Image</label>
      <div id="ic-dropzone" class="border-2 border-dashed border-slate-300 dark:border-brand-border rounded-2xl p-6 text-center cursor-pointer hover:border-brand-500 transition">
        <input type="file" id="ic-file" accept="image/*" class="hidden">
        <svg class="w-10 h-10 text-slate-400 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        <p class="text-xs text-slate-600 dark:text-slate-300 font-medium">Click to select image or drag &amp; drop</p>
        <p class="text-[11px] text-slate-400 mt-1">PNG, JPEG, WebP (Zero server upload)</p>
      </div>
    </div>

    <div>
      <div class="flex justify-between items-center mb-1.5">
        <label for="ic-quality" class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Quality Level</label>
        <span id="ic-quality-val" class="text-xs font-mono font-bold text-brand-600 dark:text-accent">80%</span>
      </div>
      <input type="range" id="ic-quality" min="10" max="100" step="5" value="80" class="w-full accent-brand-500 cursor-pointer">
    </div>

    <div>
      <div class="flex justify-between items-center mb-1.5">
        <label for="ic-scale" class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Resize Dimension Scale</label>
        <span id="ic-scale-val" class="text-xs font-mono font-bold text-brand-600 dark:text-accent">100%</span>
      </div>
      <input type="range" id="ic-scale" min="20" max="100" step="5" value="100" class="w-full accent-brand-500 cursor-pointer">
    </div>

    <div>
      <label for="ic-format" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Output Format</label>
      <select id="ic-format" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white text-sm focus:ring-2 focus:ring-brand-500 outline-none">
        <option value="image/jpeg" selected>JPEG (Best for photos)</option>
        <option value="image/webp">WebP (Modern high efficiency)</option>
      </select>
    </div>
  </div>

  <div class="lg:col-span-7 space-y-6">
    <div class="bg-slate-900 text-white rounded-3xl p-6 sm:p-8 border border-slate-800 shadow-xl space-y-6">
      <div class="flex items-center justify-between border-b border-slate-800 pb-4">
        <div>
          <span class="text-xs font-mono text-slate-400 uppercase">Estimated Reduction</span>
          <p id="ic-reduction-pct" class="text-3xl sm:text-4xl font-extrabold font-mono text-emerald-400 mt-1">0%</p>
        </div>
        <a id="ic-download-btn" class="px-5 py-2.5 bg-brand-500 hover:bg-brand-600 text-white text-xs font-bold rounded-xl transition shadow flex items-center gap-2 cursor-pointer pointer-events-none opacity-50">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
          Download Compressed
        </a>
      </div>

      <div class="grid grid-cols-2 gap-4 text-xs font-mono">
        <div class="p-3 bg-slate-800/60 rounded-xl border border-slate-700">
          <span class="text-slate-400 block mb-1">Original Size</span>
          <p id="ic-orig-size" class="text-base font-bold text-white">0 KB</p>
          <span id="ic-orig-dim" class="text-[11px] text-slate-500">0 x 0 px</span>
        </div>
        <div class="p-3 bg-slate-800/60 rounded-xl border border-slate-700">
          <span class="text-slate-400 block mb-1">Compressed Size</span>
          <p id="ic-comp-size" class="text-base font-bold text-emerald-400">0 KB</p>
          <span id="ic-comp-dim" class="text-[11px] text-slate-500">0 x 0 px</span>
        </div>
      </div>

      <div class="space-y-2">
        <span class="text-xs font-mono text-slate-400 uppercase">Preview</span>
        <div class="max-h-64 overflow-hidden rounded-2xl bg-black/40 flex items-center justify-center border border-slate-800 p-2">
          <img id="ic-preview" class="max-h-56 max-w-full object-contain rounded-lg hidden" alt="Compressed Preview">
          <span id="ic-placeholder" class="text-xs text-slate-500 py-12">No image loaded yet.</span>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
(function() {
  const dropzone = document.getElementById('ic-dropzone');
  const fileInput = document.getElementById('ic-file');
  const quality = document.getElementById('ic-quality');
  const qualityVal = document.getElementById('ic-quality-val');
  const scale = document.getElementById('ic-scale');
  const scaleVal = document.getElementById('ic-scale-val');
  const formatEl = document.getElementById('ic-format');

  const origSizeEl = document.getElementById('ic-orig-size');
  const compSizeEl = document.getElementById('ic-comp-size');
  const origDimEl = document.getElementById('ic-orig-dim');
  const compDimEl = document.getElementById('ic-comp-dim');
  const reductionPct = document.getElementById('ic-reduction-pct');
  const preview = document.getElementById('ic-preview');
  const placeholder = document.getElementById('ic-placeholder');
  const downloadBtn = document.getElementById('ic-download-btn');

  let currentImg = null;
  let originalFile = null;

  function formatBytes(bytes) {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  }

  function compress() {
    if (!currentImg) return;

    qualityVal.textContent = quality.value + '%';
    scaleVal.textContent = scale.value + '%';

    const canvas = document.createElement('canvas');
    const scaleFactor = parseInt(scale.value) / 100;
    const w = Math.round(currentImg.naturalWidth * scaleFactor);
    const h = Math.round(currentImg.naturalHeight * scaleFactor);

    canvas.width = w;
    canvas.height = h;
    const ctx = canvas.getContext('2d');
    ctx.drawImage(currentImg, 0, 0, w, h);

    const q = parseInt(quality.value) / 100;
    const mime = formatEl.value;

    canvas.toBlob(blob => {
      if (!blob) return;
      const compSize = blob.size;
      const origSize = originalFile.size;
      const saved = Math.max(0, ((origSize - compSize) / origSize) * 100);

      origSizeEl.textContent = formatBytes(origSize);
      compSizeEl.textContent = formatBytes(compSize);
      origDimEl.textContent = currentImg.naturalWidth + ' x ' + currentImg.naturalHeight + ' px';
      compDimEl.textContent = w + ' x ' + h + ' px';
      reductionPct.textContent = '-' + saved.toFixed(1) + '%';

      const url = URL.createObjectURL(blob);
      preview.src = url;
      preview.classList.remove('hidden');
      placeholder.classList.add('hidden');

      downloadBtn.href = url;
      downloadBtn.download = 'compressed-' + (originalFile.name.replace(/\.[^/.]+$/, '')) + (mime === 'image/webp' ? '.webp' : '.jpg');
      downloadBtn.classList.remove('pointer-events-none', 'opacity-50');
    }, mime, q);
  }

  function handleFile(file) {
    if (!file || !file.type.startsWith('image/')) return;
    originalFile = file;
    const reader = new FileReader();
    reader.onload = e => {
      const img = new Image();
      img.onload = () => {
        currentImg = img;
        compress();
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  }

  dropzone.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', e => handleFile(e.target.files[0]));

  dropzone.addEventListener('dragover', e => { e.preventDefault(); dropzone.classList.add('border-brand-500'); });
  dropzone.addEventListener('dragleave', () => dropzone.classList.remove('border-brand-500'));
  dropzone.addEventListener('drop', e => {
    e.preventDefault();
    dropzone.classList.remove('border-brand-500');
    if (e.dataTransfer.files.length) handleFile(e.dataTransfer.files[0]);
  });

  [quality, scale, formatEl].forEach(el => el.addEventListener('input', compress));
})();
</script>