<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
  <div class="lg:col-span-5 bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-md space-y-5">
    <div class="flex items-center justify-between border-b border-slate-100 dark:border-brand-border pb-3">
      <h3 class="text-base font-bold text-slate-900 dark:text-white">Loan Parameters</h3>
      <span class="text-xs font-bold text-brand-600 dark:text-accent bg-brand-500/10 px-2.5 py-1 rounded-full">Equated Monthly Installment</span>
    </div>

    <div>
      <label for="emi-principal" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Loan Principal Amount (₹ / $)</label>
      <input type="number" id="emi-principal" value="2500000" min="10000" step="10000" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white font-mono text-sm focus:ring-2 focus:ring-brand-500 outline-none">
    </div>

    <div>
      <div class="flex justify-between items-center mb-1.5">
        <label for="emi-rate" class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Interest Rate (% p.a.)</label>
        <span id="emi-rate-val" class="text-xs font-mono font-bold text-brand-600 dark:text-accent">8.5%</span>
      </div>
      <input type="range" id="emi-rate" min="1" max="25" step="0.25" value="8.5" class="w-full accent-brand-500 cursor-pointer">
    </div>

    <div>
      <div class="flex justify-between items-center mb-1.5">
        <label for="emi-tenure" class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Loan Tenure (Years)</label>
        <span id="emi-tenure-val" class="text-xs font-mono font-bold text-brand-600 dark:text-accent">15 Years</span>
      </div>
      <input type="range" id="emi-tenure" min="1" max="30" step="1" value="15" class="w-full accent-brand-500 cursor-pointer">
    </div>
  </div>

  <div class="lg:col-span-7 space-y-6">
    <div class="bg-slate-900 text-white rounded-3xl p-6 sm:p-8 border border-slate-800 shadow-xl space-y-6">
      <div class="flex items-center justify-between border-b border-slate-800 pb-4">
        <div>
          <span class="text-xs font-mono text-slate-400 uppercase">Monthly Equated Installment</span>
          <p id="emi-result-monthly" class="text-3xl sm:text-4xl font-extrabold font-mono text-emerald-400 mt-1">₹24,628</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="p-4 bg-slate-800/60 rounded-2xl border border-slate-700">
          <p class="text-[11px] text-slate-400 uppercase font-mono">Total Interest Payable</p>
          <p id="emi-result-interest" class="text-lg sm:text-xl font-bold font-mono text-amber-400 mt-1">₹19,33,024</p>
        </div>
        <div class="p-4 bg-slate-800/60 rounded-2xl border border-slate-700">
          <p class="text-[11px] text-slate-400 uppercase font-mono">Total Repayment Amount</p>
          <p id="emi-result-total" class="text-lg sm:text-xl font-bold font-mono text-white mt-1">₹44,33,024</p>
        </div>
      </div>

      <div class="space-y-2">
        <div class="flex justify-between text-xs font-mono">
          <span class="text-slate-400">Principal vs Interest Ratio</span>
          <span id="emi-ratio-text" class="text-slate-300 font-bold">56.4% Principal / 43.6% Interest</span>
        </div>
        <div class="w-full h-3 bg-slate-700 rounded-full overflow-hidden flex">
          <div id="emi-bar-principal" class="bg-brand-500 h-full transition-all" style="width: 56%"></div>
          <div id="emi-bar-interest" class="bg-amber-400 h-full transition-all" style="width: 44%"></div>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
(function() {
  const pEl = document.getElementById('emi-principal');
  const rEl = document.getElementById('emi-rate');
  const rVal = document.getElementById('emi-rate-val');
  const tEl = document.getElementById('emi-tenure');
  const tVal = document.getElementById('emi-tenure-val');

  const monthlyEl = document.getElementById('emi-result-monthly');
  const interestEl = document.getElementById('emi-result-interest');
  const totalEl = document.getElementById('emi-result-total');
  const barP = document.getElementById('emi-bar-principal');
  const barI = document.getElementById('emi-bar-interest');
  const ratioText = document.getElementById('emi-ratio-text');

  function fmt(n) {
    return '₹' + Math.round(n).toLocaleString('en-IN');
  }

  function calculate() {
    const P = parseFloat(pEl.value) || 0;
    const annualR = parseFloat(rEl.value) || 0;
    const years = parseFloat(tEl.value) || 0;

    rVal.textContent = annualR.toFixed(2) + '%';
    tVal.textContent = years + (years === 1 ? ' Year' : ' Years');

    const r = (annualR / 12) / 100;
    const n = years * 12;

    let emi = 0;
    if (r === 0) {
      emi = P / n;
    } else {
      emi = (P * r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
    }

    const total = emi * n;
    const interest = total - P;

    monthlyEl.textContent = fmt(emi);
    interestEl.textContent = fmt(interest);
    totalEl.textContent = fmt(total);

    const pPct = total > 0 ? (P / total * 100).toFixed(1) : 50;
    const iPct = total > 0 ? (interest / total * 100).toFixed(1) : 50;

    barP.style.width = pPct + '%';
    barI.style.width = iPct + '%';
    ratioText.textContent = pPct + '% Principal / ' + iPct + '% Interest';
  }

  [pEl, rEl, tEl].forEach(el => el.addEventListener('input', calculate));
  calculate();
})();
</script>