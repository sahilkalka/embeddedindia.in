<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
  <div class="lg:col-span-5 bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-md space-y-4">
    <div class="flex items-center justify-between border-b border-slate-100 dark:border-brand-border pb-3">
      <h3 class="text-base font-bold text-slate-900 dark:text-white">Robots.txt Builder</h3>
      <span class="text-xs font-bold text-brand-600 dark:text-accent bg-brand-500/10 px-2.5 py-1 rounded-full">Webmaster Crawler Rules</span>
    </div>

    <div>
      <label for="rob-ua" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">User-Agent</label>
      <input type="text" id="rob-ua" value="*" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white font-mono text-xs focus:ring-2 focus:ring-brand-500 outline-none">
    </div>

    <div>
      <label for="rob-sitemap" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Sitemap URL</label>
      <input type="url" id="rob-sitemap" value="https://embeddedindia.in/sitemap.xml" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white text-xs focus:ring-2 focus:ring-brand-500 outline-none">
    </div>

    <div>
      <label for="rob-disallow" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Disallowed Paths (One per line)</label>
      <textarea id="rob-disallow" rows="4" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white font-mono text-xs focus:ring-2 focus:ring-brand-500 outline-none">/admin
/api/telemetry
/scratch
/tmp</textarea>
    </div>
  </div>

  <div class="lg:col-span-7 space-y-6">
    <div class="bg-slate-900 text-white rounded-3xl p-6 sm:p-8 border border-slate-800 shadow-xl space-y-4">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h3 class="text-xs font-mono font-bold text-brand-400 uppercase">Generated robots.txt</h3>
        <button type="button" id="rob-copy-btn" class="px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl">Copy robots.txt</button>
      </div>

      <textarea id="rob-output" readonly rows="10" class="w-full px-4 py-3 rounded-2xl bg-slate-800/80 border border-slate-700 text-emerald-400 font-mono text-xs outline-none"></textarea>
    </div>
  </div>
</div>
<script>
(function() {
  const ua = document.getElementById('rob-ua');
  const sm = document.getElementById('rob-sitemap');
  const dis = document.getElementById('rob-disallow');
  const out = document.getElementById('rob-output');

  function update() {
    let lines = [
      '# robots.txt generated by Embedded India Webmaster Tools',
      'User-agent: ' + (ua.value.trim() || '*')
    ];

    const disallowed = dis.value.split('\n').map(s => s.trim()).filter(Boolean);
    if (disallowed.length > 0) {
      disallowed.forEach(p => lines.push('Disallow: ' + p));
    } else {
      lines.push('Disallow:');
    }

    if (sm.value.trim()) {
      lines.push('');
      lines.push('Sitemap: ' + sm.value.trim());
    }

    out.value = lines.join('\n');
  }

  [ua, sm, dis].forEach(el => el.addEventListener('input', update));

  document.getElementById('rob-copy-btn').addEventListener('click', () => {
    if (out.value) {
      navigator.clipboard.writeText(out.value);
      const b = document.getElementById('rob-copy-btn');
      const orig = b.textContent;
      b.textContent = 'Copied!';
      setTimeout(() => b.textContent = orig, 1200);
    }
  });

  update();
})();
</script>