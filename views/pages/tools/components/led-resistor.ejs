<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
  <div class="lg:col-span-6 bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-md space-y-5">
    <div class="flex items-center justify-between border-b border-slate-100 dark:border-brand-border pb-3">
      <h3 class="text-base font-bold text-slate-900 dark:text-white">LED Circuit Inputs</h3>
      <span class="text-xs font-bold text-brand-600 dark:text-accent bg-brand-500/10 px-2.5 py-1 rounded-full">Current Limit</span>
    </div>

    <div>
      <label for="led-vsource" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Supply Voltage Vsource (V)</label>
      <input type="number" id="led-vsource" value="5.0" step="0.1" min="0.5" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white font-mono text-sm focus:ring-2 focus:ring-brand-500 outline-none">
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label for="led-vf" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">LED Forward Drop Vf (V)</label>
        <input type="number" id="led-vf" value="2.1" step="0.1" min="0.1" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white font-mono text-sm focus:ring-2 focus:ring-brand-500 outline-none">
      </div>
      <div>
        <label for="led-i" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Forward Current I (mA)</label>
        <input type="number" id="led-i" value="20" step="1" min="0.1" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white font-mono text-sm focus:ring-2 focus:ring-brand-500 outline-none">
      </div>
    </div>

    <div>
      <span class="text-xs font-bold text-slate-500 dark:text-slate-400 block mb-2 uppercase tracking-wider">Common Color Presets:</span>
      <div class="flex flex-wrap gap-2 text-xs font-semibold">
        <button type="button" class="led-preset-btn px-2.5 py-1 bg-red-500/15 text-red-600 dark:text-red-400 rounded-lg hover:bg-red-500 hover:text-white transition" data-vf="1.8" data-i="20">Red (1.8V)</button>
        <button type="button" class="led-preset-btn px-2.5 py-1 bg-green-500/15 text-green-600 dark:text-green-400 rounded-lg hover:bg-green-500 hover:text-white transition" data-vf="2.2" data-i="20">Green (2.2V)</button>
        <button type="button" class="led-preset-btn px-2.5 py-1 bg-blue-500/15 text-blue-600 dark:text-blue-400 rounded-lg hover:bg-blue-500 hover:text-white transition" data-vf="3.2" data-i="20">Blue (3.2V)</button>
        <button type="button" class="led-preset-btn px-2.5 py-1 bg-amber-500/15 text-amber-600 dark:text-amber-400 rounded-lg hover:bg-amber-500 hover:text-white transition" data-vf="3.3" data-i="20">White (3.3V)</button>
      </div>
    </div>
  </div>

  <div class="lg:col-span-6 space-y-6">
    <div class="bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-md">
      <h3 class="text-base font-bold text-slate-900 dark:text-white border-b border-slate-100 dark:border-brand-border pb-3">Resistor Sizing &amp; Rating</h3>
      <div class="mt-6 grid grid-cols-2 gap-4">
        <div class="p-4 bg-brand-50 dark:bg-brand-900/40 rounded-2xl border border-brand-200 dark:border-brand-700">
          <span class="text-xs text-brand-800 dark:text-accent font-semibold block">Ideal Resistance</span>
          <span id="led-resIdeal" class="text-3xl font-black text-brand-700 dark:text-white font-mono">--</span>
          <span class="text-[10px] text-slate-500 dark:text-slate-400 font-semibold block mt-0.5">Calculated Ohms (Ω)</span>
        </div>
        <div class="p-4 bg-accent/15 dark:bg-accent/20 rounded-2xl border border-accent/30">
          <span class="text-xs text-accent-dark dark:text-accent font-semibold block">Nearest Standard (E24)</span>
          <span id="led-resE24" class="text-3xl font-black text-slate-900 dark:text-white font-mono">--</span>
          <span class="text-[10px] text-slate-500 dark:text-slate-400 font-semibold block mt-0.5">Commercial E24 Value</span>
        </div>
      </div>
      <div class="mt-4 grid grid-cols-2 gap-3">
        <div class="p-3 bg-slate-50 dark:bg-brand-dark rounded-xl border border-slate-200/60 dark:border-brand-border/60">
          <span class="text-[10px] text-slate-500 dark:text-slate-400 block font-semibold">Resistor Dissipation</span>
          <span id="led-resPower" class="text-sm font-bold text-slate-900 dark:text-white font-mono">--</span>
        </div>
        <div class="p-3 bg-slate-50 dark:bg-brand-dark rounded-xl border border-slate-200/60 dark:border-brand-border/60">
          <span class="text-[10px] text-slate-500 dark:text-slate-400 block font-semibold">Recommended Rating</span>
          <span id="led-resRating" class="text-sm font-bold text-slate-900 dark:text-white font-mono">--</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  const e24Values = [10, 11, 12, 13, 15, 16, 18, 20, 22, 24, 27, 30, 33, 36, 39, 43, 47, 51, 56, 62, 68, 75, 82, 91];

  function findNearestE24(r) {
    if (r <= 0) return 0;
    const exponent = Math.floor(Math.log10(r));
    const base = r / Math.pow(10, exponent);
    let nearest = e24Values[0];
    let minDiff = Math.abs(base - (nearest / 10));
    e24Values.forEach(val => {
      const v = val / 10;
      const diff = Math.abs(base - v);
      if (diff < minDiff) {
        minDiff = diff;
        nearest = val;
      }
    });
    return Math.round((nearest / 10) * Math.pow(10, exponent));
  }

  function calcLed() {
    const vs = parseFloat(document.getElementById('led-vsource')?.value) || 0;
    const vf = parseFloat(document.getElementById('led-vf')?.value) || 0;
    const iMa = parseFloat(document.getElementById('led-i')?.value) || 0;

    const iA = iMa / 1000;
    const vDrop = vs - vf;

    if (vDrop <= 0 || iA <= 0) {
      document.getElementById('led-resIdeal').textContent = 'Vsource ≤ Vf';
      document.getElementById('led-resE24').textContent = 'N/A';
      document.getElementById('led-resPower').textContent = '0 mW';
      document.getElementById('led-resRating').textContent = 'N/A';
      return;
    }

    const idealR = vDrop / iA;
    const e24R = findNearestE24(idealR);
    const powerW = vDrop * iA;
    const recW = powerW < 0.06 ? '1/16 W (0402)' : powerW < 0.125 ? '1/8 W (0805)' : powerW < 0.25 ? '1/4 W (1206)' : '1/2 W or greater';

    document.getElementById('led-resIdeal').textContent = idealR.toFixed(1) + ' Ω';
    document.getElementById('led-resE24').textContent = e24R.toLocaleString() + ' Ω';
    document.getElementById('led-resPower').textContent = (powerW * 1000).toFixed(1) + ' mW';
    document.getElementById('led-resRating').textContent = recW;
  }

  ['led-vsource', 'led-vf', 'led-i'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calcLed);
  });
  document.querySelectorAll('.led-preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.getElementById('led-vf').value = btn.getAttribute('data-vf');
      document.getElementById('led-i').value = btn.getAttribute('data-i');
      calcLed();
    });
  });
  calcLed();
})();
</script>