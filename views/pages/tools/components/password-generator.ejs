<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
  <div class="lg:col-span-5 bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-md space-y-5">
    <div class="flex items-center justify-between border-b border-slate-100 dark:border-brand-border pb-3">
      <h3 class="text-base font-bold text-slate-900 dark:text-white">Security Settings</h3>
      <span class="text-xs font-bold text-brand-600 dark:text-accent bg-brand-500/10 px-2.5 py-1 rounded-full">crypto.getRandomValues</span>
    </div>

    <div>
      <div class="flex justify-between items-center mb-1.5">
        <label for="pw-length" class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Password Length</label>
        <span id="pw-len-val" class="text-xs font-mono font-bold text-brand-600 dark:text-accent">24 Characters</span>
      </div>
      <input type="range" id="pw-length" min="8" max="64" step="1" value="24" class="w-full accent-brand-500 cursor-pointer">
    </div>

    <div class="space-y-3 pt-2">
      <label class="flex items-center gap-2.5 cursor-pointer text-xs font-medium text-slate-700 dark:text-slate-300">
        <input type="checkbox" id="pw-upper" checked class="rounded text-brand-500 focus:ring-brand-500 w-4 h-4">
        <span>Uppercase Letters (A-Z)</span>
      </label>
      <label class="flex items-center gap-2.5 cursor-pointer text-xs font-medium text-slate-700 dark:text-slate-300">
        <input type="checkbox" id="pw-lower" checked class="rounded text-brand-500 focus:ring-brand-500 w-4 h-4">
        <span>Lowercase Letters (a-z)</span>
      </label>
      <label class="flex items-center gap-2.5 cursor-pointer text-xs font-medium text-slate-700 dark:text-slate-300">
        <input type="checkbox" id="pw-digits" checked class="rounded text-brand-500 focus:ring-brand-500 w-4 h-4">
        <span>Numbers (0-9)</span>
      </label>
      <label class="flex items-center gap-2.5 cursor-pointer text-xs font-medium text-slate-700 dark:text-slate-300">
        <input type="checkbox" id="pw-symbols" checked class="rounded text-brand-500 focus:ring-brand-500 w-4 h-4">
        <span>Special Symbols (!@#$%^&amp;*()_+-=)</span>
      </label>
      <label class="flex items-center gap-2.5 cursor-pointer text-xs font-medium text-slate-700 dark:text-slate-300">
        <input type="checkbox" id="pw-exclude-ambig" class="rounded text-brand-500 focus:ring-brand-500 w-4 h-4">
        <span>Avoid Ambiguous Characters (l, 1, I, O, 0)</span>
      </label>
    </div>

    <button type="button" id="pw-regen-btn" class="w-full py-3 bg-brand-500 hover:bg-brand-600 text-white font-bold text-xs rounded-xl shadow transition">
      Generate New Password
    </button>
  </div>

  <div class="lg:col-span-7 space-y-6">
    <div class="bg-slate-900 text-white rounded-3xl p-6 sm:p-8 border border-slate-800 shadow-xl space-y-6">
      <div>
        <span class="text-xs font-mono text-slate-400 uppercase">Generated Secure Password</span>
        <div class="mt-2 flex items-center gap-2">
          <input type="text" id="pw-output" readonly class="w-full px-4 py-3 bg-slate-800/80 border border-slate-700 rounded-2xl text-emerald-400 font-mono text-base tracking-wider outline-none select-all">
          <button type="button" id="pw-copy-btn" class="px-5 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-2xl transition whitespace-nowrap">
            Copy
          </button>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 text-xs font-mono">
        <div class="p-3 bg-slate-800/60 rounded-xl border border-slate-700">
          <span class="text-slate-400 block mb-1">Entropy Strength</span>
          <p id="pw-entropy" class="text-base font-bold text-emerald-400">144 bits</p>
        </div>
        <div class="p-3 bg-slate-800/60 rounded-xl border border-slate-700">
          <span class="text-slate-400 block mb-1">Crack Time Estimate</span>
          <p id="pw-crack-time" class="text-base font-bold text-white">&gt; 100 Trillion Years</p>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
(function() {
  const lenEl = document.getElementById('pw-length');
  const lenVal = document.getElementById('pw-len-val');
  const upperEl = document.getElementById('pw-upper');
  const lowerEl = document.getElementById('pw-lower');
  const digitsEl = document.getElementById('pw-digits');
  const symbolsEl = document.getElementById('pw-symbols');
  const ambigEl = document.getElementById('pw-exclude-ambig');

  const outEl = document.getElementById('pw-output');
  const copyBtn = document.getElementById('pw-copy-btn');
  const regenBtn = document.getElementById('pw-regen-btn');
  const entropyEl = document.getElementById('pw-entropy');
  const crackTimeEl = document.getElementById('pw-crack-time');

  function generatePassword() {
    const length = parseInt(lenEl.value);
    lenVal.textContent = length + ' Characters';

    let upper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    let lower = 'abcdefghijklmnopqrstuvwxyz';
    let digits = '0123456789';
    let symbols = '!@#$%^&*()_+-=[]{}|;:,.<>?';

    if (ambigEl.checked) {
      upper = upper.replace(/[IO]/g, '');
      lower = lower.replace(/[lo]/g, '');
      digits = digits.replace(/[01]/g, '');
    }

    let pool = '';
    if (upperEl.checked) pool += upper;
    if (lowerEl.checked) pool += lower;
    if (digitsEl.checked) pool += digits;
    if (symbolsEl.checked) pool += symbols;

    if (!pool) {
      outEl.value = 'Select at least one character set!';
      return;
    }

    const randomBuffer = new Uint32Array(length);
    window.crypto.getRandomValues(randomBuffer);

    let pw = '';
    for (let i = 0; i < length; i++) {
      pw += pool[randomBuffer[i] % pool.length];
    }
    outEl.value = pw;

    // Calculate Entropy
    const poolSize = pool.length;
    const entropy = Math.round(length * Math.log2(poolSize));
    entropyEl.textContent = entropy + ' bits';

    if (entropy < 40) crackTimeEl.textContent = 'Few Seconds (Very Weak)';
    else if (entropy < 60) crackTimeEl.textContent = 'Few Hours (Weak)';
    else if (entropy < 80) crackTimeEl.textContent = 'Centuries (Strong)';
    else crackTimeEl.textContent = '> 100 Trillion Years (Military Grade)';
  }

  [lenEl, upperEl, lowerEl, digitsEl, symbolsEl, ambigEl].forEach(el => el.addEventListener('input', generatePassword));
  regenBtn.addEventListener('click', generatePassword);

  copyBtn.addEventListener('click', () => {
    if (outEl.value) {
      navigator.clipboard.writeText(outEl.value);
      const orig = copyBtn.textContent;
      copyBtn.textContent = 'Copied!';
      setTimeout(() => copyBtn.textContent = orig, 1500);
    }
  });

  generatePassword();
})();
</script>