<%- include('../layouts/header') %>

<!-- Hero Header (Left-Aligned with Ambient Mesh) -->
<section class="py-16 lg:py-20 bg-white dark:bg-[#0d1715] border-b border-slate-200 dark:border-brand-border spaceship-ambient-mesh circuit-grid">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">
    <div class="max-w-3xl">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-slate-100 dark:bg-slate-800/90 border border-slate-300 dark:border-slate-700 text-slate-800 dark:text-slate-100 text-xs font-bold uppercase tracking-wider shadow-sm backdrop-blur-md animate-float-slow">
        <span class="w-2 h-2 rounded-full bg-brand-500 dark:bg-accent animate-ping flex-shrink-0"></span>
        <span class="font-extrabold text-slate-800 dark:text-slate-100">Who We Are</span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-black text-slate-900 dark:text-white mt-4 tracking-tight leading-tight">
        Launching digital futures further, faster
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-700 dark:text-slate-200 leading-relaxed font-normal">
        India's specialized engineering backbone for turnkey embedded hardware and firmware product realization, taking designs from silicon architecture to industrial volume.
      </p>
    </div>
  </div>
</section>

<!-- Vision & Mission Statement -->
<section id="vision" class="py-20 bg-slate-50 dark:bg-[#13221f]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-white dark:bg-brand-surface rounded-3xl p-8 sm:p-14 border border-slate-200 dark:border-brand-border shadow-xl">
      <div class="max-w-3xl">
        <span class="text-xs font-bold text-brand-500 dark:text-accent uppercase tracking-wider">Our Vision</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white mt-2">
          Engineering the Connected Future
        </h2>
        <p class="mt-6 text-lg sm:text-xl text-slate-700 dark:text-slate-200 leading-relaxed font-normal">
          Our mission is to empower innovative companies by transforming complex product concepts into robust, reliable, and market-ready embedded systems. We are the trusted engineering backbone enabling the next generation of smart, connected devices, from the deep edge to the cloud.
        </p>
      </div>
    </div>

    <!-- 3 Core Pillars -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
      
      <!-- Pillar 1 -->
      <div class="spotlight-card reveal-on-scroll bg-white dark:bg-brand-surface p-8 rounded-3xl border border-slate-200 dark:border-brand-border shadow-md">
        <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-900/60 flex items-center justify-center mb-6 icon-bounce-container">
          <img src="/assets/images/mission1.svg" alt="Precision Engineering" class="w-10 h-10" onerror="this.src='/favicon.svg'">
        </div>
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">Precision Engineering</h3>
        <p class="text-sm text-slate-700 dark:text-slate-200 leading-relaxed">
          We adhere to rigorous quality standards (e.g., V&amp;V, HIL testing) to deliver systems that are not just functional, but truly dependable in harsh industrial and automotive environments.
        </p>
      </div>

      <!-- Pillar 2 -->
      <div class="spotlight-card reveal-on-scroll delay-100 bg-white dark:bg-brand-surface p-8 rounded-3xl border border-slate-200 dark:border-brand-border shadow-md">
        <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-900/60 flex items-center justify-center mb-6 icon-bounce-container">
          <img src="/assets/images/mission2.svg" alt="Future-Proof Innovation" class="w-10 h-10" onerror="this.src='/favicon.svg'">
        </div>
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">Future-Proof Innovation</h3>
        <p class="text-sm text-slate-700 dark:text-slate-200 leading-relaxed">
          We consistently invest in expertise across emerging trends, including Edge AI/TinyML deployment and advanced cybersecurity protocols, ensuring your products lead the market for years to come.
        </p>
      </div>

      <!-- Pillar 3 -->
      <div class="spotlight-card reveal-on-scroll delay-200 bg-white dark:bg-brand-surface p-8 rounded-3xl border border-slate-200 dark:border-brand-border shadow-md">
        <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-900/60 flex items-center justify-center mb-6 icon-bounce-container">
          <img src="/assets/images/mission3.svg" alt="Transparent Partnership" class="w-10 h-10" onerror="this.src='/favicon.svg'">
        </div>
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">Transparent Partnership</h3>
        <p class="text-sm text-slate-700 dark:text-slate-200 leading-relaxed">
          We view ourselves as an extension of your team, maintaining open communication and agility throughout the entire product realization lifecycle with zero vendor lock-in.
        </p>
      </div>

    </div>

        <!-- Animated Numerical Counter Metrics -->
    <div class="mt-12 bg-white dark:bg-brand-surface rounded-3xl p-8 border border-slate-200 dark:border-brand-border shadow-md grid grid-cols-1 sm:grid-cols-3 gap-6 text-center">
      <div>
        <p class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white font-mono">
          <span class="count-up" data-target="100">0</span>+
        </p>
        <p class="text-xs text-slate-600 dark:text-slate-300 mt-1 font-semibold uppercase tracking-wider">Delivered Systems</p>
      </div>
      <div>
        <p class="text-3xl sm:text-4xl font-black text-brand-500 dark:text-accent font-mono">
          <span class="count-up" data-target="99.8" data-decimal="1">0</span>%
        </p>
        <p class="text-xs text-slate-600 dark:text-slate-300 mt-1 font-semibold uppercase tracking-wider">First-Pass HIL Rate</p>
      </div>
      <div>
        <p class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white font-mono">
          &lt; <span class="count-up" data-target="24">0</span>h
        </p>
        <p class="text-xs text-slate-600 dark:text-slate-300 mt-1 font-semibold uppercase tracking-wider">Architect Response SLA</p>
      </div>
    </div>

    <!-- Offices & Engineering Presence -->
    <section id="presence" class="mt-12 bg-white dark:bg-brand-surface rounded-3xl p-8 sm:p-10 border border-slate-200 dark:border-brand-border shadow-md">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <span class="text-xs font-bold text-brand-500 dark:text-accent uppercase tracking-wider">Engineering Labs &amp; Presence</span>
          <h3 class="text-2xl font-bold text-slate-900 dark:text-white mt-1">Offices &amp; Locations</h3>
          <p class="text-sm text-slate-700 dark:text-slate-300 mt-2 font-medium flex items-center space-x-2">
            <span>📍</span>
            <span><%= settings.contact_address || 'Hyderabad, India' %></span>
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-4 text-xs font-semibold">
          <a href="mailto:<%= settings.contact_email || 'info@embeddedindia.in' %>" class="px-5 py-2.5 bg-brand-500 hover:bg-brand-600 text-white rounded-xl font-bold transition shadow-md">
            <%= settings.contact_email || 'info@embeddedindia.in' %>
          </a>
          <% if (settings.contact_phone) { %>
            <a href="tel:<%= settings.contact_phone.replace(/[^0-9+]/g, '') %>" class="px-5 py-2.5 bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 rounded-xl font-bold transition border border-slate-300 dark:border-slate-700">
              <%= settings.contact_phone %>
            </a>
          <% } %>
        </div>
      </div>
    </section>

  </div>
</section>

<section class="py-16 bg-white dark:bg-brand-dark">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
<h2 class="text-3xl font-black text-slate-900 dark:text-white text-center">The Engineering Team</h2>
<p class="text-center text-sm text-slate-600 dark:text-slate-300 mt-3">Hardware, firmware, and validation disciplines working together across your product lifecycle.</p>
<div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-6">
<% [['HW', 'Hardware architecture', 'Schematic capture, PCB layout, component selection, and design-for-manufacture reviews.'], ['FW', 'Embedded firmware', 'Microcontroller software, RTOS integration, connectivity, and board bring-up.'], ['QA', 'Systems validation', 'Test planning, hardware-in-the-loop verification, and production handover.']].forEach(member => { %>
<div class="p-6 rounded-2xl border border-slate-200 dark:border-brand-border bg-slate-50 dark:bg-brand-surface"><span aria-hidden="true" class="inline-flex w-12 h-12 items-center justify-center rounded-full bg-brand-50 dark:bg-brand-900 text-brand-700 dark:text-accent font-bold"><%= member[0] %></span><h3 class="mt-4 font-bold text-slate-900 dark:text-white"><%= member[1] %></h3><p class="mt-2 text-sm text-slate-600 dark:text-slate-300"><%= member[2] %></p></div>
<% }); %>
</div></div></section>
<%- include('../partials/cta-banner') %>

<script src="/js/counters.js"></script>

<%- include('../layouts/footer') %>

