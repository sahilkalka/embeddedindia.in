<%- include('../layouts/header') %>

<!-- Contact Header (Left-Aligned with Ambient Mesh) -->
<section class="py-16 lg:py-20 bg-white dark:bg-[#0d1715] border-b border-slate-200 dark:border-brand-border spaceship-ambient-mesh circuit-grid">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">
    <div class="max-w-3xl">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-white/90 dark:bg-brand-surface/90 border border-slate-200 dark:border-brand-border text-brand-600 dark:text-accent text-xs font-bold uppercase tracking-wider shadow-sm backdrop-blur-md animate-float-slow">
        <span class="w-2 h-2 rounded-full bg-accent animate-ping"></span>
        <span>Get in Touch</span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-black text-slate-900 dark:text-white mt-4 tracking-tight leading-tight">
        Contact Us
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-700 dark:text-slate-200 leading-relaxed font-normal">
        Discuss your hardware architecture, review RFPs, or inquire about our turnkey engineering cycles. Email us at <a href="mailto:<%= settings.contact_email || 'info@embeddedindia.in' %>" class="text-brand-500 dark:text-accent font-semibold hover:underline"><%= settings.contact_email || 'info@embeddedindia.in' %></a> or submit your technical specifications below.
      </p>
    </div>
  </div>
</section>

<!-- Contact Form & Info Section -->
<section class="py-20 bg-slate-50 dark:bg-[#13221f]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Left Column: Contact Info & Support -->
      <div class="lg:col-span-5 space-y-8">
        <div class="spotlight-card reveal-on-scroll bg-white dark:bg-brand-surface rounded-3xl p-8 border border-slate-200 dark:border-brand-border shadow-md">
          <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-900/60 flex items-center justify-center mb-6 icon-bounce-container">
            <img src="/assets/images/contact-us.svg" alt="Contact Icon" class="w-10 h-10" onerror="this.src='/favicon.svg'">
          </div>
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">Direct Communication</h2>
          <p class="text-sm text-slate-700 dark:text-slate-200 leading-relaxed mb-6">
            Our systems architects review incoming RFPs and inquiries daily. We provide technical NDAs prior to in-depth architecture discussions.
          </p>

          <div class="space-y-4 text-sm">
            <div class="flex items-start space-x-3">
              <div class="text-brand-500 dark:text-accent mt-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <strong class="text-slate-900 dark:text-white block">Email</strong>
                <a href="mailto:<%= settings.contact_email || 'info@embeddedindia.in' %>" class="text-brand-500 dark:text-accent hover:underline"><%= settings.contact_email || 'info@embeddedindia.in' %></a>
              </div>
            </div>

            <div class="flex items-start space-x-3">
              <div class="text-brand-500 dark:text-accent mt-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <strong class="text-slate-900 dark:text-white block">Offices &amp; Locations</strong>
                <span class="text-slate-600 dark:text-slate-300"><%= settings.contact_address || 'Bangalore, Hyderabad, Pune • India' %></span>
              </div>
            </div>

            <% if (settings.contact_phone) { %>
            <div class="flex items-start space-x-3">
              <div class="text-brand-500 dark:text-accent mt-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <strong class="text-slate-900 dark:text-white block">Phone / WhatsApp</strong>
                <a href="tel:<%= settings.contact_phone.replace(/[^0-9+]/g, '') %>" class="text-slate-600 dark:text-slate-300 hover:text-brand-500"><%= settings.contact_phone %></a>
              </div>
            </div>
            <% } %>

            <div class="flex items-start space-x-3">
              <div class="text-brand-500 dark:text-accent mt-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <strong class="text-slate-900 dark:text-white block">Turnaround Guarantee</strong>
                <span class="text-slate-600 dark:text-slate-300">Technical reply within 24 business hours</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Anti-Spam Contact Form -->
      <div class="lg:col-span-7">
        <div class="spotlight-card reveal-on-scroll delay-100 bg-white dark:bg-brand-surface rounded-3xl p-8 sm:p-12 border border-slate-200 dark:border-brand-border shadow-xl">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">Send Us a Message</h2>
          <p class="text-sm text-slate-600 dark:text-slate-300 mb-8">
            Tell us about your embedded hardware or firmware project specifications.
          </p>

          <form id="contact-form" class="space-y-6">
            
            <!-- Anti-Spam Layer 1: Honeypot Trap (Invisible to humans, trapped bots fill this) -->
            <div class="hidden" aria-hidden="true">
              <label for="website_url_trap">Do not fill this field</label>
              <input type="text" id="website_url_trap" name="website_url_trap" tabindex="-1" autocomplete="off">
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
                  Full Name <span class="text-red-500">*</span>
                </label>
                <input 
                  type="text" 
                  name="name" 
                  required 
                  placeholder="e.g. Rahul Sharma"
                  class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm transition"
                >
              </div>

              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
                  Work Email <span class="text-red-500">*</span>
                </label>
                <input 
                  type="email" 
                  name="email" 
                  required 
                  placeholder="rahul@company.com"
                  class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm transition"
                >
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
                  Phone / WhatsApp (Optional)
                </label>
                <input 
                  type="tel" 
                  name="phone" 
                  placeholder="+91 98765 43210"
                  class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm transition"
                >
              </div>

              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
                  Service Category
                </label>
                <select 
                  name="serviceCategory" 
                  class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm transition"
                >
                  <option value="Hardware Design">Hardware Design &amp; PCB Layout</option>
                  <option value="Firmware/BSP">Firmware &amp; BSP Development</option>
                  <option value="IoT Solutions">IoT &amp; Edge Gateway Systems</option>
                  <option value="Automotive">Automotive ECU &amp; HIL Testing</option>
                  <option value="Full Turnkey">Full Turnkey Product Realization</option>
                  <option value="Obsolescence">Component Obsolescence Redesign</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
                Project Subject <span class="text-red-500">*</span>
              </label>
              <input 
                type="text" 
                name="subject" 
                required 
                placeholder="e.g. 4-Layer STM32 Motor Controller Redesign"
                class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm transition"
              >
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
                Message / Technical Requirements <span class="text-red-500">*</span>
              </label>
              <textarea 
                name="message" 
                rows="5" 
                required 
                placeholder="Outline your target microcontroller, operating environment, production timeline, and key requirements..."
                class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm transition"
              ></textarea>
            </div>

            <div id="contact-status-box" class="hidden p-4 rounded-xl text-sm font-medium"></div>

            <button 
              type="submit" 
              id="contact-submit-btn" 
              class="btn-shimmer w-full py-4 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl shadow-lg transition text-base tracking-wide flex items-center justify-center space-x-2 active:scale-95"
            >
              <span>Submit Inquiry to Engineering Team</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </button>

            <p class="text-[11px] text-slate-400 text-center">
              Protected by server-side rate limiting and automated spam filters. Your email is kept strictly confidential.
            </p>
          </form>

        </div>
      </div>

    </div>
  </div>
</section>

<!-- AJAX Submission Script -->
<script>
  const contactForm = document.getElementById('contact-form');
  const contactStatus = document.getElementById('contact-status-box');
  const submitBtn = document.getElementById('contact-submit-btn');

  if (contactForm) {
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      submitBtn.disabled = true;
      submitBtn.classList.add('opacity-70');
      contactStatus.className = 'p-4 rounded-xl text-sm bg-brand-50 dark:bg-brand-900/40 text-brand-700 dark:text-accent font-semibold block';
      contactStatus.textContent = 'Transmitting your inquiry securely...';

      const formData = new FormData(contactForm);
      const data = Object.fromEntries(formData.entries());

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await response.json();

        if (result.success) {
          contactStatus.className = 'p-4 rounded-xl text-sm bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 font-semibold block border border-emerald-200 dark:border-emerald-800';
          contactStatus.textContent = result.message;
          contactForm.reset();
        } else {
          contactStatus.className = 'p-4 rounded-xl text-sm bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-400 font-semibold block border border-red-200 dark:border-red-800';
          contactStatus.textContent = result.message;
        }
      } catch (err) {
        contactStatus.className = 'p-4 rounded-xl text-sm bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-400 font-semibold block border border-red-200 dark:border-red-800';
        contactStatus.textContent = 'Connection error. Please email <%= settings.contact_email || "info@embeddedindia.in" %> directly.';
      } finally {
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-70');
      }
    });
  }
</script>

<%- include('../layouts/footer') %>
