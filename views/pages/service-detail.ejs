<%- include('../layouts/header') %>

<!-- Service Detail Hero -->
<section class="py-14 lg:py-20 bg-white dark:bg-[#0d1715] border-b border-slate-200 dark:border-brand-border spaceship-ambient-mesh circuit-grid">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">
    <div class="max-w-3xl">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <a href="/services" class="text-xs font-bold text-brand-500 dark:text-accent hover:underline inline-flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          <span>All Engineering Services</span>
        </a>
        <span class="text-slate-400">&bull;</span>
        <span class="px-2.5 py-0.5 rounded-full bg-brand-50 dark:bg-brand-900/60 text-brand-700 dark:text-accent text-[11px] font-bold uppercase tracking-wider">
          <%= service.discipline %>
        </span>
      </div>
      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        <%= service.title %>
      </h1>
      <p class="mt-4 text-sm sm:text-lg text-slate-700 dark:text-slate-200 leading-relaxed font-normal">
        <%= service.description %>
      </p>
      <div class="mt-6 sm:mt-8 flex flex-wrap gap-3">
        <a href="/contact?service=<%= encodeURIComponent(service.contactCategory || service.title) %>" class="btn-shimmer inline-flex items-center gap-2 min-h-[44px] px-6 py-3 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl text-sm transition shadow-lg active:scale-95">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          <span>Request Service Quote &rarr;</span>
        </a>
        <a href="/tools" class="inline-flex items-center gap-2 min-h-[44px] px-5 py-3 bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-white font-bold rounded-xl text-sm transition border border-slate-300 dark:border-slate-700 hover:border-brand-500 active:scale-95">
          <svg class="w-4 h-4 text-brand-500 dark:text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
          <span>Explore Calculators</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Service Capabilities & Specifications -->
<section class="py-14 sm:py-20 bg-slate-50 dark:bg-[#13221f]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <% if (service.slug === 'embedded-ui-hmi-development') { %>
    <!-- TouchGFX (MCU) vs Qt (MPU) Architectural Comparison Matrix -->
    <div class="bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-10 border-2 border-brand-500/40 dark:border-accent/40 shadow-md">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
        <div>
          <span class="text-xs font-bold text-brand-500 dark:text-accent uppercase tracking-wider">Dual-Platform HMI Architecture</span>
          <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white mt-1">TouchGFX on STM32 MCU vs. Qt / QML on Microprocessor (MPU)</h2>
        </div>
        <span class="px-3 py-1 rounded-full bg-brand-500/15 text-brand-700 dark:text-accent text-xs font-black">IEC 62304 &bull; Industrial HMI</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 rounded-2xl bg-brand-50/50 dark:bg-brand-900/30 border border-brand-500/40">
          <span class="px-2.5 py-0.5 rounded-md bg-brand-500 text-white text-[11px] font-black uppercase">Our Flagship Specialty &bull; MCU</span>
          <h3 class="text-lg font-extrabold text-slate-900 dark:text-white mt-2">TouchGFX by STMicroelectronics (STM32 MCU)</h3>
          <p class="text-xs text-slate-700 dark:text-slate-200 mt-2 leading-relaxed">
            Ideal for cost-optimized, ultra-reliable Industrial &amp; Medical HMIs requiring instant-on (<code class="font-mono">&lt;300ms</code>) boot, 60 FPS animations via Chrom-ART™ (DMA2D) &amp; NeoChrom™ GPU, and deterministic FreeRTOS / ThreadX execution on STM32U5, STM32H7, STM32F7, and STM32G0.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border">
          <span class="px-2.5 py-0.5 rounded-md bg-slate-200 dark:bg-slate-700 text-slate-800 dark:text-slate-100 text-[11px] font-black uppercase">Rich Multi-Screen UI &bull; MPU</span>
          <h3 class="text-lg font-extrabold text-slate-900 dark:text-white mt-2">Qt 6 / QML on Embedded Linux (MPU)</h3>
          <p class="text-xs text-slate-700 dark:text-slate-200 mt-2 leading-relaxed">
            Engineered for high-resolution 1080p/4K clinical workstations, multi-screen industrial panels, 3D shaders, and rich data visualization on NXP i.MX8/i.MX93, STM32MP1/MP2, and TI Sitara AM62x running custom Yocto / Buildroot Linux.
          </p>
        </div>
      </div>
    </div>
    <% } %>

    <div class="bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-12 border border-slate-200 dark:border-brand-border shadow-md">
      <span class="text-xs font-bold text-brand-500 dark:text-accent uppercase tracking-wider">Engineering Scope</span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">Core Deliverables &amp; Capabilities</h2>
      <p class="text-slate-600 dark:text-slate-300 mt-2 max-w-2xl text-sm sm:text-base">
        Every project adheres to IPC standards, comprehensive design verification, and thorough technical documentation.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
        <% (service.features || []).forEach(feat => { %>
          <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200/60 dark:border-brand-border/60">
            <h3 class="font-bold text-slate-900 dark:text-white mb-2 text-base"><%= feat.title %></h3>
            <p class="text-xs text-slate-700 dark:text-slate-200 leading-relaxed font-normal"><%= feat.description %></p>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Architectural Feasibility & Quality Benchmarks -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="bg-white dark:bg-brand-surface rounded-3xl p-8 border border-slate-200 dark:border-brand-border shadow-sm">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-3 flex items-center space-x-2">
          <span>⚡ Quality Assurance &amp; Standards</span>
        </h3>
        <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
          <li class="flex items-start space-x-2">
            <span class="text-brand-500 dark:text-accent font-bold">&check;</span>
            <span>IPC-A-610 Class 3 SMT and Class 2/3 PCB layout fabrication rules.</span>
          </li>
          <li class="flex items-start space-x-2">
            <span class="text-brand-500 dark:text-accent font-bold">&check;</span>
            <span>Automated Hardware-in-the-Loop (HIL) fault injection and regression testing.</span>
          </li>
          <li class="flex items-start space-x-2">
            <span class="text-brand-500 dark:text-accent font-bold">&check;</span>
            <span>Pre-compliance EMC/EMI scans and thermal boundary modeling.</span>
          </li>
          <li class="flex items-start space-x-2">
            <span class="text-brand-500 dark:text-accent font-bold">&check;</span>
            <span>Full production package: Schematics, Gerbers, ODB++, BOM, Pick-and-Place, Test Jigs.</span>
          </li>
        </ul>
      </div>

      <div class="bg-white dark:bg-brand-surface rounded-3xl p-8 border border-slate-200 dark:border-brand-border shadow-sm flex flex-col justify-between">
        <div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2 flex items-center space-x-2">
            <span>🤝 Transparent Partnership &amp; IP Protection</span>
          </h3>
          <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed mt-2">
            You retain 100% intellectual property ownership upon completion. All schematics, PCB source files (Altium/KiCad), and firmware source code (Git repository) are transferred with zero vendor lock-in.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-100 dark:border-brand-border flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-500">Typical Prototype Turn: 3 - 5 Weeks</span>
          <a href="/contact?service=<%= encodeURIComponent(service.contactCategory || service.title) %>" class="inline-flex items-center gap-1 text-xs font-bold text-brand-500 dark:text-accent hover:underline">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            <span>Initiate Project Inquiry &rarr;</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- Bottom CTA -->
<section class="py-16 bg-brand-500 text-white text-center">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="text-3xl font-extrabold">Ready to evaluate your technical requirements?</h2>
    <p class="mt-3 text-emerald-100 dark:text-emerald-50 text-base max-w-xl mx-auto font-medium">
      Speak directly with an Embedded India systems architect to review your schematics, power budget, and timeline.
    </p>
    <a href="/contact?service=<%= encodeURIComponent(service.contactCategory || service.title) %>" class="btn-shimmer inline-flex items-center gap-2 mt-6 px-8 py-4 bg-white text-brand-900 font-bold rounded-xl shadow-lg hover:bg-slate-100 transition active:scale-95 transform hover:-translate-y-0.5">
      <svg class="w-4 h-4 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
      <span>Start Your Project Consultation</span>
    </a>
  </div>
</section>

<%- include('../layouts/footer') %>
