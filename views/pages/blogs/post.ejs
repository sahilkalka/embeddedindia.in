<%- include('../../layouts/header') %>

<!-- Article Header Section -->
<article class="py-12 lg:py-16 bg-white dark:bg-[#0d1715] border-b border-slate-200 dark:border-brand-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs font-semibold text-slate-700 dark:text-slate-300 mb-6">
      <a href="/" class="hover:text-brand-500">Home</a>
      <span>/</span>
      <a href="/blogs" class="hover:text-brand-500">Blogs</a>
      <span>/</span>
      <a href="/blogs?category=<%= encodeURIComponent(post.category) %>" class="text-brand-600 dark:text-accent font-bold"><%= post.category %></a>
    </nav>

    <!-- Slot 1: Blog Header Leaderboard Ad (if enabled) -->
    <% if (settings.ad_slot_blog_header === 'true') { %>
      <div class="mb-8 p-4 bg-slate-50 dark:bg-brand-surface rounded-2xl border border-slate-200 dark:border-brand-border text-center overflow-hidden ad-slot-leaderboard">
        <span class="block mb-2 text-[10px] uppercase font-bold tracking-wider text-slate-400">Advertisement</span>
        <% if (settings.custom_ad_html_header && settings.custom_ad_html_header.trim()) { %>
          <%- settings.custom_ad_html_header %>
        <% } else if (settings.enable_sponsor_banner === 'true' && settings.sponsor_banner_img) { %>
          <a href="<%= settings.sponsor_banner_url || '#' %>" target="_blank" rel="noopener sponsored" class="inline-block group">
            <img src="<%= settings.sponsor_banner_img %>" alt="<%= settings.sponsor_banner_alt || 'Sponsor' %>" class="max-h-20 mx-auto rounded-lg">
            <span class="text-xs font-semibold text-slate-600 dark:text-slate-300 block mt-1"><%= settings.sponsor_banner_text || '' %></span>
          </a>
        <% } else if (settings.enable_adsense === 'true' && settings.adsense_pub_id) { %>
          <ins class="adsbygoogle"
               style="display:block"
               data-ad-client="<%= settings.adsense_pub_id %>"
               data-ad-slot="<%= settings.adsense_header_slot || '1234567890' %>"
               data-ad-format="auto"
               data-full-width-responsive="true"></ins>
          <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
        <% } %>
      </div>
    <% } %>

    <div class="max-w-4xl">
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        <%= post.title %>
      </h1>

      <div class="flex flex-wrap items-center gap-4 mt-6 pt-6 border-t border-slate-100 dark:border-brand-border text-xs text-slate-700 dark:text-slate-300">
        <span class="font-bold text-slate-800 dark:text-slate-200">By <%= post.author %></span>
        <span>&bull;</span>
        <span><%= post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : 'Draft' %></span>
        <span>&bull;</span>
        <span><%= post.readingTime %> min read</span>
        <span>&bull;</span>
        <span><%= post.views %> views</span>
      </div>
    </div>

  </div>
</article>

<!-- Article Content Section with Optional Sticky Sidebar -->
<section class="py-16 bg-slate-50 dark:bg-[#13221f]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 <%= settings.ad_slot_blog_sidebar === 'true' ? 'lg:grid-cols-12 gap-10' : '' %>">
      
      <!-- Main Article Column -->
      <div class="w-full min-w-0 <%= settings.ad_slot_blog_sidebar === 'true' ? 'lg:col-span-8' : 'max-w-4xl mx-auto' %>">
        
        <!-- Markdown / HTML Content (with auto-injected In-Article Ad Slot 2) -->
        <div class="bg-white dark:bg-brand-surface rounded-3xl p-4 sm:p-8 lg:p-12 border border-slate-200 dark:border-brand-border shadow-md prose dark:prose-invert max-w-none text-slate-800 dark:text-slate-200 text-base leading-relaxed space-y-6 overflow-x-hidden min-w-0">
          <%- contentHtml %>
        </div>

        <!-- Native Mid-Article Internal Promotion Card -->
        <div class="my-10 bg-gradient-to-r from-brand-900 to-brand-800 rounded-3xl p-8 text-white border border-brand-700 shadow-xl flex flex-col sm:flex-row items-center justify-between gap-6">
          <div>
            <span class="px-2.5 py-1 bg-accent/20 text-accent rounded-full text-xs font-bold uppercase tracking-wider">Engineering Feasibility</span>
            <h3 class="text-xl font-bold mt-2">Designing a Custom Microcontroller or IoT Board?</h3>
            <p class="text-xs text-slate-300 mt-1 max-w-lg">
              Embedded India provides schematic design, impedance-controlled layouts, and HIL verification test benches.
            </p>
          </div>
          <a href="/contact?utm_source=blog_article&utm_medium=mid_card&utm_campaign=<%= post.slug %>" class="px-6 py-3 bg-accent hover:bg-accent-light text-brand-900 font-bold rounded-xl text-xs transition whitespace-nowrap shadow-md">
            Speak with an Architect &rarr;
          </a>
        </div>

        <!-- Slot 4: Post-Article Footer Ad Slot (if enabled) -->
        <% if (settings.ad_slot_post_footer === 'true') { %>
          <div class="my-8 p-5 bg-white dark:bg-brand-surface rounded-2xl border border-slate-200 dark:border-brand-border text-center overflow-hidden ad-slot-footer">
            <span class="block mb-2 text-[10px] uppercase font-bold tracking-wider text-slate-400">Sponsored Content</span>
            <% if (settings.custom_ad_html_footer && settings.custom_ad_html_footer.trim()) { %>
              <%- settings.custom_ad_html_footer %>
            <% } else if (settings.enable_sponsor_banner === 'true' && settings.sponsor_banner_img) { %>
              <a href="<%= settings.sponsor_banner_url || '#' %>" target="_blank" rel="noopener sponsored" class="inline-block group">
                <img src="<%= settings.sponsor_banner_img %>" alt="<%= settings.sponsor_banner_alt || 'Sponsor' %>" class="max-h-24 mx-auto rounded-lg shadow-sm">
                <p class="text-xs font-semibold text-slate-600 dark:text-slate-300 mt-2"><%= settings.sponsor_banner_text || '' %></p>
              </a>
            <% } else if (settings.enable_adsense === 'true' && settings.adsense_pub_id) { %>
              <ins class="adsbygoogle"
                   style="display:block"
                   data-ad-client="<%= settings.adsense_pub_id %>"
                   data-ad-slot="<%= settings.adsense_footer_slot || '1234567890' %>"
                   data-ad-format="autorelaxed"></ins>
              <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
            <% } %>
          </div>
        <% } %>

        <!-- Tags Cloud -->
        <% if (post.tags) { %>
          <div class="flex flex-wrap items-center gap-2 pt-6">
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Tags:</span>
            <% post.tags.split(',').forEach(tag => { %>
              <a href="/blogs?tag=<%= encodeURIComponent(tag.trim()) %>" class="px-3 py-1 bg-white dark:bg-brand-surface rounded-lg border border-slate-200 dark:border-brand-border text-xs text-slate-600 dark:text-slate-300 hover:text-brand-500">
                #<%= tag.trim() %>
              </a>
            <% }) %>
          </div>
        <% } %>

      </div>

      <!-- Slot 3: Sticky Blog Sidebar Ad Column (if enabled) -->
      <% if (settings.ad_slot_blog_sidebar === 'true') { %>
        <aside class="lg:col-span-4 space-y-6">
          <div class="sticky top-28 space-y-6">
            
            <div class="p-5 bg-white dark:bg-brand-surface rounded-3xl border border-slate-200 dark:border-brand-border shadow-sm text-center">
              <span class="block mb-3 text-[10px] uppercase font-bold tracking-wider text-slate-400">Partner Spotlight</span>
              <% if (settings.custom_ad_html_sidebar && settings.custom_ad_html_sidebar.trim()) { %>
                <%- settings.custom_ad_html_sidebar %>
              <% } else if (settings.carbon_serve_id && settings.enable_carbon_ads === 'true') { %>
                <script async type="text/javascript" src="//cdn.carbonads.com/carbon.js?serve=<%= settings.carbon_serve_id %>&placement=<%= settings.carbon_placement_id || 'embeddedindiain' %>" id="_carbonads_sidebar_js"></script>
              <% } else if (settings.enable_sponsor_banner === 'true' && settings.sponsor_banner_img) { %>
                <a href="<%= settings.sponsor_banner_url || '#' %>" target="_blank" rel="noopener sponsored" class="block group">
                  <img src="<%= settings.sponsor_banner_img %>" alt="<%= settings.sponsor_banner_alt || 'Sponsor' %>" class="w-full rounded-2xl shadow-sm mb-3">
                  <h4 class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-emerald-500 transition"><%= settings.sponsor_banner_alt || 'Featured Sponsor' %></h4>
                  <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1"><%= settings.sponsor_banner_text || '' %></p>
                </a>
              <% } else if (settings.enable_adsense === 'true' && settings.adsense_pub_id) { %>
                <ins class="adsbygoogle"
                     style="display:block"
                     data-ad-client="<%= settings.adsense_pub_id %>"
                     data-ad-slot="<%= settings.adsense_sidebar_slot || '1234567890' %>"
                     data-ad-format="vertical"></ins>
                <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
              <% } else { %>
                <div class="p-6 border-2 border-dashed border-slate-200 dark:border-brand-border rounded-2xl text-xs text-slate-400">
                  <p class="font-bold">Sidebar Ad Slot Active</p>
                  <p class="text-[10px] mt-1">Configure AdSense, Carbon, or Sponsor in /admin</p>
                </div>
              <% } %>
            </div>

            <!-- Lead Magnet Quick Box in Sidebar -->
            <div class="p-5 bg-gradient-to-br from-brand-900 to-slate-900 text-white rounded-3xl border border-brand-700 shadow-md">
              <span class="text-[10px] bg-accent/20 text-accent font-bold px-2 py-0.5 rounded-full uppercase">Free Engineering PDF</span>
              <h4 class="font-bold text-sm mt-2">PCB Layout &amp; DFM Checklist</h4>
              <p class="text-xs text-slate-300 mt-1">Complete 42-point review list for zero-spin hardware releases.</p>
              <a href="/contact?service=Hardware%20Design" class="mt-3 block text-center py-2 px-3 bg-accent hover:bg-accent-light text-brand-900 font-bold rounded-xl text-xs transition">
                Download Free Checklist &rarr;
              </a>
            </div>

          </div>
        </aside>
      <% } %>

    </div>

    <!-- Related Articles -->
    <% if (relatedPosts && relatedPosts.length > 0) { %>
      <div class="mt-16 pt-12 border-t border-slate-200 dark:border-brand-border">
        <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">Related Engineering Articles</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <% relatedPosts.forEach(rel => { %>
            <a href="/blogs/<%= rel.slug %>" class="bg-white dark:bg-brand-surface p-5 rounded-2xl border border-slate-200 dark:border-brand-border hover:border-brand-500 transition group block">
              <span class="text-[10px] font-bold text-brand-500 dark:text-accent uppercase"><%= rel.category %></span>
              <h4 class="font-bold text-sm text-slate-900 dark:text-white group-hover:text-brand-500 transition mt-1 line-clamp-2">
                <%= rel.title %>
              </h4>
              <p class="text-[11px] text-slate-500 mt-2 line-clamp-2"><%= rel.summary %></p>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

  </div>
</section>

<!-- Article End CTA Banner -->
<section class="py-16 bg-brand-500 text-white text-center">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="text-3xl font-extrabold">Ready to engineer your next embedded system?</h2>
    <p class="mt-3 text-emerald-100 dark:text-emerald-50 text-base max-w-xl mx-auto font-medium">
      Speak directly with an Embedded India systems architect to evaluate your technical requirements and timeline.
    </p>
    <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/contact?topic=<%= encodeURIComponent(post.slug) %>" class="btn-shimmer inline-flex items-center min-h-[44px] px-8 py-4 bg-white text-brand-900 font-bold rounded-xl shadow-lg hover:bg-slate-100 transition active:scale-95 transform hover:-translate-y-0.5">
        Discuss This Architecture
      </a>
      <a href="tel:+918328514090" class="inline-flex items-center min-h-[44px] px-6 py-3 border-2 border-white/40 text-white font-bold rounded-xl hover:bg-white/10 transition">
        📞 +91 83285 14090
      </a>
    </div>
  </div>
</section>

<%- include('../../layouts/footer') %>
