<%- include('../../layouts/header') %>

<!-- Blog Index Hero -->
<section class="py-16 bg-white dark:bg-[#0d1715] border-b border-slate-200 dark:border-brand-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <span class="px-3 py-1 bg-brand-50 dark:bg-brand-900/60 text-brand-600 dark:text-accent rounded-full text-xs font-bold uppercase tracking-wider">
          Knowledge Base
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white mt-4 tracking-tight">
          Embedded India Engineering Blog
        </h1>
        <p class="mt-2 text-base text-slate-600 dark:text-slate-300 max-w-2xl">
          Deep-dive technical guides on embedded systems, high-speed PCB layout, firmware security, HIL testing, and TinyML.
        </p>
      </div>

      <!-- Search Bar -->
      <form action="/blogs" method="GET" class="w-full md:w-80">
        <div class="relative">
          <input 
            type="text" 
            name="q" 
            value="<%= searchQuery || '' %>" 
            placeholder="Search guides, C++, PCB..."
            aria-label="Search engineering guides and articles" 
            class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"
          >
          <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </div>
      </form>
    </div>

    <!-- Category Filter Tabs -->
    <div class="flex flex-wrap gap-2 mt-8 pt-6 border-t border-slate-100 dark:border-brand-border/60">
      <a href="/blogs" class="px-4 py-1.5 rounded-xl text-xs font-bold transition <%= !selectedCategory ? 'bg-brand-500 text-white' : 'bg-slate-100 dark:bg-brand-dark text-slate-600 dark:text-slate-300 hover:bg-slate-200' %>">
        All Articles
      </a>
      <% categories.forEach(cat => { %>
        <a href="/blogs?category=<%= encodeURIComponent(cat) %>" class="px-4 py-1.5 rounded-xl text-xs font-bold transition <%= selectedCategory === cat ? 'bg-brand-500 text-white' : 'bg-slate-100 dark:bg-brand-dark text-slate-600 dark:text-slate-300 hover:bg-slate-200' %>">
          <%= cat %>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- Blog Listing with Sidebar -->
<section class="py-16 bg-slate-50 dark:bg-[#13221f]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Main Articles Feed (8 Cols) -->
      <div class="lg:col-span-8 space-y-8">
        
        <% if (posts.length === 0) { %>
          <div class="bg-white dark:bg-brand-surface rounded-2xl p-12 text-center border border-slate-200 dark:border-brand-border">
            <p class="text-lg font-bold text-slate-700 dark:text-slate-300">No articles matched your filter criteria.</p>
            <a href="/blogs" class="inline-block mt-4 px-6 py-2 bg-brand-500 text-white rounded-xl text-sm font-bold">Clear Filters</a>
          </div>
        <% } %>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <% posts.forEach(post => { %>
            <article class="bg-white dark:bg-brand-surface border border-slate-200 dark:border-brand-border rounded-2xl p-6 flex flex-col justify-between hover:border-brand-500 dark:hover:border-accent transition duration-300 shadow-sm hover:shadow-lg group">
              <div>
                <div class="flex items-center justify-between text-xs text-slate-700 dark:text-slate-300 mb-3">
                  <a href="/blogs?category=<%= encodeURIComponent(post.category) %>" class="px-2.5 py-0.5 rounded-full bg-brand-50 dark:bg-brand-900/60 text-brand-700 dark:text-accent font-semibold hover:underline">
                    <%= post.category %>
                  </a>
                  <span><%= post.readingTime %> min read</span>
                </div>

                <h2 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-brand-500 dark:group-hover:text-accent transition line-clamp-2 leading-snug">
                  <a href="/blogs/<%= post.slug %>"><%= post.title %></a>
                </h2>

                <p class="text-xs text-slate-600 dark:text-slate-300 mt-2.5 line-clamp-3 leading-relaxed">
                  <%= post.summary %>
                </p>
              </div>

              <div class="mt-6 pt-4 border-t border-slate-100 dark:border-brand-border/60 flex items-center justify-between text-xs">
                <span class="text-slate-400"><%= post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Draft' %></span>
                <a href="/blogs/<%= post.slug %>" class="font-bold text-brand-500 dark:text-accent group-hover:translate-x-1 transition inline-flex items-center">
                  Read Guide &rarr;
                </a>
              </div>
            </article>
          <% }) %>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
          <div class="flex items-center justify-center space-x-2 pt-8">
            <% for (let i = 1; i <= totalPages; i++) { %>
              <a 
                href="/blogs?page=<%= i %><%= selectedCategory ? '&category=' + encodeURIComponent(selectedCategory) : '' %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>"
                class="w-10 h-10 rounded-xl flex items-center justify-center text-xs font-bold transition <%= currentPage === i ? 'bg-brand-500 text-white shadow' : 'bg-white dark:bg-brand-surface text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-brand-border' %>"
              >
                <%= i %>
              </a>
            <% } %>
          </div>
        <% } %>

      </div>

      <!-- Sidebar (4 Cols) -->
      <aside class="lg:col-span-4 space-y-8">
        
        <!-- Native Internal Promo Banner Card with UTM Tracking -->
        <div class="bg-gradient-to-br from-brand-900 to-brand-800 rounded-3xl p-6 sm:p-8 text-white border border-brand-700 shadow-xl">
          <span class="px-2.5 py-1 bg-accent/20 text-accent rounded-full text-[10px] font-bold uppercase tracking-wider">Turnkey Services</span>
          <h3 class="text-xl font-bold mt-3">From Concept to Volume SMT Assembly</h3>
          <p class="text-xs text-slate-300 mt-2 leading-relaxed">
            Partner with India's specialized embedded engineering team. We deliver custom schematics, high-speed PCB layouts, and robust RTOS firmware.
          </p>
          <a href="/contact?utm_source=blog_sidebar&utm_medium=native_card&utm_campaign=turnkey_promo" class="block text-center mt-5 py-3 px-4 bg-accent hover:bg-accent-light text-brand-900 font-bold rounded-xl text-xs transition shadow-md">
            Request Engineering Review &rarr;
          </a>
        </div>

        <!-- Calculators Sidebar Card -->
        <div class="bg-white dark:bg-brand-surface rounded-3xl p-6 border border-slate-200 dark:border-brand-border shadow-sm">
          <h3 class="font-bold text-slate-900 dark:text-white text-sm uppercase tracking-wider mb-4 border-b border-slate-100 dark:border-brand-border pb-2">
            Popular Calculators
          </h3>
          <ul class="space-y-3 text-xs font-semibold">
            <li><a href="/tools/pcb-trace" class="text-slate-700 dark:text-slate-300 hover:text-brand-500 dark:hover:text-accent flex items-center justify-between"><span>IPC-2221 PCB Trace Width</span><span>&rarr;</span></a></li>
            <li><a href="/tools/555-timer" class="text-slate-700 dark:text-slate-300 hover:text-brand-500 dark:hover:text-accent flex items-center justify-between"><span>555 Timer Astable/Mono</span><span>&rarr;</span></a></li>
            <li><a href="/tools/uart-baud" class="text-slate-700 dark:text-slate-300 hover:text-brand-500 dark:hover:text-accent flex items-center justify-between"><span>UART Baud Rate Error Calc</span><span>&rarr;</span></a></li>
            <li><a href="/tools/smd-code" class="text-slate-700 dark:text-slate-300 hover:text-brand-500 dark:hover:text-accent flex items-center justify-between"><span>SMD Resistor Decoder</span><span>&rarr;</span></a></li>
          </ul>
        </div>

      </aside>

    </div>
  </div>
</section>

<%- include('../../layouts/footer') %>
