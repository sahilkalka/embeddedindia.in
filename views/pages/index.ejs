<!-- Interactive Scripts: Particle Canvas, Typewriter, Spotlight Cursor, Oscilloscope & Bring-Up -->
<script>
  // 1. Typewriter Animation
  const typewriterTarget = document.getElementById('typewriterTarget');
  const typewriterPhrases = [
    'High-Speed PCB Layouts',
    'Automotive CAN-FD ECUs',
    'Ultra-Low Power Firmware',
    'TinyML Edge AI Nodes',
    'Turnkey IoT Hardware'
  ];
  let phraseIndex = 0;
  let charIndex = 0;
  let isDeleting = false;

  if (typewriterTarget) {
  function typeStep() {
    const currentPhrase = typewriterPhrases[phraseIndex];
    if (isDeleting) {
      typewriterTarget.textContent = currentPhrase.substring(0, charIndex - 1);
      charIndex--;
    } else {
      typewriterTarget.textContent = currentPhrase.substring(0, charIndex + 1);
      charIndex++;
    }

    let speed = isDeleting ? 40 : 80;

    if (!isDeleting && charIndex === currentPhrase.length) {
      speed = 2000; // Pause at end
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      phraseIndex = (phraseIndex + 1) % typewriterPhrases.length;
      speed = 400; // Pause before typing next
    }

    setTimeout(typeStep, speed);
  }
  typeStep();
  }

  // 2. Interactive Interactive Background Circuit Particle Canvas
  const nodeCanvas = document.getElementById('circuitNodesCanvas');
  if (nodeCanvas) {
    const ctx = nodeCanvas.getContext('2d');
    let width = nodeCanvas.width = nodeCanvas.offsetWidth;
    let height = nodeCanvas.height = nodeCanvas.offsetHeight;
    
    window.addEventListener('resize', () => {
      width = nodeCanvas.width = nodeCanvas.offsetWidth;
      height = nodeCanvas.height = nodeCanvas.offsetHeight;
    });

    const particles = [];
    const count = Math.min(Math.floor(width / 35), 45);
    for (let i = 0; i < count; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.6,
        vy: (Math.random() - 0.5) * 0.6,
        radius: Math.random() * 2 + 1.5
      });
    }

    let mouseX = -1000, mouseY = -1000;
    window.addEventListener('mousemove', (e) => {
      const rect = nodeCanvas.getBoundingClientRect();
      mouseX = e.clientX - rect.left;
      mouseY = e.clientY - rect.top;
    });

    function animateNodes() {
      ctx.clearRect(0, 0, width, height);

      // Connect close nodes with faint circuit lines
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 110) {
            ctx.strokeStyle = `rgba(0, 127, 95, ${0.2 * (1 - dist / 110)})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.stroke();
          }
        }
      }

      // Draw and move particles
      particles.forEach(p => {
        p.x += p.vx;
        p.y += p.vy;

        if (p.x < 0 || p.x > width) p.vx *= -1;
        if (p.y < 0 || p.y > height) p.vy *= -1;

        // Subtle mouse repulsion
        const dx = p.x - mouseX;
        const dy = p.y - mouseY;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < 80) {
          p.x += dx * 0.02;
          p.y += dy * 0.02;
        }

        ctx.fillStyle = '#55a630';
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fill();
      });

      requestAnimationFrame(animateNodes);
    }
    animateNodes();
  }

  // 3. Spotlight Cursor Tracker on Service Cards
  document.querySelectorAll('.spotlight-card').forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      card.style.setProperty('--mouse-x', `${x}px`);
      card.style.setProperty('--mouse-y', `${y}px`);
    });
  });

  // 4. Metric Counter Animation
  function startCounters() {
    document.querySelectorAll('.count-up').forEach(el => {
      const target = parseFloat(el.getAttribute('data-target'));
      const isDecimal = el.getAttribute('data-decimal') === '1';
      let current = 0;
      const step = target / 40;
      const interval = setInterval(() => {
        current += step;
        if (current >= target) {
          el.textContent = isDecimal ? target.toFixed(1) : Math.round(target);
          clearInterval(interval);
        } else {
          el.textContent = isDecimal ? current.toFixed(1) : Math.round(current);
        }
      }, 30);
    });
  }
  startCounters();

  // 5. Archetypes Configurator Data
  const ARCHETYPES = {
    iot: {
      mcu: 'ESP32-S3 Dual 240MHz',
      pcb: '4-Layer FR-4 (1.6mm)',
      power: '< 15µA Deep Sleep',
      turn: '3 - 4 Weeks Turnkey',
      code: `// IoT Node Firmware (ESP32-S3)
void init_iot_node(void) {
    power_rail_config(RAIL_3V3, ULTRA_LOW_NOISE);
    lora_mesh_join(CHANNEL_915MHZ);
    bme680_sensor_read(&telemetry);
    esp_sleep_enable_timer_wakeup(60 * 1000000);
    esp_deep_sleep_start();
}`
    },
    automotive: {
      mcu: 'STM32H743 Cortex-M7 @ 480MHz',
      pcb: '6-Layer ENIG (ISO 7637-2 Surge)',
      power: '9V - 36V Automotive DC',
      turn: '4 - 5 Weeks with HIL',
      code: `// Automotive ECU (CAN-FD 5Mbps)
void can_fd_init(void) {
    FDCAN1->CCCR |= FDCAN_CCCR_FDOE | FDCAN_CCCR_BRSE;
    fdcan_set_bitrate(1000000, 5000000); // 1M Arb / 5M Data
    hil_watchdog_refresh();
    iso26262_safety_monitor_start();
}`
    },
    edgeai: {
      mcu: 'NXP i.MX RT1060 + Arm Ethos NPU',
      pcb: '6-Layer Controlled 50Ω/90Ω',
      power: 'Dynamic DVFS 1.2V / 3.3V',
      turn: '4 Weeks Prototype',
      code: `// TinyML Vibration Anomaly Detection
void run_edge_inference(const float* accel_fft) {
    tflite::MicroInterpreter interpreter(model, tensor_arena);
    interpreter.Invoke();
    float anomaly_score = interpreter.output(0)->data.f[0];
    if (anomaly_score > 0.85f) trigger_alarm();
}`
    },
    highspeed: {
      mcu: 'Xilinx Zynq-7000 / DDR3 Memory',
      pcb: '8-Layer Megtron-6 (Low Loss)',
      power: 'Point-of-Load PMIC Multi-Rail',
      turn: '5 Weeks Turnkey',
      code: `// High-Speed DDR3 Calibration
int ddr3_phy_training(void) {
    calibrate_write_leveling();
    deskew_data_lanes(LANE_0_TO_3);
    assert(eye_margin_ps > 180);
    return PHY_TRAINED_OK;
}`
    }
  };

  const archetypeBtns = document.querySelectorAll('.archetype-btn');
  archetypeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const type = btn.getAttribute('data-type');
      const data = ARCHETYPES[type];
      if (!data) return;

      archetypeBtns.forEach(b => {
        b.className = 'px-3.5 py-2 rounded-xl bg-white dark:bg-slate-800 text-slate-800 dark:text-white font-bold border border-slate-300 dark:border-slate-600 hover:border-brand-500 transition archetype-btn';
      });
      btn.className = 'px-3.5 py-2 rounded-xl bg-brand-500 text-white font-black border border-white/20 shadow-md transition transform scale-105 archetype-btn';

      document.getElementById('specMcu').textContent = data.mcu;
      document.getElementById('specPcb').textContent = data.pcb;
      document.getElementById('specPower').textContent = data.power;
      document.getElementById('specTurn').textContent = data.turn;
      document.getElementById('liveCodeSnippet').textContent = data.code;
    });
  });

  // 6. Console Tabs
  const tabBtns = document.querySelectorAll('.console-tab-btn');
  const tabCode = document.getElementById('tabContentCode');
  const tabScope = document.getElementById('tabContentScope');
  const tabTerm = document.getElementById('tabContentTerminal');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-tab');
      tabBtns.forEach(b => {
        b.className = 'px-3 py-1 rounded-md text-slate-300 hover:text-white font-bold console-tab-btn';
      });
      btn.className = 'px-3 py-1 rounded-md bg-brand-500 text-white font-black border border-white/20 console-tab-btn';

      tabCode.classList.add('hidden');
      tabScope.classList.add('hidden');
      tabTerm.classList.add('hidden');

      if (target === 'code') tabCode.classList.remove('hidden');
      if (target === 'scope') {
        tabScope.classList.remove('hidden');
        startOscilloscope();
      }
      if (target === 'terminal') tabTerm.classList.remove('hidden');
    });
  });

  // 7. Multi-Waveform Live Canvas Oscilloscope
  let currentWaveform = 'square';
  let scopeAnimId = null;

  function setWaveform(type) {
    currentWaveform = type;
    const label = document.getElementById('scopeSignalLabel');
    if (type === 'square') label.textContent = 'Signal: Clock PWM (10.0 MHz)';
    if (type === 'sine') label.textContent = 'Signal: Analog Front-End Sine (1.0 kHz)';
    if (type === 'burst') label.textContent = 'Signal: UART TX Burst (115200 Baud)';
  }

  function startOscilloscope() {
    if (scopeAnimId) cancelAnimationFrame(scopeAnimId);
    const canvas = document.getElementById('scopeCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let offset = 0;

    function draw() {
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Grid Lines
      ctx.strokeStyle = '#1e293b';
      ctx.lineWidth = 1;
      for (let x = 0; x < canvas.width; x += 30) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, canvas.height);
        ctx.stroke();
      }
      for (let y = 0; y < canvas.height; y += 30) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(canvas.width, y);
        ctx.stroke();
      }

      // Signal Trace
      ctx.strokeStyle = '#55a630';
      ctx.lineWidth = 2.5;
      ctx.shadowBlur = 10;
      ctx.shadowColor = '#55a630';
      ctx.beginPath();

      if (currentWaveform === 'square') {
        const period = 50;
        for (let x = 0; x < canvas.width; x++) {
          const cycleX = (x + offset) % period;
          const y = cycleX < period / 2 ? 35 : 115;
          if (x === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
      } else if (currentWaveform === 'sine') {
        for (let x = 0; x < canvas.width; x++) {
          const y = 75 + Math.sin((x + offset) * 0.08) * 45;
          if (x === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
      } else if (currentWaveform === 'burst') {
        // Serial packet bursts
        for (let x = 0; x < canvas.width; x++) {
          const noise = ((Math.sin((x + offset) * 0.2) > 0.1) ? 35 : 115);
          if (x === 0) ctx.moveTo(x, noise);
          else ctx.lineTo(x, noise);
        }
      }

      ctx.stroke();
      ctx.shadowBlur = 0;

      offset += 2.5;
      scopeAnimId = requestAnimationFrame(draw);
    }
    draw();
  }

  // 8. Virtual Bring-Up Button
  const btnBringUp = document.getElementById('btnRunBringUp');
  const bringUpStatus = document.getElementById('bringUpStatus');
  const termLogs = document.getElementById('terminalLogs');

  if (btnBringUp) btnBringUp.addEventListener('click', () => {
    // Switch to terminal tab
    tabBtns.forEach(b => {
      b.className = b.getAttribute('data-tab') === 'terminal' ? 'px-3 py-1 rounded-md bg-brand-500 text-white font-black border border-white/20 console-tab-btn' : 'px-3 py-1 rounded-md text-slate-300 hover:text-white font-bold console-tab-btn';
    });
    tabCode.classList.add('hidden');
    tabScope.classList.add('hidden');
    tabTerm.classList.remove('hidden');

    btnBringUp.disabled = true;
    bringUpStatus.textContent = 'Executing bring-up...';
    bringUpStatus.className = 'text-[11px] font-mono text-yellow-400 animate-pulse';
    termLogs.innerHTML = '<div class="text-slate-500">// Initiating automated hardware bench cycle...</div>';

    const steps = [
      { t: 300, msg: '<div class="text-emerald-400">[0.001s] [POWER] LDO rails 3.3V stable (3.302V, ripple &lt; 8mV)... OK</div>' },
      { t: 800, msg: '<div class="text-emerald-400">[0.015s] [CLOCK] 72MHz PLL locked, jitter &lt; 5ps... OK</div>' },
      { t: 1300, msg: '<div class="text-emerald-400">[0.045s] [PERIPH] SPI Flash JEDEC ID verified (Winbond 16MB)... OK</div>' },
      { t: 1800, msg: '<div class="text-emerald-400">[0.092s] [HIL] CAN-FD bus arbitration 5Mbps loopback test... PASS</div>' },
      { t: 2300, msg: '<div class="text-accent font-bold">[0.120s] [RTOS] FreeRTOS kernel started. 4 tasks active. SYSTEM READY.</div>' }
    ];

    steps.forEach(step => {
      setTimeout(() => {
        termLogs.innerHTML += step.msg;
      }, step.t);
    });

    setTimeout(() => {
      btnBringUp.disabled = false;
      bringUpStatus.textContent = 'Board Status: 100% ONLINE';
      bringUpStatus.className = 'text-[11px] font-mono text-emerald-400 font-bold';
    }, 2400);
  });

  // 9. Instant Homepage Sandbox Slider
  const miniSlider = document.getElementById('miniCurrentSlider');
  const miniCurrentLabel = document.getElementById('miniCurrentLabel');
  const miniWidthResult = document.getElementById('miniWidthResult');
  const miniWidthMmResult = document.getElementById('miniWidthMmResult');

  function updateMiniTrace() {
    const current = parseFloat(miniSlider.value);
    miniCurrentLabel.textContent = current.toFixed(1) + ' Amps';
    
    // IPC-2221 External: A = (I / (0.048 * (10^0.44)))^(1/0.725)
    const areaMils2 = Math.pow(current / (0.048 * Math.pow(10, 0.44)), 1 / 0.725);
    const widthMils = areaMils2 / 1.378; // 1 oz
    const widthMm = widthMils * 0.0254;

    miniWidthResult.textContent = widthMils.toFixed(1) + ' mils';
    miniWidthMmResult.textContent = '(' + widthMm.toFixed(2) + ' mm)';
  }

  if (miniSlider) { miniSlider.addEventListener('input', updateMiniTrace); updateMiniTrace(); }
  
  // Estimator State & Handler
  let currentEstPhase = 'prototype';
  let currentEstComplexity = 'low';
  let currentEstCompliance = 'none';

  function updateEstimator() {
    fetch('/api/estimator/calculate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        phase: currentEstPhase,
        complexity: currentEstComplexity,
        compliance: currentEstCompliance
      })
    })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        const timeEl = document.getElementById('estTimelineOutput');
        const compEl = document.getElementById('estComplexityOutput');
        const listEl = document.getElementById('estDeliverablesList');
        const teamEl = document.getElementById('estTeamOutput');
        const ctaEl = document.getElementById('estQuoteCta');

        if (timeEl) timeEl.textContent = data.timeline;
        if (compEl) compEl.textContent = data.complexityLabel + ' • ' + data.complianceLabel;
        if (teamEl) teamEl.textContent = data.recommendedTeam;
        if (listEl) {
          listEl.innerHTML = data.deliverables.map(d => 
            `<li class="flex items-center space-x-2"><span class="text-emerald-500 font-bold">✓</span><span>${d}</span></li>`
          ).join('');
        }
        if (ctaEl) {
          ctaEl.href = `/contact?service=${encodeURIComponent(currentEstPhase === 'firmware' ? 'Firmware/BSP' : 'Hardware Design')}&subject=${encodeURIComponent('RFQ: ' + data.timeline + ' ' + data.complexityLabel)}`;
        }
      }
    })
    .catch(err => console.warn('Estimator err:', err));
  }

  document.querySelectorAll('.est-phase-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.est-phase-btn').forEach(b => {
        b.className = 'est-phase-btn px-4 py-3 rounded-2xl bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700 text-left transition hover:border-brand-500 active:scale-95';
      });
      btn.className = 'est-phase-btn px-4 py-3 rounded-2xl bg-brand-500 text-white font-black border border-brand-500 shadow-md text-left transition transform active:scale-95';
      currentEstPhase = btn.dataset.val;
      updateEstimator();
    });
  });

  document.querySelectorAll('.est-comp-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.est-comp-btn').forEach(b => {
        b.className = 'est-comp-btn px-4 py-3 rounded-2xl bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700 text-left transition hover:border-brand-500 active:scale-95';
      });
      btn.className = 'est-comp-btn px-4 py-3 rounded-2xl bg-brand-500 text-white font-black border border-brand-500 shadow-md text-left transition transform active:scale-95';
      currentEstComplexity = btn.dataset.val;
      updateEstimator();
    });
  });

  document.querySelectorAll('.est-comp-rule').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.est-comp-rule').forEach(b => {
        b.className = 'est-comp-rule px-3 py-2.5 rounded-xl bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700 text-center transition hover:border-brand-500 active:scale-95';
      });
      btn.className = 'est-comp-rule px-3 py-2.5 rounded-xl bg-brand-500 text-white font-black border border-brand-500 text-center transition active:scale-95';
      currentEstCompliance = btn.dataset.val;
      updateEstimator();
    });
  });

</script>

