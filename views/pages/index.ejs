      <!-- Value Prop 3: Full-Cycle Product Realization -->
      <div class="spotlight-card bg-slate-50 dark:bg-brand-surface rounded-3xl p-8 border border-slate-200 dark:border-brand-border shadow-sm flex flex-col justify-between hover:border-brand-500 transition duration-300">
        <div>
