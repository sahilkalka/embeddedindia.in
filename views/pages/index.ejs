<%- include('../layouts/header') %>

<% if (settings.section_hero_enabled !== "false") { %>
<!-- Spaceship-Inspired Ambient Hero Section with Interactive Canvas -->
<section class="relative overflow-hidden spaceship-ambient-mesh circuit-grid py-16 lg:py-24 border-b border-slate-200/80 dark:border-[#1e3831] transition-colors">
  
  <!-- Interactive Particle / Circuit Nodes Background Canvas -->
  <canvas id="circuitNodesCanvas" class="absolute inset-0 w-full h-full pointer-events-none z-0 opacity-40 dark:opacity-60"></canvas>

  <!-- Animated Glowing Ambient Orbs -->
  <div class="absolute -top-32 left-1/4 w-[450px] h-[450px] bg-brand-500/15 dark:bg-brand-500/25 rounded-full blur-3xl pointer-events-none animate-pulse-glow"></div>
  <div class="absolute top-1/2 -right-20 w-[450px] h-[450px] bg-accent/15 dark:bg-accent/25 rounded-full blur-3xl pointer-events-none animate-pulse-glow" style="animation-delay: 2.5s;"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Copy, Animated Typewriter, Category Pills & Live Spec Estimator -->
      <div class="lg:col-span-7 space-y-6 text-left">
        
        <!-- Live Status Pill with Floating Levitation Animation (High Contrast) -->
        <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 text-slate-900 dark:text-white text-xs sm:text-sm font-black shadow-md backdrop-blur-md animate-float-slow">
          <span class="w-2.5 h-2.5 rounded-full bg-accent animate-ping"></span>
          <span>India's Turnkey Embedded Hardware &amp; Firmware Lab</span>
        </div>

        <!-- Big Punchy Title with Animated Rotating Typewriter Text -->
        <div class="space-y-2 text-left">
          <h1 class="text-4xl sm:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-none">
            <%= settings.hero_title || 'Think Big.' %> <br>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-500 via-brand-600 to-accent">
              <%= settings.hero_subtitle || 'We Engineer:' %>
            </span>
          </h1>
          <!-- Animated Typewriter Display (Left Aligned & High Contrast) -->
          <div class="h-10 sm:h-12 flex items-center justify-start text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white font-mono">
            <span id="typewriterTarget" class="text-brand-500 dark:text-accent font-black">High-Speed PCB Layouts</span>
            <span class="animate-cursor-blink text-brand-500 dark:text-accent ml-1 font-black">_</span>
          </div>
        </div>

        <p class="text-base sm:text-lg text-slate-700 dark:text-slate-200 max-w-2xl font-semibold leading-relaxed text-left">
          <%= settings.hero_description || 'From early napkin architecture and high-speed PCB layouts to deterministic RTOS firmware, HIL automated testing, and volume SMT manufacturing.' %>
        </p>

        <!-- Interactive Archetype Selector Pills (High Contrast, Left Aligned) -->
        <div class="pt-2 text-left">
          <span class="text-xs font-black uppercase tracking-wider text-slate-800 dark:text-slate-200 block mb-2.5">
            Select an engineering domain to inspect real-world architecture:
          </span>
          <div class="flex flex-wrap items-center justify-start gap-2 text-xs font-bold" id="archetypePills">
            <button type="button" data-type="iot" class="px-3.5 py-2 rounded-xl bg-brand-500 text-white font-black border border-white/20 shadow-md transition transform hover:scale-105 archetype-btn">
              ⚡ IoT &amp; Wireless
            </button>
            <button type="button" data-type="automotive" class="px-3.5 py-2 rounded-xl bg-white dark:bg-slate-800 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-600 hover:border-brand-500 transition archetype-btn font-bold">
              🚗 Automotive CAN-FD
            </button>
            <button type="button" data-type="edgeai" class="px-3.5 py-2 rounded-xl bg-white dark:bg-slate-800 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-600 hover:border-brand-500 transition archetype-btn font-bold">
              🧠 TinyML Edge AI
            </button>
            <button type="button" data-type="highspeed" class="px-3.5 py-2 rounded-xl bg-white dark:bg-slate-800 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-600 hover:border-brand-500 transition archetype-btn font-bold">
              🔌 High-Speed PCB
            </button>
          </div>
        </div>

        <!-- Live Dynamic Architecture Preview Card (Human-Readable Contrast) -->
        <div class="bg-slate-100 dark:bg-slate-900 rounded-2xl p-5 border border-slate-300 dark:border-slate-700 shadow-md transition-all text-xs" id="archCard">
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-left">
            <div>
              <span class="text-slate-600 dark:text-slate-300 block text-[11px] uppercase font-bold tracking-wider">Target Silicon</span>
              <span id="specMcu" class="font-black text-slate-900 dark:text-white text-sm">ESP32-S3 Dual 240MHz</span>
            </div>
            <div>
              <span class="text-slate-600 dark:text-slate-300 block text-[11px] uppercase font-bold tracking-wider">PCB Stackup</span>
              <span id="specPcb" class="font-black text-slate-900 dark:text-white text-sm">4-Layer FR-4 (1.6mm)</span>
            </div>
            <div>
              <span class="text-slate-600 dark:text-slate-300 block text-[11px] uppercase font-bold tracking-wider">Power Budget</span>
              <span id="specPower" class="font-black text-brand-600 dark:text-accent text-sm">&lt; 15µA Deep Sleep</span>
            </div>
            <div>
              <span class="text-slate-600 dark:text-slate-300 block text-[11px] uppercase font-bold tracking-wider">Prototype Turn</span>
              <span id="specTurn" class="font-black text-brand-600 dark:text-accent text-sm">3 - 4 Weeks Turnkey</span>
            </div>
          </div>
        </div>

        <!-- CTA Buttons (Left Aligned) -->
        <div class="flex flex-col sm:flex-row items-center justify-start gap-4 pt-2">
          <a href="/contact" class="btn-shimmer w-full sm:w-auto px-8 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-black rounded-xl shadow-lg shadow-brand-500/25 border border-white/20 transition transform hover:-translate-y-0.5 text-center text-sm active:scale-95">
            Start your new design experience with us &rarr;
          </a>
          <a href="/tools" class="w-full sm:w-auto px-7 py-3.5 bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-900 dark:text-white font-extrabold rounded-xl border border-slate-300 dark:border-slate-600 transition shadow-sm text-center flex items-center justify-center space-x-2 text-sm active:scale-95">
            <span>Explore Engineering Tools</span>
            <span class="text-[10px] bg-accent/20 text-accent font-black px-2 py-0.5 rounded uppercase">8 Tools</span>
          </a>
        </div>

        <!-- Animated Numerical Counter Metrics (Left Aligned) -->
        <div class="pt-6 border-t border-slate-200 dark:border-slate-800 grid grid-cols-3 gap-4 text-left">
          <div>
            <p class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white font-mono">
              <span class="count-up" data-target="100">0</span>+
            </p>
            <p class="text-xs text-slate-600 dark:text-slate-300 mt-0.5 font-semibold">Delivered Systems</p>
          </div>
          <div>
            <p class="text-2xl sm:text-3xl font-black text-brand-500 dark:text-accent font-mono">
              <span class="count-up" data-target="99.8" data-decimal="1">0</span>%
            </p>
            <p class="text-xs text-slate-600 dark:text-slate-300 mt-0.5 font-semibold">First-Pass HIL Rate</p>
          </div>
          <div>
            <p class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white font-mono">
              &lt; <span class="count-up" data-target="24">0</span>h
            </p>
            <p class="text-xs text-slate-600 dark:text-slate-300 mt-0.5 font-semibold">Architect Response</p>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Hardware Bring-Up Console & Live Oscilloscope -->
      <div class="lg:col-span-5 relative">
        
        <!-- Floating Glassmorphic Status Pill (Top) -->
        <div class="hidden sm:flex absolute -top-5 -left-4 z-20 items-center space-x-2 px-3.5 py-1.5 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-xl shadow-xl text-[11px] font-black text-slate-900 dark:text-white backdrop-blur-md animate-float-slow">
          <span class="w-2.5 h-2.5 rounded-full bg-accent animate-ping"></span>
          <span>IPC-A-610 Class 3 SMT Standards</span>
        </div>

        <!-- Floating Glassmorphic Status Pill (Bottom) -->
        <div class="hidden sm:flex absolute -bottom-4 -right-4 z-20 items-center space-x-2 px-3.5 py-1.5 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-xl shadow-xl text-[11px] font-black text-slate-900 dark:text-white backdrop-blur-md animate-float-reverse">
          <span class="w-2.5 h-2.5 rounded-full bg-accent animate-pulse"></span>
          <span>Live HIL Telemetry Active</span>
        </div>

        <div class="relative mx-auto max-w-md lg:max-w-none bg-slate-950 rounded-3xl p-5 sm:p-6 shadow-2xl border border-slate-800 text-white overflow-hidden">
          
          <!-- Console Header & Tab Bar -->
          <div class="flex items-center justify-between pb-4 border-b border-slate-800">
            <div class="flex items-center space-x-2">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
            </div>
            
            <!-- Interactive Tabs -->
            <div class="flex items-center space-x-1.5 text-[11px] font-mono" id="consoleTabs">
              <button type="button" data-tab="code" class="px-3 py-1 rounded-md bg-brand-500 text-white font-black border border-white/20 console-tab-btn">firmware.c</button>
              <button type="button" data-tab="scope" class="px-3 py-1 rounded-md text-slate-300 hover:text-white font-bold console-tab-btn">Oscilloscope</button>
              <button type="button" data-tab="terminal" class="px-3 py-1 rounded-md text-slate-300 hover:text-white font-bold console-tab-btn">Serial Monitor</button>
            </div>
          </div>

          <!-- Tab Content 1: Code View -->
          <div id="tabContentCode" class="mt-4 font-mono text-xs text-slate-300 leading-relaxed min-h-[220px]">
            <pre><code id="liveCodeSnippet" class="text-emerald-400 dark:text-accent font-semibold">// Embedded India Turnkey Hardware Core
void init_embedded_system(void) {
    power_rail_config(RAIL_3V3, ULTRA_LOW_NOISE);
    uart_baud_init(115200, OVERSAMPLE_16);
    lora_mesh_join(CHANNEL_915MHZ);
    hil_fault_injection_guard();
    start_freertos_scheduler();
}
// Status: Ready for Bring-up</code></pre>
          </div>

          <!-- Tab Content 2: Live HTML5 Canvas Oscilloscope with Multi-Signal Switcher -->
          <div id="tabContentScope" class="mt-4 hidden min-h-[220px] flex flex-col justify-between">
            <div class="flex items-center justify-between text-[11px] font-mono text-slate-300 mb-2 font-bold">
              <span id="scopeSignalLabel">Signal: Clock PWM (10.0 MHz)</span>
              <!-- Signal Selectors -->
              <div class="flex space-x-1">
                <button type="button" onclick="setWaveform('square')" class="px-2 py-0.5 bg-slate-800 hover:bg-slate-700 rounded text-[10px] text-white font-bold">Square</button>
                <button type="button" onclick="setWaveform('sine')" class="px-2 py-0.5 bg-slate-800 hover:bg-slate-700 rounded text-[10px] text-white font-bold">Sine</button>
                <button type="button" onclick="setWaveform('burst')" class="px-2 py-0.5 bg-slate-800 hover:bg-slate-700 rounded text-[10px] text-white font-bold">Burst</button>
              </div>
            </div>
            <canvas id="scopeCanvas" width="400" height="150" class="w-full h-36 bg-slate-900 rounded-xl border border-slate-800"></canvas>
            <span class="text-[10px] text-slate-400 font-mono mt-2 text-center block font-semibold">Synthesizing live hardware frequency domain</span>
          </div>

          <!-- Tab Content 3: Serial Monitor Boot Logs -->
          <div id="tabContentTerminal" class="mt-4 hidden font-mono text-xs min-h-[220px] bg-slate-900 p-3 rounded-xl overflow-y-auto space-y-1 text-slate-300">
            <div class="text-slate-400 font-bold">// Connected to /dev/ttyUSB0 (115200 8N1)</div>
            <div id="terminalLogs">
              <div class="text-emerald-400 font-medium">[0.001s] [POWER] VDD_3V3 rail nominal: 3.302V &plusmn;0.01V... OK</div>
              <div class="text-emerald-400 font-medium">[0.015s] [CLOCK] 72MHz PLL locked, jitter &lt; 5ps... OK</div>
              <div class="text-emerald-400 font-medium">[0.045s] [FLASH] SPI NOR Winbond 16MB verified... OK</div>
              <div class="text-emerald-400 font-medium">[0.092s] [HIL] Automated CAN bus fault loopback test... PASS</div>
              <div class="text-accent font-bold">[0.120s] [RTOS] FreeRTOS kernel started. 4 tasks active.</div>
            </div>
          </div>

          <!-- Interactive Action Bar: Run Virtual Bring-up -->
          <div class="mt-4 pt-4 border-t border-slate-800 flex items-center justify-between">
            <button type="button" id="btnRunBringUp" class="px-4 py-2 bg-brand-500 hover:bg-brand-600 text-white font-mono text-xs font-black rounded-xl transition flex items-center space-x-2 shadow-lg shadow-brand-500/20 border border-white/20 active:scale-95">
              <span>▶ Run Virtual Bring-Up</span>
            </button>
            <span id="bringUpStatus" class="text-[11px] font-mono text-accent font-black tracking-wide">Board Status: ONLINE</span>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>
<% } %>

<% if (settings.section_sandbox_enabled !== "false") { %>
<!-- Interactive Mini-Engineering Sandbox (Instant Trace Calculator on Homepage) -->
<section class="py-12 bg-white dark:bg-brand-dark border-b border-slate-200/80 dark:border-brand-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gradient-to-r from-brand-50 via-slate-50 to-emerald-50 dark:from-brand-surface dark:via-brand-dark dark:to-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-sm">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-5 space-y-2">
          <span class="px-2.5 py-0.5 rounded-full bg-accent/20 text-accent font-bold text-xs uppercase tracking-wider">Instant Sandbox</span>
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">
            Live PCB Trace Width Estimator
          </h2>
          <p class="text-xs text-slate-600 dark:text-slate-300 font-medium">
            Slide the current slider to instantly calculate IPC-2221 trace width geometry without leaving the homepage.
          </p>
        </div>

        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-12 gap-6 items-center">
          <div class="sm:col-span-7 space-y-3">
            <div class="flex items-center justify-between text-xs font-bold">
              <span class="text-slate-700 dark:text-slate-300">Target Current:</span>
              <span id="miniCurrentLabel" class="font-mono text-brand-600 dark:text-accent text-sm">2.5 Amps</span>
            </div>
            <input type="range" id="miniCurrentSlider" min="0.5" max="10.0" step="0.5" value="2.5" class="w-full accent-brand-500 cursor-pointer">
            <div class="flex justify-between text-[10px] text-slate-400 font-mono">
              <span>0.5A (Signals)</span>
              <span>5.0A (Motors)</span>
              <span>10.0A (Power Bus)</span>
            </div>
          </div>

          <div class="sm:col-span-5 p-4 bg-white dark:bg-brand-surface rounded-2xl border border-slate-200 dark:border-brand-border text-center shadow-sm">
            <span class="text-[10px] font-bold uppercase text-slate-700 dark:text-slate-300 font-semibold block">Required Trace Width</span>
            <span id="miniWidthResult" class="text-2xl font-black text-slate-900 dark:text-white font-mono mt-0.5 block">21.4 mils</span>
            <span id="miniWidthMmResult" class="text-xs font-semibold text-emerald-600 dark:text-accent block">(0.54 mm)</span>
            <a href="/tools/pcb-trace" class="inline-block mt-2 text-[10px] font-bold text-brand-500 dark:text-accent hover:underline">
              Advanced IPC-2221 Tool &rarr;
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
<% } %>

