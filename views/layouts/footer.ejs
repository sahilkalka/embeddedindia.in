  <!-- Global Client-Side Scripts -->
  <script src="/assets/js/header-search.js"></script>
  <script>
    // 3. Back-to-Top Button Scroll Handler
    const backToTopBtn = document.getElementById('back-to-top-btn');
    if (backToTopBtn) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 300) {
          backToTopBtn.classList.remove('hidden', 'pointer-events-none');
        } else {
          backToTopBtn.classList.add('hidden', 'pointer-events-none');
        }
      });
      backToTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // 4. Delayed RFQ Popup Modal Handler
    const rfqModal = document.getElementById('rfq-auto-modal');
    const rfqClose = document.getElementById('rfq-modal-close');
    const rfqDismiss = document.getElementById('rfq-modal-dismiss');
    if (rfqModal && !sessionStorage.getItem('rfq-dismissed')) {
      const delaySec = Number('<%= settings.rfq_modal_delay_sec || 5 %>') || 5;
      setTimeout(() => {
        if (!sessionStorage.getItem('rfq-dismissed')) {
          rfqModal.classList.remove('hidden');
        }
      }, delaySec * 1000);

      const hideRfq = () => {
        rfqModal.classList.add('hidden');
        sessionStorage.setItem('rfq-dismissed', 'true');
      };
      if (rfqClose) rfqClose.addEventListener('click', hideRfq);
      if (rfqDismiss) rfqDismiss.addEventListener('click', hideRfq);
    }

    // 5. Card Spotlight Cursor Tracker
    document.querySelectorAll('.spotlight-card, .interactive-card').forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
        card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
      });
    });

    // 6. Mobile Navigation Menu
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    if (mobileMenuBtn && mobileMenu) {
      mobileMenuBtn.addEventListener('click', () => {
        const isHidden = mobileMenu.classList.toggle('hidden');
        mobileMenu.setAttribute('aria-hidden', isHidden ? 'true' : 'false');
        mobileMenuBtn.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
      });
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
          mobileMenu.classList.add('hidden');
          mobileMenu.setAttribute('aria-hidden', 'true');
          mobileMenuBtn.setAttribute('aria-expanded', 'false');
          mobileMenuBtn.focus();
        }
      });
    }

    // 7. Header Quick Search Widget
    const SEARCH_INDEX = [
      { type: 'Service', title: 'Full-Cycle Product Realization', url: '/services/full-cycle-embedded-product-engineering', desc: 'Turnkey electronic hardware, RTOS firmware, DFM validation' },
      { type: 'Service', title: 'Embedded Software & Firmware Development', url: '/services/embedded-software-firmware-development', desc: 'Deterministic bare-metal, FreeRTOS, Zephyr drivers' },
      { type: 'Service', title: 'Hardware Design & High-Speed PCB Layout', url: '/services/hardware-design-engineering', desc: 'Multi-layer PCB, HDI microvias, impedance matching' },
      { type: 'Service', title: 'Board Support Package (BSP) Development', url: '/services/bsp-development', desc: 'Custom U-Boot, Linux kernel device trees, drivers' },
      { type: 'Service', title: 'IoT and Edge Computing Solutions', url: '/services/iot-edge-computing-solutions', desc: 'LoRaWAN, 4G, BLE, TinyML predictive vibration' },
      { type: 'Service', title: 'Automotive Embedded Systems & HIL', url: '/services/automotive-embedded-systems', desc: 'ECUs, CAN-FD, ISO 26262, Hardware-in-the-Loop' },
