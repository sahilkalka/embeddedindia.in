  <!-- Global Client-Side Scripts: Theme Toggle, 4 Modern Color Schemes, Cursor Spotlight & Scroll Reveals -->
  <script>
    // 1. Theme Switcher Logic (Dark / Light)
    const themeToggleBtn = document.getElementById('theme-toggle');
    const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
    const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');

    function updateIcons() {
      if (document.documentElement.classList.contains('dark')) {
        themeToggleLightIcon.classList.remove('hidden');
        themeToggleDarkIcon.classList.add('hidden');
      } else {
        themeToggleDarkIcon.classList.remove('hidden');
        themeToggleLightIcon.classList.add('hidden');
      }
    }

    updateIcons();

    if (themeToggleBtn) {
      themeToggleBtn.addEventListener('click', () => {
        if (document.documentElement.classList.contains('dark')) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('color-theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('color-theme', 'dark');
        }
        updateIcons();
      });
    }

    // 2. Modern 3 Color Scheme Switcher (Emerald, Cyan, Space Grey) + Dynamic Favicon
    const paletteButtons = document.querySelectorAll('.palette-btn');
    const paletteDropdownBtn = document.getElementById('palette-dropdown-btn');
    const paletteDropdownMenu = document.getElementById('palette-dropdown-menu');
    const paletteChevron = document.getElementById('palette-chevron');
    const activeSchemeDot = document.getElementById('active-scheme-dot');

    const paletteColorMap = {
      emerald: '#007f5f',
      cyan: '#0284c7',
      spacegrey: '#475569'
    };

    function updateFavicon(color) {
      const faviconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="8" fill="#0b1412"/><path d="M16 4C16.8 4 17.5 4.4 18 5.2L28 21.8C28.7 23 28.2 24.5 27 25.2C26.6 25.4 26.1 25.5 25.6 25.5H19.8C18.7 25.5 17.7 24.8 17.3 23.8L16 20.3L14.7 23.8C14.3 24.8 13.3 25.5 12.2 25.5H6.4C5 25.5 3.9 24.4 3.9 23C3.9 22.5 4 22.1 4.3 21.8L14 5.2C14.5 4.4 15.2 4 16 4Z" fill="${color}"/></svg>`;
      const link = document.querySelector("link[rel*='icon']") || document.createElement('link');
      link.type = 'image/svg+xml';
      link.rel = 'icon';
      link.href = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(faviconSvg);
      document.getElementsByTagName('head')[0].appendChild(link);
    }

    function applyPalette(scheme) {
      const safeScheme = ['emerald', 'cyan', 'spacegrey'].includes(scheme) ? scheme : 'emerald';
      document.documentElement.setAttribute('data-palette', safeScheme);
      localStorage.setItem('color-palette', safeScheme);

      const colorHex = paletteColorMap[safeScheme] || '#007f5f';

      // Update favicon color dynamically
      updateFavicon(colorHex);

      // Update active indicator dot in header dropdown button
      if (activeSchemeDot) {
        activeSchemeDot.style.backgroundColor = colorHex;
      }

      paletteButtons.forEach(btn => {
        const check = btn.querySelector('.scheme-check');
        const isMatch = btn.dataset.scheme === safeScheme;

        if (isMatch) {
          if (check) check.classList.remove('hidden');
          btn.classList.add('active-palette-item', 'font-bold');
        } else {
          if (check) check.classList.add('hidden');
          btn.classList.remove('active-palette-item', 'font-bold');
        }
      });
    }

    const initialScheme = localStorage.getItem('color-palette') || 'emerald';
    applyPalette(initialScheme);

    // Toggle Palette Dropdown
    if (paletteDropdownBtn && paletteDropdownMenu) {
      paletteDropdownBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !paletteDropdownMenu.classList.contains('hidden');
        paletteDropdownMenu.classList.toggle('hidden');
        paletteDropdownBtn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
        if (paletteChevron) paletteChevron.classList.toggle('rotate-180', !isOpen);
      });

      document.addEventListener('click', (e) => {
        if (!paletteDropdownMenu.contains(e.target) && !paletteDropdownBtn.contains(e.target)) {
          paletteDropdownMenu.classList.add('hidden');
          paletteDropdownBtn.setAttribute('aria-expanded', 'false');
          if (paletteChevron) paletteChevron.classList.remove('rotate-180');
        }
      });
    }

    paletteButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        applyPalette(btn.dataset.scheme);
        if (paletteDropdownMenu && !paletteDropdownMenu.classList.contains('hidden')) {
          paletteDropdownMenu.classList.add('hidden');
          if (paletteDropdownBtn) paletteDropdownBtn.setAttribute('aria-expanded', 'false');
          if (paletteChevron) paletteChevron.classList.remove('rotate-180');
        }
      });
    });

    // 3. Global Spotlight Tracking & 3D Tilt Physics for Cards
    function initCardInteractivity() {
      const cards = document.querySelectorAll('.spotlight-card, .interactive-card');
      cards.forEach(card => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          card.style.setProperty('--mouse-x', `${x}px`);
          card.style.setProperty('--mouse-y', `${y}px`);

          // Subtle 3D Tilt micro-interaction
          const centerX = rect.width / 2;
          const centerY = rect.height / 2;
          const rotateX = ((y - centerY) / centerY) * -3.5;
          const rotateY = ((x - centerX) / centerX) * 3.5;
          card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-4px)`;
        });

        card.addEventListener('mouseleave', () => {
          card.style.transform = '';
        });
      });
    }
    initCardInteractivity();

    // 4. Global Scroll Reveal Observer (IntersectionObserver)
    const revealElements = document.querySelectorAll('.reveal-on-scroll');
    if (revealElements.length > 0 && 'IntersectionObserver' in window) {
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

      revealElements.forEach(el => revealObserver.observe(el));
    } else {
      revealElements.forEach(el => el.classList.add('revealed'));
    }

    // 5. Mobile Menu
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    if (mobileMenuBtn && mobileMenu) {
      mobileMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    }

    // 6. Cookie Banner
    const cookieBanner = document.getElementById('cookie-banner');
    const cookieAccept = document.getElementById('cookie-accept');
    const cookieDecline = document.getElementById('cookie-decline');

    if (cookieBanner && !localStorage.getItem('cookie-choice')) {
      cookieBanner.classList.remove('hidden');
      cookieAccept?.addEventListener('click', () => {
        localStorage.setItem('cookie-choice', 'accepted');
        cookieBanner.classList.add('hidden');
      });
      cookieDecline?.addEventListener('click', () => {
        localStorage.setItem('cookie-choice', 'declined');
        cookieBanner.classList.add('hidden');
      });
    }

    // 7. Newsletter Form Submission AJAX
    const newsletterForm = document.getElementById('newsletter-form');
    const newsletterStatus = document.getElementById('newsletter-status');
    if (newsletterForm) {
      newsletterForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        newsletterStatus.textContent = 'Submitting...';
        newsletterStatus.className = 'text-xs text-accent';
        const formData = new FormData(newsletterForm);
        const data = Object.fromEntries(formData.entries());

        try {
          const res = await fetch('/api/newsletter/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          const result = await res.json();
          if (result.success) {
            newsletterStatus.textContent = result.message;
            newsletterStatus.className = 'text-xs text-accent font-semibold';
            newsletterForm.reset();
          } else {
            newsletterStatus.textContent = result.message;
            newsletterStatus.className = 'text-xs text-red-400';
          }
        } catch (err) {
          newsletterStatus.textContent = 'Error connecting to server. Please try again.';
          newsletterStatus.className = 'text-xs text-red-400';
        }
      });
    }
  </script>
