  <!-- Global Client-Side Scripts -->
  <script>
    // 1. Theme Switcher Logic (Dark / Light)
    const themeToggleBtn = document.getElementById('theme-toggle');
    const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
    const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');
    const themeToggleLabel = document.getElementById('theme-toggle-label');

    function updateIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        themeToggleLightIcon.classList.remove('hidden');
        themeToggleDarkIcon.classList.add('hidden');
      } else {
        themeToggleDarkIcon.classList.remove('hidden');
        themeToggleLightIcon.classList.add('hidden');
      }
      if (themeToggleLabel) themeToggleLabel.textContent = isDark ? 'Light mode' : 'Dark mode';
      if (themeToggleBtn) themeToggleBtn.setAttribute('aria-label', `Switch to ${isDark ? 'light' : 'dark'} mode`);
    }

    updateIcons();

    if (themeToggleBtn) {
      themeToggleBtn.addEventListener('click', () => {
        if (document.documentElement.classList.contains('dark')) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('color-theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('color-theme', 'dark');
        }
        updateIcons();
        if (typeof applyPalette === 'function') {
          applyPalette(localStorage.getItem('color-palette') || 'cyber-emerald');
        }
      });
    }

    // 2. Palette Selection Switcher
    const paletteButtons = document.querySelectorAll('.palette-btn');
    const paletteDropdownBtn = document.getElementById('palette-dropdown-btn');
    const paletteDropdownMenu = document.getElementById('palette-dropdown-menu');
    const paletteChevron = document.getElementById('palette-chevron');
    const activeSchemeDot = document.getElementById('active-scheme-dot');

    const THEME_PALETTES = {
      'cyber-emerald': {
        name: 'Cyber Emerald',
        hex: '#007f5f',
        light: {
          '--primary-color': '#007f5f',
          '--primary-hover': '#007255',
          '--primary-active': '#00664c',
          '--secondary-color': '#55a630',
          '--accent-light': '#80b918',
          '--accent-dark': '#387322',
          '--glow-color': 'rgba(0, 127, 95, 0.22)'
        },
        dark: {
          '--primary-color': '#059669',
          '--primary-hover': '#047857',
          '--primary-active': '#065f46',
          '--secondary-color': '#80b918',
          '--accent-light': '#a3e635',
          '--accent-dark': '#65a30d',
          '--glow-color': 'rgba(5, 150, 105, 0.35)'
        }
      },
      'quantum-cyan': {
        name: 'Quantum Cyan',
        hex: '#0284c7',
        light: {
          '--primary-color': '#0284c7',
          '--primary-hover': '#0369a1',
