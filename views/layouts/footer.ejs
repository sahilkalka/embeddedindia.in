          '--accent-light': '#c084fc',
          '--accent-dark': '#581c87',
          '--glow-color': 'rgba(147, 51, 234, 0.22)'
        },
        dark: {
          '--primary-color': '#a855f7',
          '--primary-hover': '#9333ea',
          '--primary-active': '#7e22ce',
          '--secondary-color': '#c084fc',
          '--accent-light': '#e9d5ff',
          '--accent-dark': '#6b21a8',
          '--glow-color': 'rgba(168, 85, 247, 0.35)'
        }
      },
      'clean-light': {
        name: 'Clean Enterprise',
        hex: '#2563eb',
        light: {
          '--primary-color': '#2563eb',
          '--primary-hover': '#1d4ed8',
          '--primary-active': '#1e40af',
          '--secondary-color': '#3b82f6',
          '--accent-light': '#60a5fa',
          '--accent-dark': '#1e3a8a',
          '--glow-color': 'rgba(37, 99, 235, 0.22)'
        },
        dark: {
          '--primary-color': '#3b82f6',
          '--primary-hover': '#2563eb',
          '--primary-active': '#1d4ed8',
          '--secondary-color': '#60a5fa',
          '--accent-light': '#93c5fd',
          '--accent-dark': '#1e40af',
          '--glow-color': 'rgba(59, 130, 246, 0.35)'
        }
      }
    };

    THEME_PALETTES['emerald'] = THEME_PALETTES['cyber-emerald'];
    THEME_PALETTES['pcb-emerald-green'] = THEME_PALETTES['cyber-emerald'];
    THEME_PALETTES['cyan'] = THEME_PALETTES['quantum-cyan'];
    THEME_PALETTES['silicon-dark-blue'] = THEME_PALETTES['quantum-cyan'];
    THEME_PALETTES['spacegrey'] = THEME_PALETTES['titanium-slate'];
    THEME_PALETTES['industrial-amber-charcoal'] = THEME_PALETTES['solar-amber'];
    THEME_PALETTES['clean-light-enterprise'] = THEME_PALETTES['clean-light'];

    function applyPalette(scheme) {
      const canonicalScheme = {
        emerald: 'cyber-emerald',
        cyan: 'quantum-cyan',
        spacegrey: 'titanium-slate'
      }[scheme] || scheme;
      const safeScheme = THEME_PALETTES[canonicalScheme] ? canonicalScheme : 'cyber-emerald';
      const paletteObj = THEME_PALETTES[safeScheme];
      document.documentElement.setAttribute('data-palette', safeScheme);
      localStorage.setItem('color-palette', safeScheme);

      const isDark = document.documentElement.classList.contains('dark');
      const vars = isDark ? (paletteObj.dark || paletteObj.light) : paletteObj.light;
      if (vars) {
        Object.entries(vars).forEach(([prop, val]) => {
          document.documentElement.style.setProperty(prop, val);
        });
      }

      if (activeSchemeDot) {
        activeSchemeDot.style.backgroundColor = paletteObj.hex || '#007f5f';
      }

      paletteButtons.forEach(btn => {
        const check = btn.querySelector('.scheme-check');
        const isMatch = btn.dataset.scheme === safeScheme;
        if (isMatch) {
          if (check) check.classList.remove('hidden');
          btn.classList.add('font-bold');
        } else {
          if (check) check.classList.add('hidden');
          btn.classList.remove('font-bold');
        }
      });
    }

    const initialScheme = localStorage.getItem('color-palette') || '<%= settings.active_theme_palette || "cyber-emerald" %>';
    applyPalette(initialScheme);

    if (paletteDropdownBtn && paletteDropdownMenu) {
      paletteDropdownBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !paletteDropdownMenu.classList.contains('hidden');
        paletteDropdownMenu.classList.toggle('hidden');
        paletteDropdownBtn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
        if (paletteChevron) paletteChevron.classList.toggle('rotate-180', !isOpen);
      });

      document.addEventListener('click', (e) => {
        if (!paletteDropdownMenu.contains(e.target) && !paletteDropdownBtn.contains(e.target)) {
          paletteDropdownMenu.classList.add('hidden');
          paletteDropdownBtn.setAttribute('aria-expanded', 'false');
          if (paletteChevron) paletteChevron.classList.remove('rotate-180');
        }
      });
    }

    paletteButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        applyPalette(btn.dataset.scheme);
        if (paletteDropdownMenu) {
          paletteDropdownMenu.classList.add('hidden');
          if (paletteDropdownBtn) paletteDropdownBtn.setAttribute('aria-expanded', 'false');
          if (paletteChevron) paletteChevron.classList.remove('rotate-180');
        }
      });
    });

    // 3. Back-to-Top Button Scroll Handler
    const backToTopBtn = document.getElementById('back-to-top-btn');
    if (backToTopBtn) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 300) {
          backToTopBtn.classList.remove('hidden');
        } else {
          backToTopBtn.classList.add('hidden');
        }
      });
      backToTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // 4. Delayed RFQ Popup Modal Handler
    const rfqModal = document.getElementById('rfq-auto-modal');
    const rfqClose = document.getElementById('rfq-modal-close');
    const rfqDismiss = document.getElementById('rfq-modal-dismiss');
    if (rfqModal && !sessionStorage.getItem('rfq-dismissed')) {
      const delaySec = Number('<%= settings.rfq_modal_delay_sec || 5 %>') || 5;
      setTimeout(() => {
        if (!sessionStorage.getItem('rfq-dismissed')) {
          rfqModal.classList.remove('hidden');
        }
      }, delaySec * 1000);

      const hideRfq = () => {
        rfqModal.classList.add('hidden');
        sessionStorage.setItem('rfq-dismissed', 'true');
      };
      if (rfqClose) rfqClose.addEventListener('click', hideRfq);
      if (rfqDismiss) rfqDismiss.addEventListener('click', hideRfq);
    }

    // 5. Card Spotlight Cursor Tracker
    document.querySelectorAll('.spotlight-card, .interactive-card').forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
        card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
      });
    });

    // 6. Mobile Navigation Menu
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    if (mobileMenuBtn && mobileMenu) {
      mobileMenuBtn.addEventListener('click', () => {
        const isHidden = mobileMenu.classList.toggle('hidden');
        mobileMenu.setAttribute('aria-hidden', isHidden ? 'true' : 'false');
        mobileMenuBtn.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
      });
    }

    // 7. Header Quick Search Widget
    const searchBtn = document.getElementById('header-search-btn');
    const searchModal = document.getElementById('header-search-modal');
    const searchClose = document.getElementById('header-search-close');
    const searchInput = document.getElementById('headerSearchInput');
    const searchResults = document.getElementById('headerSearchResults');

    const SEARCH_INDEX = [
      { type: 'Service', title: 'Full-Cycle Product Realization', url: '/services/full-cycle-embedded-product-engineering', desc: 'Turnkey electronic hardware, RTOS firmware, DFM validation' },
      { type: 'Service', title: 'Embedded Software & Firmware Development', url: '/services/embedded-software-firmware-development', desc: 'Deterministic bare-metal, FreeRTOS, Zephyr drivers' },
      { type: 'Service', title: 'Hardware Design & High-Speed PCB Layout', url: '/services/hardware-design-engineering', desc: 'Multi-layer PCB, HDI microvias, impedance matching' },
      { type: 'Service', title: 'Board Support Package (BSP) Development', url: '/services/bsp-development', desc: 'Custom U-Boot, Linux kernel device trees, drivers' },
      { type: 'Service', title: 'IoT and Edge Computing Solutions', url: '/services/iot-edge-computing-solutions', desc: 'LoRaWAN, 4G, BLE, TinyML predictive vibration' },
      { type: 'Service', title: 'Automotive Embedded Systems & HIL', url: '/services/automotive-embedded-systems', desc: 'ECUs, CAN-FD, ISO 26262, Hardware-in-the-Loop' },
      { type: 'Tool', title: 'IPC-2221 PCB Trace Width Calculator', url: '/tools/pcb-trace', desc: 'Copper trace ampacity and thermal cross section' },
      { type: 'Tool', title: '555 Timer Frequency & Duty Cycle', url: '/tools/555-timer', desc: 'Astable and monostable oscillation calculations' },
      { type: 'Tool', title: 'LED Series Current Limiting Resistor', url: '/tools/led-resistor', desc: 'Forward drop and power dissipation calculator' },
      { type: 'Tool', title: 'UART Baud Rate Error Calculator', url: '/tools/uart-baud', desc: 'Clock divider and framing error tolerances' },
      { type: 'Tool', title: 'SMD Resistor 3/4-Digit & EIA-96 Code Decoder', url: '/tools/smd-code', desc: 'Surface-mount component marking lookup' },
      { type: 'Tool', title: 'IoT Battery Life & Deep-Sleep Estimator', url: '/tools/battery-life', desc: 'Duty cycle and multi-year cell lifetime' },
      { type: 'Tool', title: 'Microstrip Controlled Trace Impedance', url: '/tools/trace-impedance', desc: 'Characteristic impedance 50-ohm calculation' },
      { type: 'Tool', title: 'Microcontroller Pinout & Peripheral Reference', url: '/tools/mcu-pinout', desc: 'STM32, ESP32, and RP2040 pin multiplexing' },
      { type: 'Blog', title: 'Hardware & Firmware Co-Design', url: '/blogs/bridging-the-divide', desc: 'Aligning hardware and firmware engineering workflows' },
      { type: 'Blog', title: 'Hardware-in-the-Loop (HIL) Testing', url: '/blogs/hardware-in-the-loop-hil', desc: 'Automated test rigs for mission-critical validation' },
      { type: 'Page', title: 'Engineering Services Portfolio', url: '/services', desc: 'All hardware and firmware engineering disciplines' },
      { type: 'Page', title: 'Client Projects & Case Studies', url: '/projects', desc: 'Bus AC controllers, water dispensers, IoT gateways' },
      { type: 'Page', title: 'About Embedded India', url: '/about', desc: 'Company vision, precision standards, and engineering presence' },
      { type: 'Page', title: 'Contact Us & Request Quote', url: '/contact', desc: 'Initiate custom embedded project inquiry' }
    ];

    function openSearch() {
      if (!searchModal) return;
      searchModal.classList.remove('hidden');
      searchModal.setAttribute('aria-hidden', 'false');
      if (searchInput) {
        searchInput.focus();
        searchInput.select();
      }
    }

    function closeSearch() {
      if (!searchModal) return;
      searchModal.classList.add('hidden');
      searchModal.setAttribute('aria-hidden', 'true');
      if (searchInput) searchInput.value = '';
      if (searchResults) {
        searchResults.innerHTML = '';
        searchResults.classList.add('hidden');
      }
    }

    if (searchBtn) searchBtn.addEventListener('click', openSearch);
    if (searchClose) searchClose.addEventListener('click', closeSearch);

    if (searchModal) {
      searchModal.addEventListener('click', (e) => {
        if (e.target === searchModal) closeSearch();
      });
    }

    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        openSearch();
      }
      if (e.key === 'Escape' && searchModal && !searchModal.classList.contains('hidden')) {
        closeSearch();
      }
    });

    if (searchInput && searchResults) {
      searchInput.addEventListener('input', () => {
        const q = searchInput.value.trim().toLowerCase();
        if (q.length < 2) {
          searchResults.innerHTML = '';
          searchResults.classList.add('hidden');
          return;
        }

        const matches = SEARCH_INDEX.filter(item => 
          item.title.toLowerCase().includes(q) || 
          item.desc.toLowerCase().includes(q) ||
          item.type.toLowerCase().includes(q)
        );

        searchResults.classList.remove('hidden');

        if (matches.length === 0) {
          searchResults.innerHTML = `
            <div class="p-6 text-center text-slate-500 dark:text-slate-400">
              <p class="font-bold text-sm">No results found for "${searchInput.value.trim()}"</p>
              <p class="text-[11px] mt-1 text-slate-400">Try searching for "PCB", "Firmware", "Automotive", "555 Timer", or "CAN".</p>
            </div>
          `;
          return;
        }

        searchResults.innerHTML = matches.map(item => `
          <a href="${item.url}" class="block p-3.5 hover:bg-slate-50 dark:hover:bg-brand-dark transition group">
            <div class="flex items-center justify-between">
              <span class="font-bold text-slate-900 dark:text-white group-hover:text-brand-500 dark:group-hover:text-accent transition">${item.title}</span>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-full uppercase bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">${item.type}</span>
            </div>
            <p class="text-slate-500 dark:text-slate-400 text-[11px] mt-0.5">${item.desc}</p>
          </a>
        `).join('');
      });
    }

    // 8. Cookie Banner Handling
    const cookieBanner = document.getElementById('cookie-banner');
    const cookieAccept = document.getElementById('cookie-accept');
    const cookieDecline = document.getElementById('cookie-decline');

    if (cookieBanner && !localStorage.getItem('cookie-choice')) {
      cookieBanner.classList.remove('hidden');
      cookieAccept?.addEventListener('click', () => {
        localStorage.setItem('cookie-choice', 'accepted');
        cookieBanner.classList.add('hidden');
      });
      cookieDecline?.addEventListener('click', () => {
        localStorage.setItem('cookie-choice', 'declined');
        cookieBanner.classList.add('hidden');
      });
    }

    // 9. Newsletter Form Submission AJAX
    const newsletterForm = document.getElementById('newsletter-form');
    const newsletterStatus = document.getElementById('newsletter-status');
    if (newsletterForm) {
      newsletterForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        newsletterStatus.textContent = 'Submitting...';
        newsletterStatus.className = 'text-xs text-accent';
        const formData = new FormData(newsletterForm);
        const data = Object.fromEntries(formData.entries());

        try {
          const res = await fetch('/api/newsletter/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          const result = await res.json();
          if (result.success) {
            newsletterStatus.textContent = result.message;
            newsletterStatus.className = 'text-xs text-accent font-semibold';
            newsletterForm.reset();
          } else {
            newsletterStatus.textContent = result.message;
            newsletterStatus.className = 'text-xs text-red-400';
          }
        } catch (err) {
          newsletterStatus.textContent = 'Error connecting to server. Please try again.';
          newsletterStatus.className = 'text-xs text-red-400';
        }
      });
    }
  </script>

  <!-- Floating "Ask EI Copilot" AI Hardware Engineering Assistant -->
  <% if (settings.enable_copilot !== 'false') { %>
  <div id="copilot-widget-container" class="fixed bottom-6 right-6 z-50 flex flex-col items-end pointer-events-auto">
    
    <!-- Copilot Chat Drawer Panel -->
    <div id="copilot-drawer" class="hidden translate-y-8 opacity-0 pointer-events-none transition-all duration-300 w-[92vw] sm:w-96 max-h-[82vh] bg-white/95 dark:bg-slate-900/95 backdrop-blur-xl rounded-3xl shadow-2xl border border-slate-200 dark:border-slate-800 flex flex-col overflow-hidden mb-3.5">
      
      <!-- Drawer Header -->
      <div class="p-4 bg-gradient-to-r from-brand-600 via-brand-500 to-accent text-white flex items-center justify-between shadow-sm">
        <div class="flex items-center space-x-2.5">
          <div class="w-8 h-8 rounded-xl bg-white/15 backdrop-blur-sm flex items-center justify-center p-1.5 shadow-xs">
            <svg class="w-full h-full text-white" viewBox="0 0 32 32" fill="currentColor">
              <path d="M16 3C16.8 3 17.5 3.4 18 4.2L28.5 21.8C29.2 23 28.7 24.5 27.5 25.2C27.1 25.4 26.6 25.5 26.1 25.5H19.8C18.7 25.5 17.7 24.8 17.3 23.8L16 20.3L14.7 23.8C14.3 24.8 13.3 25.5 12.2 25.5H5.9C4.5 25.5 3.4 24.4 3.4 23C3.4 22.5 3.5 22.1 3.8 21.8L14 4.2C14.5 3.4 15.2 3 16 3Z"/>
            </svg>
          </div>
          <div>
            <h3 class="font-black text-sm tracking-tight leading-none text-white">Ask EI Copilot</h3>
            <p class="text-[10px] text-white/80 font-semibold mt-0.5 flex items-center space-x-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-300 animate-ping inline-block"></span>
              <span>Hardware &amp; RTOS Assistant</span>
            </p>
          </div>
        </div>
        <button id="copilot-close-btn" type="button" aria-label="Minimize Copilot" class="p-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-white transition active:scale-90">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
        </button>
      </div>

      <!-- Quick Suggestion Chips -->
      <div class="px-3.5 py-2.5 bg-slate-50 dark:bg-slate-950/50 border-b border-slate-200/70 dark:border-slate-800 flex items-center space-x-1.5 overflow-x-auto text-[11px] no-scrollbar">
        <button type="button" class="copilot-chip whitespace-nowrap px-2.5 py-1 rounded-lg bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 font-bold hover:border-brand-500 transition active:scale-95 shadow-xs" data-prompt="What microcontroller is best for ultra-low power coin-cell IoT?">🔋 Battery MCU</button>
        <button type="button" class="copilot-chip whitespace-nowrap px-2.5 py-1 rounded-lg bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 font-bold hover:border-brand-500 transition active:scale-95 shadow-xs" data-prompt="What PCB trace width do I need for 5 Amps?">📐 Trace Width</button>
        <button type="button" class="copilot-chip whitespace-nowrap px-2.5 py-1 rounded-lg bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 font-bold hover:border-brand-500 transition active:scale-95 shadow-xs" data-prompt="How does Embedded India execute Hardware-in-the-Loop (HIL) testing?">⚡ HIL Testing</button>
        <button type="button" class="copilot-chip whitespace-nowrap px-2.5 py-1 rounded-lg bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 font-bold hover:border-brand-500 transition active:scale-95 shadow-xs" data-prompt="I need a turnkey quote for an automotive CAN-FD device.">🚗 Turnkey Quote</button>
      </div>

      <!-- Messages Scroll Area -->
      <div id="copilot-messages" class="flex-1 p-4 overflow-y-auto space-y-3 min-h-[220px] max-h-[350px]">
        <div class="flex items-start space-x-2">
          <div class="w-6 h-6 rounded-lg bg-gradient-to-tr from-brand-600 to-accent flex-shrink-0 flex items-center justify-center text-white text-[10px] font-black shadow-xs mt-0.5">EI</div>
          <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-3.5 rounded-2xl rounded-tl-xs shadow-xs text-xs text-slate-700 dark:text-slate-200 leading-relaxed font-normal">
            <%= settings.copilot_greeting || 'Hello! I am your Embedded India engineering copilot. Ask me about MCU selection, PCB layouts, RTOS firmware, or scoping your next project!' %>
          </div>
        </div>
      </div>

      <!-- Input Form -->
      <form id="copilot-form" class="p-3 bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 flex items-center space-x-2">
        <input type="text" id="copilot-input" placeholder="Ask technical question or describe your project..." autocomplete="off" class="flex-1 px-3.5 py-2.5 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500">
        <button type="submit" aria-label="Send message" class="px-4 py-2.5 bg-brand-500 hover:bg-brand-600 text-white rounded-xl text-xs font-bold transition shadow-md active:scale-95 flex items-center justify-center">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </button>
      </form>
    </div>

    <!-- Floating Trigger Bubble Button -->
    <button id="copilot-trigger-btn" type="button" aria-label="Open EI Copilot" class="spring-btn group flex items-center space-x-2.5 px-4 py-3 rounded-2xl bg-gradient-to-r from-brand-600 via-brand-500 to-accent text-white shadow-xl shadow-brand-500/30 hover:shadow-brand-500/45 border border-white/20 transform hover:-translate-y-1 active:scale-95 transition">
      <div class="relative w-6 h-6 flex items-center justify-center">
        <span class="absolute w-full h-full rounded-full bg-white/30 animate-ping"></span>
        <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
      </div>
      <span class="text-xs font-black tracking-tight hidden sm:inline-block">Ask EI Copilot</span>
      <span class="w-2 h-2 rounded-full bg-emerald-300 shadow-xs"></span>
    </button>

  </div>
  <% } %>

  <script src="/assets/js/copilot-widget.js"></script>

</body>
</html>
