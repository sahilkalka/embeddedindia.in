          <button id="cookie-decline" class="px-4 py-1.5 bg-slate-200 dark:bg-brand-dark hover:bg-slate-300 dark:hover:bg-brand-900 text-slate-700 dark:text-slate-300 rounded-lg text-xs font-semibold transition">Decline</button>
