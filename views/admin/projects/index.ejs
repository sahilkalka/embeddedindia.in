<%- include('../layout_top') %>

<div class="w-full space-y-6 text-left mx-auto">
  
  <!-- Header & Actions -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-black text-slate-900 dark:text-white">Engineering Projects &amp; Case Studies</h1>
      <p class="text-xs text-slate-500 mt-1">Manage portfolio hardware designs, technical specs, videos, and featured case studies</p>
    </div>

    <div class="flex flex-wrap items-center gap-2.5">
      <a href="/admin/projects/new" class="px-5 py-2.5 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl text-xs transition shadow flex items-center space-x-2 active:scale-95">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        <span>Add New Project</span>
      </a>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-4 bg-emerald-100 dark:bg-emerald-950/50 border border-emerald-300 dark:border-emerald-800 rounded-xl text-xs font-bold text-emerald-800 dark:text-emerald-300 flex items-center space-x-2">
      <span>✓</span>
      <span>Project successfully saved and synchronized with public portfolio.</span>
    </div>
  <% } %>

  <!-- Category Filter Pills (Wraps cleanly on mobile with zero horizontal scroll) -->
  <div class="flex flex-wrap items-center gap-2">
    <% (categories || ['All']).forEach(function(cat) { %>
      <a 
        href="/admin/projects?category=<%= encodeURIComponent(cat) %>" 
        class="px-3 py-1.5 rounded-lg text-xs font-bold transition <%= selectedCategory === cat ? 'bg-brand-500 text-white shadow-sm' : 'bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-brand-500' %>"
      >
        <%= cat %>
      </a>
    <% }); %>
  </div>

  <!-- Table Container -->
  <div class="rounded-2xl border overflow-hidden shadow-sm admin-table-container">
    <% if (!projects || projects.length === 0) { %>
      <div class="p-8 text-center text-slate-500 text-xs">
        No projects found. <a href="/admin/projects/new" class="text-brand-500 font-bold underline">Create your first engineering case study</a>.
      </div>
    <% } else { %>
      <!-- Mobile Card View (Zero Horizontal Scroll) -->
      <div class="md:hidden admin-table-body divide-y">
        <% projects.forEach(function(p) { %>
          <div class="p-4 space-y-3">
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0 flex-1">
                <a href="/admin/projects/<%= p.id %>/edit" class="hover:text-brand-500 transition block font-black text-slate-900 dark:text-white text-xs break-words">
                  <%= p.title %>
                </a>
                <span class="text-[10px] text-slate-400 font-mono font-normal break-all">/projects/<%= p.slug %></span>
              </div>
              <button 
                type="button" 
                onclick="toggleFeatured('<%= p.id %>', this)" 
                class="px-2.5 py-1 rounded-full text-[10px] font-black transition shrink-0 <%= p.featured ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-400 border border-emerald-500/30' : 'bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400 border border-slate-300 dark:border-slate-700' %>"
                title="Click to toggle featured status on homepage"
              >
                <%= p.featured ? '★ Featured' : '☆ Standard' %>
              </button>
            </div>
            <div class="flex flex-wrap items-center gap-1.5 text-[11px]">
              <span class="px-2 py-0.5 rounded-md text-[10px] font-bold admin-badge-category"><%= p.category %></span>
              <% if (p.industry) { %>
                <span class="text-slate-500"><%= p.industry %></span>
              <% } %>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase <%= p.status === 'completed' ? 'admin-badge-published' : 'admin-badge-draft' %>">
                <%= p.status %>
              </span>
            </div>
            <% if (p.techStack) { %>
              <p class="font-mono text-[10px] text-slate-600 dark:text-slate-400 break-words"><%= p.techStack %></p>
            <% } %>
            <div class="flex items-center justify-end gap-1.5 pt-1 text-xs">
              <a href="/projects/<%= p.slug %>" target="_blank" aria-label="View project" title="View Project" class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition inline-flex items-center justify-center">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              </a>
              <a href="/admin/projects/<%= p.id %>/edit" aria-label="Edit project" title="Edit Project" class="w-9 h-9 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-100 dark:hover:bg-emerald-900/60 transition inline-flex items-center justify-center">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
              </a>
              <form action="/admin/projects/<%= p.id %>/delete" method="POST" onsubmit="return confirm('Delete this project permanently?')" class="inline">
                <%- csrfField %>
                <button type="submit" aria-label="Delete project" title="Delete Project" class="w-9 h-9 !min-h-0 !min-w-0 rounded-xl bg-red-50 dark:bg-red-950/50 text-red-600 dark:text-red-400 hover:bg-red-100 dark:hover:bg-red-900/60 transition inline-flex items-center justify-center">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                </button>
              </form>
            </div>
          </div>
        <% }); %>
      </div>

      <!-- Desktop Table View -->
      <div class="hidden md:block overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="admin-table-head uppercase font-bold text-[11px] tracking-wider">
            <tr>
              <th class="p-4">Project Title</th>
              <th class="p-4">Category / Industry</th>
              <th class="p-4">Tech Stack</th>
              <th class="p-4 text-center">Featured</th>
              <th class="p-4">Status</th>
              <th class="p-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="admin-table-body divide-y">
            <% projects.forEach(function(p) { %>
              <tr class="transition">
                <td class="p-4 font-bold text-slate-900 dark:text-white max-w-xs">
                  <a href="/admin/projects/<%= p.id %>/edit" class="hover:text-brand-500 transition block font-black">
                    <%= p.title %>
                  </a>
                  <span class="text-[10px] text-slate-400 font-mono font-normal">/projects/<%= p.slug %></span>
                </td>
                <td class="p-4">
                  <span class="px-2.5 py-0.5 rounded-md text-[10px] font-bold admin-badge-category block w-fit mb-1">
                    <%= p.category %>
                  </span>
                  <span class="text-[11px] text-slate-500 truncate block"><%= p.industry %></span>
                </td>
                <td class="p-4 font-mono text-[11px] text-slate-700 dark:text-slate-300 max-w-xs truncate">
                  <%= p.techStack || '—' %>
                </td>
                <td class="p-4 text-center">
                  <button 
                    type="button" 
                    onclick="toggleFeatured('<%= p.id %>', this)" 
                    class="px-2.5 py-1 rounded-full text-[10px] font-black transition <%= p.featured ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-400 border border-emerald-500/30' : 'bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400 border border-slate-300 dark:border-slate-700' %>"
                    title="Click to toggle featured status on homepage"
                  >
                    <%= p.featured ? '★ Featured' : '☆ Standard' %>
                  </button>
                </td>
                <td class="p-4">
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase <%= p.status === 'completed' ? 'admin-badge-published' : 'admin-badge-draft' %>">
                    <%= p.status %>
                  </span>
                </td>
                <td class="p-4 text-right whitespace-nowrap">
                  <div class="inline-flex items-center justify-end gap-1.5">
                    <a href="/projects/<%= p.slug %>" target="_blank" aria-label="View project" title="View Project" class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition inline-flex items-center justify-center">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                    </a>
                    <a href="/admin/projects/<%= p.id %>/edit" aria-label="Edit project" title="Edit Project" class="w-9 h-9 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-100 dark:hover:bg-emerald-900/60 transition inline-flex items-center justify-center">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    </a>
                    <form action="/admin/projects/<%= p.id %>/delete" method="POST" onsubmit="return confirm('Delete this project permanently?')" class="inline">
                      <%- csrfField %>
                      <button type="submit" aria-label="Delete project" title="Delete Project" class="w-9 h-9 !min-h-0 !min-w-0 rounded-xl bg-red-50 dark:bg-red-950/50 text-red-600 dark:text-red-400 hover:bg-red-100 dark:hover:bg-red-900/60 transition inline-flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

</div>

<script>
  async function toggleFeatured(projectId, btn) {
    try {
      const res = await fetch(`/admin/projects/${projectId}/toggle-featured`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (data.success) {
        if (data.featured) {
          btn.textContent = '★ Featured';
          btn.className = 'px-2.5 py-1 rounded-full text-[10px] font-black transition bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-400 border border-emerald-500/30';
        } else {
          btn.textContent = '☆ Standard';
          btn.className = 'px-2.5 py-1 rounded-full text-[10px] font-black transition bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400 border border-slate-300 dark:border-slate-700';
        }
      }
    } catch (e) {
      alert('Error updating featured status');
    }
  }
</script>

<%- include('../layout_bottom') %>
