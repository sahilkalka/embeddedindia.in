<%- include('layout_top') %>

<div class="w-full space-y-6 min-w-0 [overflow-wrap:anywhere] mx-auto">
  
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="min-w-0 flex-1 basis-96">
      <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white">
        <span>📊 Lead / RFQ Pipeline &amp; Customer Inquiries</span>
      </h1>
      <p class="text-xs text-slate-500 mt-1">Track inbound RFQ leads through each lifecycle stage, export data, and verify outgoing notifications</p>
    </div>

    <!-- Top Action Buttons -->
    <div class="flex items-center flex-wrap gap-2">
      <a href="/admin/inquiries/export<%= selectedStatus ? '?status=' + selectedStatus : '' %>" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition shadow-sm flex items-center space-x-1.5 active:scale-95 whitespace-nowrap flex-shrink-0">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <span class="whitespace-nowrap flex-shrink-0">Export CSV</span>
      </a>

      <button type="button" id="openSmtpModalBtn" class="px-4 py-2 bg-slate-100 dark:bg-brand-surface hover:bg-slate-200 dark:hover:bg-brand-dark text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-brand-border rounded-xl text-xs font-bold transition shadow-sm flex items-center space-x-1.5 active:scale-95 whitespace-nowrap flex-shrink-0">
        <svg class="w-4 h-4 text-brand-500 dark:text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        <span class="whitespace-nowrap flex-shrink-0">Live SMTP Test</span>
      </button>
    </div>
  </div>

  <!-- Pipeline Stage Filters -->
  <div class="admin-pipeline flex items-center space-x-2 text-xs font-bold overflow-x-auto pb-2">
    <span class="text-slate-400 text-[11px] uppercase mr-1">Pipeline:</span>
    <a href="/admin/inquiries" class="px-3 py-1.5 rounded-xl transition whitespace-nowrap <%= !selectedStatus ? 'bg-brand-500 text-white shadow-sm' : 'bg-white dark:bg-brand-surface text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-brand-border' %>">
      All Leads (<%= inquiries.length %>)
    </a>
    <a href="/admin/inquiries?status=new" class="px-3 py-1.5 rounded-xl transition whitespace-nowrap <%= selectedStatus === 'new' ? 'bg-red-500 text-white shadow-sm' : 'bg-white dark:bg-brand-surface text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-brand-border' %>">
      New
    </a>
    <a href="/admin/inquiries?status=in_progress" class="px-3 py-1.5 rounded-xl transition whitespace-nowrap <%= selectedStatus === 'in_progress' ? 'bg-amber-500 text-white shadow-sm' : 'bg-white dark:bg-brand-surface text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-brand-border' %>">
      In Progress
    </a>
    <a href="/admin/inquiries?status=quoted" class="px-3 py-1.5 rounded-xl transition whitespace-nowrap <%= selectedStatus === 'quoted' ? 'bg-blue-500 text-white shadow-sm' : 'bg-white dark:bg-brand-surface text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-brand-border' %>">
      Quoted / Proposal Sent
    </a>
    <a href="/admin/inquiries?status=won" class="px-3 py-1.5 rounded-xl transition whitespace-nowrap <%= selectedStatus === 'won' ? 'bg-emerald-600 text-white shadow-sm' : 'bg-white dark:bg-brand-surface text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-brand-border' %>">
      Won / Closed
    </a>
    <a href="/admin/inquiries?status=archived" class="px-3 py-1.5 rounded-xl transition whitespace-nowrap <%= selectedStatus === 'archived' ? 'bg-slate-600 text-white shadow-sm' : 'bg-white dark:bg-brand-surface text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-brand-border' %>">
      Archived
    </a>
  </div>

  <% if (inquiries.length === 0) { %>
    <div class="bg-white dark:bg-brand-surface rounded-2xl p-12 text-center border border-slate-200 dark:border-brand-border">
      <p class="text-slate-500 text-sm">No RFQ inquiries found in this pipeline stage.</p>
    </div>
  <% } %>

  <div class="space-y-4">
    <% inquiries.forEach(inq => { %>
      <div class="bg-white dark:bg-brand-surface rounded-2xl p-6 border border-slate-200 dark:border-brand-border shadow-sm space-y-4">
        
        <div class="flex flex-wrap items-center justify-between pb-4 border-b border-slate-100 dark:border-brand-border gap-2">
          <div class="min-w-0 flex-1 basis-64">
            <div class="flex items-center space-x-3 flex-wrap gap-1">
              <h2 class="text-base font-extrabold text-slate-900 dark:text-white"><%= inq.name %></h2>
              <% if (inq.company) { %>
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">(<%= inq.company %>)</span>
              <% } %>
              
              <% 
                let badgeClass = 'bg-slate-100 text-slate-700';
                if (inq.status === 'new') badgeClass = 'bg-red-100 dark:bg-red-950/60 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-800';
                if (inq.status === 'in_progress') badgeClass = 'bg-amber-100 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800';
                if (inq.status === 'quoted') badgeClass = 'bg-blue-100 dark:bg-blue-950/60 text-blue-800 dark:text-blue-300 border border-blue-200 dark:border-blue-800';
                if (inq.status === 'won') badgeClass = 'bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800';
                if (inq.status === 'archived' || inq.status === 'resolved') badgeClass = 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700';
              %>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase <%= badgeClass %>">
                <%= (inq.status || 'new').replace('_', ' ') %>
              </span>
              <span class="text-xs text-brand-600 dark:text-accent font-semibold"><%= inq.serviceCategory || 'General Inquiry' %></span>
            </div>
            <p class="text-xs text-slate-400 mt-1">
              <%= new Date(inq.createdAt).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) %> &bull; IP: <%= inq.ipAddress || 'unknown' %>
            </p>
          </div>

          <!-- Pipeline Controls & Actions -->
          <div class="flex items-center flex-wrap gap-3">
            <a href="mailto:<%= inq.email %>?subject=Re:%20<%= encodeURIComponent(inq.subject || 'RFQ Inquiry - Embedded India') %>" class="px-3 py-1.5 bg-brand-50 dark:bg-brand-900/40 text-brand-700 dark:text-accent rounded-xl text-xs font-bold hover:bg-brand-100 transition shadow-xs whitespace-nowrap">
              Reply via Email
            </a>

            <!-- Pipeline Status Selector -->
            <form action="/admin/inquiries/<%= inq.id %>/status" method="POST" class="inline">
              <select name="status" aria-label="Pipeline stage for <%= inq.name %>" onchange="this.form.submit()" class="px-2.5 py-1.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-xs font-semibold text-slate-700 dark:text-slate-300 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="new" <%= inq.status === 'new' ? 'selected' : '' %>>Stage: New</option>
                <option value="in_progress" <%= inq.status === 'in_progress' ? 'selected' : '' %>>Stage: In Progress</option>
                <option value="quoted" <%= inq.status === 'quoted' ? 'selected' : '' %>>Stage: Quoted</option>
                <option value="won" <%= inq.status === 'won' ? 'selected' : '' %>>Stage: Won</option>
                <option value="archived" <%= (inq.status === 'archived' || inq.status === 'resolved') ? 'selected' : '' %>>Stage: Archived</option>
              </select>
            </form>

            <form action="/admin/inquiries/<%= inq.id %>/delete" method="POST" onsubmit="return confirm('Delete this inquiry?')" class="inline">
              <button type="submit" aria-label="Delete inquiry" class="p-1.5 text-slate-400 hover:text-red-600 transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              </button>
            </form>
          </div>
        </div>

        <div class="text-xs">
          <p>
            <strong>Email:</strong> <a href="mailto:<%= inq.email %>" class="text-brand-500 hover:underline"><%= inq.email %></a> 
            <% if (inq.phone) { %> &bull; <strong>Phone:</strong> <a href="tel:<%= inq.phone.replace(/[^0-9+]/g, '') %>" class="hover:underline"><%= inq.phone %></a> <% } %>
          </p>
          <p class="mt-1 font-bold text-slate-800 dark:text-slate-200">Subject: <%= inq.subject %></p>
          <div class="mt-2 p-3 bg-slate-50 dark:bg-brand-dark rounded-xl text-slate-700 dark:text-slate-300 whitespace-pre-wrap leading-relaxed font-sans">
            <%= inq.message %>
          </div>
        </div>

      </div>
    <% }) %>
  </div>

</div>

<!-- Quick SMTP Diagnostic Modal -->
<div id="smtpModal" aria-hidden="true" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="w-full max-w-md bg-white dark:bg-brand-surface rounded-2xl p-6 border border-slate-200 dark:border-brand-border shadow-2xl relative">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-brand-border">
      <h3 class="text-sm font-bold text-slate-900 dark:text-white">🚀 Dispatch Live SMTP Diagnostic Email</h3>
      <button type="button" id="closeSmtpModalBtn" class="text-slate-400 hover:text-slate-600 dark:hover:text-white text-sm font-bold font-mono">ESC</button>
    </div>
    
    <div class="mt-4 space-y-3">
      <div>
        <label for="quickSmtpTo" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Destination Email</label>
        <input type="email" id="quickSmtpTo" value="info@embeddedindia.in" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-xs text-slate-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-brand-500 font-mono">
      </div>

      <button type="button" id="triggerSmtpTestBtn" class="w-full py-2.5 bg-brand-500 hover:bg-brand-600 text-white rounded-xl text-xs font-bold transition shadow-sm active:scale-95">
        ⚡ Send Live Handshake Verification
      </button>

      <div id="smtpQuickResult" class="hidden p-3 rounded-xl text-xs font-mono"></div>
    </div>
  </div>
</div>

<script>
  const openBtn = document.getElementById('openSmtpModalBtn');
  const closeBtn = document.getElementById('closeSmtpModalBtn');
  const modal = document.getElementById('smtpModal');
  const sendBtn = document.getElementById('triggerSmtpTestBtn');
  const resultDiv = document.getElementById('smtpQuickResult');
  const emailInput = document.getElementById('quickSmtpTo');

  if (openBtn && modal) {
    openBtn.addEventListener('click', () => {
      modal.classList.remove('hidden');
      modal.setAttribute('aria-hidden', 'false');
    });
    closeBtn?.addEventListener('click', () => {
      modal.classList.add('hidden');
      modal.setAttribute('aria-hidden', 'true');
    });
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.classList.add('hidden');
    });
  }

  if (sendBtn) {
    sendBtn.addEventListener('click', async () => {
      sendBtn.disabled = true;
      resultDiv.className = 'p-3 rounded-xl text-xs font-mono bg-blue-50 dark:bg-blue-950/50 text-blue-800 dark:text-blue-300 border border-blue-200 dark:border-blue-800 block animate-pulse';
      resultDiv.innerHTML = 'Executing socket TLS handshake and sending test email to ' + emailInput.value + '...';

      try {
        const res = await fetch('/admin/settings/test-smtp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ toEmail: emailInput.value })
        });
        const data = await res.json();
        if (data.success) {
          resultDiv.className = 'p-3 rounded-xl text-xs font-mono bg-emerald-50 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 block';
          resultDiv.innerHTML = `<strong>✅ SMTP Success!</strong><br>${data.message}<br><span class="text-[10px] text-slate-500">ID: ${data.messageId}</span>`;
        } else {
          resultDiv.className = 'p-3 rounded-xl text-xs font-mono bg-red-50 dark:bg-red-950/50 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800 block';
          resultDiv.innerHTML = `<strong>❌ Handshake Failed:</strong><br>${data.error}`;
        }
      } catch (err) {
        resultDiv.className = 'p-3 rounded-xl text-xs font-mono bg-red-50 dark:bg-red-950/50 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800 block';
        resultDiv.innerHTML = `<strong>Network Error:</strong> ${err.message}`;
      } finally {
        sendBtn.disabled = false;
      }
    });
  }
</script>

<%- include('layout_bottom') %>
