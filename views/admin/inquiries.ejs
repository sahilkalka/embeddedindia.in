<%- include('layout_top') %>

<div class="space-y-6">
  
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white">Customer Consultation Inquiries</h1>
      <p class="text-xs text-slate-500 mt-1">Manage inbound hardware and firmware project leads</p>
    </div>

    <!-- Status Filter -->
    <div class="flex items-center space-x-2 text-xs font-bold">
      <a href="/admin/inquiries" class="px-3 py-1.5 rounded-xl transition <%= !selectedStatus ? 'bg-brand-500 text-white' : 'bg-white dark:bg-brand-surface text-slate-700 dark:text-slate-300' %>">All</a>
      <a href="/admin/inquiries?status=new" class="px-3 py-1.5 rounded-xl transition <%= selectedStatus === 'new' ? 'bg-brand-500 text-white' : 'bg-white dark:bg-brand-surface text-slate-700 dark:text-slate-300' %>">New</a>
      <a href="/admin/inquiries?status=in_progress" class="px-3 py-1.5 rounded-xl transition <%= selectedStatus === 'in_progress' ? 'bg-brand-500 text-white' : 'bg-white dark:bg-brand-surface text-slate-700 dark:text-slate-300' %>">In Progress</a>
      <a href="/admin/inquiries?status=resolved" class="px-3 py-1.5 rounded-xl transition <%= selectedStatus === 'resolved' ? 'bg-brand-500 text-white' : 'bg-white dark:bg-brand-surface text-slate-700 dark:text-slate-300' %>">Resolved</a>
    </div>
  </div>

  <% if (inquiries.length === 0) { %>
    <div class="bg-white dark:bg-brand-surface rounded-2xl p-12 text-center border border-slate-200 dark:border-brand-border">
      <p class="text-slate-500 text-sm">No inquiries found in this category.</p>
    </div>
  <% } %>

  <div class="space-y-4">
    <% inquiries.forEach(inq => { %>
      <div class="bg-white dark:bg-brand-surface rounded-2xl p-6 border border-slate-200 dark:border-brand-border shadow-sm space-y-4">
        
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 dark:border-brand-border gap-2">
          <div>
            <div class="flex items-center space-x-3">
              <h2 class="text-base font-extrabold text-slate-900 dark:text-white"><%= inq.name %></h2>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase <%= inq.status === 'new' ? 'bg-red-100 text-red-700' : inq.status === 'in_progress' ? 'bg-yellow-100 text-yellow-800' : 'bg-emerald-100 text-emerald-800' %>">
                <%= inq.status.replace('_', ' ') %>
              </span>
              <span class="text-xs text-brand-600 dark:text-accent font-semibold"><%= inq.serviceCategory %></span>
            </div>
            <p class="text-xs text-slate-400 mt-0.5">
              <%= new Date(inq.createdAt).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) %> &bull; IP: <%= inq.ipAddress || 'unknown' %>
            </p>
          </div>

          <!-- Actions -->
          <div class="flex items-center space-x-3">
            <a href="mailto:<%= inq.email %>?subject=Re:%20<%= encodeURIComponent(inq.subject) %>" class="px-3 py-1.5 bg-brand-50 dark:bg-brand-900/40 text-brand-700 dark:text-accent rounded-xl text-xs font-bold hover:bg-brand-100 transition">
              Reply via Email
            </a>

            <!-- Update Status Form -->
            <form action="/admin/inquiries/<%= inq.id %>/status" method="POST" class="inline">
              <select name="status" onchange="this.form.submit()" class="px-2.5 py-1.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-xs font-semibold text-slate-700 dark:text-slate-300">
                <option value="new" <%= inq.status === 'new' ? 'selected' : '' %>>Mark New</option>
                <option value="in_progress" <%= inq.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
                <option value="resolved" <%= inq.status === 'resolved' ? 'selected' : '' %>>Resolved</option>
              </select>
            </form>

            <form action="/admin/inquiries/<%= inq.id %>/delete" method="POST" onsubmit="return confirm('Delete this inquiry?')" class="inline">
              <button type="submit" class="p-1.5 text-slate-400 hover:text-red-600 transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              </button>
            </form>
          </div>
        </div>

        <div class="text-xs">
          <p><strong>Email:</strong> <a href="mailto:<%= inq.email %>" class="text-brand-500 hover:underline"><%= inq.email %></a> <% if (inq.phone) { %> &bull; <strong>Phone:</strong> <%= inq.phone %> <% } %></p>
          <p class="mt-1 font-bold text-slate-800 dark:text-slate-200">Subject: <%= inq.subject %></p>
          <div class="mt-2 p-3 bg-slate-50 dark:bg-brand-dark rounded-xl text-slate-700 dark:text-slate-300 whitespace-pre-wrap leading-relaxed">
            <%= inq.message %>
          </div>
        </div>

      </div>
    <% }) %>
  </div>

</div>

<%- include('layout_bottom') %>
