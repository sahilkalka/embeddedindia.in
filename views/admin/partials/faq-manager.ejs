<section id="faq-manager" class="settings-section hidden p-6 sm:p-8 space-y-6">
  <form class="settings-module-form space-y-6" action="/admin/settings" method="POST" data-module="Homepage FAQs" id="faqManagerForm">
    <input type="hidden" id="custom_faqs" name="custom_faqs" value="<%= settings.custom_faqs || '[]' %>">
    <div class="module-heading flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-100 dark:border-brand-border pb-4 gap-3">
      <div><h2 class="text-lg font-black text-slate-900 dark:text-white flex items-center space-x-2"><span>💬 Homepage FAQs</span></h2><p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Add questions below the existing homepage FAQs. Edit, reorder, or remove entries, then save to publish.</p></div>
      <div class="flex items-center space-x-2 flex-shrink-0"><%- include('module-save-button', { label: 'Save FAQs' }) %></div>
    </div>
    <div id="faqEditorRows" class="space-y-4"></div>
    <button type="button" id="addFaqRow" class="inline-flex items-center px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-brand-dark text-xs font-bold text-brand-700 dark:text-accent">+ Add FAQ</button>
    <p id="faqEditorStatus" class="text-sm text-slate-600 dark:text-slate-300" aria-live="polite"></p>
  </form>
</section>
<script src="/js/faq-manager.js?v=2" defer></script>
