<section id="newsletter-config" aria-labelledby="newsletter-config-title" class="settings-section hidden">

      <form class="settings-module-form space-y-6" action="/admin/settings" method="POST" data-module="Newsletter Configuration">
        <%- csrfField %>
        <input type="hidden" name="_active_tab" value="newsletter-config">

        <%- include('../settings-module-header', {"sectionId":"newsletter-config","title":"Newsletter","icon":"mail","description":"Set digest frequency, topics, categories, and subscriber notifications.","saveLabel":"Save Newsletter Settings","actions":[{"id":"btnTriggerDigest","handler":"triggerNewsletterDigest()","icon":"forward_to_inbox","label":"Test send"}]}) %>

        <div class="settings-panel space-y-4"><h3 class="settings-panel-title">Digest preferences</h3>
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
          <!-- Frequency -->
          <div>
            <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1" for="newsletter-config-newsletter_frequency">Digest Dispatch Frequency</label>
            <select id="newsletter-config-newsletter_frequency" name="newsletter_frequency" class="w-full px-3 py-2.5 rounded-xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700 font-semibold">
              <option value="daily" <%= settings.newsletter_frequency === 'daily' ? 'selected' : '' %>>Daily Digest (Past 24h Posts)</option>
              <option value="weekly" <%= (!settings.newsletter_frequency || settings.newsletter_frequency === 'weekly') ? 'selected' : '' %>>Weekly Digest (Past 7 Days - Recommended)</option>
              <option value="bi-weekly" <%= settings.newsletter_frequency === 'bi-weekly' ? 'selected' : '' %>>Bi-Weekly Digest (Past 14 Days)</option>
              <option value="monthly" <%= settings.newsletter_frequency === 'monthly' ? 'selected' : '' %>>Monthly Digest (Past 30 Days)</option>
            </select>
          </div>

          <!-- Topic Focus -->
          <div>
            <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1" for="newsletter-config-newsletter_topic">Primary Newsletter Topic / Subject Header</label>
            <input id="newsletter-config-newsletter_topic" type="text" name="newsletter_topic" value="<%= settings.newsletter_topic || 'Embedded Systems, RTOS & High-Speed Hardware Design' %>" placeholder="Embedded Systems & Hardware" class="w-full px-3 py-2.5 rounded-xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700 font-medium">
          </div>

          <!-- Category Filter -->
          <div>
            <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1" for="newsletter-config-newsletter_category">Post Category Filter</label>
            <select id="newsletter-config-newsletter_category" name="newsletter_category" class="w-full px-3 py-2.5 rounded-xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700 font-semibold">
              <option value="all" <%= (!settings.newsletter_category || settings.newsletter_category === 'all') ? 'selected' : '' %>>All Categories (Curated Highlights)</option>
              <option value="firmware" <%= settings.newsletter_category === 'firmware' ? 'selected' : '' %>>Firmware &amp; RTOS</option>
              <option value="hardware" <%= settings.newsletter_category === 'hardware' ? 'selected' : '' %>>High-Speed PCB Layout</option>
              <option value="iot" <%= settings.newsletter_category === 'iot' ? 'selected' : '' %>>IoT &amp; Wireless</option>
            </select>
          </div>
        </div>
</div>

        <!-- Editorial Intro Content -->
        <div class="settings-panel text-xs space-y-3">
          <label class="block font-semibold text-slate-700 dark:text-slate-300" for="newsletter-config-newsletter_intro_content">Newsletter Editorial Intro Message</label>
          <textarea id="newsletter-config-newsletter_intro_content" name="newsletter_intro_content" rows="3" placeholder="Custom greeting and editor commentary sent above the curated articles list..." class="w-full px-3.5 py-2.5 rounded-xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700 font-medium"><%= settings.newsletter_intro_content || 'Here are the latest engineering guides, embedded firmware patterns, and hardware architectures curated by our engineering lab:' %></textarea>
        </div>

        <div id="digestTriggerResult" class="hidden p-3 rounded-xl text-xs font-mono"></div>

        <!-- Link to subscriber management -->
        <div class="settings-panel p-4 rounded-2xl bg-slate-50 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 flex items-center justify-between text-xs">
          <div>
            <h3 class="settings-panel-title">Subscriber audience</h3>
            <span class="text-slate-500 dark:text-slate-400">Manage, export, and review confirmed double opt-in subscribers</span>
          </div>
          <a href="/admin/subscribers" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-white rounded-xl font-bold transition">
            Manage Subscribers &rarr;
          </a>
        </div>

        <div class="settings-module-footer">
          <%- include('../module-save-button', { label: "Save Newsletter Settings" }) %>
        </div>
      </form>
    </section>
