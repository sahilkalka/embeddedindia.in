<!DOCTYPE html>
<html lang="en" class="overflow-x-hidden max-w-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - Embedded India</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <script>
    if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
    const savedPalette = localStorage.getItem('color-palette') || 'emerald';
    document.documentElement.setAttribute('data-palette', savedPalette);
  </script>
</head>
<body class="bg-slate-100 dark:bg-[#090d16] text-slate-900 dark:text-slate-100 font-sans min-h-screen flex flex-col antialiased transition-colors duration-200 overflow-x-hidden max-w-full">

  <!-- Top Admin Bar -->
  <header class="sticky top-0 z-50 bg-white/95 dark:bg-slate-900 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 transition-colors shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      
      <!-- Brand & Admin Badge -->
      <div class="flex items-center space-x-3">
        <a href="/admin" class="flex items-center space-x-2.5 group">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-brand-600 via-brand-500 to-accent p-0.5 shadow-sm">
            <div class="w-full h-full bg-white dark:bg-slate-900 rounded-[6px] flex items-center justify-center p-1.5 transition">
              <svg class="w-full h-full text-brand-600 dark:text-accent" viewBox="0 0 32 32" fill="currentColor">
                <path d="M16 3C16.8 3 17.5 3.4 18 4.2L28.5 21.8C29.2 23 28.7 24.5 27.5 25.2C27.1 25.4 26.6 25.5 26.1 25.5H19.8C18.7 25.5 17.7 24.8 17.3 23.8L16 20.3L14.7 23.8C14.3 24.8 13.3 25.5 12.2 25.5H5.9C4.5 25.5 3.4 24.4 3.4 23C3.4 22.5 3.5 22.1 3.8 21.8L14 4.2C14.5 3.4 15.2 3 16 3Z"/>
              </svg>
            </div>
          </div>
          <span class="text-base font-black tracking-tight text-slate-900 dark:text-white flex items-center">
            <span>Embedded</span>
            <span class="text-brand-600 dark:text-accent font-black ml-1">India</span>
          </span>
          <span class="text-[10px] bg-brand-500/10 dark:bg-accent/20 text-brand-700 dark:text-accent font-extrabold px-2 py-0.5 rounded uppercase tracking-wider border border-brand-500/20">
            Admin
          </span>
        </a>
      </div>

      <!-- Navigation Tabs (Desktop) -->
      <nav class="hidden lg:flex items-center space-x-1 text-xs font-bold">
        <a href="/admin" class="px-3 py-1.5 rounded-lg transition <%= currentPath === '/admin' ? 'bg-brand-500 text-white font-extrabold shadow-sm' : 'text-slate-700 dark:text-slate-300 hover:text-brand-600 dark:hover:text-accent hover:bg-slate-100 dark:hover:bg-slate-800' %>">
          Overview
        </a>
        <a href="/admin/inquiries" class="px-3 py-1.5 rounded-lg transition <%= currentPath.startsWith('/admin/inquiries') ? 'bg-brand-500 text-white font-extrabold shadow-sm' : 'text-slate-700 dark:text-slate-300 hover:text-brand-600 dark:hover:text-accent hover:bg-slate-100 dark:hover:bg-slate-800' %>">
          Inquiries
        </a>
        <a href="/admin/subscribers" class="px-3 py-1.5 rounded-lg transition <%= currentPath.startsWith('/admin/subscribers') ? 'bg-brand-500 text-white font-extrabold shadow-sm' : 'text-slate-700 dark:text-slate-300 hover:text-brand-600 dark:hover:text-accent hover:bg-slate-100 dark:hover:bg-slate-800' %>">
          Subscribers
        </a>
        <a href="/admin/posts" class="px-3 py-1.5 rounded-lg transition <%= currentPath.startsWith('/admin/posts') ? 'bg-brand-500 text-white font-extrabold shadow-sm' : 'text-slate-700 dark:text-slate-300 hover:text-brand-600 dark:hover:text-accent hover:bg-slate-100 dark:hover:bg-slate-800' %>">
          Blog Posts
        </a>
        <a href="/admin/ai" class="px-3 py-1.5 rounded-lg transition flex items-center space-x-1 <%= currentPath.startsWith('/admin/ai') ? 'bg-brand-500 text-white font-extrabold shadow-sm' : 'text-brand-600 dark:text-accent font-extrabold hover:bg-brand-50 dark:hover:bg-slate-800' %>">
          <span>✨ AI Engine</span>
        </a>
        <a href="/admin/settings" class="px-3 py-1.5 rounded-lg transition <%= currentPath.startsWith('/admin/settings') ? 'bg-brand-500 text-white font-extrabold shadow-sm' : 'text-slate-700 dark:text-slate-300 hover:text-brand-600 dark:hover:text-accent hover:bg-slate-100 dark:hover:bg-slate-800' %>">
          Settings &amp; Accounts
        </a>
      </nav>

      <!-- Right Header Actions: Theme Toggle, Palette Switcher, View Site & Sign Out -->
      <div class="flex items-center space-x-2 sm:space-x-2.5 text-xs">
        
        <!-- Compact Palette Switcher: Emerald, Cyan, Space Grey -->
        <div class="relative" id="admin-palette-dropdown-wrapper">
          <button id="admin-palette-dropdown-btn" type="button" aria-label="Select accent color" aria-expanded="false" class="p-1.5 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg border border-slate-200 dark:border-slate-700 focus:outline-none transition shadow-sm active:scale-95 flex items-center space-x-1" title="Accent Color Scheme">
            <svg class="w-3.5 h-3.5 text-slate-600 dark:text-slate-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle>
              <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle>
              <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle>
              <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle>
              <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.563-2.512 5.563-5.563C22 6.5 17.5 2 12 2z"></path>
            </svg>
            <span id="admin-active-scheme-dot" class="w-2 h-2 rounded-full transition-colors duration-200" style="background-color: #007f5f;"></span>
          </button>

          <!-- Floating Dropdown Menu -->
          <div id="admin-palette-dropdown-menu" class="hidden absolute right-0 mt-2 w-44 rounded-xl shadow-2xl py-1 z-50 palette-dropdown-panel animate-in fade-in zoom-in-95 duration-150">
            <div class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider palette-header-label">
              Accent Scheme
            </div>
            <button type="button" data-scheme="emerald" class="palette-btn w-full px-2.5 py-1.5 text-left text-xs font-semibold flex items-center justify-between transition rounded-md">
              <span class="flex items-center space-x-2">
                <span class="w-2.5 h-2.5 rounded-full bg-[#007f5f]"></span>
                <span>Cyber Emerald</span>
              </span>
              <span class="scheme-check hidden text-[#007f5f] font-bold text-xs">✓</span>
            </button>
            <button type="button" data-scheme="cyan" class="palette-btn w-full px-2.5 py-1.5 text-left text-xs font-semibold flex items-center justify-between transition rounded-md">
              <span class="flex items-center space-x-2">
                <span class="w-2.5 h-2.5 rounded-full bg-[#0284c7]"></span>
                <span>Quantum Cyan</span>
              </span>
              <span class="scheme-check hidden text-[#0284c7] font-bold text-xs">✓</span>
            </button>
            <button type="button" data-scheme="spacegrey" class="palette-btn w-full px-2.5 py-1.5 text-left text-xs font-semibold flex items-center justify-between transition rounded-md">
              <span class="flex items-center space-x-2">
                <span class="w-2.5 h-2.5 rounded-full bg-[#475569]"></span>
                <span>Space Grey</span>
              </span>
              <span class="scheme-check hidden text-[#475569] font-bold text-xs">✓</span>
            </button>
          </div>
        </div>

        <!-- Dark / Light Theme Toggle -->
        <button id="theme-toggle" type="button" aria-label="Toggle theme" class="p-1.5 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg border border-slate-200 dark:border-slate-700 focus:outline-none transition shadow-sm active:scale-95">
          <svg id="theme-toggle-dark-icon" class="hidden w-4 h-4 text-slate-700" fill="currentColor" viewBox="0 0 20 20">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
          </svg>
          <svg id="theme-toggle-light-icon" class="hidden w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
          </svg>
        </button>

        <a href="/" target="_blank" class="hidden sm:inline-flex px-3 py-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 rounded-lg transition font-bold border border-slate-200 dark:border-slate-700">
          View Site &rarr;
        </a>
        <a href="/admin/logout" class="px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white rounded-lg transition font-bold shadow-sm">
          Sign Out
        </a>
      </div>

    </div>

    <!-- Mobile Sub-Navigation Bar for Small Screens -->
    <div class="lg:hidden flex items-center space-x-2 px-4 py-2 bg-slate-50 dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800 text-[11px] font-bold overflow-x-auto whitespace-nowrap">
      <a href="/admin" class="px-2.5 py-1 rounded-md transition <%= currentPath === '/admin' ? 'bg-brand-500 text-white' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800' %>">Overview</a>
      <a href="/admin/inquiries" class="px-2.5 py-1 rounded-md transition <%= currentPath.startsWith('/admin/inquiries') ? 'bg-brand-500 text-white' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800' %>">Inquiries</a>
      <a href="/admin/subscribers" class="px-2.5 py-1 rounded-md transition <%= currentPath.startsWith('/admin/subscribers') ? 'bg-brand-500 text-white' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800' %>">Subscribers</a>
      <a href="/admin/posts" class="px-2.5 py-1 rounded-md transition <%= currentPath.startsWith('/admin/posts') ? 'bg-brand-500 text-white' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800' %>">Posts</a>
      <a href="/admin/ai" class="px-2.5 py-1 rounded-md transition flex items-center space-x-1 <%= currentPath.startsWith('/admin/ai') ? 'bg-brand-500 text-white' : 'text-brand-600 dark:text-accent hover:bg-slate-200 dark:hover:bg-slate-800' %>">
        <span>✨ AI Engine</span>
      </a>
      <a href="/admin/settings" class="px-2.5 py-1 rounded-md transition <%= currentPath.startsWith('/admin/settings') ? 'bg-brand-500 text-white' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800' %>">Settings</a>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-8 w-full flex-grow">
