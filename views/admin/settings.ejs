<%- include('layout_top') %>

<%- include('partials/settings-styles') %>

<div class="w-full mx-auto space-y-6 pb-20">

  <!-- Global Toast Notification Banner for AJAX Saves -->
  <div id="settingsToast" class="hidden fixed bottom-6 right-6 z-50 p-4 rounded-2xl bg-emerald-600 text-white shadow-2xl text-xs font-bold flex items-center space-x-2.5 animate-in fade-in slide-in-from-bottom duration-200">
    <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
    <span id="settingsToastMsg">Module settings updated and applied live!</span>
  </div>

  <% if (success) { %>
    <div class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-xs font-bold flex items-center space-x-2 shadow-sm">
      <svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
      <span>Settings configuration successfully updated and synced across all pages.</span>
    </div>
  <% } %>

  <!-- Taskbar-style settings navigation -->
  <div class="settings-workspace flex flex-col lg:flex-row rounded-3xl border border-slate-200 dark:border-slate-700 shadow-sm">
    <%- include('partials/settings-nav') %>

    <!-- RIGHT CONTENT AREA -->
    <div class="settings-content flex-1 min-w-0">

    <!-- ============================================================== -->
    <!-- MODULE 1: DYNAMIC THEME & COLOR PALETTE ENGINE (SIDE-BY-SIDE) -->
    <!-- ============================================================== -->
    <%- include('partials/faq-manager') %>
<section id="site-customizer" class="settings-section hidden bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-sm space-y-6">
      
      <form class="settings-module-form space-y-6" action="/admin/settings" method="POST" data-module="Customizer &amp; Events">
        <input type="hidden" name="_active_tab" value="site-customizer">

        <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-100 dark:border-brand-border pb-4 gap-3">
          <div>
            <h2 class="text-lg font-black text-slate-900 dark:text-white flex items-center space-x-2">
              <span>🎛️ No-Code Site Customizer &amp; Lab Events</span>
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Control live hardware status pill, telemetry banner, typography, navigation behavior, and promo copy.</p>
          </div>
          <div class="flex items-center space-x-2 flex-shrink-0">
            <button type="submit" title="Save Customizer &amp; Events" aria-label="Save Customizer &amp; Events" class="nav-icon-link group flex flex-col items-center justify-center min-w-[56px] sm:min-w-[62px] py-1.5 px-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-800/60 text-slate-700 dark:text-slate-200 hover:text-brand-600 dark:hover:text-accent hover:bg-slate-100 dark:hover:bg-slate-800 shadow-xs hover:border-slate-300 dark:hover:border-slate-600 transition cursor-pointer flex-shrink-0">
              <span class="material-symbols-rounded text-xl transition-transform duration-200 group-hover:scale-110 flex-shrink-0" aria-hidden="true">save</span>
              <span class="text-[11px] font-bold tracking-tight mt-0.5 whitespace-nowrap leading-tight">Save</span>
            </button>
          </div>
        </div>

        <!-- 2A. Bangalore Lab Live Event & Telemetry Pill Controls -->
        <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <span class="text-xs font-black uppercase text-slate-900 dark:text-white flex items-center space-x-1.5">
                <span>⚡ Bangalore Hardware Lab Event &amp; Status Controls</span>
              </span>
              <p class="text-[11px] text-slate-500 mt-0.5">Controls the header status pill and the public homepage telemetry ticker.</p>
            </div>
            
            <!-- Event Enabled Toggle -->
            <div class="flex items-center space-x-2">
              <span class="text-xs font-bold text-slate-600 dark:text-slate-400">Status Pill:</span>
              <%- include('../partials/theme-toggle', {
                name: 'lab_event_enabled',
                id: 'lab_event_enabled',
                checked: settings.lab_event_enabled !== 'false',
                onChange: 'updateEventPreview',
                onLabel: 'Enabled',
                offLabel: 'Disabled',
                label: 'Bangalore Lab Status Pill',
                showBadge: true
              }) %>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
            <div>
              <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Short Pill Label (Navbar)</label>
              <input type="text" id="lab_event_label" name="lab_event_label" value="<%= settings.lab_event_label || 'Bangalore Lab: Online' %>" oninput="updateEventPreview()" placeholder="Bangalore Lab: Online" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 text-xs font-medium">
              <span class="text-[10px] text-slate-400">Keep under 25 chars to prevent navbar stretching</span>
            </div>

            <div class="sm:col-span-2">
              <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Full Status Text (Homepage Telemetry Ticker &amp; Tooltip)</label>
              <input type="text" id="lab_status_text" name="lab_status_text" value="<%= settings.lab_status_text || 'Bangalore Lab: Online • 4 Active SMT Lines • HIL Station #2 Active' %>" oninput="updateEventPreview()" placeholder="Bangalore Lab: Online • 4 Active SMT Lines • HIL Station #2 Active" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 text-xs font-mono">
            </div>

            <div class="sm:col-span-3">
              <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Event Target Click URL</label>
              <input type="text" id="lab_event_url" name="lab_event_url" value="<%= settings.lab_event_url || '/about#lab' %>" placeholder="/about#lab or /services" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 text-xs font-mono">
            </div>
          </div>

          <!-- Live Event Pill Mockup -->
          <div class="pt-2 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between">
            <span class="text-[11px] font-bold text-slate-500">Live Header Preview:</span>
            <div id="eventPillMockup" class="inline-flex items-center space-x-2 px-3 py-1 bg-brand-500/10 dark:bg-accent/15 border border-brand-500/20 rounded-full text-[11px] font-bold text-brand-700 dark:text-accent shadow-xs">
              <span class="w-2 h-2 rounded-full bg-brand-500 dark:bg-accent live-radar"></span>
              <span id="eventPillText" class="truncate max-w-xs"><%= settings.lab_event_label || 'Bangalore Lab: Online' %></span>
            </div>
          </div>
        </div>

        <!-- 2B. Core Site Branding & Copy -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
          <div>
            <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Site Brand Name</label>
            <input type="text" name="site_name" value="<%= settings.site_name || 'Embedded India' %>" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700 font-bold">
          </div>
          <div>
            <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Site Tagline</label>
            <input type="text" name="site_tagline" value="<%= settings.site_tagline || 'Turnkey Hardware & Firmware Engineering Lab' %>" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700 font-medium">
          </div>
          <div>
            <label for="btn_nav_sticky" class="block font-semibold text-slate-700 dark:text-slate-300 mb-2 cursor-pointer">Header Navigation Style</label>
            <div class="mt-1">
              <%- include('../partials/theme-toggle', {
                name: 'nav_sticky',
                id: 'nav_sticky',
                checked: settings.nav_sticky !== 'false',
                onLabel: 'Sticky Header',
                offLabel: 'Static Header',
                label: 'Header Navigation Style',
                showBadge: true
              }) %>
            </div>
          </div>
          <div>
            <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Sticky Header Transparency</label>
            <div class="flex items-center space-x-2">
              <input type="range" id="header_opacity_slider" min="10" max="100" step="5" value="<%= settings.header_opacity || '95' %>" oninput="document.getElementById('header_opacity_input').value = this.value; document.getElementById('header_opacity_val').textContent = this.value + '%';" class="w-full accent-brand-500 cursor-pointer">
              <input type="hidden" id="header_opacity_input" name="header_opacity" value="<%= settings.header_opacity || '95' %>">
              <span id="header_opacity_val" class="text-xs font-mono font-bold text-brand-600 dark:text-accent min-w-[42px] text-right"><%= settings.header_opacity || '95' %>%</span>
            </div>
            <span class="text-[10px] text-slate-400">100% = solid opaque, 95% = frosted glass (default), 50% = semi-transparent</span>
          </div>
          <div>
            <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Site Container Max Width</label>
            <select name="container_max_width" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700 text-xs font-medium cursor-pointer">
              <option value="80rem" <%= (!settings.container_max_width || settings.container_max_width === '80rem' || settings.container_max_width === '1280px') ? 'selected' : '' %>>80rem / 1280px (Standard Default)</option>
              <option value="85rem" <%= settings.container_max_width === '85rem' ? 'selected' : '' %>>85rem / 1360px (Comfortable Wide)</option>
              <option value="90rem" <%= settings.container_max_width === '90rem' ? 'selected' : '' %>>90rem / 1440px (Spacious Desktop)</option>
              <option value="96rem" <%= settings.container_max_width === '96rem' ? 'selected' : '' %>>96rem / 1536px (Ultra-Wide Screen)</option>
              <option value="72rem" <%= settings.container_max_width === '72rem' ? 'selected' : '' %>>72rem / 1152px (Compact Focused)</option>
              <option value="100%" <%= settings.container_max_width === '100%' ? 'selected' : '' %>>100% (Full Fluid Width)</option>
            </select>
            <span class="text-[10px] text-slate-400">Adjusts max width across navbar, hero cards, and sections</span>
          </div>
          <div>
            <label for="btn_enable_smooth_scroll" class="block font-semibold text-slate-700 dark:text-slate-300 mb-2 cursor-pointer">Smooth Scrolling</label>
            <div class="mt-1">
              <%- include('../partials/theme-toggle', {
                name: 'enable_smooth_scroll',
                id: 'enable_smooth_scroll',
                checked: settings.enable_smooth_scroll !== 'false',
                onLabel: 'Enabled',
                offLabel: 'Disabled',
                label: 'Smooth Scrolling',
                showBadge: true
              }) %>
            </div>
          </div>
          <div>
            <label for="btn_promo_banner_active" class="block font-semibold text-slate-700 dark:text-slate-300 mb-2 cursor-pointer">Global Promo Announcement Bar</label>
            <div class="mt-1">
              <%- include('../partials/theme-toggle', {
                name: 'promo_banner_active',
                id: 'promo_banner_active',
                checked: settings.promo_banner_active === 'true',
                onLabel: 'Active (Show)',
                offLabel: 'Hidden',
                label: 'Global Promo Announcement Bar',
                showBadge: true
              }) %>
            </div>
          </div>
          <div>
            <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Footer Copyright Text</label>
            <input type="text" name="footer_copyright" value="<%= settings.footer_copyright || 'Embedded India. Precision Electronics & Systems Engineering.' %>" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700">
          </div>
        </div>

                <!-- 2C. Public Contact Desk, Engineering Centers & SLA -->
        <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <span class="text-xs font-black uppercase text-slate-900 dark:text-white flex items-center space-x-1.5">
                <span>📍 Public Contact Desk &amp; Engineering Centers</span>
              </span>
              <p class="text-[11px] text-slate-500 mt-0.5">Configures public contact channels, physical engineering centers, WhatsApp line, and SLA across the site.</p>
            </div>
            <span class="text-[10px] px-2.5 py-0.5 rounded-full font-bold bg-brand-500/10 text-brand-600 dark:text-accent border border-brand-500/20">
              Live Synchronized
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            <!-- 1. Email Inquiries & RFQs -->
            <div>
              <label class="block font-bold text-slate-800 dark:text-slate-200 mb-1 flex items-center space-x-1.5">
                <span>✉️ Email Inquiries &amp; RFQs</span>
              </label>
              <input type="email" id="contact_email" name="contact_email" value="<%= settings.contact_email || 'info@embeddedindia.in' %>" placeholder="info@embeddedindia.in" class="w-full px-3.5 py-2.5 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 text-xs font-mono text-slate-900 dark:text-white focus:ring-1 focus:ring-brand-500">
              <span class="text-[10px] text-slate-400">Primary public email displayed across contact page, footer, and inquiry forms</span>
            </div>

            <div class="sm:col-span-2"><label for="calendly_url" class="block font-bold text-slate-800 dark:text-slate-200 mb-1">Meeting booking URL</label><input type="url" id="calendly_url" name="calendly_url" value="<%= settings.calendly_url || '' %>" placeholder="https://calendly.com/your-team/architecture-review" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 text-xs"><span class="text-[10px] text-slate-500">Leave blank to hide the booking card. Use your own HTTPS booking page.</span></div>
<!-- 2. Engineering Centers -->
            <div>
              <label class="block font-bold text-slate-800 dark:text-slate-200 mb-1 flex items-center space-x-1.5">
                <span>🏢 Engineering Centers</span>
              </label>
              <input type="text" id="contact_address" name="contact_address" value="<%= settings.contact_address || 'Hyderabad, India' %>" placeholder="Hyderabad, India" class="w-full px-3.5 py-2.5 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 text-xs text-slate-900 dark:text-white focus:ring-1 focus:ring-brand-500">
              <span class="text-[10px] text-slate-400">Physical lab locations shown in Contact, Footer, and Schema.org SEO data</span>
            </div>

            <!-- 3. Direct Line / WhatsApp -->
            <div>
              <label class="block font-bold text-slate-800 dark:text-slate-200 mb-1 flex items-center space-x-1.5">
                <span>📞 Direct Line / WhatsApp</span>
              </label>
              <input type="text" id="contact_phone" name="contact_phone" value="<%= settings.contact_phone || '+91 98765 43210' %>" placeholder="+91 98765 43210" class="w-full px-3.5 py-2.5 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 text-xs font-mono text-slate-900 dark:text-white focus:ring-1 focus:ring-brand-500">
              <span class="text-[10px] text-slate-400">Telephone and WhatsApp routing number for rapid client dispatch</span>
            </div>

            <!-- 4. Turnaround SLA -->
            <div>
              <label class="block font-bold text-slate-800 dark:text-slate-200 mb-1 flex items-center space-x-1.5">
                <span>⏱️ Turnaround SLA</span>
              </label>
              <input type="text" id="contact_turnaround_sla" name="contact_turnaround_sla" value="<%= settings.contact_turnaround_sla || 'Technical reply and feasibility review within 24 business hours' %>" placeholder="Technical reply and feasibility review within 24 business hours" class="w-full px-3.5 py-2.5 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 text-xs text-slate-900 dark:text-white focus:ring-1 focus:ring-brand-500">
              <span class="text-[10px] text-slate-400">Guaranteed review SLA displayed directly on the Contact Us desk</span>
            </div>
          </div>
        </div>

        <div class="pt-2 flex justify-end">
          <button type="submit" title="Save Customizer &amp; Events" aria-label="Save Customizer &amp; Events" class="nav-icon-link group flex flex-col items-center justify-center min-w-[56px] sm:min-w-[62px] py-1.5 px-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-800/60 text-slate-700 dark:text-slate-200 hover:text-brand-600 dark:hover:text-accent hover:bg-slate-100 dark:hover:bg-slate-800 shadow-xs hover:border-slate-300 dark:hover:border-slate-600 transition cursor-pointer flex-shrink-0">
            <span class="material-symbols-rounded text-xl transition-transform duration-200 group-hover:scale-110 flex-shrink-0" aria-hidden="true">save</span>
            <span class="text-[11px] font-bold tracking-tight mt-0.5 whitespace-nowrap leading-tight">Save</span>
          </button>
        </div>
      </form>
    </section>

    <!-- ============================================================== -->
    <!-- MODULE 3: MODULAR SECTION FEATURE FLAGS & LIVE HOMEPAGE PREVIEW -->
    <!-- ============================================================== -->
    <section id="feature-flags" class="settings-section hidden bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-sm space-y-6">
      
      <form class="settings-module-form space-y-6" action="/admin/settings" method="POST" data-module="Feature Flags">
        <input type="hidden" name="_active_tab" value="feature-flags">

        <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-100 dark:border-brand-border pb-4 gap-3">
          <div>
            <h2 class="text-lg font-black text-slate-900 dark:text-white flex items-center space-x-2">
              <span>🚩 Modular Section Feature Flags &amp; Live Homepage Preview</span>
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Toggle homepage sections on or off. The real homepage preview on the right visually updates and allows testing across Desktop, Tablet, and Mobile viewports.</p>
          </div>
          <div class="flex items-center space-x-2 flex-shrink-0">
            <button type="submit" title="Save Feature Flags" aria-label="Save Feature Flags" class="nav-icon-link group flex flex-col items-center justify-center min-w-[56px] sm:min-w-[62px] py-1.5 px-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-800/60 text-slate-700 dark:text-slate-200 hover:text-brand-600 dark:hover:text-accent hover:bg-slate-100 dark:hover:bg-slate-800 shadow-xs hover:border-slate-300 dark:hover:border-slate-600 transition cursor-pointer flex-shrink-0">
              <span class="material-symbols-rounded text-xl transition-transform duration-200 group-hover:scale-110 flex-shrink-0" aria-hidden="true">save</span>
              <span class="text-[11px] font-bold tracking-tight mt-0.5 whitespace-nowrap leading-tight">Save</span>
            </button>
          </div>
        </div>

        <!-- 2-COLUMN SPLIT: LEFT TOGGLES (5 cols) | RIGHT LIVE HOMEPAGE PREVIEW (7 cols) -->
        <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 items-start">
          
          <!-- LEFT: 11 Section Toggles (iOS / Tailwind Style Switches) -->
          <div class="xl:col-span-5 space-y-2.5 text-xs">
            <%
            const SECTION_FLAGS = [
              { key: 'section_hero_enabled', num: '1', title: 'Hero Section', desc: 'Primary headline, PCB telemetry pill & CTA buttons', val: settings.section_hero_enabled },
              { key: 'lab_event_enabled', num: '2', title: 'Lab Telemetry Ticker', desc: 'Live active SMT lines & HIL station indicator banner', val: settings.lab_event_enabled },
              { key: 'section_sandbox_enabled', num: '3', title: 'Interactive Sandbox', desc: 'Trace sandbox & firmware architecture runner', val: settings.section_sandbox_enabled },
              { key: 'section_services_enabled', num: '4', title: 'Engineering Services', desc: 'Hardware, RTOS Firmware, IoT & Turnkey PCB capabilities', val: settings.section_services_enabled },
              { key: 'section_architecture_enabled', num: '5', title: 'Architecture Viewer', desc: 'Automotive, TinyML, and IoT architecture breakdowns', val: settings.section_architecture_enabled },
              { key: 'section_projects_enabled', num: '6', title: 'Featured Projects', desc: 'Curated hardware case studies and real-world designs', val: settings.section_projects_enabled },
              { key: 'section_tools_enabled', num: '7', title: 'Engineering Tools Hub', desc: 'Interactive calculators: Trace Width, Battery Life, Antenna', val: settings.section_tools_enabled },
              { key: 'section_blog_enabled', num: '8', title: 'Technical Blog', desc: 'Latest technical articles, firmware guides, and whitepapers', val: settings.section_blog_enabled },
              { key: 'section_process_enabled', num: '8b', title: 'How We Work', desc: 'Four-step engagement process', val: settings.section_process_enabled },
              { key: 'section_testimonials_enabled', num: '9', title: 'Testimonials & Trust', desc: 'OEM client testimonials and lab certification badges', val: settings.section_testimonials_enabled },
              { key: 'section_faq_enabled', num: '10', title: 'FAQ Accordion', desc: 'Frequently asked engineering & manufacturing questions', val: settings.section_faq_enabled },
              { key: 'section_cta_enabled', num: '11', title: 'Feasibility Consultation CTA Banner', desc: 'High-conversion bottom RFQ banner linking to /contact', val: settings.section_cta_enabled }
            ];
            %>

            <% SECTION_FLAGS.forEach(f => { 
              const isEnabled = f.val !== 'false';
            %>
            <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border flex items-center justify-between transition hover:border-slate-300 dark:hover:border-slate-700">
              <div class="pr-3">
                <label class="font-bold text-slate-900 dark:text-white block"><%= f.num %>. <%= f.title %></label>
                <span class="text-[10px] text-slate-400"><%= f.desc %></span>
              </div>
              
              <div class="flex items-center space-x-2.5 flex-shrink-0">
                <span id="badge_<%= f.key %>" class="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-md <%= isEnabled ? 'bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300' : 'bg-slate-200 dark:bg-slate-800 text-slate-500' %>">
                  <%= isEnabled ? 'Show' : 'Hide' %>
                </span>
                
                <!-- iOS / Tailwind Toggle Switch Button -->
                <button type="button" 
                  role="switch" 
                  aria-checked="<%= isEnabled ? 'true' : 'false' %>"
                  id="btn_<%= f.key %>"
                  onclick="toggleSectionFlag('<%= f.key %>', this)" 
                  class="relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 <%= isEnabled ? 'bg-emerald-500' : 'bg-slate-300 dark:bg-slate-700' %>"
                  title="Click to toggle section <%= f.title %>">
                  <span class="sr-only">Toggle <%= f.title %></span>
