              </select>
            </div>
            <input type="text" name="promo_banner_title" value="<%= settings.promo_banner_title || '' %>" placeholder="Banner text headline..." class="w-full px-2 py-1.5 rounded-lg bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 text-xs">
            <div class="grid grid-cols-2 gap-2">
              <input type="text" name="promo_banner_cta" value="<%= settings.promo_banner_cta || 'Book Consultation' %>" placeholder="CTA Button" class="w-full px-2 py-1 rounded bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 text-[11px]">
              <input type="text" name="promo_banner_url" value="<%= settings.promo_banner_url || '/contact' %>" placeholder="Target URL" class="w-full px-2 py-1 rounded bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 text-[11px] font-mono">
            </div>
          </div>

        </div>
      </div>

      <!-- 5D. Root ads.txt Live Editor -->
      <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase text-slate-800 dark:text-slate-200">ads.txt Content (Served live at /ads.txt for IAB verification)</span>
          <a href="/ads.txt" target="_blank" class="text-[11px] text-brand-500 hover:underline">View /ads.txt &nearr;</a>
        </div>
        <textarea name="ads_txt_content" rows="4" placeholder="google.com, pub-2644536267352236, DIRECT, f08c47fec0942fa0" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 font-mono text-xs"><%= settings.ads_txt_content || 'google.com, pub-2644536267352236, DIRECT, f08c47fec0942fa0' %></textarea>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- MODULE 6: OUTGOING SMTP CONFIGURATION -->
    <!-- ========================================== -->
    <section id="smtp-settings" class="bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-sm space-y-6">
      <div class="flex items-center justify-between border-b border-slate-100 dark:border-brand-border pb-4">
        <div>
          <h2 class="text-lg font-black text-slate-900 dark:text-white flex items-center space-x-2">
            <span>📧 Outgoing SMTP Mailer Configuration</span>
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Dispatches real-time inquiry alerts to info@embeddedindia.in, double opt-in verification, and technical digests.</p>
        </div>
        <span class="text-[10px] bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 font-bold px-2.5 py-1 rounded-full uppercase">
          SMTP Transport
        </span>
      </div>

      <!-- Quick Presets -->
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400">Quick Presets:</span>
        <button type="button" onclick="setSmtpPreset('gmail')" class="px-2.5 py-1 bg-slate-100 dark:bg-brand-dark rounded-lg font-semibold hover:bg-slate-200 transition">Gmail (587)</button>
        <button type="button" onclick="setSmtpPreset('sendgrid')" class="px-2.5 py-1 bg-slate-100 dark:bg-brand-dark rounded-lg font-semibold hover:bg-slate-200 transition">SendGrid (587)</button>
        <button type="button" onclick="setSmtpPreset('mock')" class="px-2.5 py-1 bg-slate-100 dark:bg-brand-dark rounded-lg font-semibold hover:bg-slate-200 transition">Local Dev Mock</button>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="sm:col-span-2">
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">SMTP Host</label>
          <input type="text" id="smtp_host" name="smtp_host" value="<%= settings.smtp_host || '' %>" placeholder="smtp.gmail.com or smtp.titan.email" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-mono">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">SMTP Port</label>
          <input type="number" id="smtp_port" name="smtp_port" value="<%= settings.smtp_port || '587' %>" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-mono">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">TLS / SSL Mode</label>
          <select id="smtp_secure" name="smtp_secure" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-semibold">
            <option value="false" <%= settings.smtp_secure !== 'true' ? 'selected' : '' %>>STARTTLS (Port 587 - Default)</option>
            <option value="true" <%= settings.smtp_secure === 'true' ? 'selected' : '' %>>SSL / TLS (Port 465)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">SMTP Username / Email</label>
          <input type="text" id="smtp_user" name="smtp_user" value="<%= settings.smtp_user || '' %>" placeholder="info@embeddedindia.in" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-mono">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">SMTP Password / App Secret</label>
          <input type="password" id="smtp_pass" name="smtp_pass" value="<%= settings.smtp_pass || '' %>" placeholder="••••••••••••" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-mono">
        </div>
      </div>

      <!-- Test SMTP Dispatch Box -->
      <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border space-y-3">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <span class="text-xs font-bold text-slate-900 dark:text-white block">Diagnostic Outbound Handshake</span>
            <span class="text-[11px] text-slate-500">Test socket TLS handshake and verify direct delivery to recipient</span>
          </div>
          <div class="flex items-center space-x-2">
            <input type="email" id="smtpTestRecipient" placeholder="info@embeddedindia.in" value="info@embeddedindia.in" class="px-3 py-1.5 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 text-xs font-mono">
            <button type="button" id="btnTestSmtp" class="px-4 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition shadow-sm active:scale-95 whitespace-nowrap">
              ⚡ Test Delivery
            </button>
          </div>
        </div>
        <div id="smtpTestResult" class="hidden p-3 rounded-xl text-xs font-mono"></div>
      </div>
    </section>

    <!-- Save Bar inside Form -->
    <div class="pt-4 flex items-center justify-end">
      <button type="submit" class="px-8 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-black rounded-2xl text-sm transition shadow-lg shadow-brand-500/25 active:scale-95 flex items-center space-x-2">
        <span>💾 Save All Configuration Changes</span>
      </button>
    </div>

  </form>

  <!-- ========================================== -->
  <!-- MODULE 7: TEAM & ADMINISTRATOR ACCOUNTS -->
  <!-- ========================================== -->
  <section id="team-accounts" class="bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-sm space-y-6">
    <div class="flex items-center justify-between border-b border-slate-100 dark:border-brand-border pb-4">
      <div>
        <h2 class="text-lg font-black text-slate-900 dark:text-white flex items-center space-x-2">
          <span>👥 Team &amp; Staff Account Access</span>
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Manage admin and editor staff accounts with bcrypt password hashing.</p>
      </div>
      <span class="text-[10px] bg-brand-50 dark:bg-brand-900/60 text-brand-600 dark:text-accent font-bold px-2.5 py-1 rounded-full uppercase">
        Access Control
      </span>
    </div>

    <!-- Existing Accounts Table -->
    <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-brand-border">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 dark:bg-brand-dark border-b border-slate-200 dark:border-brand-border font-bold uppercase text-slate-500">
          <tr>
            <th class="py-3 px-4">Account Email</th>
            <th class="py-3 px-4">Username</th>
            <th class="py-3 px-4">Role</th>
            <th class="py-3 px-4">Created</th>
            <th class="py-3 px-4 text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-brand-border">
          <% (users || []).forEach(u => { %>
            <tr class="hover:bg-slate-50 dark:hover:bg-brand-dark/50 transition">
              <td class="py-3 px-4 font-semibold text-slate-900 dark:text-white">
                <%= u.email %>
                <% if (currentUser && currentUser.userId === u.id) { %>
                  <span class="ml-1.5 px-2 py-0.5 rounded-full text-[10px] bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 font-bold">You</span>
                <% } %>
              </td>
              <td class="py-3 px-4 font-mono text-slate-500"><%= u.username %></td>
              <td class="py-3 px-4">
                <span class="px-2 py-0.5 rounded-full uppercase font-bold text-[10px] <%= u.role === 'admin' ? 'bg-emerald-100 text-emerald-800' : 'bg-blue-100 text-blue-800' %>">
                  <%= u.role %>
                </span>
              </td>
              <td class="py-3 px-4 text-slate-400"><%= new Date(u.createdAt).toLocaleDateString() %></td>
              <td class="py-3 px-4 text-right">
                <% if (!currentUser || currentUser.userId !== u.id) { %>
                  <button type="button" onclick="deleteAccount('<%= u.id %>')" class="text-red-500 hover:text-red-700 font-bold">Remove</button>
                <% } else { %>
                  <span class="text-slate-400">Active</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Create Staff User Box -->
    <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border space-y-4">
      <span class="text-xs font-bold text-slate-900 dark:text-white block">➕ Add New Staff Account</span>
      
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
        <div>
          <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Email</label>
          <input type="email" id="newAccountEmail" placeholder="engineer@embeddedindia.in" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 text-xs">
        </div>
        <div>
          <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Role</label>
          <select id="newAccountRole" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 text-xs font-semibold">
            <option value="admin">Administrator (Full Access)</option>
            <option value="editor">Editor (Blogs & Articles)</option>
          </select>
        </div>
        <div>
          <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Password (Min 8 Chars)</label>
          <input type="password" id="newAccountPass" placeholder="••••••••••••" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 text-xs font-mono">
        </div>
      </div>

      <div class="flex items-center justify-between pt-2">
        <button type="button" id="btnAddAccount" class="px-5 py-2 bg-brand-500 hover:bg-brand-600 text-white rounded-xl text-xs font-bold transition shadow-sm active:scale-95">
          Validate &amp; Create Account
        </button>
        <span class="text-[11px] text-slate-400">Enforces salted bcrypt hashing</span>
      </div>
      <div id="addAccountResult" class="hidden p-3 rounded-xl text-xs font-mono"></div>
    </div>

    <!-- Password Change for Active Staff -->
    <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border space-y-4">
      <span class="text-xs font-bold text-slate-900 dark:text-white block">🔑 Update Your Active Password</span>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
        <div>
          <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Current Password</label>
          <input type="password" id="currentAccountPass" placeholder="••••••••••••" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 text-xs font-mono">
        </div>
        <div>
          <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">New Password</label>
          <input type="password" id="updatedAccountPass" placeholder="••••••••••••" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 text-xs font-mono">
        </div>
      </div>
      <button type="button" id="btnChangePassword" class="px-5 py-2 bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-800 dark:text-white rounded-xl text-xs font-bold transition">
        Update Password
      </button>
      <div id="changePassResult" class="hidden p-3 rounded-xl text-xs font-mono"></div>
    </div>
  </section>

</div>

<script>
  // 1. Predefined Palettes Dictionary for Interactive Client-Side Preview
  const PALETTES = {
    'cyber-emerald': { name: 'Cyber Emerald', bgPrimary: '#0b1412', bgSurface: '#13221e', textPrimary: '#f1f5f9', textMuted: '#94a3b8', accentPrimary: '#059669', accentSecondary: '#55a630', borderColor: '#1e3831' },
    'quantum-cyan': { name: 'Quantum Cyan', bgPrimary: '#08101a', bgSurface: '#0f1d2e', textPrimary: '#f8fafc', textMuted: '#94a3b8', accentPrimary: '#0ea5e9', accentSecondary: '#06b6d4', borderColor: '#172a42' },
    'titanium-slate': { name: 'Titanium Slate', bgPrimary: '#090d16', bgSurface: '#0f172a', textPrimary: '#f8fafc', textMuted: '#94a3b8', accentPrimary: '#38bdf8', accentSecondary: '#64748b', borderColor: '#334155' },
    'solar-amber': { name: 'Solar Amber', bgPrimary: '#18181b', bgSurface: '#27272a', textPrimary: '#fafafa', textMuted: '#a1a1aa', accentPrimary: '#f59e0b', accentSecondary: '#fbbf24', borderColor: '#3f3f46' },
    'supernova-violet': { name: 'Supernova Violet', bgPrimary: '#0f0c1b', bgSurface: '#18142a', textPrimary: '#faf5ff', textMuted: '#c084fc', accentPrimary: '#a855f7', accentSecondary: '#c084fc', borderColor: '#3b2d54' },
    'clean-light': { name: 'Clean Enterprise', bgPrimary: '#f8fafc', bgSurface: '#ffffff', textPrimary: '#0f172a', textMuted: '#64748b', accentPrimary: '#2563eb', accentSecondary: '#3b82f6', borderColor: '#e2e8f0' },
    // Aliases
    'emerald': { name: 'Cyber Emerald', bgPrimary: '#0b1412', bgSurface: '#13221e', textPrimary: '#f1f5f9', textMuted: '#94a3b8', accentPrimary: '#059669', accentSecondary: '#55a630', borderColor: '#1e3831' },
    'pcb-emerald-green': { name: 'Cyber Emerald', bgPrimary: '#0b1412', bgSurface: '#13221e', textPrimary: '#f1f5f9', textMuted: '#94a3b8', accentPrimary: '#059669', accentSecondary: '#55a630', borderColor: '#1e3831' },
    'cyan': { name: 'Quantum Cyan', bgPrimary: '#08101a', bgSurface: '#0f1d2e', textPrimary: '#f8fafc', textMuted: '#94a3b8', accentPrimary: '#0ea5e9', accentSecondary: '#06b6d4', borderColor: '#172a42' },
    'silicon-dark-blue': { name: 'Quantum Cyan', bgPrimary: '#08101a', bgSurface: '#0f1d2e', textPrimary: '#f8fafc', textMuted: '#94a3b8', accentPrimary: '#0ea5e9', accentSecondary: '#06b6d4', borderColor: '#172a42' },
    'spacegrey': { name: 'Titanium Slate', bgPrimary: '#090d16', bgSurface: '#0f172a', textPrimary: '#f8fafc', textMuted: '#94a3b8', accentPrimary: '#38bdf8', accentSecondary: '#64748b', borderColor: '#334155' },
    'clean-light-enterprise': { name: 'Clean Enterprise', bgPrimary: '#f8fafc', bgSurface: '#ffffff', textPrimary: '#0f172a', textMuted: '#64748b', accentPrimary: '#2563eb', accentSecondary: '#3b82f6', borderColor: '#e2e8f0' }
  };

  function previewPalette(key) {
    let p = PALETTES[key];
    if (key === 'custom') {
      p = {
        name: 'Custom Palette',
        bgPrimary: document.getElementById('palette_bg_primary').value,
        bgSurface: document.getElementById('palette_bg_surface').value,
        textPrimary: document.getElementById('palette_text_primary').value,
        textMuted: document.getElementById('palette_text_muted').value,
        accentPrimary: document.getElementById('palette_accent_primary').value,
        accentSecondary: document.getElementById('palette_accent_secondary').value,
        borderColor: document.getElementById('palette_border_color').value
      };
    } else if (p) {
      document.getElementById('palette_bg_primary').value = p.bgPrimary;
      document.getElementById('picker_bg_primary').value = p.bgPrimary;
      document.getElementById('palette_bg_surface').value = p.bgSurface;
      document.getElementById('picker_bg_surface').value = p.bgSurface;
      document.getElementById('palette_text_primary').value = p.textPrimary;
      document.getElementById('picker_text_primary').value = p.textPrimary;
      document.getElementById('palette_text_muted').value = p.textMuted;
      document.getElementById('picker_text_muted').value = p.textMuted;
      document.getElementById('palette_accent_primary').value = p.accentPrimary;
      document.getElementById('picker_accent_primary').value = p.accentPrimary;
      document.getElementById('palette_accent_secondary').value = p.accentSecondary;
      document.getElementById('picker_accent_secondary').value = p.accentSecondary;
      document.getElementById('palette_border_color').value = p.borderColor;
      document.getElementById('picker_border_color').value = p.borderColor;
    }

    if (p) {
      const box = document.getElementById('liveThemePreviewBox');
      box.style.background = p.bgPrimary;
      box.style.borderColor = p.borderColor;
      const subCard = box.querySelector('div.p-4');
      if (subCard) {
        subCard.style.background = p.bgSurface;
        subCard.style.borderColor = p.borderColor;
      }
      const title = box.querySelector('h3');
      if (title) title.style.color = p.textPrimary;
      const desc = box.querySelector('p');
      if (desc) desc.style.color = p.textMuted;
      const btn = box.querySelector('button');
      if (btn) btn.style.background = p.accentPrimary;
      const secText = box.querySelector('span.text-xs');
      if (secText) secText.style.color = p.accentSecondary;
    }
  }

  function syncColorInput(inputId, hex) {
    document.getElementById(inputId).value = hex;
    previewPalette('custom');
  }

  // 2. SMTP Preset Autofill
  function setSmtpPreset(type) {
    if (type === 'gmail') {
      document.getElementById('smtp_host').value = 'smtp.gmail.com';
      document.getElementById('smtp_port').value = '587';
      document.getElementById('smtp_secure').value = 'false';
    } else if (type === 'sendgrid') {
      document.getElementById('smtp_host').value = 'smtp.sendgrid.net';
      document.getElementById('smtp_port').value = '587';
      document.getElementById('smtp_secure').value = 'false';
      document.getElementById('smtp_user').value = 'apikey';
    } else if (type === 'mock') {
      document.getElementById('smtp_host').value = 'localhost';
      document.getElementById('smtp_port').value = '1025';
      document.getElementById('smtp_secure').value = 'false';
      document.getElementById('smtp_user').value = 'mock';
      document.getElementById('smtp_pass').value = 'mock';
    }
  }

  // 3. Test SMTP Delivery
  const btnTestSmtp = document.getElementById('btnTestSmtp');
  const smtpTestRecipient = document.getElementById('smtpTestRecipient');
  const smtpTestResult = document.getElementById('smtpTestResult');

  if (btnTestSmtp) {
    btnTestSmtp.addEventListener('click', async () => {
      smtpTestResult.className = 'p-3 rounded-xl text-xs font-mono bg-blue-50 dark:bg-blue-950/50 text-blue-800 dark:text-blue-300 border border-blue-200 dark:border-blue-800 block';
      smtpTestResult.innerHTML = '<span class="animate-pulse">🔄 Executing socket TLS handshake & email delivery...</span>';
      btnTestSmtp.disabled = true;

      try {
        const res = await fetch('/admin/settings/test-smtp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            host: document.getElementById('smtp_host').value,
            port: document.getElementById('smtp_port').value,
            secure: document.getElementById('smtp_secure').value,
            user: document.getElementById('smtp_user').value,
            pass: document.getElementById('smtp_pass').value,
            toEmail: smtpTestRecipient.value || 'info@embeddedindia.in'
          })
        });
        const data = await res.json();
        if (data.success) {
          smtpTestResult.className = 'p-3 rounded-xl text-xs font-mono bg-emerald-50 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 block';
          smtpTestResult.innerHTML = `<strong>✅ SMTP Success!</strong><br>${data.message}<br><span class="text-[10px] text-slate-500">Msg ID: ${data.messageId}</span>`;
        } else {
          smtpTestResult.className = 'p-3 rounded-xl text-xs font-mono bg-red-50 dark:bg-red-950/50 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800 block';
          smtpTestResult.innerHTML = `<strong>❌ Handshake Failed:</strong><br>${data.error}`;
        }
      } catch (err) {
        smtpTestResult.className = 'p-3 rounded-xl text-xs font-mono bg-red-50 dark:bg-red-950/50 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800 block';
        smtpTestResult.innerHTML = `Network Error: ${err.message}`;
      } finally {
        btnTestSmtp.disabled = false;
      }
    });
  }

  // 4. Validate AdSense Account
  const btnValidateAd = document.getElementById('btnValidateAd');
  const adValidationResult = document.getElementById('adValidationResult');
  if (btnValidateAd) {
    btnValidateAd.addEventListener('click', async () => {
      adValidationResult.className = 'p-2 rounded text-[11px] font-mono bg-blue-50 dark:bg-blue-950 text-blue-800 dark:text-blue-300 block animate-pulse';
      adValidationResult.textContent = 'Validating Publisher ID...';
      try {
        const res = await fetch('/admin/settings/validate-ad', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ pubId: document.getElementById('adsense_pub_id').value })
        });
        const data = await res.json();
        if (data.success) {
          adValidationResult.className = 'p-2 rounded text-[11px] font-mono bg-emerald-50 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 block';
          adValidationResult.textContent = `✅ ${data.message} (${data.adsTxtLine})`;
        } else {
          adValidationResult.className = 'p-2 rounded text-[11px] font-mono bg-red-50 dark:bg-red-950 text-red-800 dark:text-red-300 block';
          adValidationResult.textContent = `❌ ${data.error}`;
        }
      } catch (err) {
        adValidationResult.className = 'p-2 rounded text-[11px] font-mono bg-red-50 dark:bg-red-950 text-red-800 dark:text-red-300 block';
        adValidationResult.textContent = `Network Error: ${err.message}`;
      }
    });
  }

  // 5. Staff Account Creation
  const btnAddAccount = document.getElementById('btnAddAccount');
  const addAccountResult = document.getElementById('addAccountResult');
  if (btnAddAccount) {
    btnAddAccount.addEventListener('click', async () => {
      addAccountResult.className = 'p-3 rounded-xl text-xs font-mono bg-blue-50 dark:bg-blue-950 text-blue-800 dark:text-blue-300 block animate-pulse';
      addAccountResult.textContent = 'Creating account...';
      try {
        const res = await fetch('/admin/settings/add-account', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: document.getElementById('newAccountEmail').value,
            role: document.getElementById('newAccountRole').value,
            password: document.getElementById('newAccountPass').value
          })
        });
        const data = await res.json();
        if (data.success) {
          addAccountResult.className = 'p-3 rounded-xl text-xs font-mono bg-emerald-50 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 block';
          addAccountResult.textContent = `✅ ${data.message}`;
          setTimeout(() => location.reload(), 1200);
        } else {
          addAccountResult.className = 'p-3 rounded-xl text-xs font-mono bg-red-50 dark:bg-red-950 text-red-800 dark:text-red-300 block';
          addAccountResult.textContent = `❌ ${data.error}`;
        }
      } catch (err) {
        addAccountResult.className = 'p-3 rounded-xl text-xs font-mono bg-red-50 dark:bg-red-950 text-red-800 dark:text-red-300 block';
        addAccountResult.textContent = `Network Error: ${err.message}`;
      }
    });
  }

  // 6. Delete Account
  async function deleteAccount(id) {
    if (!confirm('Remove this staff account?')) return;
    try {
      const res = await fetch('/admin/settings/delete-account', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id })
      });
      const data = await res.json();
      if (data.success) location.reload();
      else alert(data.error);
    } catch (err) {
      alert('Network error removing account');
    }
  }

  // 7. Change Password
  const btnChangePassword = document.getElementById('btnChangePassword');
  const changePassResult = document.getElementById('changePassResult');
  if (btnChangePassword) {
    btnChangePassword.addEventListener('click', async () => {
      try {
        const res = await fetch('/admin/settings/change-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            currentPassword: document.getElementById('currentAccountPass').value,
            newPassword: document.getElementById('updatedAccountPass').value
          })
        });
        const data = await res.json();
        if (data.success) {
          changePassResult.className = 'p-3 rounded-xl text-xs font-mono bg-emerald-50 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 block';
          changePassResult.textContent = `✅ ${data.message}`;
        } else {
          changePassResult.className = 'p-3 rounded-xl text-xs font-mono bg-red-50 dark:bg-red-950 text-red-800 dark:text-red-300 block';
          changePassResult.textContent = `❌ ${data.error}`;
        }
      } catch (err) {
        changePassResult.className = 'p-3 rounded-xl text-xs font-mono bg-red-50 dark:bg-red-950 text-red-800 dark:text-red-300 block';
        changePassResult.textContent = `Network Error: ${err.message}`;
      }
    });
  }
</script>

<%- include('layout_bottom') %>
