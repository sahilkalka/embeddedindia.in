        <div class="pt-2 flex justify-end">
          <button type="submit" title="Save SEO Settings" aria-label="Save SEO Settings" class="nav-icon-link group flex flex-col items-center justify-center min-w-[56px] sm:min-w-[62px] py-1.5 px-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-800/60 text-slate-700 dark:text-slate-200 hover:text-brand-600 dark:hover:text-accent hover:bg-slate-100 dark:hover:bg-slate-800 shadow-xs hover:border-slate-300 dark:hover:border-slate-600 transition cursor-pointer flex-shrink-0">
            <span class="material-symbols-rounded text-xl transition-transform duration-200 group-hover:scale-110 flex-shrink-0" aria-hidden="true">save</span>
            <span class="text-[11px] font-bold tracking-tight mt-0.5 whitespace-nowrap leading-tight">Save</span>
          </button>
        </div>
      </form>
