    <!-- ========================================== -->
    <!-- MODULE 4: DYNAMIC SEO & CUSTOM SCRIPT INJECTOR -->
    <!-- ========================================== -->
    <section id="seo-scripts" class="bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-sm space-y-6">
      <div class="flex items-center justify-between border-b border-slate-100 dark:border-brand-border pb-4">
        <div>
          <h2 class="text-lg font-black text-slate-900 dark:text-white flex items-center space-x-2">
            <span>🔍 Dynamic SEO &amp; Custom Scripts Manager</span>
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Configure per-route meta overrides, live robots.txt rules, and inject third-party scripts into &lt;head&gt; and &lt;body&gt;.</p>
        </div>
        <span class="text-[10px] bg-brand-50 dark:bg-brand-900/60 text-brand-600 dark:text-accent font-bold px-2.5 py-1 rounded-full uppercase">
          SEO &amp; Scripts
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Global Default Title</label>
          <input type="text" name="site_title_default" value="<%= settings.site_title_default || 'Embedded System Design & Development Services in India' %>" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs text-slate-900 dark:text-white">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Global Default Meta Keywords</label>
          <input type="text" name="site_keywords_default" value="<%= settings.site_keywords_default || 'embedded systems india, PCB design bangalore, firmware development, IoT edge computing' %>" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs text-slate-900 dark:text-white">
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Global Default Meta Description</label>
        <textarea name="site_description_default" rows="2" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs text-slate-900 dark:text-white"><%= settings.site_description_default || 'Embedded System Design & Development Services in India, from concept to production. Specializing in IoT, microcontrollers, and hardware/firmware solutions.' %></textarea>
      </div>

      <!-- Route-Specific SEO Overrides JSON -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Route-Specific SEO Overrides (JSON format: route -&gt; title, description, keywords)</label>
          <span class="text-[10px] text-slate-400 font-mono">Example: {"/about": {"title": "About Us", "description": "..."}}</span>
        </div>
        <textarea name="seo_route_overrides" rows="3" placeholder='{"/projects": {"title": "Portfolio - Embedded India", "description": "Custom hardware projects"}}' class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 font-mono text-xs text-slate-900 dark:text-white"><%= settings.seo_route_overrides || '' %></textarea>
      </div>

      <!-- Live robots.txt Editor -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="text-xs font-bold text-slate-700 dark:text-slate-300">robots.txt Live Editor</label>
          <a href="/robots.txt" target="_blank" class="text-[11px] text-brand-500 hover:underline">View live /robots.txt &nearr;</a>
        </div>
        <textarea name="robots_txt_custom" rows="4" placeholder="User-agent: *&#10;Allow: /&#10;Disallow: /admin/&#10;Sitemap: https://embeddedindia.in/sitemap.xml" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 font-mono text-xs text-slate-900 dark:text-white"><%= settings.robots_txt_custom || '' %></textarea>
      </div>

      <!-- Custom Scripts Injection -->
