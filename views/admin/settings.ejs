            </button>
            <button type="submit" title="Save Newsletter Settings" aria-label="Save Newsletter Settings" class="nav-icon-link group flex flex-col items-center justify-center min-w-[56px] sm:min-w-[62px] py-1.5 px-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-800/60 text-slate-700 dark:text-slate-200 hover:text-brand-600 dark:hover:text-accent hover:bg-slate-100 dark:hover:bg-slate-800 shadow-xs hover:border-slate-300 dark:hover:border-slate-600 transition cursor-pointer flex-shrink-0">
              <span class="material-symbols-rounded text-xl transition-transform duration-200 group-hover:scale-110 flex-shrink-0" aria-hidden="true">save</span>
              <span class="text-[11px] font-bold tracking-tight mt-0.5 whitespace-nowrap leading-tight">Save</span>
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
          <!-- Frequency -->
          <div>
            <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Digest Dispatch Frequency</label>
            <select name="newsletter_frequency" class="w-full px-3 py-2.5 rounded-xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700 font-semibold">
              <option value="daily" <%= settings.newsletter_frequency === 'daily' ? 'selected' : '' %>>Daily Digest (Past 24h Posts)</option>
              <option value="weekly" <%= (!settings.newsletter_frequency || settings.newsletter_frequency === 'weekly') ? 'selected' : '' %>>Weekly Digest (Past 7 Days - Recommended)</option>
              <option value="bi-weekly" <%= settings.newsletter_frequency === 'bi-weekly' ? 'selected' : '' %>>Bi-Weekly Digest (Past 14 Days)</option>
              <option value="monthly" <%= settings.newsletter_frequency === 'monthly' ? 'selected' : '' %>>Monthly Digest (Past 30 Days)</option>
            </select>
          </div>

          <!-- Topic Focus -->
          <div>
            <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Primary Newsletter Topic / Subject Header</label>
