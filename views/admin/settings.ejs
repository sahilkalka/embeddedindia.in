        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Custom &lt;head&gt; Scripts (Analytics, Meta, Fonts)</label>
          <textarea name="custom_head_scripts" rows="4" placeholder="<!-- Injected directly before </head> -->&#10;<script>/* custom code */</script>" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 font-mono text-xs text-slate-900 dark:text-white"><%= settings.custom_head_scripts || '' %></textarea>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Custom &lt;body&gt; Scripts (Chatbots, Conversion Pixels)</label>
          <textarea name="custom_body_scripts" rows="4" placeholder="<!-- Injected directly before </body> -->&#10;<script>/* custom code */</script>" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 font-mono text-xs text-slate-900 dark:text-white"><%= settings.custom_body_scripts || '' %></textarea>
        </div>
      </div>
