            <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Post Category Filter</label>
            <select name="newsletter_category" class="w-full px-3 py-2.5 rounded-xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700 font-semibold">
              <option value="all" <%= (!settings.newsletter_category || settings.newsletter_category === 'all') ? 'selected' : '' %>>All Categories (Curated Highlights)</option>
              <option value="firmware" <%= settings.newsletter_category === 'firmware' ? 'selected' : '' %>>Firmware &amp; RTOS</option>
              <option value="hardware" <%= settings.newsletter_category === 'hardware' ? 'selected' : '' %>>High-Speed PCB Layout</option>
              <option value="iot" <%= settings.newsletter_category === 'iot' ? 'selected' : '' %>>IoT &amp; Wireless</option>
            </select>
          </div>
        </div>

        <!-- Editorial Intro Content -->
        <div class="text-xs space-y-1">
          <label class="block font-semibold text-slate-700 dark:text-slate-300">Newsletter Editorial Intro Message</label>
          <textarea name="newsletter_intro_content" rows="3" placeholder="Custom greeting and editor commentary sent above the curated articles list..." class="w-full px-3.5 py-2.5 rounded-xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700 font-medium"><%= settings.newsletter_intro_content || 'Here are the latest engineering guides, embedded firmware patterns, and hardware architectures curated by our engineering lab:' %></textarea>
        </div>

        <div id="digestTriggerResult" class="hidden p-3 rounded-xl text-xs font-mono"></div>

        <!-- Link to subscriber management -->
        <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 flex items-center justify-between text-xs">
          <div>
            <span class="font-bold text-slate-900 dark:text-white block">Subscriber Audience Database</span>
            <span class="text-slate-500 dark:text-slate-400">Manage, export, and review confirmed double opt-in subscribers</span>
          </div>
          <a href="/admin/subscribers" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-white rounded-xl font-bold transition">
            Manage Subscribers &rarr;
          </a>
        </div>

        <div class="pt-2 flex justify-end">
          <button type="submit" title="Save Newsletter Settings" aria-label="Save Newsletter Settings" class="nav-icon-link group flex flex-col items-center justify-center min-w-[56px] sm:min-w-[62px] py-1.5 px-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-800/60 text-slate-700 dark:text-slate-200 hover:text-brand-600 dark:hover:text-accent hover:bg-slate-100 dark:hover:bg-slate-800 shadow-xs hover:border-slate-300 dark:hover:border-slate-600 transition cursor-pointer flex-shrink-0">
            <span class="material-symbols-rounded text-xl transition-transform duration-200 group-hover:scale-110 flex-shrink-0" aria-hidden="true">save</span>
            <span class="text-[11px] font-bold tracking-tight mt-0.5 whitespace-nowrap leading-tight">Save</span>
          </button>
        </div>
      </form>
    </section>

    <!-- ============================================================== -->
    <!-- MODULE 7: OUTGOING SMTP & EMAIL RECIPIENT ROUTING -->
    <!-- ============================================================== -->
    <section id="smtp-settings" class="settings-section hidden bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-sm space-y-6">
      
      <form class="settings-module-form space-y-6" action="/admin/settings" method="POST" data-module="SMTP &amp; Email Routing">
        <input type="hidden" name="_active_tab" value="smtp-settings">

        <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-100 dark:border-brand-border pb-4 gap-3">
          <div>
            <h2 class="text-lg font-black text-slate-900 dark:text-white flex items-center space-x-2">
              <span>📧 Outgoing SMTP Mailer &amp; Email Recipient Routing</span>
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Designate which staff/users receive customer inquiries and newsletter signups, plus SMTP socket credentials.</p>
          </div>
          <div class="flex items-center space-x-2 flex-shrink-0">
            <button type="submit" title="Save SMTP &amp; Routing" aria-label="Save SMTP &amp; Routing" class="nav-icon-link group flex flex-col items-center justify-center min-w-[56px] sm:min-w-[62px] py-1.5 px-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-800/60 text-slate-700 dark:text-slate-200 hover:text-brand-600 dark:hover:text-accent hover:bg-slate-100 dark:hover:bg-slate-800 shadow-xs hover:border-slate-300 dark:hover:border-slate-600 transition cursor-pointer flex-shrink-0">
              <span class="material-symbols-rounded text-xl transition-transform duration-200 group-hover:scale-110 flex-shrink-0" aria-hidden="true">save</span>
              <span class="text-[11px] font-bold tracking-tight mt-0.5 whitespace-nowrap leading-tight">Save</span>
            </button>
          </div>
        </div>

        <!-- 7A. RECIPIENT ROUTING (CUSTOMER INQUIRIES & NEWSLETTER LEADS) -->
        <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-black uppercase text-slate-900 dark:text-white">
              👥 Inbound Email Notification Routing
            </span>
            <span class="text-[11px] text-slate-400">Comma-separated email addresses supported</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            
            <!-- Customer Queries Recipient -->
            <div class="space-y-1.5">
              <label class="block font-bold text-slate-800 dark:text-slate-200">
                Customer Inquiries &amp; RFQ Quotes Recipient(s):
              </label>
              <input type="text" id="inquiry_recipient_emails" name="inquiry_recipient_emails" value="<%= settings.inquiry_recipient_emails || 'info@embeddedindia.in' %>" placeholder="info@embeddedindia.in, engineering@embeddedindia.in" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 font-mono text-xs">
              
              <!-- Quick Select from Registered Staff Accounts -->
              <div class="flex flex-wrap items-center gap-1.5 pt-1">
                <span class="text-[10px] text-slate-400 font-bold uppercase">Staff Quick-Add:</span>
                <% (users || []).forEach(u => { %>
                  <button type="button" onclick="appendEmailTo('inquiry_recipient_emails', '<%= u.email %>')" class="text-[10px] px-2 py-0.5 rounded-lg bg-slate-200 dark:bg-slate-800 hover:bg-brand-500 hover:text-white transition font-mono">
                    + <%= u.email %>
                  </button>
                <% }) %>
              </div>
            </div>

            <!-- Newsletter Alerts Recipient -->
            <div class="space-y-1.5">
              <label class="block font-bold text-slate-800 dark:text-slate-200">
                Newsletter Subscriber Leads Alert Recipient(s):
              </label>
              <input type="text" id="newsletter_recipient_emails" name="newsletter_recipient_emails" value="<%= settings.newsletter_recipient_emails || 'info@embeddedindia.in' %>" placeholder="newsletter@embeddedindia.in, info@embeddedindia.in" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 font-mono text-xs">
              
              <!-- Quick Select from Registered Staff Accounts -->
              <div class="flex flex-wrap items-center gap-1.5 pt-1">
                <span class="text-[10px] text-slate-400 font-bold uppercase">Staff Quick-Add:</span>
                <% (users || []).forEach(u => { %>
                  <button type="button" onclick="appendEmailTo('newsletter_recipient_emails', '<%= u.email %>')" class="text-[10px] px-2 py-0.5 rounded-lg bg-slate-200 dark:bg-slate-800 hover:bg-brand-500 hover:text-white transition font-mono">
                    + <%= u.email %>
                  </button>
                <% }) %>
              </div>
            </div>

          </div>
        </div>

        <!-- 7B. Outgoing SMTP Socket Settings -->
        <div class="space-y-4">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="text-[11px] font-bold text-slate-500 dark:text-slate-400">Quick Presets:</span>
            <button type="button" onclick="setSmtpPreset('gmail')" class="px-2.5 py-1 bg-slate-100 dark:bg-brand-dark rounded-lg font-semibold hover:bg-slate-200 transition">Gmail (587)</button>
            <button type="button" onclick="setSmtpPreset('sendgrid')" class="px-2.5 py-1 bg-slate-100 dark:bg-brand-dark rounded-lg font-semibold hover:bg-slate-200 transition">SendGrid (587)</button>
            <button type="button" onclick="setSmtpPreset('mock')" class="px-2.5 py-1 bg-slate-100 dark:bg-brand-dark rounded-lg font-semibold hover:bg-slate-200 transition">Local Dev Mock</button>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
            <div class="sm:col-span-2">
              <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">SMTP Host</label>
              <input type="text" id="smtp_host" name="smtp_host" value="<%= settings.smtp_host || '' %>" placeholder="smtp.gmail.com" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700 font-mono text-xs">
            </div>
            <div>
              <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">SMTP Port</label>
              <input type="number" id="smtp_port" name="smtp_port" value="<%= settings.smtp_port || '587' %>" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700 font-mono text-xs">
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
            <div>
              <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">TLS / SSL Mode</label>
              <select id="smtp_secure" name="smtp_secure" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700 font-semibold">
                <option value="false" <%= settings.smtp_secure !== 'true' ? 'selected' : '' %>>STARTTLS (Port 587 - Default)</option>
                <option value="true" <%= settings.smtp_secure === 'true' ? 'selected' : '' %>>SSL / TLS (Port 465)</option>
              </select>
            </div>
            <div>
              <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">SMTP Username / Email</label>
              <input type="text" id="smtp_user" name="smtp_user" value="<%= settings.smtp_user || '' %>" placeholder="info@embeddedindia.in" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700 font-mono text-xs">
            </div>
            <div>
              <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">SMTP Password / App Secret</label>
              <input type="password" id="smtp_pass" name="smtp_pass" value="<%= settings.smtp_pass || '' %>" placeholder="••••••••••••" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700 font-mono text-xs">
            </div>
          </div>
        </div>

        <!-- Test SMTP Dispatch Box -->
        <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border space-y-3">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <span class="text-xs font-bold text-slate-900 dark:text-white block">Diagnostic Outbound Handshake</span>
              <span class="text-[11px] text-slate-500">Test socket TLS handshake and verify direct delivery</span>
            </div>
            <div class="flex items-center space-x-2">
              <input type="email" id="smtpTestRecipient" placeholder="info@embeddedindia.in" value="info@embeddedindia.in" class="px-3 py-1.5 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 text-xs font-mono">
              <button type="button" id="btnTestSmtp" class="nav-icon-link group flex flex-col items-center justify-center min-w-[64px] py-1.5 px-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-800/60 text-slate-700 dark:text-slate-200 hover:text-brand-600 dark:hover:text-accent hover:bg-slate-100 dark:hover:bg-slate-800 shadow-xs hover:border-slate-300 dark:hover:border-slate-600 transition duration-200 active:scale-95 cursor-pointer flex-shrink-0">
                <span class="material-symbols-rounded text-xl transition-transform duration-200 group-hover:scale-110 flex-shrink-0" aria-hidden="true">mark_email_read</span>
                <span class="text-[11px] font-bold tracking-tight mt-0.5 whitespace-nowrap leading-tight">Test SMTP</span>
              </button>
            </div>
          </div>
          <div id="smtpTestResult" class="hidden p-3 rounded-xl text-xs font-mono"></div>
        </div>

        <div class="pt-2 flex justify-end">
          <button type="submit" title="Save SMTP &amp; Routing" aria-label="Save SMTP &amp; Routing" class="nav-icon-link group flex flex-col items-center justify-center min-w-[56px] sm:min-w-[62px] py-1.5 px-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-800/60 text-slate-700 dark:text-slate-200 hover:text-brand-600 dark:hover:text-accent hover:bg-slate-100 dark:hover:bg-slate-800 shadow-xs hover:border-slate-300 dark:hover:border-slate-600 transition cursor-pointer flex-shrink-0">
            <span class="material-symbols-rounded text-xl transition-transform duration-200 group-hover:scale-110 flex-shrink-0" aria-hidden="true">save</span>
            <span class="text-[11px] font-bold tracking-tight mt-0.5 whitespace-nowrap leading-tight">Save</span>
          </button>
        </div>
      </form>
    </section>

    <!-- ============================================================== -->
    <!-- MODULE 8: TEAM & ADMINISTRATOR ACCOUNTS -->
    <!-- ============================================================== -->
    <section id="team-accounts" class="settings-section hidden bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-sm space-y-6">
      <div class="flex items-center justify-between border-b border-slate-100 dark:border-brand-border pb-4">
        <div>
          <h2 class="text-lg font-black text-slate-900 dark:text-white flex items-center space-x-2">
            <span>👥 Team &amp; Staff Account Access</span>
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Manage admin and editor staff accounts with bcrypt password hashing.</p>
        </div>
        <span class="text-[10px] bg-brand-50 dark:bg-brand-900/60 text-brand-600 dark:text-accent font-bold px-2.5 py-1 rounded-full uppercase">
          Access Control
        </span>
      </div>

      <!-- Accounts Table -->
      <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-brand-border">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 dark:bg-brand-dark border-b border-slate-200 dark:border-brand-border font-bold uppercase text-slate-500">
            <tr>
              <th class="py-3 px-4">Account Email</th>
              <th class="py-3 px-4">Username</th>
              <th class="py-3 px-4">Role</th>
              <th class="py-3 px-4">Created</th>
              <th class="py-3 px-4 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-brand-border">
            <% (users || []).forEach(u => { %>
              <tr class="hover:bg-slate-50 dark:hover:bg-brand-dark/50 transition">
                <td class="py-3 px-4 font-semibold text-slate-900 dark:text-white">
                  <%= u.email %>
                  <% if (currentUser && currentUser.userId === u.id) { %>
                    <span class="ml-1.5 px-2 py-0.5 rounded-full text-[10px] bg-brand-500/15 text-brand-700 dark:text-accent border border-brand-500/20 font-bold">You</span>
                  <% } %>
                </td>
                <td class="py-3 px-4 font-mono text-slate-500"><%= u.username %></td>
                <td class="py-3 px-4">
                  <span class="px-2 py-0.5 rounded-full uppercase font-bold text-[10px] <%= u.role === 'admin' ? 'bg-brand-500/15 text-brand-700 dark:text-accent border border-brand-500/20' : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700' %>">
                    <%= u.role %>
                  </span>
                </td>
                <td class="py-3 px-4 text-slate-400"><%= new Date(u.createdAt).toLocaleDateString() %></td>
                <td class="py-3 px-4 text-right">
                  <% if (!currentUser || currentUser.userId !== u.id) { %>
                    <button type="button" onclick="deleteAccount('<%= u.id %>')" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border border-red-200 dark:border-red-900/40 bg-red-50/50 dark:bg-red-950/30 text-red-600 dark:text-red-400 hover:bg-red-100 dark:hover:bg-red-900/50 text-[11px] font-bold transition">
                      <span class="material-symbols-rounded text-sm" aria-hidden="true">delete</span>
                      <span>Remove</span>
                    </button>
                  <% } else { %>
                    <span class="text-slate-400">Active</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Add New Account Box -->
      <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border space-y-4">
        <span class="text-xs font-bold text-slate-900 dark:text-white block">➕ Add New Staff Account</span>
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
          <div>
            <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Email</label>
            <input type="email" id="newAccountEmail" placeholder="engineer@embeddedindia.in" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 text-xs">
          </div>
          <div>
            <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Role</label>
            <select id="newAccountRole" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 text-xs font-semibold">
              <option value="admin">Administrator (Full Access)</option>
              <option value="editor">Editor (Blogs &amp; Articles)</option>
            </select>
          </div>
          <div>
            <label class="block font-semibold text-slate-600 dark:text-slate-400 mb-1">Password (Min 8 Chars)</label>
            <input type="password" id="newAccountPass" placeholder="••••••••••••" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 text-xs font-mono">
          </div>
        </div>

        <div class="flex items-center justify-between pt-2">
          <button type="button" id="btnAddAccount" class="nav-icon-link group flex flex-col items-center justify-center min-w-[76px] py-1.5 px-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-800/60 text-slate-700 dark:text-slate-200 hover:text-brand-600 dark:hover:text-accent hover:bg-slate-100 dark:hover:bg-slate-800 shadow-xs hover:border-slate-300 dark:hover:border-slate-600 transition cursor-pointer">
            <span class="material-symbols-rounded text-xl transition-transform duration-200 group-hover:scale-110 flex-shrink-0" aria-hidden="true">person_add</span>
            <span class="text-[11px] font-bold tracking-tight mt-0.5 whitespace-nowrap leading-tight">Create Staff</span>
          </button>
          <span class="text-[11px] text-slate-400">Enforces salted bcrypt hashing</span>
        </div>
        <div id="addAccountResult" class="hidden p-3 rounded-xl text-xs font-mono"></div>
      </div>
    </section>

    </div>
  </div>
</div>

<!-- ============================================================== -->
<!-- CLIENT JAVASCRIPT CONTROLLERS -->
<!-- ============================================================== -->
<script>
  // ====================================================================
  // 1. PALETTES DATA DEFINITIONS FOR PREVIEW & EDITING
  // ====================================================================
  const MODULE_METADATA = {
    'faq-manager': { title: 'Homepage FAQs', icon: 'quiz', breadcrumb: 'FAQs', subtitle: 'Manage additional homepage questions and answers.' },
    'theme-engine': {
      title: 'Dynamic Theme & Color Palette Engine',
      icon: 'palette',
      breadcrumb: 'Themes & Palettes',
      subtitle: 'Live side-by-side color palette engine: select a unified scheme or customize hex values with real-time component updates.'
    },
    'site-customizer': {
      title: 'No-Code Site Customizer & Lab Events',
      icon: 'tune',
      breadcrumb: 'Site Customizer',
      subtitle: 'Control live hardware status pill, telemetry banner, typography, navigation behavior, and promo copy.'
    },
    'feature-flags': {
      title: 'Modular Section Feature Flags & Live Homepage Preview',
      icon: 'flag',
      breadcrumb: 'Feature Flags & Preview',
      subtitle: 'Toggle homepage sections on or off with real-time homepage iframe preview across Desktop, Tablet, and Mobile.'
    },
    'seo-scripts': {
      title: 'Dynamic SEO & AI Meta Optimizer',
      icon: 'query_stats',
      breadcrumb: 'SEO & Scripts',
      subtitle: 'Real-time SEO score meter, diagnostic checklist, and 1-click AI optimization for high click-through rates.'
    },
    'monetization-ads': {
      title: 'Monetization & Multi-Provider Ad Engine',
      icon: 'payments',
      breadcrumb: 'Monetization Hub',
      subtitle: 'Manage Google AdSense, direct B2B sponsored placements, ads.txt sync, and visual slot mapping.'
    },
    'newsletter-config': {
      title: 'Technical Newsletter & Auto-Digest Configuration',
      icon: 'mail',
      breadcrumb: 'Newsletter Engine',
      subtitle: 'Configure automated newsletter digest frequency, topic focus, category filtering, and subscriber notifications.'
    },
    'smtp-settings': {
      title: 'Outgoing SMTP Mailer & Email Recipient Routing',
      icon: 'outgoing_mail',
      breadcrumb: 'SMTP & Routing',
      subtitle: 'Designate which staff/users receive customer inquiries and newsletter signups, plus SMTP socket credentials.'
    },
    'team-accounts': {
      title: 'Team & Staff Account Access',
      icon: 'group',
      breadcrumb: 'Staff Accounts',
      subtitle: 'Manage admin and editor staff accounts with bcrypt password hashing.'
    }
  };

  // ====================================================================
  // 2. SETTINGS MODE SECTION / PAGE SWITCHER
  // ====================================================================
  
  // ====================================================================
  // INLINE PALETTE DRAWER CONTROLLERS (EXPAND, EDIT, SAVE, DELETE)
  // ====================================================================
  window.switchSettingsSection = function(sectionId, updateUrl = true) {
    const HASH_ALIASES = {
      'theme-engine': 'site-customizer',
      'theme-engine.': 'site-customizer',
      'seo': 'seo-scripts',
      'newsletter': 'newsletter-config',
      'smtp': 'smtp-settings',
      'staff': 'team-accounts'
    };
    if (HASH_ALIASES[sectionId]) {
      sectionId = HASH_ALIASES[sectionId];
    }
    const targetSection = document.getElementById(sectionId);
    if (!targetSection) {
      console.warn('Target section not found:', sectionId);
      return;
    }

    // 1. Hide all sections, show target
    document.querySelectorAll('.settings-section').forEach(sec => {
      sec.classList.add('hidden');
    });
    targetSection.classList.remove('hidden');

    // 2. Update Header Title & Breadcrumbs
    const meta = MODULE_METADATA[sectionId];
    if (meta) {
