  let themePreviewNightMode = true;
  let selectedPreviewPaletteKey = 'cyber-emerald';

  function toggleThemePreviewMode() {
    themePreviewNightMode = !themePreviewNightMode;
    const toggle = document.getElementById('themePreviewModeToggle');
    const label = document.getElementById('previewModeLabel');
    const text = document.getElementById('themePreviewModeText');
    const icon = document.getElementById('themePreviewModeIcon');
    if (toggle) {
      toggle.setAttribute('aria-pressed', String(themePreviewNightMode));
      toggle.setAttribute(
        'aria-label',
        themePreviewNightMode ? 'Turn off night mode for theme preview' : 'Turn on night mode for theme preview'
      );
    }
    if (label) label.textContent = themePreviewNightMode ? 'Night preview' : 'Day preview';
    if (text) text.textContent = themePreviewNightMode ? 'Night on' : 'Night off';
    if (icon) icon.textContent = themePreviewNightMode ? 'dark_mode' : 'light_mode';
    renderPreviewCanvas(selectedPreviewPaletteKey);
  }

  function selectPalette(key) {
    selectedPreviewPaletteKey = key;
    // 1. Update radio input
    const radio = document.querySelector(`input[name="active_theme_palette"][value="${key}"]`);
    if (radio) radio.checked = true;

    // 2. Update visual card accents and active badges
    document.querySelectorAll('.palette-card').forEach(card => {
      const isMatch = card.dataset.paletteCard === key;
      const activeLabel = card.querySelector('.palette-active-label');
      card.classList.toggle('palette-card-active', isMatch);
      card.classList.toggle('border-slate-200', !isMatch);
      card.classList.toggle('dark:border-brand-border', !isMatch);
      card.classList.toggle('hover:border-slate-300', !isMatch);
      if (activeLabel) activeLabel.classList.toggle('hidden', !isMatch);
    });

    // 3. Render preview canvas
    renderPreviewCanvas(key);
  }

  function renderPreviewCanvas(key) {
    selectedPreviewPaletteKey = key;
    let p = PALETTE_DEFINITIONS[key];
    if (key === 'custom' || !p) {
      const bgP = document.getElementById('palette_bg_primary')?.value || '#0b1412';
      const bgS = document.getElementById('palette_bg_surface')?.value || '#13221e';
      const acP = document.getElementById('palette_accent_primary')?.value || '#059669';
      const acS = document.getElementById('palette_accent_secondary')?.value || '#55a630';
      const txP = document.getElementById('palette_text_primary')?.value || '#f1f5f9';

      p = {
        name: 'Custom Hex Engine',
        bgPrimary: bgP,
        bgSurface: bgS,
        accentPrimary: acP,
        accentSecondary: acS,
        textPrimary: txP,
        textMuted: '#94a3b8',
        borderColor: '#27443d'
      };

      // Also update chips
      const chipBg = document.getElementById('chip_bg_primary');
      const chipSurf = document.getElementById('chip_bg_surface');
      const chipAcP = document.getElementById('chip_accent_primary');
      const chipAcS = document.getElementById('chip_accent_secondary');
      const chipTx = document.getElementById('chip_text_primary');
      if (chipBg) chipBg.style.backgroundColor = bgP;
      if (chipSurf) chipSurf.style.backgroundColor = bgS;
      if (chipAcP) chipAcP.style.backgroundColor = acP;
      if (chipAcS) chipAcS.style.backgroundColor = acS;
      if (chipTx) chipTx.style.backgroundColor = txP;
    }

    const previewPalette = themePreviewNightMode ? p : {
      ...p,
      bgPrimary: '#f8fafc',
      bgSurface: '#ffffff',
      textPrimary: '#0f172a',
      textMuted: '#475569',
      borderColor: '#e2e8f0'
    };
    const box = document.getElementById('liveThemePreviewBox');
    if (!box) return;

    box.style.backgroundColor = previewPalette.bgPrimary;
    box.style.borderColor = previewPalette.borderColor;

    const badge = document.getElementById('previewPaletteNameBadge');
    if (badge) badge.innerText = p.name;

    const previewHeader = box.querySelector('.preview-header');
    if (previewHeader) previewHeader.style.borderColor = previewPalette.borderColor;
    const nav = document.getElementById('prevNav');
    if (nav) nav.style.color = previewPalette.textMuted;

    const brandIcon = document.getElementById('prevBrandIcon');
    if (brandIcon) brandIcon.style.backgroundColor = previewPalette.accentPrimary;

    const brandAccent = document.getElementById('prevBrandAccent');
    if (brandAccent) brandAccent.style.color = previewPalette.accentPrimary;

    const brandName = document.getElementById('prevBrandName');
    if (brandName) brandName.style.color = previewPalette.textPrimary;

    const navLink = document.getElementById('prevNavLink');
    if (navLink) navLink.style.color = previewPalette.accentPrimary;

    const subCard = document.getElementById('prevSubCard');
    if (subCard) {
      subCard.style.backgroundColor = previewPalette.bgSurface;
      subCard.style.borderColor = previewPalette.borderColor;
    }

    const pillTag = document.getElementById('prevPillTag');
    if (pillTag) {
      pillTag.style.backgroundColor = previewPalette.accentPrimary + '26';
      pillTag.style.color = previewPalette.accentPrimary;
      pillTag.style.borderColor = previewPalette.accentPrimary + '4d';
    }

    const metaText = document.getElementById('prevMetaText');
    if (metaText) metaText.style.color = previewPalette.textMuted;
    const title = document.getElementById('prevTitle');
    if (title) title.style.color = previewPalette.textPrimary;

    const titleAccent = document.getElementById('prevTitleAccent');
    if (titleAccent) titleAccent.style.color = previewPalette.accentPrimary;

    const desc = document.getElementById('prevDesc');
    if (desc) desc.style.color = previewPalette.textMuted;

    const btnPrimary = document.getElementById('prevBtnPrimary');
    if (btnPrimary) btnPrimary.style.backgroundColor = previewPalette.accentPrimary;

    const btnSecondary = document.getElementById('prevBtnSecondary');
    if (btnSecondary) {
      btnSecondary.style.color = previewPalette.accentSecondary;
      btnSecondary.style.borderColor = previewPalette.accentSecondary + '66';
    }

    box.querySelectorAll('.preview-swatch').forEach(swatch => {
      swatch.style.backgroundColor = themePreviewNightMode ? 'rgba(0, 0, 0, 0.4)' : '#f1f5f9';
      swatch.style.color = themePreviewNightMode ? '#cbd5e1' : '#334155';
      swatch.style.borderColor = themePreviewNightMode ? 'rgba(255, 255, 255, 0.05)' : '#e2e8f0';
    });

    // Update Swatch text
    const sBg = document.getElementById('swatchBgText');
    const sSurf = document.getElementById('swatchSurfaceText');
    const sPri = document.getElementById('swatchPrimaryText');
    const sSec = document.getElementById('swatchSecondaryText');
    const sTx = document.getElementById('swatchTextText');
    if (sBg) sBg.innerText = p.bgPrimary;
    if (sSurf) sSurf.innerText = p.bgSurface;
    if (sPri) sPri.innerText = p.accentPrimary;
    if (sSec) sSec.innerText = p.accentSecondary;
    if (sTx) sTx.innerText = p.textPrimary;
  }

  function editPaletteHexes(key) {
