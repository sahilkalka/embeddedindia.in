  function appendEmailTo(inputId, email) {
    const input = document.getElementById(inputId);
    if (!input) return;
    const current = (input.value || '').trim();
    if (!current) {
      input.value = email;
    } else {
      const list = current.split(',').map(s => s.trim());
      if (!list.includes(email)) {
        list.push(email);
        input.value = list.join(', ');
