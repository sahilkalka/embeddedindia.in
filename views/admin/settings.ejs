<%- include('layout_top') %>

<div class="max-w-4xl space-y-6">
  
  <div>
    <h1 class="text-2xl font-black text-slate-900 dark:text-white flex items-center space-x-2">
      <span>⚙️ Global System, SMTP &amp; Account Settings</span>
    </h1>
    <p class="text-xs text-slate-500 dark:text-[#94A3B8] mt-1">Configure company metadata, outgoing SMTP mailer, AdSense monetization, and administrative accounts</p>
  </div>

  <% if (success) { %>
    <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-xs font-bold flex items-center space-x-2 shadow-sm">
      <span>✅ System configuration settings saved successfully!</span>
    </div>
  <% } %>

  <!-- Main Settings Form -->
  <form action="/admin/settings" method="POST" class="space-y-6">
    
    <!-- 1. General Company Information -->
    <div class="bg-white dark:bg-[#111916] rounded-[14px] p-6 border border-slate-200 dark:border-[rgba(16,185,129,0.18)] shadow-sm space-y-5 mb-6">
      <h2 class="text-base font-bold uppercase tracking-wide text-[#0F172A] dark:text-white border-b border-slate-100 dark:border-[rgba(255,255,255,0.08)] pb-3">
        1. Company &amp; Contact Metadata
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">Company / Brand Name</label>
          <input type="text" name="site_name" value="<%= settings.site_name || 'Embedded India' %>" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] placeholder-[#94A3B8] dark:placeholder-[#64748B] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs font-semibold transition">
        </div>
        <div>
          <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">Primary Inquiries Email</label>
          <input type="email" name="contact_email" value="<%= settings.contact_email || 'info@embeddedindia.in' %>" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] placeholder-[#94A3B8] dark:placeholder-[#64748B] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs font-semibold transition">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">Phone / WhatsApp</label>
          <input type="text" name="contact_phone" value="<%= settings.contact_phone || '+91 98765 43210' %>" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] placeholder-[#94A3B8] dark:placeholder-[#64748B] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs font-semibold transition">
        </div>
        <div>
          <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">Offices &amp; Locations</label>
          <input type="text" name="contact_address" value="<%= settings.contact_address || 'Bangalore / Hyderabad / Pune, India' %>" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] placeholder-[#94A3B8] dark:placeholder-[#64748B] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs font-semibold transition">
        </div>
      </div>

      <!-- Homepage Hero Content -->
      <div class="pt-4 border-t border-slate-100 dark:border-[rgba(255,255,255,0.08)] space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">Hero Main Heading</label>
            <input type="text" name="hero_title" value="<%= settings.hero_title || 'Think Big.' %>" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] placeholder-[#94A3B8] dark:placeholder-[#64748B] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs font-semibold transition">
          </div>
          <div>
            <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">Hero Subheading Prefix</label>
            <input type="text" name="hero_subtitle" value="<%= settings.hero_subtitle || 'We Engineer:' %>" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] placeholder-[#94A3B8] dark:placeholder-[#64748B] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs font-semibold transition">
          </div>
        </div>
        <div>
          <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">Hero Description Paragraph</label>
          <textarea name="hero_description" rows="2" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] placeholder-[#94A3B8] dark:placeholder-[#64748B] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs transition"><%= settings.hero_description || 'From early napkin architecture and high-speed PCB layouts to deterministic RTOS firmware, HIL automated testing, and volume SMT manufacturing.' %></textarea>
        </div>
      </div>
    </div>

    <!-- 2. Outgoing Mail Server (SMTP) Configuration & Test -->
    <div class="bg-white dark:bg-[#111916] rounded-[14px] p-6 border border-slate-200 dark:border-[rgba(16,185,129,0.18)] shadow-sm space-y-5 mb-6">
      <div class="flex items-center justify-between border-b border-slate-100 dark:border-[rgba(255,255,255,0.08)] pb-3">
        <div>
          <h2 class="text-base font-bold uppercase tracking-wide text-[#0F172A] dark:text-white">
            2. Outgoing Mail Server (SMTP) Configuration
          </h2>
          <p class="text-xs text-slate-500 dark:text-[#94A3B8] mt-0.5">Used for consultation inquiries, newsletter double opt-in, and automated engineering digests</p>
        </div>
        <span class="text-[10px] bg-emerald-50 dark:bg-[rgba(16,185,129,0.15)] text-emerald-700 dark:text-[#34D399] border border-emerald-200 dark:border-[rgba(16,185,129,0.3)] font-bold px-2.5 py-1 rounded-full uppercase">
          SMTP Service
        </span>
      </div>

      <!-- Quick Preset Helper Buttons -->
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span class="text-[11px] font-bold text-slate-500 dark:text-[#94A3B8] mr-1">Quick Presets:</span>
        <button type="button" onclick="setSmtpPreset('gmail')" class="px-2.5 py-1 bg-slate-100 dark:bg-[#16211D] hover:bg-slate-200 dark:hover:bg-[#1f2e29] rounded-lg text-slate-700 dark:text-slate-300 text-[11px] font-semibold transition border border-slate-200 dark:border-[rgba(255,255,255,0.08)]">
          Gmail (smtp.gmail.com:587)
        </button>
        <button type="button" onclick="setSmtpPreset('sendgrid')" class="px-2.5 py-1 bg-slate-100 dark:bg-[#16211D] hover:bg-slate-200 dark:hover:bg-[#1f2e29] rounded-lg text-slate-700 dark:text-slate-300 text-[11px] font-semibold transition border border-slate-200 dark:border-[rgba(255,255,255,0.08)]">
          SendGrid (smtp.sendgrid.net:587)
        </button>
        <button type="button" onclick="setSmtpPreset('mock')" class="px-2.5 py-1 bg-slate-100 dark:bg-[#16211D] hover:bg-slate-200 dark:hover:bg-[#1f2e29] rounded-lg text-slate-700 dark:text-slate-300 text-[11px] font-semibold transition border border-slate-200 dark:border-[rgba(255,255,255,0.08)]">
          Dev / Local Mock
        </button>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="sm:col-span-2">
          <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">SMTP Host Server</label>
          <input type="text" id="smtp_host" name="smtp_host" value="<%= settings.smtp_host || '' %>" placeholder="smtp.gmail.com or smtp.sendgrid.net" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] placeholder-[#94A3B8] dark:placeholder-[#64748B] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs font-mono transition">
        </div>
        <div>
          <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">Port</label>
          <input type="number" id="smtp_port" name="smtp_port" value="<%= settings.smtp_port || '587' %>" placeholder="587 or 465" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] placeholder-[#94A3B8] dark:placeholder-[#64748B] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs font-mono transition">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">Encryption Protocol</label>
          <select id="smtp_secure" name="smtp_secure" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs font-semibold transition">
            <option value="false" <%= settings.smtp_secure !== 'true' ? 'selected' : '' %>>STARTTLS (Port 587 / 25)</option>
            <option value="true" <%= settings.smtp_secure === 'true' ? 'selected' : '' %>>SSL / TLS Direct (Port 465)</option>
          </select>
        </div>
        <div>
          <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">SMTP Username / Email</label>
          <input type="text" id="smtp_user" name="smtp_user" value="<%= settings.smtp_user || '' %>" placeholder="mailer@embeddedindia.in" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] placeholder-[#94A3B8] dark:placeholder-[#64748B] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs font-mono transition">
        </div>
        <div>
          <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">SMTP Password / App Key</label>
          <input type="password" id="smtp_pass" name="smtp_pass" value="<%= settings.smtp_pass || '' %>" placeholder="••••••••••••••••" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] placeholder-[#94A3B8] dark:placeholder-[#64748B] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs font-mono transition">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">Sender Display Name</label>
          <input type="text" name="smtp_from_name" value="<%= settings.smtp_from_name || 'Embedded India' %>" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] placeholder-[#94A3B8] dark:placeholder-[#64748B] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs font-semibold transition">
        </div>
        <div>
          <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">Sender Email Address</label>
          <input type="email" name="smtp_from_email" value="<%= settings.smtp_from_email || 'info@embeddedindia.in' %>" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] placeholder-[#94A3B8] dark:placeholder-[#64748B] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs font-semibold transition">
        </div>
      </div>

      <!-- Live Test SMTP Connection Box -->
      <div class="pt-4 border-t border-slate-100 dark:border-[rgba(255,255,255,0.06)] space-y-3">
        <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">
          🧪 Test SMTP Configuration &amp; Dispatch Verification Email
        </label>
        <div class="flex flex-col sm:flex-row items-center gap-3">
          <input type="email" id="smtpTestRecipient" value="<%= settings.contact_email || 'admin@embeddedindia.in' %>" placeholder="Recipient email for test delivery" class="flex-1 w-full h-[42px] px-3 py-2 rounded-[8px] bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] placeholder-[#94A3B8] dark:placeholder-[#64748B] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs transition">
          <button type="button" id="btnTestSmtp" class="w-full sm:w-auto h-[42px] px-5 bg-[#10B981] hover:bg-[#059669] text-white text-xs font-bold rounded-[8px] transition shadow-sm active:scale-95 flex items-center justify-center space-x-2 whitespace-nowrap">
            <span>✉ Test SMTP Connection</span>
          </button>
        </div>
        <div id="smtpTestResult" class="hidden p-3.5 rounded-xl text-xs font-mono"></div>
      </div>
    </div>

    <!-- 3. Monetization & Ad Account Validation -->
    <div class="bg-white dark:bg-[#111916] rounded-[14px] p-6 border border-slate-200 dark:border-[rgba(16,185,129,0.18)] shadow-sm space-y-5 mb-6">
      <div class="flex items-center justify-between border-b border-slate-100 dark:border-[rgba(255,255,255,0.08)] pb-3">
        <div>
          <h2 class="text-base font-bold uppercase tracking-wide text-[#0F172A] dark:text-white">
            3. Monetization &amp; Ad Account Validation (Google AdSense)
          </h2>
          <p class="text-xs text-slate-500 dark:text-[#94A3B8] mt-0.5">Validate your publisher account, enforce ad slot injection, and generate compliant ads.txt</p>
        </div>
        <span class="text-[10px] bg-emerald-50 dark:bg-[rgba(16,185,129,0.15)] text-emerald-700 dark:text-[#34D399] border border-emerald-200 dark:border-[rgba(16,185,129,0.3)] font-bold px-2.5 py-1 rounded-full uppercase">
          Monetization
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">Enable Google AdSense Slots</label>
          <select id="enable_adsense" name="enable_adsense" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs font-semibold transition">
            <option value="false" <%= settings.enable_adsense === 'false' ? 'selected' : '' %>>Disabled</option>
            <option value="true" <%= settings.enable_adsense === 'true' ? 'selected' : '' %>>Enabled</option>
          </select>
        </div>
        <div>
          <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">Google AdSense Publisher ID</label>
          <input type="text" id="adsense_pub_id" name="adsense_pub_id" value="<%= settings.adsense_pub_id || 'ca-pub-2644536267352236' %>" placeholder="ca-pub-2644536267352236" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] placeholder-[#94A3B8] dark:placeholder-[#64748B] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs font-mono font-semibold transition">
        </div>
      </div>

      <!-- Ad Account Validation Feature Sub-Card -->
      <div class="p-5 rounded-[12px] bg-slate-50 dark:bg-[#16211D] border border-slate-200 dark:border-[rgba(255,255,255,0.08)] space-y-3">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <span class="text-[0.95rem] font-semibold text-[#0F172A] dark:text-[#F8FAFC] block">Ad Account &amp; ads.txt Verification</span>
            <span class="text-[0.8rem] text-[#475569] dark:text-[#94A3B8]">Validates your publisher account syntax and creates the required root <code class="text-brand-500 font-mono">/ads.txt</code> record</span>
          </div>
          <div class="flex items-center gap-2">
            <button type="button" id="btnValidateAd" class="h-[42px] px-5 bg-[#10B981] hover:bg-[#059669] text-white text-xs font-bold rounded-[8px] transition shadow-sm active:scale-95 flex items-center space-x-1.5">
              <span>⚡ Validate Ad Account &amp; Sync ads.txt</span>
            </button>
            <a href="/ads.txt" target="_blank" class="h-[42px] px-4 flex items-center justify-center bg-white dark:bg-[#0C1310] hover:bg-slate-100 dark:hover:bg-[#16211D] text-[#334155] dark:text-slate-200 text-xs font-bold rounded-[8px] border border-slate-300 dark:border-[rgba(255,255,255,0.14)] transition shadow-sm">
              View /ads.txt &nearr;
            </a>
          </div>
        </div>
        <div id="adValidationResult" class="hidden p-3 rounded-lg text-xs font-mono"></div>
      </div>
    </div>

    <!-- 4. Native Internal Promo Banners -->
    <div class="bg-white dark:bg-[#111916] rounded-[14px] p-6 border border-slate-200 dark:border-[rgba(16,185,129,0.18)] shadow-sm space-y-5 mb-6">
      <h2 class="text-base font-bold uppercase tracking-wide text-[#0F172A] dark:text-white border-b border-slate-100 dark:border-[rgba(255,255,255,0.08)] pb-3">
        4. Native Internal Promotion Banner
      </h2>

      <div>
        <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">Banner Status</label>
        <select name="promo_banner_active" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs font-semibold transition">
          <option value="true" <%= settings.promo_banner_active === 'true' ? 'selected' : '' %>>Active (Show on header announcement)</option>
          <option value="false" <%= settings.promo_banner_active === 'false' ? 'selected' : '' %>>Hidden</option>
        </select>
      </div>

      <div>
        <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">Banner Title / Pitch</label>
        <input type="text" name="promo_banner_title" value="<%= settings.promo_banner_title || '' %>" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] placeholder-[#94A3B8] dark:placeholder-[#64748B] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs font-semibold transition">
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">Call-to-Action Text</label>
          <input type="text" name="promo_banner_cta" value="<%= settings.promo_banner_cta || 'Book an Engineering Feasibility Call' %>" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] placeholder-[#94A3B8] dark:placeholder-[#64748B] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs font-semibold transition">
        </div>
        <div>
          <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">Destination URL (with UTM)</label>
          <input type="text" name="promo_banner_url" value="<%= settings.promo_banner_url || '/contact?service=Hardware%20Design' %>" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] placeholder-[#94A3B8] dark:placeholder-[#64748B] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs font-mono transition">
        </div>
      </div>

      <!-- Contained Save Global Configuration Button inside Section 4 Footer Bar -->
      <div class="pt-4 border-t border-slate-200 dark:border-[rgba(255,255,255,0.06)] flex items-center justify-end">
        <button type="submit" class="h-[42px] px-5 bg-[#10B981] hover:bg-[#059669] text-white font-bold rounded-[8px] text-xs sm:text-sm transition shadow-sm active:scale-95 flex items-center justify-center space-x-2">
          <span>💾 Save Global Configuration</span>
        </button>
      </div>
    </div>

  </form>

  <!-- 5. Administrator & Staff Accounts Management Panel (Validate & Add Account) -->
  <div class="bg-white dark:bg-[#111916] rounded-[14px] p-6 border border-slate-200 dark:border-[rgba(16,185,129,0.18)] shadow-sm space-y-6 mb-6">
    <div class="flex items-center justify-between border-b border-slate-100 dark:border-[rgba(255,255,255,0.08)] pb-3">
      <div>
        <h2 class="text-base font-bold uppercase tracking-wide text-[#0F172A] dark:text-white">
          5. Team &amp; Administrator Account Management
        </h2>
        <p class="text-xs text-slate-500 dark:text-[#94A3B8] mt-0.5">Validate account credentials, assign roles, and grant admin access to engineering staff</p>
      </div>
      <span class="text-[10px] bg-emerald-50 dark:bg-[rgba(16,185,129,0.15)] text-emerald-700 dark:text-[#34D399] border border-emerald-200 dark:border-[rgba(16,185,129,0.3)] font-bold px-2.5 py-1 rounded-full uppercase">
        Access Control
      </span>
    </div>

    <!-- Existing Accounts Table -->
    <div class="overflow-x-auto rounded-[12px] border border-slate-200 dark:border-[rgba(255,255,255,0.08)] bg-white dark:bg-[#111916]">
      <table class="w-full text-left">
        <thead>
          <tr class="bg-slate-50 dark:bg-[rgba(255,255,255,0.03)] border-b border-slate-200 dark:border-[rgba(255,255,255,0.06)]">
            <th class="py-3 px-4 text-[0.75rem] font-bold uppercase tracking-[0.05em] text-[#64748B] dark:text-[#94A3B8]">Account Email</th>
            <th class="py-3 px-4 text-[0.75rem] font-bold uppercase tracking-[0.05em] text-[#64748B] dark:text-[#94A3B8]">Username</th>
            <th class="py-3 px-4 text-[0.75rem] font-bold uppercase tracking-[0.05em] text-[#64748B] dark:text-[#94A3B8]">Role</th>
            <th class="py-3 px-4 text-[0.75rem] font-bold uppercase tracking-[0.05em] text-[#64748B] dark:text-[#94A3B8]">Created</th>
            <th class="py-3 px-4 text-[0.75rem] font-bold uppercase tracking-[0.05em] text-[#64748B] dark:text-[#94A3B8] text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="usersTableBody" class="divide-y divide-slate-100 dark:divide-[rgba(255,255,255,0.06)] text-slate-700 dark:text-slate-300">
          <% (users || []).forEach(u => { %>
            <tr id="user-row-<%= u.id %>" class="hover:bg-slate-50 dark:hover:bg-[rgba(255,255,255,0.02)] transition">
              <td class="py-3.5 px-4 align-middle font-semibold text-slate-900 dark:text-white border-b border-slate-100 dark:border-[rgba(255,255,255,0.06)]">
                <%= u.email %>
                <% if (currentUser && currentUser.userId === u.id) { %>
                  <span class="ml-1.5 px-2 py-0.5 bg-[rgba(16,185,129,0.15)] text-[#059669] dark:text-[#34D399] border border-[rgba(16,185,129,0.3)] rounded-full text-[10px] font-bold">You</span>
                <% } %>
              </td>
              <td class="py-3.5 px-4 align-middle font-mono text-[11px] text-slate-600 dark:text-slate-400 border-b border-slate-100 dark:border-[rgba(255,255,255,0.06)]"><%= u.username %></td>
              <td class="py-3.5 px-4 align-middle border-b border-slate-100 dark:border-[rgba(255,255,255,0.06)]">
                <% if (u.role === 'admin') { %>
                  <span class="inline-block px-2.5 py-0.5 rounded-full text-[0.75rem] font-semibold uppercase bg-[rgba(16,185,129,0.15)] text-[#059669] dark:text-[#34D399] border border-[rgba(16,185,129,0.3)]">
                    Admin
                  </span>
                <% } else { %>
                  <span class="inline-block px-2.5 py-0.5 rounded-full text-[0.75rem] font-semibold uppercase bg-blue-50 dark:bg-[rgba(59,130,246,0.15)] text-blue-700 dark:text-blue-400 border border-blue-200 dark:border-[rgba(59,130,246,0.3)]">
                    <%= u.role %>
                  </span>
                <% } %>
              </td>
              <td class="py-3.5 px-4 align-middle text-slate-500 dark:text-[#94A3B8] text-[11px] border-b border-slate-100 dark:border-[rgba(255,255,255,0.06)]">
                <%= new Date(u.createdAt).toLocaleDateString() %>
              </td>
              <td class="py-3.5 px-4 align-middle text-right border-b border-slate-100 dark:border-[rgba(255,255,255,0.06)]">
                <% if (!currentUser || currentUser.userId !== u.id) { %>
                  <button type="button" onclick="deleteAccount('<%= u.id %>')" class="text-[#DC2626] dark:text-[#F87171] hover:bg-[rgba(239,68,68,0.12)] px-2.5 py-1 rounded-[6px] font-semibold text-[11px] transition">
                    Remove
                  </button>
                <% } else { %>
                  <span class="text-slate-400 dark:text-slate-500 text-[11px]">Active</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Validate & Add New Account Sub-Card -->
    <div class="p-5 rounded-[12px] bg-slate-50 dark:bg-[#16211D] border border-slate-200 dark:border-[rgba(255,255,255,0.08)] space-y-4">
      <div class="flex items-center space-x-2 flex-wrap gap-1">
        <span class="text-[0.95rem] font-semibold text-[#0F172A] dark:text-[#F8FAFC]">➕ Add &amp; Validate New Account</span>
        <span class="text-[0.8rem] text-[#475569] dark:text-[#94A3B8] font-normal">(Enforces email format, uniqueness, and strong password checks)</span>
      </div>

      <!-- Responsive 3-column CSS Grid -->
      <div class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(220px,1fr))] items-end">
        <div>
          <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">Staff Email</label>
          <input type="email" id="newAccountEmail" placeholder="engineer@embeddedindia.in" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] placeholder-[#94A3B8] dark:placeholder-[#64748B] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs transition">
        </div>
        <div>
          <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">Role</label>
          <select id="newAccountRole" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs font-semibold transition">
            <option value="admin">Administrator (Full Access)</option>
            <option value="editor">Content Editor (Blogs only)</option>
          </select>
        </div>
        <div>
          <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">Password (Min 8 chars)</label>
          <input type="password" id="newAccountPass" placeholder="••••••••••••" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] placeholder-[#94A3B8] dark:placeholder-[#64748B] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs font-mono transition">
        </div>
      </div>

      <div class="pt-4 border-t border-slate-200 dark:border-[rgba(255,255,255,0.06)] flex flex-col sm:flex-row items-center justify-between gap-3">
        <button type="button" id="btnAddAccount" class="w-full sm:w-auto h-[42px] px-5 bg-[#10B981] hover:bg-[#059669] text-white text-xs font-bold rounded-[8px] transition shadow-sm active:scale-95 flex items-center justify-center space-x-1.5">
          <span>⚡ Validate &amp; Create Account</span>
        </button>
        <span class="text-[0.8rem] text-[#475569] dark:text-[#94A3B8]">Account password is encrypted with salt rounds via bcrypt</span>
      </div>

      <div id="addAccountResult" class="hidden p-3 rounded-lg text-xs font-mono"></div>
    </div>

    <!-- Change Password Sub-Card for Currently Logged-in Staff -->
    <div class="p-5 rounded-[12px] bg-slate-50 dark:bg-[#16211D] border border-slate-200 dark:border-[rgba(255,255,255,0.08)] space-y-4">
      <div class="flex items-center space-x-2 flex-wrap gap-1">
        <span class="text-[0.95rem] font-semibold text-[#0F172A] dark:text-[#F8FAFC]">🔑 Change Your Active Account Password</span>
        <span class="text-[0.8rem] text-[#475569] dark:text-[#94A3B8] font-normal">(Updates credentials for <%= currentUser ? currentUser.email : 'your active session' %>)</span>
      </div>

      <!-- Responsive 2-column CSS Grid -->
      <div class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(260px,1fr))]">
        <div>
          <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">Current Password</label>
          <input type="password" id="currentAccountPass" placeholder="••••••••••••" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] placeholder-[#94A3B8] dark:placeholder-[#64748B] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs font-mono transition">
        </div>
        <div>
          <label class="block text-[0.85rem] font-medium text-[#334155] dark:text-[#CBD5E1] mb-[6px]">New Password (Min 8 characters)</label>
          <input type="password" id="updatedAccountPass" placeholder="••••••••••••" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-[#0C1310] text-[#0F172A] dark:text-[#F1F5F9] placeholder-[#94A3B8] dark:placeholder-[#64748B] border border-[#CBD5E1] dark:border-[rgba(255,255,255,0.14)] focus:outline-none focus:ring-2 focus:ring-[#10B981] focus:border-[#10B981] text-xs font-mono transition">
        </div>
      </div>

      <div class="pt-4 border-t border-slate-200 dark:border-[rgba(255,255,255,0.06)] flex items-center justify-start">
        <button type="button" id="btnChangePassword" class="h-[42px] px-5 bg-[rgba(16,185,129,0.12)] border border-[#10B981] text-[#059669] dark:text-[#34D399] hover:bg-[#10B981] hover:text-[#052E16] text-xs font-bold rounded-[8px] transition shadow-sm active:scale-95 flex items-center space-x-1.5">
          <span>Update Password</span>
        </button>
      </div>

      <div id="changePassResult" class="hidden p-3 rounded-lg text-xs font-mono"></div>
    </div>

  </div>

</div>

<script>
  // 1. SMTP Preset Autofill
  function setSmtpPreset(type) {
    if (type === 'gmail') {
      document.getElementById('smtp_host').value = 'smtp.gmail.com';
      document.getElementById('smtp_port').value = '587';
      document.getElementById('smtp_secure').value = 'false';
    } else if (type === 'sendgrid') {
      document.getElementById('smtp_host').value = 'smtp.sendgrid.net';
      document.getElementById('smtp_port').value = '587';
      document.getElementById('smtp_secure').value = 'false';
      document.getElementById('smtp_user').value = 'apikey';
    } else if (type === 'mock') {
      document.getElementById('smtp_host').value = 'localhost';
      document.getElementById('smtp_port').value = '1025';
      document.getElementById('smtp_secure').value = 'false';
      document.getElementById('smtp_user').value = 'mock';
      document.getElementById('smtp_pass').value = 'mock';
    }
  }

  // 2. Test SMTP Connection
  const btnTestSmtp = document.getElementById('btnTestSmtp');
  const smtpTestRecipient = document.getElementById('smtpTestRecipient');
  const smtpTestResult = document.getElementById('smtpTestResult');

  if (btnTestSmtp) {
    btnTestSmtp.addEventListener('click', async () => {
      smtpTestResult.className = 'p-3.5 rounded-xl text-xs font-mono bg-blue-50 dark:bg-blue-950/50 text-blue-800 dark:text-blue-300 border border-blue-200 dark:border-blue-800 block';
      smtpTestResult.innerHTML = '<span class="animate-pulse">🔄 Performing socket connection, TLS handshake, and dispatching verification email...</span>';
      btnTestSmtp.disabled = true;

      const payload = {
        host: document.getElementById('smtp_host').value,
        port: document.getElementById('smtp_port').value,
        secure: document.getElementById('smtp_secure').value,
        user: document.getElementById('smtp_user').value,
        pass: document.getElementById('smtp_pass').value,
        toEmail: smtpTestRecipient.value || document.getElementById('smtp_user').value
      };

      try {
        const res = await fetch('/admin/settings/test-smtp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          smtpTestResult.className = 'p-3.5 rounded-xl text-xs font-mono bg-emerald-50 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 block space-y-1 shadow-sm';
          smtpTestResult.innerHTML = `
            <div class="font-bold text-sm">✅ SMTP Connection &amp; Delivery Successful!</div>
            <div class="mt-1">${data.message || 'Verification test email dispatched successfully.'}</div>
            <div class="text-[10px] text-slate-500 font-mono">Message ID: ${data.messageId}</div>
          `;
        } else {
          smtpTestResult.className = 'p-3.5 rounded-xl text-xs font-mono bg-red-50 dark:bg-red-950/50 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800 block space-y-1';
          smtpTestResult.innerHTML = `
            <div class="font-bold text-sm">❌ SMTP Handshake Error</div>
            <div>${data.error}</div>
          `;
        }
      } catch (err) {
        smtpTestResult.className = 'p-3.5 rounded-xl text-xs font-mono bg-red-50 dark:bg-red-950/50 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800 block';
        smtpTestResult.innerHTML = `❌ <strong>Network Error:</strong> ${err.message}`;
      } finally {
        btnTestSmtp.disabled = false;
      }
    });
  }

  // 3. Validate Ad Account & ads.txt Sync
  const btnValidateAd = document.getElementById('btnValidateAd');
  const adValidationResult = document.getElementById('adValidationResult');

  if (btnValidateAd) {
    btnValidateAd.addEventListener('click', async () => {
      const pubId = document.getElementById('adsense_pub_id').value.trim();
      adValidationResult.className = 'p-3 rounded-lg text-xs font-mono bg-blue-50 dark:bg-blue-950/50 text-blue-800 dark:text-blue-300 border border-blue-200 dark:border-blue-800 block animate-pulse';
      adValidationResult.textContent = 'Validating Google AdSense publisher syntax and generating /ads.txt...';
      btnValidateAd.disabled = true;

      try {
        const res = await fetch('/admin/settings/validate-ad-account', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ pubId })
        });
        const data = await res.json();
        if (data.success) {
          adValidationResult.className = 'p-3 rounded-lg text-xs font-mono bg-emerald-50 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 block space-y-1';
          adValidationResult.innerHTML = `
            <div class="font-bold text-sm">✅ Ad Account Validated &amp; Verified!</div>
            <div><strong>Publisher ID:</strong> ${data.pubId}</div>
            <div><strong>ads.txt Record:</strong> <code>${data.adsTxtLine}</code></div>
            <div class="mt-1 text-[11px] text-emerald-700 dark:text-emerald-400">
              Successfully generated and served at <a href="${data.adsTxtUrl}" target="_blank" class="underline font-bold">/ads.txt</a>
            </div>
          `;
          document.getElementById('enable_adsense').value = 'true';
        } else {
          adValidationResult.className = 'p-3 rounded-lg text-xs font-mono bg-red-50 dark:bg-red-950/50 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800 block';
          adValidationResult.innerHTML = `❌ <strong>Ad Account Validation Failed:</strong> ${data.error}`;
        }
      } catch (err) {
        adValidationResult.className = 'p-3 rounded-lg text-xs font-mono bg-red-50 dark:bg-red-950/50 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800 block';
        adValidationResult.innerHTML = `❌ <strong>Request Failed:</strong> ${err.message}`;
      } finally {
        btnValidateAd.disabled = false;
      }
    });
  }

  // 4. Validate & Add Account Feature
  const btnAddAccount = document.getElementById('btnAddAccount');
  const addAccountResult = document.getElementById('addAccountResult');

  if (btnAddAccount) {
    btnAddAccount.addEventListener('click', async () => {
      const email = document.getElementById('newAccountEmail').value.trim();
      const password = document.getElementById('newAccountPass').value;
      const role = document.getElementById('newAccountRole').value;

      if (!email) {
        alert('Please enter an account email address.');
        return;
      }
      if (!password || password.length < 8) {
        alert('Password must be at least 8 characters long.');
        return;
      }

      addAccountResult.className = 'p-3 rounded-lg text-xs font-mono bg-blue-50 dark:bg-blue-950/50 text-blue-800 dark:text-blue-300 border border-blue-200 dark:border-blue-800 block animate-pulse';
      addAccountResult.textContent = 'Validating email uniqueness and hashing credentials...';
      btnAddAccount.disabled = true;

      try {
        const res = await fetch('/admin/settings/add-account', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password, role })
        });
        const data = await res.json();
        if (data.success) {
          addAccountResult.className = 'p-3 rounded-lg text-xs font-mono bg-emerald-50 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 block';
          addAccountResult.innerHTML = `✅ <strong>${data.message}</strong>`;

          // Append to table
          const tbody = document.getElementById('usersTableBody');
          const row = document.createElement('tr');
          row.id = `user-row-${data.user.id}`;
          row.className = 'hover:bg-slate-50 dark:hover:bg-[rgba(255,255,255,0.02)] transition';
          row.innerHTML = `
            <td class="py-3.5 px-4 align-middle font-semibold text-slate-900 dark:text-white border-b border-slate-100 dark:border-[rgba(255,255,255,0.06)]">${data.user.email}</td>
            <td class="py-3.5 px-4 align-middle font-mono text-[11px] text-slate-600 dark:text-slate-400 border-b border-slate-100 dark:border-[rgba(255,255,255,0.06)]">${data.user.username}</td>
            <td class="py-3.5 px-4 align-middle border-b border-slate-100 dark:border-[rgba(255,255,255,0.06)]">
              <span class="inline-block px-2.5 py-0.5 rounded-full text-[0.75rem] font-semibold uppercase ${data.user.role === 'admin' ? 'bg-[rgba(16,185,129,0.15)] text-[#059669] dark:text-[#34D399] border border-[rgba(16,185,129,0.3)]' : 'bg-blue-50 dark:bg-[rgba(59,130,246,0.15)] text-blue-700 dark:text-blue-400 border border-blue-200 dark:border-[rgba(59,130,246,0.3)]'}">
                ${data.user.role}
              </span>
            </td>
            <td class="py-3.5 px-4 align-middle text-slate-500 dark:text-[#94A3B8] text-[11px] border-b border-slate-100 dark:border-[rgba(255,255,255,0.06)]">${new Date().toLocaleDateString()}</td>
            <td class="py-3.5 px-4 align-middle text-right border-b border-slate-100 dark:border-[rgba(255,255,255,0.06)]">
              <button type="button" onclick="deleteAccount('${data.user.id}')" class="text-[#DC2626] dark:text-[#F87171] hover:bg-[rgba(239,68,68,0.12)] px-2.5 py-1 rounded-[6px] font-semibold text-[11px] transition">Remove</button>
            </td>
          `;
          tbody.prepend(row);

          // Clear inputs
          document.getElementById('newAccountEmail').value = '';
          document.getElementById('newAccountPass').value = '';
        } else {
          addAccountResult.className = 'p-3 rounded-lg text-xs font-mono bg-red-50 dark:bg-red-950/50 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800 block';
          addAccountResult.innerHTML = `❌ <strong>Account Validation Error:</strong> ${data.error}`;
        }
      } catch (err) {
        addAccountResult.className = 'p-3 rounded-lg text-xs font-mono bg-red-50 dark:bg-red-950/50 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800 block';
        addAccountResult.innerHTML = `❌ <strong>Request Failed:</strong> ${err.message}`;
      } finally {
        btnAddAccount.disabled = false;
      }
    });
  }

  // 5. Delete Account Function
  async function deleteAccount(id) {
    if (!confirm('Are you sure you want to remove this staff account?')) return;
    try {
      const res = await fetch('/admin/settings/delete-account', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id })
      });
      const data = await res.json();
      if (data.success) {
        document.getElementById(`user-row-${id}`)?.remove();
      } else {
        alert(data.error || 'Failed to remove account.');
      }
    } catch (e) {
      alert('Error removing account: ' + e.message);
    }
  }

  // 6. Change Password Function
  const btnChangePassword = document.getElementById('btnChangePassword');
  const changePassResult = document.getElementById('changePassResult');
  if (btnChangePassword) {
    btnChangePassword.addEventListener('click', async () => {
      const currentPassword = document.getElementById('currentAccountPass').value;
      const newPassword = document.getElementById('updatedAccountPass').value;

      if (!currentPassword || !newPassword) {
        changePassResult.className = 'p-3 rounded-lg text-xs font-mono bg-red-50 dark:bg-red-950/50 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800 block';
        changePassResult.textContent = 'Please fill out both current and new password.';
        return;
      }

      btnChangePassword.disabled = true;
      try {
        const res = await fetch('/admin/settings/change-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ currentPassword, newPassword })
        });
        const data = await res.json();
        if (data.success) {
          changePassResult.className = 'p-3 rounded-lg text-xs font-mono bg-emerald-50 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 block';
          changePassResult.textContent = '✅ ' + data.message;
          document.getElementById('currentAccountPass').value = '';
          document.getElementById('updatedAccountPass').value = '';
        } else {
          changePassResult.className = 'p-3 rounded-lg text-xs font-mono bg-red-50 dark:bg-red-950/50 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800 block';
          changePassResult.textContent = '❌ ' + data.error;
        }
      } catch (err) {
        changePassResult.className = 'p-3 rounded-lg text-xs font-mono bg-red-50 dark:bg-red-950/50 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800 block';
        changePassResult.textContent = '❌ Request failed: ' + err.message;
      } finally {
        btnChangePassword.disabled = false;
      }
    });
  }
</script>

