              <div>
                <span class="font-bold block text-slate-800 dark:text-slate-200">Description</span>
                <span class="text-[10px] text-slate-500 dark:text-slate-400 font-mono" id="descCount">Optimal</span>
              </div>
            </div>

            <div id="chk_keywords" class="p-2.5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 flex items-center space-x-2">
              <span class="status-icon text-emerald-500 font-bold">✓</span>
              <div>
                <span class="font-bold block text-slate-800 dark:text-slate-200">Focus Keywords</span>
                <span class="text-[10px] text-slate-500 dark:text-slate-400 font-mono" id="keywordsCount">Configured</span>
              </div>
            </div>

            <div id="chk_og" class="p-2.5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 flex items-center space-x-2">
              <span class="status-icon text-emerald-500 font-bold">✓</span>
              <div>
                <span class="font-bold block text-slate-800 dark:text-slate-200">OG Social Card</span>
                <span class="text-[10px] text-slate-500 dark:text-slate-400 font-mono">Image specified</span>
              </div>
            </div>
          </div>
        </div>

        <!-- SEO Input Fields -->
        <div class="space-y-4 text-xs">
          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="font-semibold text-slate-700 dark:text-slate-300">Meta Title</label>
              <span class="text-[10px] text-slate-500 dark:text-slate-400 font-mono" id="titleCounter">0 / 60 chars</span>
