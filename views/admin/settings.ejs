              <input type="text" name="carbon_placement_id" value="<%= settings.carbon_placement_id || '' %>" placeholder="Placement" class="w-full px-2 py-1.5 rounded-lg bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 text-xs font-mono">
