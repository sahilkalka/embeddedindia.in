  // INLINE PALETTE DRAWER CONTROLLERS (EXPAND, EDIT, SAVE, DELETE)
  // ====================================================================
  function togglePaletteDrawer(key) {
    const drawer = document.getElementById('drawer-' + key);
    if (!drawer) return;

    const isHidden = drawer.classList.contains('hidden');
    // Close other drawers
    document.querySelectorAll('.palette-drawer').forEach(d => d.classList.add('hidden'));

    if (isHidden) {
      // Sync drawer color inputs with current PALETTE_DEFINITIONS
      const p = PALETTE_DEFINITIONS[key];
      if (p) {
        syncDrawerInput(key, 'bgPrimary', p.bgPrimary);
        syncDrawerInput(key, 'bgSurface', p.bgSurface);
        syncDrawerInput(key, 'accentPrimary', p.accentPrimary);
        syncDrawerInput(key, 'accentSecondary', p.accentSecondary);
        syncDrawerInput(key, 'textPrimary', p.textPrimary);
      }
      drawer.classList.remove('hidden');
      selectPalette(key);
    }
  }

  function closePaletteDrawer(key) {
    const drawer = document.getElementById('drawer-' + key);
    if (drawer) drawer.classList.add('hidden');
  }

  function syncDrawerInput(key, prop, value) {
    const picker = document.getElementById('picker_' + key + '_' + prop);
    const hex = document.getElementById('hex_' + key + '_' + prop);
    if (picker) picker.value = value;
    if (hex) hex.value = value;
  }

    function onDrawerColorChange(key, prop, value) {
    if (!PALETTE_DEFINITIONS[key]) return;
    PALETTE_DEFINITIONS[key][prop] = value;
    syncDrawerInput(key, prop, value);

    // Update card swatches directly using classes
    const card = document.querySelector(`[data-palette-card="${key}"]`);
    if (card) {
      if (prop === 'bgPrimary') {
        const el = card.querySelector('.swatch-bg');
        if (el) el.style.background = value;
      } else if (prop === 'bgSurface') {
        const el = card.querySelector('.swatch-surface');
        if (el) el.style.background = value;
      } else if (prop === 'accentPrimary') {
        card.style.setProperty('--palette-accent', value);
        const el = card.querySelector('.swatch-primary');
        if (el) el.style.background = value;
      } else if (prop === 'accentSecondary') {
        const el = card.querySelector('.swatch-secondary');
        if (el) el.style.background = value;
      } else if (prop === 'textPrimary') {
        const el = card.querySelector('.swatch-text');
        if (el) el.style.background = value;
      }
    }

    // Select palette and re-render preview canvas
    selectPalette(key);
  }

  async function savePaletteChanges(key) {
    const p = PALETTE_DEFINITIONS[key];
    if (!p) return;

    const payload = {
      active_theme_palette: key,
      _active_tab: 'theme-engine'
    };
    payload['palette_override_' + key + '_bgPrimary'] = p.bgPrimary;
    payload['palette_override_' + key + '_bgSurface'] = p.bgSurface;
    payload['palette_override_' + key + '_accentPrimary'] = p.accentPrimary;
    payload['palette_override_' + key + '_accentSecondary'] = p.accentSecondary;
    payload['palette_override_' + key + '_textPrimary'] = p.textPrimary;

    try {
      const res = await fetch('/admin/settings', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.error || 'Unable to save palette.');
      showToast('✅ Saved custom hexes for ' + p.name + '!');
      closePaletteDrawer(key);
    } catch(err) {
      alert('Error saving palette: ' + err.message);
    }
  }

  async function updatePaletteState(key, action) {
    const response = await fetch(`/admin/settings/palettes/${encodeURIComponent(key)}/${action}`, {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      }
    });
    const data = await response.json();
    if (!response.ok || !data.success) throw new Error(data.error || 'Palette update failed.');
  }

  async function resetPalette(key) {
    const p = PALETTE_DEFINITIONS[key];
    if (!p) return;
    if (!confirm(`Restore ${p.name} to its original colors and make it available again?`)) return;
    try {
      await updatePaletteState(key, 'reset');
      window.location.hash = 'theme-engine';
      window.location.reload();
    } catch (err) {
      alert('Unable to restore palette: ' + err.message);
    }
  }

  async function deletePalette(key) {
    const p = PALETTE_DEFINITIONS[key];
    if (!p || !confirm(`Remove ${p.name} from the available palettes? You can restore it later.`)) return;
    try {
      await updatePaletteState(key, 'delete');
      window.location.hash = 'theme-engine';
      window.location.reload();
    } catch (err) {
      alert('Unable to delete palette: ' + err.message);
    }
  }

  window.switchSettingsSection = function(sectionId) {
    const targetSection = document.getElementById(sectionId);
    if (!targetSection) {
      console.warn('Target section not found:', sectionId);
      return;
    }

    // 1. Hide all sections, show target
    document.querySelectorAll('.settings-section').forEach(sec => {
      sec.classList.add('hidden');
    });
    targetSection.classList.remove('hidden');

    // 2. Update Header Title & Breadcrumbs
    const meta = MODULE_METADATA[sectionId];
    if (meta) {
      const pageTitle = document.getElementById('settingsPageTitle');
      const pageIcon = document.getElementById('settingsPageIcon');
      const pageSub = document.getElementById('settingsPageSubtitle');
      const crumb = document.getElementById('settingsBreadcrumbModule');
      if (pageTitle) pageTitle.textContent = meta.title;
      if (pageIcon) pageIcon.textContent = meta.icon;
      if (pageSub) pageSub.innerText = meta.subtitle;
      if (crumb) crumb.innerText = meta.breadcrumb;
    }

    // 3. Update taskbar navigation state
    document.querySelectorAll('.settings-nav-btn').forEach(btn => {
      const tab = btn.getAttribute('data-settings-tab');
      const isTarget = (tab === sectionId);
      btn.classList.toggle('is-active', isTarget);
      if (isTarget) btn.setAttribute('aria-current', 'page');
      else btn.removeAttribute('aria-current');
    });

    // 4. Update URL Hash seamlessly
    if (history.replaceState) {
      history.replaceState(null, null, '#' + sectionId);
    }

    // 5. Scroll to top smoothly
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };
  const switchSettingsSection = window.switchSettingsSection;

