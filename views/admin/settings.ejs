<%- include('layout_top') %>

<style>
  .settings-workspace {
    overflow: hidden;
    background: #fff;
  }
  .dark .settings-workspace { background: var(--bg-surface, #13221e); }
  .settings-taskbar {
    display: flex;
    flex-direction: column;
    background: transparent;
    border-bottom: 1px solid #e2e8f0;
    padding: 0.75rem;
  }
  .dark .settings-taskbar { border-color: #334155; }
  .settings-content { min-width: 0; }
  .settings-section {
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
  }
  .settings-nav-btn {
    display: flex;
    min-height: 4rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    border-radius: 0.9rem;
    padding: 0.55rem 0.25rem;
    color: #64748b;
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1.1;
    text-align: center;
    transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
  }
  .dark .settings-nav-btn { color: #cbd5e1; }
  .settings-nav-btn:hover { background: var(--bg-primary, #f1f5f9); color: var(--accent-primary, #059669); }
  .settings-nav-btn.is-active {
    background: var(--accent-primary, #059669);
    color: #fff;
    box-shadow: 0 6px 16px color-mix(in srgb, var(--accent-primary, #059669) 24%, transparent);
  }
  .settings-nav-btn:focus-visible {
    outline: 2px solid var(--accent-primary, #059669);
    outline-offset: 2px;
  }
  .settings-nav-icon { font-size: 1.35rem; line-height: 1; }
  .settings-nav-label { max-width: 100%; }
  .palette-picker-panel {
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    padding: 0.875rem;
    background: #f8fafc;
    color: #0f172a;
  }
  .palette-picker-heading { color: #0f172a !important; }
  .palette-picker-panel .palette-card {
    background: #fff;
    border-color: #e2e8f0;
    color: #0f172a;
  }
  .palette-picker-panel .palette-card-title { color: #0f172a !important; }
  .palette-picker-panel .palette-card-divider { border-color: #e2e8f0; }
  .palette-picker-panel .palette-card-edit {
    background: #f1f5f9;
    color: #0f172a;
  }
  .palette-picker-panel .palette-card-edit:hover { border-color: var(--accent-primary, #059669); }
  .palette-picker-panel .palette-card-active {
    background: color-mix(in srgb, var(--palette-accent, var(--accent-primary, #059669)) 8%, #fff);
  }
  .palette-picker-panel .palette-drawer {
    background: #fff;
    border-color: #e2e8f0;
    color: #0f172a;
  }
  .palette-picker-panel .palette-drawer-heading { color: var(--accent-primary, #059669); }
  .palette-picker-panel .palette-drawer-muted { color: #64748b; }
  .palette-picker-panel .palette-drawer-divider { border-color: #e2e8f0; }
  .palette-picker-panel .palette-drawer-input {
    background: #f8fafc;
    border-color: #cbd5e1;
    color: #0f172a;
  }
  .dark .palette-picker-panel {
    border-color: var(--border-color, #334155);
    background: var(--bg-primary, #0f172a);
    color: var(--text-primary, #f8fafc);
  }
  .dark .palette-picker-heading,
  .dark .palette-picker-panel .palette-card-title { color: var(--text-primary, #f8fafc) !important; }
  .dark .palette-picker-panel .palette-card {
    background: var(--bg-surface, #1e293b);
    border-color: var(--border-color, #334155);
    color: var(--text-primary, #f8fafc);
  }
  .dark .palette-picker-panel .palette-card-divider,
  .dark .palette-picker-panel .palette-drawer-divider { border-color: var(--border-color, #334155); }
  .dark .palette-picker-panel .palette-card-edit,
  .dark .palette-picker-panel .palette-drawer-input {
    background: var(--bg-primary, #0f172a);
    border-color: var(--border-color, #334155);
    color: var(--text-primary, #f8fafc);
  }
  .dark .palette-picker-panel .palette-card-active {
    background: color-mix(in srgb, var(--palette-accent, var(--accent-primary, #059669)) 8%, var(--bg-surface, #1e293b));
  }
  .dark .palette-picker-panel .palette-drawer {
    background: var(--bg-surface, #1e293b);
    border-color: var(--border-color, #334155);
    color: var(--text-primary, #f8fafc);
  }
  .dark .palette-picker-panel .palette-drawer-muted { color: var(--text-muted, #94a3b8); }
  .dark .palette-picker-panel .palette-drawer-input { color: var(--text-primary, #f8fafc); }
  .palette-card-active {
    border-color: var(--palette-accent, var(--accent-primary, #059669)) !important;
    background: color-mix(in srgb, var(--palette-accent, var(--accent-primary, #059669)) 8%, transparent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--palette-accent, var(--accent-primary, #059669)) 20%, transparent);
  }
  @media (min-width: 1024px) {
    .settings-workspace { min-height: 38rem; }
    .settings-taskbar {
      width: 7.5rem;
      flex-shrink: 0;
      border-bottom: 0;
      border-right: 1px solid #e2e8f0;
      padding: 1rem 0.75rem;
    }
    .dark .settings-taskbar { border-color: #334155; }
    .settings-content { flex: 1; }
    .settings-nav-btn { min-height: 4.25rem; }
  }
</style>

<div class="max-w-7xl mx-auto space-y-6 pb-20">
  
  <!-- Top Settings Title & Controls Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-5">
    <div>
      <div class="flex items-center space-x-2 text-xs font-bold text-brand-600 dark:text-accent uppercase tracking-wider mb-1">
        <span>Admin Dashboard</span>
        <span>/</span>
        <span id="settingsBreadcrumbModule">Themes &amp; Palettes</span>
      </div>
      <h1 class="text-2xl font-black text-slate-900 dark:text-white flex items-center gap-2.5">
        <span id="settingsPageIcon" class="material-symbols-rounded text-brand-600 dark:text-accent" aria-hidden="true">palette</span>
        <span id="settingsPageTitle">Dynamic Theme &amp; Color Palette Engine</span>
      </h1>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1" id="settingsPageSubtitle">
        Live side-by-side color palette engine: select a unified scheme or customize hex values with real-time component updates.
      </p>
    </div>

    <div class="flex items-center space-x-2.5 flex-shrink-0">
      <a href="/" target="_blank" class="px-3.5 py-2 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 rounded-xl text-xs font-bold transition flex items-center space-x-1.5 border border-slate-300 dark:border-slate-700">
        <span>👁️ View Public Site</span>
        <span>&nearr;</span>
      </a>
      <a href="/admin" class="px-3.5 py-2 bg-red-500/10 hover:bg-red-500/20 text-red-600 dark:text-red-400 rounded-xl text-xs font-bold transition flex items-center space-x-1 border border-red-500/20">
        <span>✕ Exit Settings</span>
      </a>
    </div>
  </div>

  <!-- Global Toast Notification Banner for AJAX Saves -->
  <div id="settingsToast" class="hidden fixed bottom-6 right-6 z-50 p-4 rounded-2xl bg-emerald-600 text-white shadow-2xl text-xs font-bold flex items-center space-x-2.5 animate-in fade-in slide-in-from-bottom duration-200">
    <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
    <span id="settingsToastMsg">Module settings updated and applied live!</span>
  </div>

  <% if (success) { %>
    <div class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-xs font-bold flex items-center space-x-2 shadow-sm">
      <svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
      <span>Settings configuration successfully updated and synced across all pages.</span>
    </div>
  <% } %>

  <!-- Taskbar-style settings navigation -->
  <div class="settings-workspace flex flex-col lg:flex-row rounded-3xl border border-slate-200 dark:border-slate-700 shadow-sm">
    <aside id="settingsLeftSidebar" class="settings-taskbar flex-shrink-0">
      <div class="hidden lg:flex flex-col items-center gap-1 border-b border-slate-200 dark:border-slate-700 pb-3 mb-2">
        <div class="w-9 h-9 rounded-xl bg-brand-500 text-white flex items-center justify-center font-black text-xs shadow-sm">EI</div>
        <span class="text-[9px] font-bold text-slate-500 dark:text-slate-400">SETTINGS</span>
      </div>
      <nav class="grid grid-cols-4 sm:grid-cols-8 lg:grid-cols-1 gap-1.5" id="settings-sidebar-nav" aria-label="Settings modules">
        <button type="button" data-settings-tab="theme-engine" aria-label="Themes" title="Themes &amp; Palettes" aria-current="page" class="settings-nav-btn is-active">
          <span class="material-symbols-rounded settings-nav-icon" aria-hidden="true">palette</span>
          <span class="settings-nav-label">Themes</span>
        </button>
        <button type="button" data-settings-tab="site-customizer" aria-label="Customizer" title="Site Customizer" class="settings-nav-btn">
          <span class="material-symbols-rounded settings-nav-icon" aria-hidden="true">tune</span>
          <span class="settings-nav-label">Customizer</span>
        </button>
        <button type="button" data-settings-tab="feature-flags" aria-label="Flags and preview" title="Feature Flags &amp; Preview" class="settings-nav-btn">
          <span class="material-symbols-rounded settings-nav-icon" aria-hidden="true">flag</span>
          <span class="settings-nav-label">Flags &amp; Live</span>
        </button>
        <button type="button" data-settings-tab="seo-scripts" aria-label="Dynamic SEO" title="Dynamic SEO &amp; AI" class="settings-nav-btn">
          <span class="material-symbols-rounded settings-nav-icon" aria-hidden="true">query_stats</span>
          <span class="settings-nav-label">SEO</span>
        </button>
        <button type="button" data-settings-tab="monetization-ads" aria-label="Monetization" title="Monetization &amp; Ads" class="settings-nav-btn">
          <span class="material-symbols-rounded settings-nav-icon" aria-hidden="true">payments</span>
          <span class="settings-nav-label">Monetization</span>
        </button>
        <button type="button" data-settings-tab="newsletter-config" aria-label="Newsletter" title="Newsletter Configuration" class="settings-nav-btn">
          <span class="material-symbols-rounded settings-nav-icon" aria-hidden="true">mail</span>
          <span class="settings-nav-label">Newsletter</span>
        </button>
        <button type="button" data-settings-tab="smtp-settings" aria-label="SMTP and routing" title="SMTP &amp; Recipient Routing" class="settings-nav-btn">
          <span class="material-symbols-rounded settings-nav-icon" aria-hidden="true">outgoing_mail</span>
          <span class="settings-nav-label">SMTP</span>
        </button>
        <button type="button" data-settings-tab="team-accounts" aria-label="Staff accounts" title="Staff Accounts &amp; Access" class="settings-nav-btn">
          <span class="material-symbols-rounded settings-nav-icon" aria-hidden="true">group</span>
          <span class="settings-nav-label">Staff</span>
        </button>
      </nav>
    </aside>

    <!-- RIGHT CONTENT AREA -->
    <div class="settings-content flex-1 min-w-0">

    <!-- ============================================================== -->
    <!-- MODULE 1: DYNAMIC THEME & COLOR PALETTE ENGINE (SIDE-BY-SIDE) -->
    <!-- ============================================================== -->
    <section id="theme-engine" class="settings-section bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-sm space-y-6">
      
      <form class="settings-module-form space-y-6" action="/admin/settings" method="POST" data-module="Theme &amp; Palettes">
        <input type="hidden" name="_active_tab" value="theme-engine">

        <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-100 dark:border-brand-border pb-4 gap-3">
          <div>
            <h2 class="text-lg font-black text-slate-900 dark:text-white flex items-center space-x-2">
              <span>🎨 Dynamic Theme &amp; Color Palette Engine</span>
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Select a unified palette on the left to immediately preview real-time component updates on the right. Preview night mode is local and does not change the live site.</p>
          </div>
          <div class="flex items-center space-x-2 flex-shrink-0">
            <button type="submit" class="px-5 py-2.5 bg-brand-500 hover:bg-brand-600 text-white rounded-xl text-xs font-black transition shadow-sm active:scale-95 flex items-center space-x-1.5">
              <span>💾 Save Theme &amp; Palettes</span>
            </button>
          </div>
        </div>

        <!-- 2-COLUMN SPLIT: LEFT LIST OF PALETTES (5 cols) | RIGHT STICKY PREVIEW (7 cols) -->
        <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 items-start">
          
          <!-- LEFT COLUMN: VERTICAL LIST OF PALETTE CARDS -->
          <div class="palette-picker-panel xl:col-span-5 space-y-3.5">
            <label class="palette-picker-heading block text-xs font-bold uppercase tracking-wider mb-2">
              Choose Active Public &amp; Admin Palette:
            </label>

<% 
            const PALETTES_LIST = [
              {
                key: 'cyber-emerald',
                num: '1',
                name: 'Cyber Emerald',
                badge: 'Default B2B',
                badgeClass: 'bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300',
                borderActiveClass: 'border-brand-500 bg-brand-50/20 dark:bg-brand-900/20 ring-2 ring-brand-500/20',
                radioClass: 'text-brand-500 focus:ring-brand-500',
                activeLabelColor: 'text-brand-600 dark:text-accent',
                defaults: { bgPrimary: '#0b1412', bgSurface: '#13221e', accentPrimary: '#059669', accentSecondary: '#55a630', textPrimary: '#f1f5f9', borderColor: '#1e3831' },
                isActive: (!settings.active_theme_palette || settings.active_theme_palette === 'cyber-emerald' || settings.active_theme_palette === 'emerald' || settings.active_theme_palette === 'pcb-emerald-green')
              },
              {
                key: 'quantum-cyan',
                num: '2',
                name: 'Quantum Cyan',
                badge: 'Quantum',
                badgeClass: 'bg-sky-100 dark:bg-sky-950 text-sky-800 dark:text-sky-300',
                borderActiveClass: 'border-sky-500 bg-sky-50/20 dark:bg-sky-950/20 ring-2 ring-sky-500/20',
                radioClass: 'text-sky-500 focus:ring-sky-500',
                activeLabelColor: 'text-sky-600 dark:text-sky-400',
                defaults: { bgPrimary: '#08101a', bgSurface: '#0f1d2e', accentPrimary: '#0ea5e9', accentSecondary: '#06b6d4', textPrimary: '#f8fafc', borderColor: '#172a42' },
                isActive: (settings.active_theme_palette === 'quantum-cyan' || settings.active_theme_palette === 'cyan' || settings.active_theme_palette === 'silicon-dark-blue')
              },
              {
                key: 'titanium-slate',
                num: '3',
                name: 'Titanium Slate',
                badge: 'Precision',
                badgeClass: 'bg-slate-200 dark:bg-slate-800 text-slate-800 dark:text-slate-300',
                borderActiveClass: 'border-slate-500 bg-slate-100/50 dark:bg-slate-800/40 ring-2 ring-slate-500/20',
                radioClass: 'text-slate-600 focus:ring-slate-600',
                activeLabelColor: 'text-slate-700 dark:text-slate-300',
                defaults: { bgPrimary: '#090d16', bgSurface: '#0f172a', accentPrimary: '#38bdf8', accentSecondary: '#64748b', textPrimary: '#f8fafc', borderColor: '#334155' },
                isActive: (settings.active_theme_palette === 'titanium-slate' || settings.active_theme_palette === 'spacegrey' || settings.active_theme_palette === 'automotive-slate-red')
              },
              {
                key: 'solar-amber',
                num: '4',
                name: 'Solar Amber',
                badge: 'Industrial',
                badgeClass: 'bg-amber-100 dark:bg-amber-950 text-amber-800 dark:text-amber-300',
                borderActiveClass: 'border-amber-500 bg-amber-50/20 dark:bg-amber-950/20 ring-2 ring-amber-500/20',
                radioClass: 'text-amber-500 focus:ring-amber-500',
                activeLabelColor: 'text-amber-600 dark:text-amber-400',
                defaults: { bgPrimary: '#18181b', bgSurface: '#27272a', accentPrimary: '#f59e0b', accentSecondary: '#fbbf24', textPrimary: '#fafafa', borderColor: '#3f3f46' },
                isActive: (settings.active_theme_palette === 'solar-amber' || settings.active_theme_palette === 'industrial-amber-charcoal')
              },
              {
                key: 'supernova-violet',
                num: '5',
                name: 'Supernova Violet',
                badge: 'Deep Space',
                badgeClass: 'bg-purple-100 dark:bg-purple-950 text-purple-800 dark:text-purple-300',
                borderActiveClass: 'border-purple-500 bg-purple-50/20 dark:bg-purple-950/20 ring-2 ring-purple-500/20',
                radioClass: 'text-purple-600 focus:ring-purple-600',
                activeLabelColor: 'text-purple-600 dark:text-purple-400',
                defaults: { bgPrimary: '#0f0c1b', bgSurface: '#18142a', accentPrimary: '#a855f7', accentSecondary: '#c084fc', textPrimary: '#faf5ff', borderColor: '#3b2d54' },
                isActive: (settings.active_theme_palette === 'supernova-violet')
              },
              {
                key: 'clean-light',
                num: '6',
                name: 'Clean Enterprise',
                badge: 'Enterprise',
                badgeClass: 'bg-blue-100 dark:bg-blue-950 text-blue-800 dark:text-blue-300',
                borderActiveClass: 'border-blue-600 bg-blue-50/20 dark:bg-blue-950/20 ring-2 ring-blue-500/20',
                radioClass: 'text-blue-600 focus:ring-blue-600',
                activeLabelColor: 'text-blue-600 dark:text-blue-400',
                defaults: { bgPrimary: '#f8fafc', bgSurface: '#ffffff', accentPrimary: '#2563eb', accentSecondary: '#3b82f6', textPrimary: '#0f172a', borderColor: '#e2e8f0' },
                isActive: (settings.active_theme_palette === 'clean-light' || settings.active_theme_palette === 'clean-light-enterprise')
              }
            ];
            %>

            <% const AVAILABLE_PALETTES = PALETTES_LIST.filter(p => settings[`palette_deleted_${p.key}`] !== 'true'); %>
            <% const DELETED_PALETTES = PALETTES_LIST.filter(p => settings[`palette_deleted_${p.key}`] === 'true'); %>
            <% AVAILABLE_PALETTES.forEach(p => {
              const curBgP = settings['palette_override_' + p.key + '_bgPrimary'] || p.defaults.bgPrimary;
              const curBgS = settings['palette_override_' + p.key + '_bgSurface'] || p.defaults.bgSurface;
              const curAcP = settings['palette_override_' + p.key + '_accentPrimary'] || p.defaults.accentPrimary;
              const curAcS = settings['palette_override_' + p.key + '_accentSecondary'] || p.defaults.accentSecondary;
              const curTxP = settings['palette_override_' + p.key + '_textPrimary'] || p.defaults.textPrimary;
            %>
            <div data-palette-card="<%= p.key %>" style="--palette-accent: <%= curAcP %>" class="palette-card p-4 rounded-2xl border-2 transition cursor-pointer <%= p.isActive ? 'palette-card-active' : 'border-slate-200 dark:border-brand-border hover:border-slate-300' %>" onclick="selectPalette('<%= p.key %>')">
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2.5">
                  <input type="radio" name="active_theme_palette" value="<%= p.key %>" <%= p.isActive ? 'checked' : '' %> onchange="selectPalette('<%= p.key %>')" class="w-4 h-4 <%= p.radioClass %>">
                  <span class="palette-card-title text-xs font-black"><%= p.num %>. <%= p.name %></span>
                </div>
                <span class="text-[10px] px-2 py-0.5 rounded-full font-bold <%= p.badgeClass %>"><%= p.badge %></span>
              </div>
              <div class="palette-card-divider flex items-center justify-between mt-3 pt-2 border-t">
                <div class="flex items-center space-x-1.5">
                  <span class="swatch-bg w-5 h-5 rounded-md shadow-xs border border-white/20" style="background:<%= curBgP %>" title="BG: <%= curBgP %>"></span>
                  <span class="swatch-surface w-5 h-5 rounded-md shadow-xs border border-white/20" style="background:<%= curBgS %>" title="Surface: <%= curBgS %>"></span>
                  <span class="swatch-primary w-5 h-5 rounded-md shadow-xs" style="background:<%= curAcP %>" title="Primary: <%= curAcP %>"></span>
                  <span class="swatch-secondary w-5 h-5 rounded-md shadow-xs" style="background:<%= curAcS %>" title="Secondary: <%= curAcS %>"></span>
                  <span class="swatch-text w-5 h-5 rounded-md shadow-xs border border-slate-300 dark:border-slate-700" style="background:<%= curTxP %>" title="Text: <%= curTxP %>"></span>
                </div>
                <div class="flex items-center space-x-2">
                  <span class="palette-active-label text-[10px] font-bold <%= p.activeLabelColor %> <%= p.isActive ? '' : 'hidden' %>">✓ Active</span>
                  <button type="button" onclick="event.stopPropagation(); togglePaletteDrawer('<%= p.key %>');" class="palette-card-edit text-[11px] px-2.5 py-1 rounded-lg font-bold transition flex items-center space-x-1">
                    <span>✏️</span> <span>Edit</span>
                  </button>
                </div>
              </div>

              <!-- Inline Expandable Palette Color Drawer -->
              <div id="drawer-<%= p.key %>" class="palette-drawer hidden mt-3 p-4 rounded-2xl border space-y-3.5 shadow-xl animate-in fade-in zoom-in-95 duration-200" onclick="event.stopPropagation();">
                <div class="palette-drawer-divider flex items-center justify-between border-b pb-2">
                  <div class="flex items-center space-x-2">
                    <span class="palette-drawer-heading text-xs font-black uppercase tracking-wider">
                      🎨 Edit <%= p.name %> Colors
                    </span>
                    <span class="palette-drawer-muted text-[10px] font-mono">Live Binding</span>
                  </div>
                  <button type="button" onclick="closePaletteDrawer('<%= p.key %>')" class="palette-drawer-muted text-xs hover:opacity-75 p-1 rounded-lg">✕</button>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs">
                  <div>
                    <label class="palette-drawer-muted block font-semibold mb-1">Canvas BG</label>
                    <div class="flex items-center space-x-1">
                      <input type="color" id="picker_<%= p.key %>_bgPrimary" value="<%= curBgP %>" onchange="onDrawerColorChange('<%= p.key %>', 'bgPrimary', this.value)" class="w-7 h-7 rounded border border-slate-600 bg-transparent cursor-pointer">
