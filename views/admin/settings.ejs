<%- include('layout_top') %>

<div class="max-w-5xl space-y-8">
  
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-5">
    <div>
      <h1 class="text-2xl font-black text-slate-900 dark:text-white flex items-center space-x-2">
        <span>⚙️ Site Customizer, Theme Engine &amp; Monetization Hub</span>
      </h1>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Configure dynamic styling, typography, feature flags, multi-provider monetization, SEO overrides, and SMTP delivery</p>
    </div>

    <div class="flex items-center space-x-2">
      <a href="/" target="_blank" class="px-3.5 py-2 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 rounded-xl text-xs font-bold transition flex items-center space-x-1.5 border border-slate-300 dark:border-slate-700">
        <span>View Live Site</span>
        <span>&nearr;</span>
      </a>
      <button type="submit" form="mainSettingsForm" class="px-5 py-2 bg-brand-500 hover:bg-brand-600 text-white rounded-xl text-xs font-bold transition shadow-md active:scale-95 flex items-center space-x-1.5">
        <span>💾 Save All Changes</span>
      </button>
    </div>
  </div>

  <% if (success) { %>
    <div class="p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-xs font-bold flex items-center space-x-2 shadow-sm animate-in fade-in duration-200">
      <svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
      <span>All system customizations, palettes, SEO tags, and monetization rules saved and applied live!</span>
    </div>
  <% } %>

  <!-- Quick Navigation Sub-Tabs -->
  <div class="flex items-center space-x-2 overflow-x-auto pb-2 border-b border-slate-200 dark:border-slate-800 text-xs font-bold">
    <a href="#theme-engine" class="px-3.5 py-1.5 rounded-xl bg-brand-50 dark:bg-brand-900/40 text-brand-600 dark:text-accent whitespace-nowrap">🎨 1. Theme &amp; Palettes</a>
    <a href="#site-customizer" class="px-3.5 py-1.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 whitespace-nowrap">🎛️ 2. No-Code Customizer</a>
    <a href="#feature-flags" class="px-3.5 py-1.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 whitespace-nowrap">🚩 3. Feature Flags</a>
    <a href="#seo-scripts" class="px-3.5 py-1.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 whitespace-nowrap">🔍 4. Dynamic SEO &amp; Scripts</a>
    <a href="#monetization-ads" class="px-3.5 py-1.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 whitespace-nowrap">💰 5. Monetization &amp; Ads</a>
    <a href="#smtp-settings" class="px-3.5 py-1.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 whitespace-nowrap">📧 6. Outgoing SMTP</a>
    <a href="#team-accounts" class="px-3.5 py-1.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 whitespace-nowrap">👥 7. Team Accounts</a>
  </div>

  <form id="mainSettingsForm" action="/admin/settings" method="POST" class="space-y-8">

    <!-- ========================================== -->
    <!-- MODULE 1: DYNAMIC THEME & COLOR PALETTE ENGINE -->
    <!-- ========================================== -->
    <section id="theme-engine" class="bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-sm space-y-6">
      <div class="flex items-center justify-between border-b border-slate-100 dark:border-brand-border pb-4">
        <div>
          <h2 class="text-lg font-black text-slate-900 dark:text-white flex items-center space-x-2">
            <span>🎨 Dynamic Theme &amp; Color Palette Engine</span>
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Select from 5 predefined B2B Embedded Tech palettes or define custom hex values injected directly into root CSS variables.</p>
        </div>
        <span class="text-[10px] bg-brand-50 dark:bg-brand-900/60 text-brand-600 dark:text-accent font-bold px-2.5 py-1 rounded-full uppercase">
          Theme Engine
        </span>
      </div>

      <!-- Predefined Palettes Selector Cards -->
      <div>
        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-3">
          Select Active Live Palette:
        </label>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          
          <!-- 1. Cyber Emerald -->
          <label class="relative flex flex-col p-4 rounded-2xl border-2 cursor-pointer transition <%= (!settings.active_theme_palette || settings.active_theme_palette === 'cyber-emerald' || settings.active_theme_palette === 'emerald' || settings.active_theme_palette === 'pcb-emerald-green') ? 'border-emerald-500 bg-emerald-50/20 dark:bg-emerald-950/20' : 'border-slate-200 dark:border-brand-border hover:border-slate-300' %>">
            <input type="radio" name="active_theme_palette" value="cyber-emerald" <%= (!settings.active_theme_palette || settings.active_theme_palette === 'cyber-emerald' || settings.active_theme_palette === 'emerald' || settings.active_theme_palette === 'pcb-emerald-green') ? 'checked' : '' %> class="sr-only" onchange="previewPalette('cyber-emerald')">
            <div class="flex items-center justify-between">
              <span class="text-xs font-black text-slate-900 dark:text-white">1. Cyber Emerald</span>
              <span class="text-[10px] px-2 py-0.5 rounded-full font-bold bg-emerald-100 text-emerald-800">Default B2B</span>
            </div>
            <div class="flex items-center space-x-1.5 mt-3">
              <span class="w-6 h-6 rounded-lg shadow-xs" style="background:#0b1412" title="Background"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs" style="background:#13221e" title="Surface"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs" style="background:#059669" title="Primary"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs" style="background:#55a630" title="Secondary"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs border border-slate-300" style="background:#f1f5f9" title="Text"></span>
            </div>
          </label>

          <!-- 2. Quantum Cyan -->
          <label class="relative flex flex-col p-4 rounded-2xl border-2 cursor-pointer transition <%= (settings.active_theme_palette === 'quantum-cyan' || settings.active_theme_palette === 'cyan' || settings.active_theme_palette === 'silicon-dark-blue') ? 'border-sky-500 bg-sky-50/20 dark:bg-sky-950/20' : 'border-slate-200 dark:border-brand-border hover:border-slate-300' %>">
            <input type="radio" name="active_theme_palette" value="quantum-cyan" <%= (settings.active_theme_palette === 'quantum-cyan' || settings.active_theme_palette === 'cyan' || settings.active_theme_palette === 'silicon-dark-blue') ? 'checked' : '' %> class="sr-only" onchange="previewPalette('quantum-cyan')">
            <div class="flex items-center justify-between">
              <span class="text-xs font-black text-slate-900 dark:text-white">2. Quantum Cyan</span>
              <span class="text-[10px] px-2 py-0.5 rounded-full font-bold bg-sky-100 text-sky-800">Quantum</span>
            </div>
            <div class="flex items-center space-x-1.5 mt-3">
              <span class="w-6 h-6 rounded-lg shadow-xs" style="background:#08101a" title="Background"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs" style="background:#0f1d2e" title="Surface"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs" style="background:#0ea5e9" title="Primary"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs" style="background:#06b6d4" title="Secondary"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs border border-slate-300" style="background:#f8fafc" title="Text"></span>
            </div>
          </label>

          <!-- 3. Titanium Slate -->
          <label class="relative flex flex-col p-4 rounded-2xl border-2 cursor-pointer transition <%= (settings.active_theme_palette === 'titanium-slate' || settings.active_theme_palette === 'spacegrey') ? 'border-slate-500 bg-slate-100/50 dark:bg-slate-800/40' : 'border-slate-200 dark:border-brand-border hover:border-slate-300' %>">
            <input type="radio" name="active_theme_palette" value="titanium-slate" <%= (settings.active_theme_palette === 'titanium-slate' || settings.active_theme_palette === 'spacegrey') ? 'checked' : '' %> class="sr-only" onchange="previewPalette('titanium-slate')">
            <div class="flex items-center justify-between">
              <span class="text-xs font-black text-slate-900 dark:text-white">3. Titanium Slate</span>
              <span class="text-[10px] px-2 py-0.5 rounded-full font-bold bg-slate-200 text-slate-800">Precision</span>
            </div>
            <div class="flex items-center space-x-1.5 mt-3">
              <span class="w-6 h-6 rounded-lg shadow-xs" style="background:#090d16" title="Background"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs" style="background:#0f172a" title="Surface"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs" style="background:#38bdf8" title="Primary"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs" style="background:#64748b" title="Secondary"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs border border-slate-300" style="background:#f8fafc" title="Text"></span>
            </div>
          </label>

          <!-- 4. Solar Amber -->
          <label class="relative flex flex-col p-4 rounded-2xl border-2 cursor-pointer transition <%= (settings.active_theme_palette === 'solar-amber' || settings.active_theme_palette === 'industrial-amber-charcoal') ? 'border-amber-500 bg-amber-50/20 dark:bg-amber-950/20' : 'border-slate-200 dark:border-brand-border hover:border-slate-300' %>">
            <input type="radio" name="active_theme_palette" value="solar-amber" <%= (settings.active_theme_palette === 'solar-amber' || settings.active_theme_palette === 'industrial-amber-charcoal') ? 'checked' : '' %> class="sr-only" onchange="previewPalette('solar-amber')">
            <div class="flex items-center justify-between">
              <span class="text-xs font-black text-slate-900 dark:text-white">4. Solar Amber</span>
              <span class="text-[10px] px-2 py-0.5 rounded-full font-bold bg-amber-100 text-amber-800">Industrial</span>
            </div>
            <div class="flex items-center space-x-1.5 mt-3">
              <span class="w-6 h-6 rounded-lg shadow-xs" style="background:#18181b" title="Background"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs" style="background:#27272a" title="Surface"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs" style="background:#f59e0b" title="Primary"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs" style="background:#fbbf24" title="Secondary"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs border border-slate-300" style="background:#fafafa" title="Text"></span>
            </div>
          </label>

          <!-- 5. Supernova Violet -->
          <label class="relative flex flex-col p-4 rounded-2xl border-2 cursor-pointer transition <%= (settings.active_theme_palette === 'supernova-violet') ? 'border-purple-500 bg-purple-50/20 dark:bg-purple-950/20' : 'border-slate-200 dark:border-brand-border hover:border-slate-300' %>">
            <input type="radio" name="active_theme_palette" value="supernova-violet" <%= (settings.active_theme_palette === 'supernova-violet') ? 'checked' : '' %> class="sr-only" onchange="previewPalette('supernova-violet')">
            <div class="flex items-center justify-between">
              <span class="text-xs font-black text-slate-900 dark:text-white">5. Supernova Violet</span>
              <span class="text-[10px] px-2 py-0.5 rounded-full font-bold bg-purple-100 text-purple-800">Deep Space</span>
            </div>
            <div class="flex items-center space-x-1.5 mt-3">
              <span class="w-6 h-6 rounded-lg shadow-xs" style="background:#0f0c1b" title="Background"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs" style="background:#18142a" title="Surface"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs" style="background:#a855f7" title="Primary"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs" style="background:#c084fc" title="Secondary"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs border border-slate-300" style="background:#faf5ff" title="Text"></span>
            </div>
          </label>

          <!-- 6. Clean Light Enterprise -->
          <label class="relative flex flex-col p-4 rounded-2xl border-2 cursor-pointer transition <%= (settings.active_theme_palette === 'clean-light' || settings.active_theme_palette === 'clean-light-enterprise') ? 'border-blue-600 bg-blue-50/20' : 'border-slate-200 dark:border-brand-border hover:border-slate-300' %>">
            <input type="radio" name="active_theme_palette" value="clean-light" <%= (settings.active_theme_palette === 'clean-light' || settings.active_theme_palette === 'clean-light-enterprise') ? 'checked' : '' %> class="sr-only" onchange="previewPalette('clean-light')">
            <div class="flex items-center justify-between">
              <span class="text-xs font-black text-slate-900 dark:text-white">6. Clean Enterprise</span>
              <span class="text-[10px] px-2 py-0.5 rounded-full font-bold bg-blue-100 text-blue-800">High Contrast</span>
            </div>
            <div class="flex items-center space-x-1.5 mt-3">
              <span class="w-6 h-6 rounded-lg shadow-xs border border-slate-300" style="background:#f8fafc" title="Background"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs border border-slate-300" style="background:#ffffff" title="Surface"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs" style="background:#2563eb" title="Primary"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs" style="background:#3b82f6" title="Secondary"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs" style="background:#0f172a" title="Text"></span>
            </div>
          </label>

          <!-- 7. Custom Hex Engine -->
          <label class="relative flex flex-col p-4 rounded-2xl border-2 cursor-pointer transition <%= (settings.active_theme_palette === 'custom') ? 'border-purple-500 bg-purple-50/20 dark:bg-purple-950/20' : 'border-slate-200 dark:border-brand-border hover:border-slate-300' %>">
            <input type="radio" name="active_theme_palette" value="custom" <%= (settings.active_theme_palette === 'custom') ? 'checked' : '' %> class="sr-only" onchange="previewPalette('custom')">
            <div class="flex items-center justify-between">
              <span class="text-xs font-black text-slate-900 dark:text-white">7. Custom Hex Engine</span>
              <span class="text-[10px] px-2 py-0.5 rounded-full font-bold bg-purple-100 text-purple-800">User Defined</span>
            </div>
            <div class="flex items-center space-x-1.5 mt-3">
              <span class="w-6 h-6 rounded-lg shadow-xs border border-slate-400" id="chip_bg_primary" style="background:<%= settings.palette_bg_primary || '#0b1412' %>"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs border border-slate-400" id="chip_bg_surface" style="background:<%= settings.palette_bg_surface || '#11221e' %>"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs border border-slate-400" id="chip_accent_primary" style="background:<%= settings.palette_accent_primary || '#059669' %>"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs border border-slate-400" id="chip_accent_secondary" style="background:<%= settings.palette_accent_secondary || '#55a630' %>"></span>
              <span class="w-6 h-6 rounded-lg shadow-xs border border-slate-400" id="chip_text_primary" style="background:<%= settings.palette_text_primary || '#f1f5f9' %>"></span>
            </div>
          </label>

        </div>
      </div>

      <!-- Spring Physics & Bounce Level Selector -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Micro-Interaction Bounce Level</label>
          <select name="theme_bounce_intensity" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-900 dark:text-white">
            <option value="bouncy" <%= settings.theme_bounce_intensity === 'bouncy' || !settings.theme_bounce_intensity ? 'selected' : '' %>>Modern Bouncy (Spring Physics cubic-bezier)</option>
            <option value="subtle" <%= settings.theme_bounce_intensity === 'subtle' ? 'selected' : '' %>>Subtle Smooth (Cubic Ease)</option>
            <option value="none" <%= settings.theme_bounce_intensity === 'none' ? 'selected' : '' %>>Minimalist (Standard Transitions)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Default Theme Mode</label>
          <select name="default_theme_mode" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-900 dark:text-white">
            <option value="dark" <%= (!settings.default_theme_mode || settings.default_theme_mode === 'dark') ? 'selected' : '' %>>Dark Mode (Default)</option>
            <option value="light" <%= settings.default_theme_mode === 'light' ? 'selected' : '' %>>Light Mode</option>
          </select>
        </div>
      </div>
      <!-- Custom Palette Hex Color Inputs (CRUD) -->
      <div class="p-5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border space-y-4">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase text-slate-800 dark:text-slate-200">Custom Palette Hex Variables (--root CSS injection)</span>
          <span class="text-[11px] text-slate-400">Values propagate automatically across all templates</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3 text-xs">
          <div>
            <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-1">--bg-primary</label>
            <div class="flex items-center space-x-1">
              <input type="color" id="picker_bg_primary" value="<%= settings.palette_bg_primary || '#0b1412' %>" class="w-7 h-7 rounded border-none cursor-pointer" oninput="syncColorInput('palette_bg_primary', this.value)">
              <input type="text" id="palette_bg_primary" name="palette_bg_primary" value="<%= settings.palette_bg_primary || '#0b1412' %>" class="w-full px-2 py-1 rounded bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 font-mono text-[11px]">
            </div>
          </div>
          <div>
            <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-1">--bg-surface</label>
            <div class="flex items-center space-x-1">
              <input type="color" id="picker_bg_surface" value="<%= settings.palette_bg_surface || '#11221e' %>" class="w-7 h-7 rounded border-none cursor-pointer" oninput="syncColorInput('palette_bg_surface', this.value)">
              <input type="text" id="palette_bg_surface" name="palette_bg_surface" value="<%= settings.palette_bg_surface || '#11221e' %>" class="w-full px-2 py-1 rounded bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 font-mono text-[11px]">
            </div>
          </div>
          <div>
            <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-1">--text-primary</label>
            <div class="flex items-center space-x-1">
              <input type="color" id="picker_text_primary" value="<%= settings.palette_text_primary || '#f1f5f9' %>" class="w-7 h-7 rounded border-none cursor-pointer" oninput="syncColorInput('palette_text_primary', this.value)">
              <input type="text" id="palette_text_primary" name="palette_text_primary" value="<%= settings.palette_text_primary || '#f1f5f9' %>" class="w-full px-2 py-1 rounded bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 font-mono text-[11px]">
            </div>
          </div>
          <div>
            <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-1">--text-muted</label>
            <div class="flex items-center space-x-1">
              <input type="color" id="picker_text_muted" value="<%= settings.palette_text_muted || '#94a3b8' %>" class="w-7 h-7 rounded border-none cursor-pointer" oninput="syncColorInput('palette_text_muted', this.value)">
              <input type="text" id="palette_text_muted" name="palette_text_muted" value="<%= settings.palette_text_muted || '#94a3b8' %>" class="w-full px-2 py-1 rounded bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 font-mono text-[11px]">
            </div>
          </div>
          <div>
            <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-1">--accent-primary</label>
            <div class="flex items-center space-x-1">
              <input type="color" id="picker_accent_primary" value="<%= settings.palette_accent_primary || '#10b981' %>" class="w-7 h-7 rounded border-none cursor-pointer" oninput="syncColorInput('palette_accent_primary', this.value)">
              <input type="text" id="palette_accent_primary" name="palette_accent_primary" value="<%= settings.palette_accent_primary || '#10b981' %>" class="w-full px-2 py-1 rounded bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 font-mono text-[11px]">
            </div>
          </div>
          <div>
            <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-1">--accent-sec</label>
            <div class="flex items-center space-x-1">
              <input type="color" id="picker_accent_secondary" value="<%= settings.palette_accent_secondary || '#34d399' %>" class="w-7 h-7 rounded border-none cursor-pointer" oninput="syncColorInput('palette_accent_secondary', this.value)">
              <input type="text" id="palette_accent_secondary" name="palette_accent_secondary" value="<%= settings.palette_accent_secondary || '#34d399' %>" class="w-full px-2 py-1 rounded bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 font-mono text-[11px]">
            </div>
          </div>
          <div>
            <label class="block text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-1">--border-color</label>
            <div class="flex items-center space-x-1">
              <input type="color" id="picker_border_color" value="<%= settings.palette_border_color || '#1e3831' %>" class="w-7 h-7 rounded border-none cursor-pointer" oninput="syncColorInput('palette_border_color', this.value)">
              <input type="text" id="palette_border_color" name="palette_border_color" value="<%= settings.palette_border_color || '#1e3831' %>" class="w-full px-2 py-1 rounded bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 font-mono text-[11px]">
            </div>
          </div>
        </div>
      </div>

      <!-- Live Interactive Component Preview Card -->
      <div id="liveThemePreviewBox" class="p-6 rounded-2xl border transition-all space-y-3" style="background: <%= theme ? theme.palette.bgPrimary : '#0b1412' %>; border-color: <%= theme ? theme.palette.borderColor : '#1e3831' %>">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full" style="background: <%= theme ? theme.palette.accentPrimary : '#10b981' %>; color: #fff;">
            Live Theme Preview
          </span>
          <span class="text-xs font-mono" style="color: <%= theme ? theme.palette.textMuted : '#94a3b8' %>">
            Active: <%= theme ? theme.palette.name : 'PCB Emerald Green' %>
          </span>
        </div>
        <div class="p-4 rounded-xl" style="background: <%= theme ? theme.palette.bgSurface : '#11221e' %>; border: 1px solid <%= theme ? theme.palette.borderColor : '#1e3831' %>">
          <h3 class="text-base font-extrabold" style="color: <%= theme ? theme.palette.textPrimary : '#f1f5f9' %>">
            Turnkey Embedded Engineering Lab
          </h3>
          <p class="text-xs mt-1" style="color: <%= theme ? theme.palette.textMuted : '#94a3b8' %>">
            From early architectural feasibility and high-speed PCB layouts to deterministic RTOS firmware.
          </p>
          <div class="mt-4 flex items-center space-x-3">
            <button type="button" class="px-4 py-1.5 rounded-lg text-xs font-bold text-white shadow-sm" style="background: <%= theme ? theme.palette.accentPrimary : '#10b981' %>">
              Primary CTA
            </button>
            <span class="text-xs font-semibold" style="color: <%= theme ? theme.palette.accentSecondary : '#34d399' %>">Secondary Metric Accent &rarr;</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- MODULE 2: NO-CODE SITE CUSTOMIZER -->
    <!-- ========================================== -->
    <section id="site-customizer" class="bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-sm space-y-6">
      <div class="flex items-center justify-between border-b border-slate-100 dark:border-brand-border pb-4">
        <div>
          <h2 class="text-lg font-black text-slate-900 dark:text-white flex items-center space-x-2">
            <span>🎛️ No-Code Site Customizer (Typography, Copy &amp; UX)</span>
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Control typography hierarchy, global brand strings, UX behavior toggles, and conversion widgets without touching code.</p>
        </div>
        <span class="text-[10px] bg-brand-50 dark:bg-brand-900/60 text-brand-600 dark:text-accent font-bold px-2.5 py-1 rounded-full uppercase">
          Customizer
        </span>
      </div>

      <!-- 2A. Typography & Layout -->
      <div class="space-y-4">
        <h3 class="text-xs font-black uppercase tracking-wider text-slate-900 dark:text-white pb-2 border-b border-slate-100 dark:border-brand-border/60">
          Typography &amp; Layout Scale
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Heading Font Family</label>
            <select name="heading_font" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-800 dark:text-white">
              <% const hFonts = ['Inter', 'Space Grotesk', 'Roboto', 'Montserrat', 'Poppins', 'Outfit', 'Fira Code']; %>
              <% hFonts.forEach(f => { %>
                <option value="<%= f %>" <%= (settings.heading_font === f) ? 'selected' : '' %>><%= f %></option>
              <% }) %>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Body Font Family</label>
            <select name="body_font" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-800 dark:text-white">
              <% const bFonts = ['Inter', 'Open Sans', 'Roboto', 'Lato', 'Source Sans Pro', 'JetBrains Mono']; %>
              <% bFonts.forEach(f => { %>
                <option value="<%= f %>" <%= (settings.body_font === f) ? 'selected' : '' %>><%= f %></option>
              <% }) %>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Base Font Size</label>
            <select name="base_font_size" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-800 dark:text-white">
              <option value="14px" <%= settings.base_font_size === '14px' ? 'selected' : '' %>>14px (Compact Technical)</option>
              <option value="15px" <%= settings.base_font_size === '15px' ? 'selected' : '' %>>15px (Balanced)</option>
              <option value="16px" <%= (!settings.base_font_size || settings.base_font_size === '16px') ? 'selected' : '' %>>16px (Standard Default)</option>
              <option value="17px" <%= settings.base_font_size === '17px' ? 'selected' : '' %>>17px (High Readability)</option>
              <option value="18px" <%= settings.base_font_size === '18px' ? 'selected' : '' %>>18px (Large Display)</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 pt-2">
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Border Radius Scale</label>
            <select name="border_radius_scale" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-800 dark:text-white">
              <option value="0.25rem" <%= settings.border_radius_scale === '0.25rem' ? 'selected' : '' %>>Sharp (4px)</option>
              <option value="0.5rem" <%= settings.border_radius_scale === '0.5rem' ? 'selected' : '' %>>Subtle (8px)</option>
              <option value="1rem" <%= (!settings.border_radius_scale || settings.border_radius_scale === '1rem') ? 'selected' : '' %>>Modern (16px Default)</option>
              <option value="1.5rem" <%= settings.border_radius_scale === '1.5rem' ? 'selected' : '' %>>Pill / High Curve (24px)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Container Max Width</label>
            <select name="container_max_width" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-800 dark:text-white">
              <option value="72rem" <%= settings.container_max_width === '72rem' ? 'selected' : '' %>>Compact (1152px / 6xl)</option>
              <option value="80rem" <%= (!settings.container_max_width || settings.container_max_width === '80rem') ? 'selected' : '' %>>Standard (1280px / 7xl)</option>
              <option value="90rem" <%= settings.container_max_width === '90rem' ? 'selected' : '' %>>Ultra-Wide (1440px)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Card Shadow Intensity</label>
            <select name="card_shadow_intensity" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-800 dark:text-white">
              <option value="none" <%= settings.card_shadow_intensity === 'none' ? 'selected' : '' %>>Flat (None)</option>
              <option value="subtle" <%= settings.card_shadow_intensity === 'subtle' ? 'selected' : '' %>>Subtle Shadow</option>
              <option value="medium" <%= (!settings.card_shadow_intensity || settings.card_shadow_intensity === 'medium') ? 'selected' : '' %>>Medium Depth</option>
              <option value="high" <%= settings.card_shadow_intensity === 'high' ? 'selected' : '' %>>Elevated 3D</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Glassmorphism Blur</label>
            <select name="enable_glassmorphism" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-800 dark:text-white">
              <option value="true" <%= settings.enable_glassmorphism === 'true' ? 'selected' : '' %>>Enabled (Backdrop Filter)</option>
              <option value="false" <%= settings.enable_glassmorphism === 'false' ? 'selected' : '' %>>Disabled (Solid Colors)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- 2B. Content & Global Strings -->
      <div class="space-y-4 pt-4 border-t border-slate-100 dark:border-brand-border/60">
        <h3 class="text-xs font-black uppercase tracking-wider text-slate-900 dark:text-white pb-2 border-b border-slate-100 dark:border-brand-border/60">
          Global Brand Strings &amp; Footer Metadata
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Brand Name</label>
            <input type="text" name="site_name" value="<%= settings.site_name || 'Embedded India' %>" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-900 dark:text-white">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Header Tagline</label>
            <input type="text" name="site_tagline" value="<%= settings.site_tagline || 'Engineering Hub' %>" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-900 dark:text-white">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Footer Copyright Text</label>
            <input type="text" name="footer_copyright" value="<%= settings.footer_copyright || '' %>" placeholder="© 2026 Embedded India. All rights reserved." class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs text-slate-900 dark:text-white">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">LinkedIn Company URL</label>
            <input type="text" name="social_linkedin" value="<%= settings.social_linkedin || '' %>" placeholder="https://linkedin.com/company/..." class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-mono text-slate-900 dark:text-white">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">GitHub Organization URL</label>
            <input type="text" name="social_github" value="<%= settings.social_github || '' %>" placeholder="https://github.com/..." class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-mono text-slate-900 dark:text-white">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Twitter / X Handle</label>
            <input type="text" name="social_twitter" value="<%= settings.social_twitter || '' %>" placeholder="https://x.com/..." class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-mono text-slate-900 dark:text-white">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">YouTube Channel URL</label>
            <input type="text" name="social_youtube" value="<%= settings.social_youtube || '' %>" placeholder="https://youtube.com/@..." class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-mono text-slate-900 dark:text-white">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Primary Email</label>
            <input type="email" name="contact_email" value="<%= settings.contact_email || 'info@embeddedindia.in' %>" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-900 dark:text-white">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Phone Number</label>
            <input type="text" name="contact_phone" value="<%= settings.contact_phone || '+91 98765 43210' %>" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-900 dark:text-white">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Offices &amp; Locations</label>
            <input type="text" name="contact_address" value="<%= settings.contact_address || 'Bangalore • Hyderabad • Pune, India' %>" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs text-slate-900 dark:text-white">
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Cookie Notice Banner Text</label>
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
            <div class="sm:col-span-9">
              <input type="text" name="cookie_banner_text" value="<%= settings.cookie_banner_text || 'We use cookies to ensure optimal functionality, save your theme preferences, and provide interactive engineering tools.' %>" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs text-slate-900 dark:text-white">
            </div>
            <div class="sm:col-span-3">
              <select name="cookie_banner_enabled" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-900 dark:text-white">
                <option value="true" <%= settings.cookie_banner_enabled !== 'false' ? 'selected' : '' %>>Banner Enabled</option>
                <option value="false" <%= settings.cookie_banner_enabled === 'false' ? 'selected' : '' %>>Banner Disabled</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <!-- 2C. Behavior & UX Toggles -->
      <div class="space-y-4 pt-4 border-t border-slate-100 dark:border-brand-border/60">
        <h3 class="text-xs font-black uppercase tracking-wider text-slate-900 dark:text-white pb-2 border-b border-slate-100 dark:border-brand-border/60">
          Behavior &amp; Conversion UX Toggles
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Navbar Position</label>
            <select name="nav_sticky" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-900 dark:text-white">
              <option value="true" <%= settings.nav_sticky !== 'false' ? 'selected' : '' %>>Sticky Top (Follow Scroll)</option>
              <option value="false" <%= settings.nav_sticky === 'false' ? 'selected' : '' %>>Static Relative</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Default Theme Mode</label>
            <select name="default_theme_mode" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-900 dark:text-white">
              <option value="dark" <%= (!settings.default_theme_mode || settings.default_theme_mode === 'dark') ? 'selected' : '' %>>Dark Mode (Default)</option>
              <option value="light" <%= settings.default_theme_mode === 'light' ? 'selected' : '' %>>Light Mode</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Smooth Scrolling</label>
            <select name="enable_smooth_scroll" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-900 dark:text-white">
              <option value="true" <%= settings.enable_smooth_scroll !== 'false' ? 'selected' : '' %>>Enabled (scroll-smooth)</option>
              <option value="false" <%= settings.enable_smooth_scroll === 'false' ? 'selected' : '' %>>Disabled (Instant jump)</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Back-to-Top Floating Button</label>
            <select name="enable_back_to_top" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-900 dark:text-white">
              <option value="true" <%= settings.enable_back_to_top !== 'false' ? 'selected' : '' %>>Enabled</option>
              <option value="false" <%= settings.enable_back_to_top === 'false' ? 'selected' : '' %>>Disabled</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Popup RFQ Modal</label>
            <select name="enable_rfq_modal" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-900 dark:text-white">
              <option value="false" <%= settings.enable_rfq_modal === 'false' ? 'selected' : '' %>>Disabled</option>
              <option value="true" <%= settings.enable_rfq_modal === 'true' ? 'selected' : '' %>>Enabled</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">RFQ Modal Delay (Seconds)</label>
            <input type="number" name="rfq_modal_delay_sec" min="1" max="60" value="<%= settings.rfq_modal_delay_sec || '5' %>" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-900 dark:text-white">
          </div>
        </div>

        <!-- WhatsApp Chat Widget Details -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 p-4 rounded-2xl bg-emerald-50/40 dark:bg-emerald-950/20 border border-emerald-200 dark:border-emerald-800">
          <div>
            <label class="block text-xs font-bold text-emerald-800 dark:text-emerald-300 mb-1">WhatsApp Widget Toggle</label>
            <select name="enable_whatsapp_widget" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-brand-surface border border-emerald-300 dark:border-emerald-700 text-xs font-semibold text-slate-900 dark:text-white">
              <option value="false" <%= settings.enable_whatsapp_widget === 'false' ? 'selected' : '' %>>Disabled</option>
              <option value="true" <%= settings.enable_whatsapp_widget === 'true' ? 'selected' : '' %>>Enabled (Show Floating Widget)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-emerald-800 dark:text-emerald-300 mb-1">WhatsApp Phone (with Country Code)</label>
            <input type="text" name="whatsapp_number" value="<%= settings.whatsapp_number || '+91 98765 43210' %>" placeholder="+919876543210" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-brand-surface border border-emerald-300 dark:border-emerald-700 text-xs font-mono text-slate-900 dark:text-white">
          </div>

          <div>
            <label class="block text-xs font-bold text-emerald-800 dark:text-emerald-300 mb-1">Preset Greeting Message</label>
            <input type="text" name="whatsapp_preset_msg" value="<%= settings.whatsapp_preset_msg || 'Hello Embedded India, I have an inquiry about custom hardware and firmware engineering.' %>" class="w-full px-3 py-2 rounded-xl bg-white dark:bg-brand-surface border border-emerald-300 dark:border-emerald-700 text-xs text-slate-900 dark:text-white">
          </div>
        </div>

        <!-- Maintenance Mode Toggle -->
        <div class="p-4 rounded-2xl bg-amber-50/50 dark:bg-amber-950/20 border border-amber-200 dark:border-amber-800 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-amber-900 dark:text-amber-300">🚨 Maintenance Mode (Returns 503 to visitors; /admin remains unlocked)</span>
            <select name="maintenance_mode" class="px-3 py-1.5 rounded-xl bg-white dark:bg-brand-surface border border-amber-300 dark:border-amber-700 text-xs font-bold text-slate-900 dark:text-white">
              <option value="false" <%= settings.maintenance_mode !== 'true' ? 'selected' : '' %>>Live / Normal Mode</option>
              <option value="true" <%= settings.maintenance_mode === 'true' ? 'selected' : '' %>>Active Maintenance Mode</option>
            </select>
          </div>
          <input type="text" name="maintenance_message" value="<%= settings.maintenance_message || 'Our engineering team is currently performing scheduled system updates. Please check back shortly.' %>" placeholder="Maintenance banner message..." class="w-full px-3 py-2 rounded-xl bg-white dark:bg-brand-surface border border-amber-200 dark:border-amber-800 text-xs text-slate-900 dark:text-white">
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- MODULE 3: FUTURE-READY MODULES & FEATURE FLAGS -->
    <!-- ========================================== -->
    <section id="feature-flags" class="bg-white dark:bg-brand-surface rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-brand-border shadow-sm space-y-6">
      <div class="flex items-center justify-between border-b border-slate-100 dark:border-brand-border pb-4">
        <div>
          <h2 class="text-lg font-black text-slate-900 dark:text-white flex items-center space-x-2">
            <span>🚩 Modular Section Feature Flags</span>
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Toggle individual public site sections on or off instantly across the homepage and footer.</p>
        </div>
        <span class="text-[10px] bg-brand-50 dark:bg-brand-900/60 text-brand-600 dark:text-accent font-bold px-2.5 py-1 rounded-full uppercase">
          Feature Flags
        </span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border space-y-1">
          <label class="block text-xs font-bold text-slate-800 dark:text-slate-200">1. Hero Section</label>
          <select name="section_hero_enabled" class="w-full px-2 py-1.5 rounded-lg bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 text-xs font-semibold">
            <option value="true" <%= settings.section_hero_enabled !== 'false' ? 'selected' : '' %>>Show</option>
            <option value="false" <%= settings.section_hero_enabled === 'false' ? 'selected' : '' %>>Hide</option>
          </select>
        </div>

        <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border space-y-1">
          <label class="block text-xs font-bold text-slate-800 dark:text-slate-200">2. Interactive Sandbox</label>
