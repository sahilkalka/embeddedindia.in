              <span class="text-xs font-bold text-slate-600 dark:text-slate-400">Status Pill:</span>
              <select name="lab_event_enabled" id="lab_event_enabled" onchange="updateEventPreview()" class="px-3 py-1.5 rounded-xl bg-white dark:bg-brand-surface border border-slate-300 dark:border-slate-700 text-xs font-bold">
                <option value="true" <%= settings.lab_event_enabled !== 'false' ? 'selected' : '' %>>🟢 Enabled (Show Pill)</option>
                <option value="false" <%= settings.lab_event_enabled === 'false' ? 'selected' : '' %>>🔴 Disabled (Hidden)</option>
