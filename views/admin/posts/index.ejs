<%- include('../layout_top') %>

<div class="w-full space-y-6 mx-auto">
  
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white">Engineering Blog CMS</h1>
      <p class="text-xs text-slate-500 mt-1">Create, edit, schedule, and optimize technical articles</p>
    </div>

    <div class="flex flex-wrap items-center gap-2.5">
      <a href="/admin/settings#ai-engine" class="px-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-white font-bold rounded-xl text-xs transition shadow flex items-center space-x-1.5 active:scale-95">
        <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        <span>AI Engine Studio</span>
      </a>
      <a href="/admin/posts/new" class="px-5 py-2.5 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl text-xs transition shadow flex items-center space-x-2 active:scale-95">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        <span>Write New Article</span>
      </a>
    </div>

  </div>

  <div class="rounded-2xl border overflow-hidden shadow-sm admin-table-container">
    <% if (!posts || posts.length === 0) { %>
      <div class="p-8 text-center text-slate-500 text-xs">
        No articles found. <a href="/admin/posts/new" class="text-brand-500 font-bold underline">Write your first technical article</a>.
      </div>
    <% } else { %>
      <!-- Mobile Card View (Zero Horizontal Scroll) -->
      <div class="md:hidden admin-table-body divide-y">
        <% posts.forEach(post => { %>
          <div class="p-4 space-y-2.5">
            <div class="flex items-center justify-between gap-2">
              <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold admin-badge-category truncate max-w-[65%]"><%= post.category %></span>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase shrink-0 <%= post.status === 'published' ? 'admin-badge-published' : post.status === 'scheduled' ? 'admin-badge-scheduled' : 'admin-badge-draft' %>">
                <%= post.status %>
              </span>
            </div>
            <a href="/blogs/<%= post.slug %>" target="_blank" class="block font-bold text-slate-900 dark:text-white hover:text-emerald-500 transition text-xs leading-snug break-words">
              <%= post.title %>
            </a>
            <div class="flex items-center justify-between gap-2 pt-1 text-xs">
              <div class="flex items-center gap-2 text-[11px] text-slate-500 dark:text-slate-300 whitespace-nowrap">
                <span class="font-mono font-bold text-slate-700 dark:text-slate-200"><%= post.views %> views</span>
                <span>&bull;</span>
                <span><%= post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : (post.scheduledAt ? 'Scheduled: ' + new Date(post.scheduledAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : 'Draft') %></span>
              </div>
              <div class="flex items-center gap-1.5 shrink-0">
                <a href="/blogs/<%= post.slug %>" target="_blank" aria-label="View post" title="View Post" class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition inline-flex items-center justify-center">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                </a>
                <a href="/admin/posts/<%= post.id %>/edit" aria-label="Edit post" title="Edit Post" class="w-9 h-9 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-100 dark:hover:bg-emerald-900/60 transition inline-flex items-center justify-center">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                </a>
                <form action="/admin/posts/<%= post.id %>/delete" method="POST" onsubmit="return confirm('Delete this post?')" class="inline">
                  <%- csrfField %>
                  <button type="submit" aria-label="Delete post" title="Delete Post" class="w-9 h-9 !min-h-0 !min-w-0 rounded-xl bg-red-50 dark:bg-red-950/50 text-red-600 dark:text-red-400 hover:bg-red-100 dark:hover:bg-red-900/60 transition inline-flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                  </button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- Desktop Table View -->
      <div class="hidden md:block overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="admin-table-head uppercase font-bold text-[11px] tracking-wider">
            <tr>
              <th class="p-4">Title</th>
              <th class="p-4">Category</th>
              <th class="p-4">Status</th>
              <th class="p-4">Views</th>
              <th class="p-4">Published / Scheduled</th>
              <th class="p-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="admin-table-body divide-y">
            <% posts.forEach(post => { %>
              <tr class="transition">
                <td class="p-4 font-bold text-slate-900 dark:text-white max-w-xs truncate">
                  <a href="/blogs/<%= post.slug %>" target="_blank" class="hover:text-emerald-500 transition">
                    <%= post.title %>
                  </a>
                </td>
                <td class="p-4">
                  <span class="px-2.5 py-1 rounded-md text-[10px] font-semibold admin-badge-category">
                    <%= post.category %>
                  </span>
                </td>
                <td class="p-4">
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase <%= post.status === 'published' ? 'admin-badge-published' : post.status === 'scheduled' ? 'admin-badge-scheduled' : 'admin-badge-draft' %>">
                    <%= post.status %>
                  </span>
                </td>
                <td class="p-4 font-mono font-bold text-slate-700 dark:text-slate-200"><%= post.views %></td>
                <td class="p-4 text-slate-500 dark:text-slate-300 font-medium">
                  <%= post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : (post.scheduledAt ? 'Scheduled: ' + new Date(post.scheduledAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : 'Draft') %>
                </td>
                <td class="p-4 text-right whitespace-nowrap">
                  <div class="inline-flex items-center justify-end gap-1.5">
                    <a href="/blogs/<%= post.slug %>" target="_blank" aria-label="View post" title="View Post" class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition inline-flex items-center justify-center">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                    </a>
                    <a href="/admin/posts/<%= post.id %>/edit" aria-label="Edit post" title="Edit Post" class="w-9 h-9 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-100 dark:hover:bg-emerald-900/60 transition inline-flex items-center justify-center">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    </a>
                    <form action="/admin/posts/<%= post.id %>/delete" method="POST" onsubmit="return confirm('Delete this post?')" class="inline">
                      <%- csrfField %>
                      <button type="submit" aria-label="Delete post" title="Delete Post" class="w-9 h-9 !min-h-0 !min-w-0 rounded-xl bg-red-50 dark:bg-red-950/50 text-red-600 dark:text-red-400 hover:bg-red-100 dark:hover:bg-red-900/60 transition inline-flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

</div>

<%- include('../layout_bottom') %>
