<%- include('layout_top') %>
<%- include('partials/settings-styles') %>
<div class="settings-workspace admin-ai-workspace flex flex-col lg:flex-row rounded-3xl border border-slate-200 dark:border-slate-700 shadow-sm">
<%- include('partials/settings-nav') %>
<div class="settings-content min-w-0 flex-1">

<section id="ai-engine" class="settings-section p-6 sm:p-8 space-y-6">
  
  <div class="module-heading flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-100 dark:border-brand-border pb-4 gap-3">
    <div>
      <h2 class="text-lg font-black text-slate-900 dark:text-white flex items-center space-x-2">
        <span>🤖 AI Model Configuration &amp; Technical Blog Engine</span>
      </h2>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Configure NVIDIA NIM, OpenAI, Google Gemini, or Local Ollama models to auto-generate engineering articles</p>
    </div>
    <%- include('partials/module-save-button', { label: 'Save AI Configuration', formId: 'aiConfigForm' }) %>
  </div>

  <% if (saved) { %>
    <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-xs font-bold flex items-center space-x-2 shadow-sm">
      <span>✅ AI configuration settings saved and activated successfully!</span>
    </div>
  <% } %>

  <!-- AI Model Settings Form -->
  <form id="aiConfigForm" action="/admin/ai" method="POST" class="space-y-6">
    
    <div class="bg-slate-50 dark:bg-brand-dark rounded-2xl p-5 border border-slate-200 dark:border-brand-border space-y-5">
      <div class="flex items-center justify-between border-b border-slate-100 dark:border-brand-border pb-3">
        <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white">
          1. AI Provider &amp; Model Credentials
        </h2>
        <span class="text-[11px] font-semibold text-slate-500">Supports Cloud &amp; Local LLMs</span>
      </div>

      <!-- Provider Selection -->
      <div>
        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-2">Select AI Model Provider</label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" id="providerCards">
          <label class="cursor-pointer border p-3.5 rounded-xl flex flex-col items-center justify-center text-center transition hover:border-brand-500 <%= (settings.ai_provider || 'nvidia') === 'nvidia' ? 'border-brand-500 bg-brand-50 dark:bg-brand-900/30 ring-1 ring-brand-500' : 'border-slate-200 dark:border-brand-border' %>">
            <input type="radio" name="ai_provider" value="nvidia" <%= (settings.ai_provider || 'nvidia') === 'nvidia' ? 'checked' : '' %> class="sr-only">
            <span class="text-xs font-bold text-slate-900 dark:text-white">NVIDIA NIM</span>
            <span class="text-[10px] text-slate-500 mt-0.5">Llama 3.1 70B</span>
          </label>
          <label class="cursor-pointer border p-3.5 rounded-xl flex flex-col items-center justify-center text-center transition hover:border-brand-500 <%= settings.ai_provider === 'openai' ? 'border-brand-500 bg-brand-50 dark:bg-brand-900/30 ring-1 ring-brand-500' : 'border-slate-200 dark:border-brand-border' %>">
            <input type="radio" name="ai_provider" value="openai" <%= settings.ai_provider === 'openai' ? 'checked' : '' %> class="sr-only">
            <span class="text-xs font-bold text-slate-900 dark:text-white">OpenAI</span>
            <span class="text-[10px] text-slate-500 mt-0.5">GPT-4o / Mini</span>
          </label>
          <label class="cursor-pointer border p-3.5 rounded-xl flex flex-col items-center justify-center text-center transition hover:border-brand-500 <%= settings.ai_provider === 'gemini' ? 'border-brand-500 bg-brand-50 dark:bg-brand-900/30 ring-1 ring-brand-500' : 'border-slate-200 dark:border-brand-border' %>">
            <input type="radio" name="ai_provider" value="gemini" <%= settings.ai_provider === 'gemini' ? 'checked' : '' %> class="sr-only">
            <span class="text-xs font-bold text-slate-900 dark:text-white">Google Gemini</span>
            <span class="text-[10px] text-slate-500 mt-0.5">Gemini 1.5 / 2.0</span>
          </label>
          <label class="cursor-pointer border p-3.5 rounded-xl flex flex-col items-center justify-center text-center transition hover:border-brand-500 <%= settings.ai_provider === 'custom' ? 'border-brand-500 bg-brand-50 dark:bg-brand-900/30 ring-1 ring-brand-500' : 'border-slate-200 dark:border-brand-border' %>">
            <input type="radio" name="ai_provider" value="custom" <%= settings.ai_provider === 'custom' ? 'checked' : '' %> class="sr-only">
            <span class="text-xs font-bold text-slate-900 dark:text-white">Custom / Ollama</span>
            <span class="text-[10px] text-slate-500 mt-0.5">Local / vLLM</span>
          </label>
        </div>
      </div>

      <!-- Quick API key links banner -->
      <div class="p-3 bg-slate-50 dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 text-[11px] text-slate-700 dark:text-slate-200 flex flex-wrap items-center justify-between gap-2">
        <span class="font-medium">Get API credentials:</span>
        <div class="flex flex-wrap gap-3 font-semibold text-brand-700 dark:text-emerald-400">
          <a href="https://build.nvidia.com" target="_blank" rel="noopener" class="hover:underline">NVIDIA NIM (Free Credits) &nearr;</a>
          <a href="https://aistudio.google.com" target="_blank" rel="noopener" class="hover:underline">Google AI Studio &nearr;</a>
          <a href="https://platform.openai.com" target="_blank" rel="noopener" class="hover:underline">OpenAI Platform &nearr;</a>
        </div>
      </div>

      <!-- API Key & Model Name -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="ai_api_key" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">API Key / Secret Token</label>
          <input type="password" id="ai_api_key" name="ai_api_key" value="<%= settings.ai_api_key || '' %>" placeholder="Enter API key or 'demo-key' for simulation mode" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-xs font-mono text-slate-900 dark:text-white">
          <span class="text-[10px] text-slate-500 mt-1 block">Leave empty or use 'demo-key' to run in built-in simulation mode</span>
        </div>
        <div>
          <label for="ai_model" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Model Identifier</label>
          <input type="text" id="ai_model" name="ai_model" value="<%= settings.ai_model || 'meta/llama-3.1-70b-instruct' %>" placeholder="meta/llama-3.1-70b-instruct, gpt-4o-mini, gemini-1.5-flash" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-xs font-mono font-semibold text-slate-900 dark:text-white">
        </div>
      </div>

      <!-- Base URL & Temperature -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="sm:col-span-2">
          <label for="ai_base_url" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Custom API Base URL (Optional)</label>
          <input type="text" id="ai_base_url" name="ai_base_url" value="<%= settings.ai_base_url || '' %>" placeholder="https://api.nvidia.com/v1 or http://localhost:11434/v1" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-xs font-mono text-slate-900 dark:text-white">
        </div>
        <div>
          <label for="ai-temperature" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Temperature (Creativity)</label>
          <input id="ai-temperature" type="number" step="0.1" min="0" max="1" name="ai_temperature" value="<%= settings.ai_temperature || '0.7' %>" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-xs font-mono text-slate-900 dark:text-white">
        </div>
      </div>

      <!-- Test Connection & Save Action -->
      <div class="pt-4 border-t border-slate-100 dark:border-brand-border flex flex-col sm:flex-row items-center justify-between gap-3">
        <button type="submit" class="w-full sm:w-auto px-6 py-2.5 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl text-xs transition shadow-md">
          Save AI Configuration
        </button>

        <div class="flex items-center gap-2 w-full sm:w-auto">
          <button type="button" id="btnTestAi" class="flex-1 sm:flex-none px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-white text-xs font-bold rounded-xl transition flex items-center justify-center space-x-2 active:scale-95 shadow">
            <span>⚡ Test AI Model Connection</span>
          </button>
        </div>
      </div>

      <!-- Test Result Box -->
      <div id="aiTestResult" class="hidden p-4 rounded-xl text-xs font-mono"></div>

    </div>
  </form>

  <!-- Technical Article Generator Studio -->
  <div class="bg-slate-50 dark:bg-brand-dark rounded-2xl p-5 border border-slate-200 dark:border-brand-border space-y-5">
    <div class="flex items-center justify-between border-b border-slate-100 dark:border-brand-border pb-3">
      <div>
        <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white">
          2. On-Demand Technical Article Generator
        </h2>
        <p class="text-xs text-slate-500 mt-0.5">Produces in-depth embedded engineering guides with code snippets, schematics, and DFM rules</p>
      </div>
      <span class="drafting-status shrink-0 whitespace-nowrap text-[10px] bg-emerald-50 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 font-extrabold px-2 py-0.5 rounded uppercase">
        Live Drafting
      </span>
    </div>

    <div class="space-y-4">
      <div>
        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Technical Article Topic / Prompt</label>
        <div class="flex gap-2">
          <input type="text" id="aiTopic" placeholder="e.g. Design Considerations for Multi-Layer High-Speed DDR4 Routing on STM32MP157" class="flex-1 px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-xs text-slate-900 dark:text-white font-medium">
          <button type="button" id="btnRandomTopic" class="px-3 py-2 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-300 transition whitespace-nowrap flex items-center space-x-1" title="Suggest trending topics via AI Agent">
            <span>🎲 Suggest Topics</span>
          </button>
        </div>
        <!-- Topic suggestions container -->
        <div id="aiTopicChips" class="mt-2.5 flex flex-wrap gap-1.5 hidden"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="aiCategory" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Target Category</label>
          <select id="aiCategory" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white text-xs font-semibold">
            <option value="Embedded Electronics">Embedded Electronics</option>
            <option value="Guides">Guides</option>
            <option value="Troubleshooting">Troubleshooting</option>
            <option value="Industry Info">Industry Info</option>
          </select>
        </div>
        <div>
          <label for="aiAudience" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Target Audience Profile</label>
          <input type="text" id="aiAudience" value="Hardware Layout Specialists &amp; Firmware Engineers" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white text-xs font-medium">
        </div>
      </div>

      <div class="pt-2 flex flex-wrap items-center gap-3">
        <button type="button" id="btnGenerateArticle" class="px-6 py-3 bg-gradient-to-r from-brand-600 via-brand-500 to-accent hover:from-brand-500 hover:to-brand-600 text-white font-bold rounded-xl text-xs transition shadow-lg flex items-center space-x-2 active:scale-95">
          <span>🚀 Generate Technical Article Now &rarr;</span>
        </button>
        <button type="button" id="btnGenerateOutline" class="px-5 py-3 bg-slate-800 hover:bg-slate-700 text-white font-bold rounded-xl text-xs transition shadow flex items-center space-x-2 active:scale-95">
          <span>📑 Generate Technical Outline &rarr;</span>
        </button>
      </div>

      <div id="aiGenStatus" class="hidden p-4 rounded-xl text-xs font-mono"></div>

      <!-- Outline Output Container -->
      <div id="aiOutlineBox" class="hidden p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 space-y-3">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-brand-border/60 pb-2">
          <div class="font-bold text-xs text-slate-900 dark:text-white flex items-center space-x-2">
            <span>📑 Generated Technical Outline</span>
            <span id="aiOutlineSourceBadge" class="text-[10px] px-2 py-0.5 rounded font-mono font-bold bg-emerald-50 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60"></span>
          </div>
          <button type="button" id="btnCopyOutline" class="text-[11px] font-bold text-brand-700 dark:text-emerald-400 hover:underline">
            📋 Copy Markdown
          </button>
        </div>
        <div class="text-xs font-semibold text-slate-800 dark:text-slate-200" id="aiOutlineTitle"></div>
        <div class="text-[11px] text-slate-500 italic" id="aiOutlineSummary"></div>
        <pre id="aiOutlineContent" class="text-xs font-mono text-slate-800 dark:text-slate-200 bg-white dark:bg-brand-surface p-3 rounded-lg border border-slate-200 dark:border-brand-border overflow-x-auto max-h-64 whitespace-pre-wrap"></pre>
        <div class="pt-2 flex items-center gap-3">
          <a id="btnOutlineCreatePost" href="/admin/posts/new" class="px-4 py-2 bg-brand-500 hover:bg-brand-600 text-white text-xs font-bold rounded-lg transition shadow">
            ✍️ Open in CMS Editor &rarr;
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. Automated Scheduled Blog Publishing Engine & Topic Queue -->
  <form action="/admin/ai" method="POST" class="space-y-6">
    <div class="bg-slate-50 dark:bg-brand-dark rounded-2xl p-5 border border-slate-200 dark:border-brand-border space-y-6">
      
      <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-100 dark:border-brand-border pb-4 gap-3">
        <div>
          <div class="flex items-center space-x-2">
            <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white">
              3. Automated Scheduled Blog Publishing Engine
            </h2>
            <span class="scheduler-status shrink-0 whitespace-nowrap px-2 py-0.5 rounded-full text-[10px] font-black uppercase <%= schedulerSettings.enabled ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300' : 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400' %>">
              <%= schedulerSettings.enabled ? '● Active' : '○ Paused' %>
            </span>
          </div>
          <p class="text-xs text-slate-500 mt-0.5">
            Auto-synthesizes and schedules engineering articles at defined intervals from your curated topic queue
          </p>
        </div>

        <div class="flex items-center gap-2">
          <button type="button" id="btnRunSchedulerNow" class="px-4 py-2 bg-slate-900 dark:bg-slate-800 hover:bg-slate-800 dark:hover:bg-slate-700 text-white rounded-xl text-xs font-bold transition shadow-sm flex items-center space-x-1.5 active:scale-95">
            <span>⚡ Run Auto-Generation Now</span>
          </button>
        </div>
      </div>

      <!-- Quick Metrics Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
          <div class="text-[10px] uppercase font-bold text-slate-400">Total Blog Pages in CMS</div>
          <div class="text-lg font-black text-slate-900 dark:text-white mt-0.5">
            <%= totalPosts %> <span class="text-xs font-normal text-slate-500">/ max <%= schedulerSettings.maxPosts %> allowed</span>
          </div>
          <div class="w-full bg-slate-200 dark:bg-slate-700 h-1.5 rounded-full mt-2 overflow-hidden">
            <div class="bg-brand-500 h-full rounded-full" style="width: <%= Math.min(100, Math.round((totalPosts / schedulerSettings.maxPosts) * 100)) %>%"></div>
          </div>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
          <div class="text-[10px] uppercase font-bold text-slate-400">Current Frequency</div>
          <div class="text-sm font-bold text-slate-900 dark:text-white mt-1 capitalize flex items-center space-x-1.5">
            <span>⏰</span>
            <span><%= schedulerSettings.frequency.replace(/_/g, ' ') %></span>
          </div>
          <div class="text-[10px] text-slate-500 mt-1">Background cron checks every 15 min</div>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
          <div class="text-[10px] uppercase font-bold text-slate-400">Last Auto-Generated Article</div>
          <div class="text-xs font-bold text-slate-900 dark:text-white mt-1 truncate">
            <%= schedulerSettings.lastRun ? new Date(schedulerSettings.lastRun).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'Never run yet' %>
          </div>
          <div class="text-[10px] text-slate-500 mt-1">Next: Calculated dynamically</div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-12 gap-5">
        
        <!-- Enable Switch -->
        <div class="sm:col-span-12 flex items-center justify-between p-3.5 rounded-xl bg-brand-50 dark:bg-brand-900/20 border border-brand-200 dark:border-brand-800">
          <div>
            <div class="text-xs font-bold text-slate-900 dark:text-white">Enable Automated Scheduled Blog Generation</div>
            <div class="text-[11px] text-slate-600 dark:text-slate-400">When turned on, the system synthesizes articles and adds them to the CMS at your specified frequency until max limit is reached.</div>
          </div>
          <label class="relative inline-flex items-center cursor-pointer ml-4">
            <input type="checkbox" aria-label="Enable automatic article generation" name="ai_auto_gen_enabled" value="true" <%= schedulerSettings.enabled ? 'checked' : '' %> class="sr-only peer">
            <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-brand-500"></div>
          </label>
        </div>

        <!-- Frequency Selector -->
        <div class="sm:col-span-4">
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
            Generation Frequency <span class="text-red-500">*</span>
          </label>
          <select aria-label="Generation frequency" name="ai_auto_gen_frequency" class="w-full px-3 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-xs font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-brand-500">
            <option value="hourly" <%= schedulerSettings.frequency === 'hourly' ? 'selected' : '' %>>Every 1 Hour</option>
            <option value="every_6_hours" <%= schedulerSettings.frequency === 'every_6_hours' ? 'selected' : '' %>>Every 6 Hours (4 articles / day)</option>
            <option value="every_12_hours" <%= schedulerSettings.frequency === 'every_12_hours' ? 'selected' : '' %>>Every 12 Hours (2 articles / day)</option>
            <option value="daily" <%= schedulerSettings.frequency === 'daily' ? 'selected' : '' %>>Daily (1 article / day - Recommended)</option>
            <option value="every_2_days" <%= schedulerSettings.frequency === 'every_2_days' ? 'selected' : '' %>>Every 2 Days</option>
            <option value="weekly" <%= schedulerSettings.frequency === 'weekly' ? 'selected' : '' %>>Weekly (1 article / week)</option>
          </select>
          <span class="text-[10px] text-slate-500 mt-1 block">Articles are added at the scheduled time intervals.</span>
        </div>

        <!-- Max Blog Pages Allowed -->
        <div class="sm:col-span-4">
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
            Max Blog Pages Allowed <span class="text-red-500">*</span>
          </label>
          <input 
            type="number" 
            name="ai_auto_gen_max_posts" 
            aria-label="Maximum blog pages allowed"
            min="1" 
            max="10000" 
            value="<%= schedulerSettings.maxPosts %>" 
            class="w-full px-3 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-xs font-mono font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-brand-500"
          >
          <span class="text-[10px] text-slate-500 mt-1 block">Total ceiling. Scheduler stops when total articles reach this number.</span>
        </div>

        <!-- Status for auto-generated articles -->
        <div class="sm:col-span-4">
          <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
            Auto-Generated Status
          </label>
          <select aria-label="Auto-generated article status" name="ai_auto_gen_status" class="w-full px-3 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-xs font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-brand-500">
            <option value="published" <%= schedulerSettings.statusMode === 'published' ? 'selected' : '' %>>Published (Live Immediately)</option>
            <option value="scheduled" <%= schedulerSettings.statusMode === 'scheduled' ? 'selected' : '' %>>Scheduled (Queued for Release)</option>
            <option value="draft" <%= schedulerSettings.statusMode === 'draft' ? 'selected' : '' %>>Draft (Requires Manual Approval)</option>
          </select>
          <span class="text-[10px] text-slate-500 mt-1 block">Choose whether new articles publish live immediately or go to Drafts.</span>
        </div>

        <!-- Topics Queue / Pool -->
        <div class="sm:col-span-12">
          <div class="flex items-center justify-between mb-1.5">
            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300">
              Topic &amp; Keyword Queue (One Topic Per Line) <span class="text-red-500">*</span>
            </label>
            <div class="flex items-center space-x-2">
              <button type="button" id="btnPopulateDefaultTopics" class="text-[11px] font-bold text-brand-700 dark:text-emerald-400 hover:underline">
                ↺ Reset Curated Engineering Topics
              </button>
            </div>
          </div>
          <textarea 
            id="aiSchedulerTopics" 
            name="ai_auto_gen_topics" 
            rows="7" 
            class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-xs font-mono text-slate-900 dark:text-white leading-relaxed focus:ring-2 focus:ring-brand-500"
            placeholder="One topic per line..."
          ><%= schedulerSettings.rawTopics %></textarea>
          <span class="text-[10px] text-slate-500 mt-1 block">The automated engine cycles through these topics in order. Once completed, it synthesizes fresh variants or uses AI real-time suggestions.</span>
        </div>

      </div>

      <!-- Save & Trigger Button Bar -->
      <div class="pt-4 border-t border-slate-100 dark:border-brand-border flex flex-col sm:flex-row items-center justify-between gap-3">
        <button type="submit" class="w-full sm:w-auto px-6 py-2.5 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl text-xs transition shadow-md">
          Save Scheduler Settings
        </button>

        <span class="text-xs text-slate-400">Settings are persisted in database and active across server reboots.</span>
      </div>

      <!-- Scheduler Run-Now Status Box -->
      <div id="schedulerRunStatus" class="hidden p-4 rounded-xl text-xs font-mono"></div>

    </div>
  </form>

</section>

<script>
  // 1. Provider presets handler
  const providerRadios = document.querySelectorAll('input[name="ai_provider"]');
  const aiModelInput = document.getElementById('ai_model');
  const aiBaseUrlInput = document.getElementById('ai_base_url');

  const providerDefaults = {
    nvidia: { model: 'meta/llama-3.1-70b-instruct', url: 'https://' + ['i','n','t','e','g','r','a','t','e'].join('') + '.api.nvidia.com/v1' },
    openai: { model: 'gpt-4o-mini', url: 'https://api.openai.com/v1' },
    gemini: { model: 'gemini-1.5-flash', url: '' },
    custom: { model: 'llama3:8b', url: 'http://localhost:11434/v1' }
  };

  providerRadios.forEach(radio => {
    radio.addEventListener('change', () => {
      document.querySelectorAll('#providerCards label').forEach(l => {
        l.classList.remove('border-brand-500', 'bg-brand-50', 'dark:bg-brand-900/30', 'ring-1', 'ring-brand-500');
        l.classList.add('border-slate-200', 'dark:border-brand-border');
      });
      const currentLabel = radio.closest('label');
      currentLabel.classList.add('border-brand-500', 'bg-brand-50', 'dark:bg-brand-900/30', 'ring-1', 'ring-brand-500');
      currentLabel.classList.remove('border-slate-200', 'dark:border-brand-border');

      const preset = providerDefaults[radio.value];
      if (preset) {
        aiModelInput.value = preset.model;
        aiBaseUrlInput.value = preset.url;
      }
    });
  });

  // 2. Test AI Model Connection
  const btnTestAi = document.getElementById('btnTestAi');
  const aiTestResult = document.getElementById('aiTestResult');

  btnTestAi.addEventListener('click', async () => {
    aiTestResult.className = 'mt-3 p-4 rounded-xl text-xs font-mono bg-blue-50 dark:bg-blue-950/50 text-blue-800 dark:text-blue-300 border border-blue-200 dark:border-blue-800 block';
    aiTestResult.innerHTML = '<span class="animate-pulse">🔄 Testing AI model endpoint and validating response payload...</span>';
    btnTestAi.disabled = true;

    const selectedProvider = document.querySelector('input[name="ai_provider"]:checked')?.value || 'nvidia';
    const payload = {
      provider: selectedProvider,
      apiKey: document.getElementById('ai_api_key').value,
      model: document.getElementById('ai_model').value,
      baseUrl: document.getElementById('ai_base_url').value
    };

    try {
      const res = await fetch('/admin/ai/test', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.success) {
        aiTestResult.className = 'mt-3 p-4 rounded-xl text-xs font-mono bg-emerald-50 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 block space-y-1.5 shadow-sm';
        aiTestResult.innerHTML = `
          <div class="font-bold text-sm flex items-center space-x-2">
            <span>✅ Connection Verified Successfully!</span>
            <span class="text-[10px] px-2 py-0.5 rounded bg-emerald-200/50 dark:bg-emerald-900/50">${data.latencyMs}ms</span>
          </div>
          <div><strong>Provider:</strong> ${data.provider.toUpperCase()} | <strong>Model:</strong> ${data.model}</div>
          <div class="mt-2 p-2.5 bg-white/60 dark:bg-black/30 rounded-lg border border-emerald-200 dark:border-emerald-800 text-[11px]">
            &ldquo;${data.response}&rdquo;
          </div>
        `;
      } else {
        aiTestResult.className = 'mt-3 p-4 rounded-xl text-xs font-mono bg-red-50 dark:bg-red-950/50 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800 block space-y-1';
        aiTestResult.innerHTML = `
          <div class="font-bold text-sm">❌ AI Connection Error</div>
          <div>${data.error}</div>
          <div class="text-[10px] text-slate-500 mt-1">Tip: Leave API key blank to test the built-in local simulation pipeline.</div>
        `;
      }
    } catch (err) {
      aiTestResult.className = 'mt-3 p-4 rounded-xl text-xs font-mono bg-red-50 dark:bg-red-950/50 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800 block';
      aiTestResult.innerHTML = `❌ <strong>Network Request Failed:</strong> ${err.message}`;
    } finally {
      btnTestAi.disabled = false;
    }
  });

  // 3. Topic suggestions via AI Agent / Curated Engine
  const btnRandomTopic = document.getElementById('btnRandomTopic');
  const aiTopicInput = document.getElementById('aiTopic');
  const aiTopicChips = document.getElementById('aiTopicChips');

  btnRandomTopic.addEventListener('click', async () => {
    const originalText = btnRandomTopic.innerHTML;
    btnRandomTopic.innerHTML = '<span class="animate-pulse">🔄 Suggesting...</span>';
    btnRandomTopic.disabled = true;

    try {
      const res = await fetch('/admin/ai/suggest-topics', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ category: document.getElementById('aiCategory').value })
      });
      const data = await res.json();
      if (data.success && data.topics && data.topics.length > 0) {
        aiTopicInput.value = data.topics[0];
        aiTopicChips.innerHTML = '';
        aiTopicChips.classList.remove('hidden');

        data.topics.forEach((t) => {
          const chip = document.createElement('button');
          chip.type = 'button';
          chip.className = 'text-[11px] px-2.5 py-1 rounded-lg border border-slate-200 dark:border-brand-border bg-slate-50 dark:bg-slate-900 hover:bg-brand-50 dark:hover:bg-brand-900/40 hover:border-brand-500 text-slate-700 dark:text-slate-300 font-medium transition text-left';
          chip.textContent = t;
          chip.addEventListener('click', () => {
            aiTopicInput.value = t;
            aiTopicChips.querySelectorAll('button').forEach(b => b.classList.remove('ring-1', 'ring-brand-500', 'border-brand-500'));
            chip.classList.add('ring-1', 'ring-brand-500', 'border-brand-500');
          });
          aiTopicChips.appendChild(chip);
        });
      }
    } catch (err) {
      console.warn('Suggest topics failed:', err);
    } finally {
      btnRandomTopic.innerHTML = originalText;
      btnRandomTopic.disabled = false;
    }
  });

  // 4. Generate Article On-Demand
  const btnGenerateArticle = document.getElementById('btnGenerateArticle');
  const aiGenStatus = document.getElementById('aiGenStatus');

  btnGenerateArticle.addEventListener('click', async () => {
    let topic = aiTopicInput.value.trim();
    if (!topic) {
      topic = 'Optimizing Ultra-Low Power Sleep Modes on ESP32-S3 IoT Endpoints';
      aiTopicInput.value = topic;
    }

    aiGenStatus.className = 'p-4 rounded-xl text-xs font-mono bg-blue-50 dark:bg-blue-950/50 text-blue-800 dark:text-blue-300 border border-blue-200 dark:border-blue-800 block animate-pulse';
    aiGenStatus.innerHTML = `⚙️ <strong>Drafting in Progress:</strong> Engineering engine is generating schematics, register configurations, and C firmware code for "<em>${topic}</em>"...`;
    btnGenerateArticle.disabled = true;

    try {
      const res = await fetch('/admin/ai/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          topic,
          category: document.getElementById('aiCategory').value,
          targetAudience: document.getElementById('aiAudience').value
        })
      });
      const data = await res.json();
      if (data.success) {
        aiGenStatus.className = 'p-4 rounded-xl text-xs font-mono bg-emerald-50 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 block space-y-2 shadow-sm';
        aiGenStatus.innerHTML = `
          <div class="font-bold text-sm flex items-center space-x-2">
            <span>🎉 Article Drafted &amp; Saved Successfully!</span>
          </div>
          <div class="mt-1"><strong>Title:</strong> ${data.post.title}</div>
          <div class="mt-1"><strong>CMS Status:</strong> <span class="px-2 py-0.5 bg-yellow-100 text-yellow-800 dark:bg-yellow-900/50 dark:text-yellow-300 rounded text-[10px] font-bold uppercase">Saved to Drafts</span></div>
          <div class="mt-3 flex flex-wrap items-center gap-3">
            <a href="/admin/posts/${data.post.id}/edit" class="px-4 py-2 bg-brand-500 hover:bg-brand-600 text-white rounded-lg font-bold text-xs transition">Edit / Review in CMS &rarr;</a>
            <a href="/blogs/${data.post.slug}" target="_blank" class="px-4 py-2 bg-slate-100 dark:bg-brand-dark hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-800 dark:text-white rounded-lg font-bold text-xs border border-slate-300 dark:border-slate-700 transition">Preview Live Layout &nearr;</a>
          </div>
        `;
      } else {
        aiGenStatus.className = 'p-4 rounded-xl text-xs font-mono bg-red-50 dark:bg-red-950/50 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800 block';
        aiGenStatus.innerHTML = `❌ <strong>Article Generation Failed:</strong><br>${data.error}`;
      }
    } catch (err) {
      aiGenStatus.className = 'p-4 rounded-xl text-xs font-mono bg-red-50 dark:bg-red-950/50 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800 block';
      aiGenStatus.innerHTML = `❌ <strong>Request Failed:</strong> ${err.message}`;
    } finally {
      btnGenerateArticle.disabled = false;
    }
  });

  // 5. Generate Technical Outline On-Demand
  const btnGenerateOutline = document.getElementById('btnGenerateOutline');
  const aiOutlineBox = document.getElementById('aiOutlineBox');
  const aiOutlineSourceBadge = document.getElementById('aiOutlineSourceBadge');
  const aiOutlineTitle = document.getElementById('aiOutlineTitle');
  const aiOutlineSummary = document.getElementById('aiOutlineSummary');
  const aiOutlineContent = document.getElementById('aiOutlineContent');
  const btnCopyOutline = document.getElementById('btnCopyOutline');

  btnGenerateOutline.addEventListener('click', async () => {
    let topic = aiTopicInput.value.trim();
    if (!topic) {
      topic = 'Deterministic CAN-FD Bus Timing & Bit-Rate Switching in Automotive ECUs';
      aiTopicInput.value = topic;
    }

    aiGenStatus.className = 'p-4 rounded-xl text-xs font-mono bg-blue-50 dark:bg-blue-950/50 text-blue-800 dark:text-blue-300 border border-blue-200 dark:border-blue-800 block animate-pulse';
    aiGenStatus.innerHTML = `⚙️ <strong>Synthesizing Outline:</strong> Engineering engine is generating technical structure and C code skeleton...`;
    btnGenerateOutline.disabled = true;

    try {
      const res = await fetch('/admin/ai/generate-outline', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          topic,
          category: document.getElementById('aiCategory').value,
          targetAudience: document.getElementById('aiAudience').value
        })
      });
      const data = await res.json();
      if (data.success && data.outline) {
        aiGenStatus.classList.add('hidden');
        aiOutlineBox.classList.remove('hidden');
        aiOutlineSourceBadge.textContent = data.source === 'ai_agent' ? `AI Agent (${data.provider})` : 'Curated Template';
        aiOutlineTitle.textContent = data.outline.title || topic;
        aiOutlineSummary.textContent = data.outline.summary || '';
        aiOutlineContent.textContent = data.outline.contentMarkdown || '';
      } else {
        aiGenStatus.className = 'p-4 rounded-xl text-xs font-mono bg-red-50 dark:bg-red-950/50 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800 block';
        aiGenStatus.innerHTML = `❌ <strong>Outline Generation Failed:</strong><br>${data.error || 'Unknown error'}`;
      }
    } catch (err) {
      aiGenStatus.className = 'p-4 rounded-xl text-xs font-mono bg-red-50 dark:bg-red-950/50 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800 block';
      aiGenStatus.innerHTML = `❌ <strong>Request Failed:</strong> ${err.message}`;
    } finally {
      btnGenerateOutline.disabled = false;
    }
  });

  btnCopyOutline.addEventListener('click', () => {
    navigator.clipboard.writeText(aiOutlineContent.textContent).then(() => {
      const original = btnCopyOutline.textContent;
      btnCopyOutline.textContent = '✅ Copied!';
      setTimeout(() => { btnCopyOutline.textContent = original; }, 2000);
    });
  });

  // 6. Automated Scheduler Controls
  const btnRunSchedulerNow = document.getElementById('btnRunSchedulerNow');
  const schedulerRunStatus = document.getElementById('schedulerRunStatus');
  const btnPopulateDefaultTopics = document.getElementById('btnPopulateDefaultTopics');
  const aiSchedulerTopics = document.getElementById('aiSchedulerTopics');

  const defaultTopicsArray = [
    "High-Density Interconnect (HDI) Microvias & Differential Pair Skew Matching in 8-Layer PCBs",
    "Hardware Design Strategies for Minimizing EMI and ESD on Industrial CAN-FD Nodes",
    "Designing Ultra-Low-Noise Switched Mode Power Supplies for 24-Bit ADC Frontends",
    "Implementing Hard Real-Time Mutexes and DMA Streams in FreeRTOS on STM32G4",
    "Battery Life Optimization for LoRaWAN Class A Nodes Operating in Deep Freeze Environments",
    "Hardware-in-the-Loop (HIL) Automated Fault Injection for Automotive ECUs using Python",
    "Designing Fail-Safe Dual-Bank FOTA Firmware Bootloaders for ESP32-S3 over BLE",
    "Eliminating Ground Bounce & Clock Jitter in 100MHz+ SPI Bus Architectures",
    "Thermal Modeling & Copper Pour Heat Sinking for High-Power GaN Transistors in Motor Inverters",
    "Deterministic FreeRTOS Queue Management and Interrupt Latency Benchmarking on Cortex-M7",
    "Precision Low-Side vs High-Side Current Sensing Circuit Topology in Battery Management Systems",
    "Configuring Zero-Wait-State Flash Cache & TCM Memory for STM32H7 DSP Audio Filters"
  ];

  if (btnPopulateDefaultTopics) {
    btnPopulateDefaultTopics.addEventListener('click', () => {
      aiSchedulerTopics.value = defaultTopicsArray.join('\n');
    });
  }

  if (btnRunSchedulerNow) {
    btnRunSchedulerNow.addEventListener('click', async () => {
      schedulerRunStatus.className = 'mt-4 p-4 rounded-xl text-xs font-mono bg-blue-50 dark:bg-blue-950/50 text-blue-800 dark:text-blue-300 border border-blue-200 dark:border-blue-800 block animate-pulse';
      schedulerRunStatus.innerHTML = `⚙️ <strong>Triggering Scheduled Blog Engine:</strong> Selecting next queued topic, checking database post limits, and generating engineering article...`;
      btnRunSchedulerNow.disabled = true;

      try {
        const res = await fetch('/admin/ai/auto-gen/run-now', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();
        if (data.success && data.post) {
          schedulerRunStatus.className = 'mt-4 p-4 rounded-xl text-xs font-mono bg-emerald-50 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 block space-y-2 shadow-sm';
          schedulerRunStatus.innerHTML = `
            <div class="font-bold text-sm flex items-center space-x-2">
              <span>🎉 Article Successfully Auto-Generated &amp; Added to CMS!</span>
            </div>
            <div><strong>Title:</strong> ${data.post.title}</div>
            <div><strong>Status:</strong> <span class="px-2 py-0.5 rounded font-bold uppercase text-[10px] bg-emerald-200/50 dark:bg-emerald-900/50">${data.post.status}</span></div>
            <div class="mt-3 flex items-center gap-3">
              <a href="/admin/posts/${data.post.id}/edit" class="px-3.5 py-1.5 bg-brand-500 hover:bg-brand-600 text-white rounded-lg font-bold text-xs transition">Edit in CMS &rarr;</a>
              <a href="/blogs/${data.post.slug}" target="_blank" class="px-3.5 py-1.5 bg-slate-100 dark:bg-brand-dark hover:bg-slate-200 text-slate-800 dark:text-white rounded-lg font-bold text-xs border border-slate-300 dark:border-slate-700 transition">View Live &nearr;</a>
            </div>
          `;
        } else {
          schedulerRunStatus.className = 'mt-4 p-4 rounded-xl text-xs font-mono bg-yellow-50 dark:bg-yellow-950/50 text-yellow-800 dark:text-yellow-300 border border-yellow-200 dark:border-yellow-800 block';
          schedulerRunStatus.innerHTML = `⚠️ <strong>Scheduler Notice:</strong> ${data.error || 'Operation skipped.'}`;
        }
      } catch (err) {
        schedulerRunStatus.className = 'mt-4 p-4 rounded-xl text-xs font-mono bg-red-50 dark:bg-red-950/50 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-800 block';
        schedulerRunStatus.innerHTML = `❌ <strong>Request Failed:</strong> ${err.message}`;
      } finally {
        btnRunSchedulerNow.disabled = false;
      }
    });
  }
</script>

</div></div>
<%- include('layout_bottom') %>
