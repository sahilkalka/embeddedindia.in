<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login - Embedded India Portal</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <script>
    if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
    const savedPalette = localStorage.getItem('color-palette') || 'emerald';
    document.documentElement.setAttribute('data-palette', savedPalette);
  </script>
</head>
<body class="ui-shell admin-login bg-slate-100 dark:bg-[#0d1715] text-[#192c27] dark:text-slate-100 font-sans min-h-screen flex items-center justify-center p-4">

  <div class="max-w-md w-full bg-white dark:bg-brand-surface rounded-3xl p-8 sm:p-10 border border-slate-200 dark:border-brand-border shadow-2xl">
    
    <!-- Logo & Typography -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 via-brand-500 to-accent p-0.5 shadow-md shadow-brand-500/20">
          <div class="w-full h-full bg-white dark:bg-[#0b1412] rounded-[10px] flex items-center justify-center p-2">
            <svg class="w-full h-full text-brand-500 dark:text-accent" viewBox="0 0 32 32" fill="currentColor">
              <path d="M16 3C16.8 3 17.5 3.4 18 4.2L28.5 21.8C29.2 23 28.7 24.5 27.5 25.2C27.1 25.4 26.6 25.5 26.1 25.5H19.8C18.7 25.5 17.7 24.8 17.3 23.8L16 20.3L14.7 23.8C14.3 24.8 13.3 25.5 12.2 25.5H5.9C4.5 25.5 3.4 24.4 3.4 23C3.4 22.5 3.5 22.1 3.8 21.8L14 4.2C14.5 3.4 15.2 3 16 3Z"/>
            </svg>
          </div>
        </div>
        <span class="text-2xl font-black text-slate-900 dark:text-white">Embedded <span class="text-brand-500 dark:text-accent">India</span></span>
      </div>
      <h1 class="text-lg font-extrabold text-slate-900 dark:text-white mt-4">Administrator Portal</h1>
      <p class="text-xs text-slate-500 mt-1">Sign in with authorized staff credentials</p>
    </div>

    <% if (error) { %>
      <div class="mb-6 p-4 rounded-xl bg-red-50 dark:bg-red-950/50 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-400 text-xs font-semibold">
        <%= error %>
      </div>
    <% } %>

    <form action="/admin/login" method="POST" class="space-y-5">
      <input type="hidden" name="redirect" value="<%= typeof redirect !== 'undefined' ? redirect : '' %>">
      <div>
        <label for="admin-email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
          Email or Username
        </label>
        <input 
          type="text" 
          id="admin-email"
          name="email" 
          required 
          placeholder="admin@embeddedindia.in" 
          class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 font-medium"
        >
      </div>

      <div>
        <label for="admin-password" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
          Password
        </label>
        <input 
          type="password" 
          id="admin-password"
          name="password" 
          required 
          placeholder="••••••••••••" 
          class="w-full px-4 py-2.5 rounded-xl bg-slate-50 dark:bg-brand-dark border border-slate-200 dark:border-brand-border text-slate-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 font-medium"
        >
      </div>

      <button 
        type="submit" 
        class="w-full py-3 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl shadow-lg transition text-sm tracking-wide"
      >
        Sign In to Dashboard &rarr;
      </button>

      <div class="pt-4 text-center">
        <a href="/" class="text-xs text-brand-500 dark:text-accent font-semibold hover:underline">&larr; Return to Public Website</a>
      </div>
    </form>

  </div>

</body>
</html>
